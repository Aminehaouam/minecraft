<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
      <Color3 name="Ambient">
        <R>1</R>
        <G>1</G>
        <B>1</B>
      </Color3>
      <float name="Brightness">0</float>
      <float name="FogEnd">100000</float>
      <bool name="GlobalShadows">false</bool>
      <Color3 name="OutdoorAmbient">
        <R>1</R>
        <G>1</G>
        <B>1</B>
      </Color3>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="1">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">ArtBlocks</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ArtBlocks — رسّامو نقوش البلاطات.

	لكل نمط نقش دالة ترسم بلاطة 16×16 بكسلاً بكسلاً. لا صور خارجية:
	الحجر يُرشّ حبيباً، والخشب يُخطّ عروقاً، والطوب يُبنى صفوفاً مزاحة،
	والخامات تُنثر عناقيدَ داخل صخر مضيف.

	وحدة نقية (بلا واجهة روبلوكس) — تُختبر خارج المحرّك.
]]

local Blocks = require(script.Parent.Blocks)
local Pixels = require(script.Parent.Pixels)

local B = Blocks.ID
local ArtBlocks = {}

export type Canvas = Pixels.Canvas

local function rgb(color: Color3): (number, number, number)
	return Pixels.rgb(color)
end

local function mix(color: Color3, other: Color3, t: number): Color3
	return color:Lerp(other, t)
end

local BLACK = Color3.fromRGB(0, 0, 0)
local WHITE = Color3.fromRGB(255, 255, 255)
local STONE_HOST = Color3.fromRGB(122, 122, 130)
local ASH_HOST = Color3.fromRGB(78, 70, 68)

-- ===== لبنات أساسية =====

local function fillBase(canvas: Canvas, size: number, color: Color3)
	local r, g, b = rgb(color)
	Pixels.fill(canvas, 0, 0, size, size, r, g, b, 255)
end

-- صخر حبيبي: أساس + رشّ + شقوق قصيرة
local function rockTexture(canvas: Canvas, size: number, color: Color3, seed: number, grain: number)
	fillBase(canvas, size, color)
	Pixels.speckle(canvas, 0, 0, size, size, seed, grain, 0.34)

	-- شقّان قصيران يكسران الرتابة
	local dark = mix(color, BLACK, 0.35)
	local dr, dg, db = rgb(dark)
	for i = 0, 1 do
		local sx = math.floor(Pixels.noise(seed + i, 11, seed) * size)
		local sy = math.floor(Pixels.noise(seed + i, 23, seed) * size)
		local length = 2 + math.floor(Pixels.noise(seed + i, 37, seed) * 3)
		local horizontal = Pixels.noise(seed + i, 41, seed) > 0.5
		for k = 0, length do
			if horizontal then
				Pixels.set(canvas, sx + k, sy, dr, dg, db, 255)
			else
				Pixels.set(canvas, sx, sy + k, dr, dg, db, 255)
			end
		end
	end
end

-- تربة: حبيبات أخشن + حصيّات صغيرة
local function soilTexture(canvas: Canvas, size: number, color: Color3, seed: number)
	fillBase(canvas, size, color)
	Pixels.speckle(canvas, 0, 0, size, size, seed, 0.26, 0.4)

	local pebble = mix(color, BLACK, 0.28)
	local pr, pg, pb = rgb(pebble)
	for i = 0, 3 do
		local px = math.floor(Pixels.noise(seed + i * 7, 3, seed) * (size - 2))
		local py = math.floor(Pixels.noise(seed + i * 7, 5, seed) * (size - 2))
		Pixels.fill(canvas, px, py, 2, 1, pr, pg, pb, 255)
		Pixels.set(canvas, px, py + 1, pr, pg, pb, 255)
	end
end

-- ===== الرسّامون =====

type Painter = (canvas: Canvas, size: number, block: Blocks.Block, seed: number) -> ()

local painters: { [string]: Painter } = {}

painters.rock = function(canvas, size, block, seed)
	rockTexture(canvas, size, block.color, seed, 0.22)
end

painters.soil = function(canvas, size, block, seed)
	soilTexture(canvas, size, block.color, seed)
end

painters.grass = function(canvas, size, block, seed)
	-- تراب تحت، وغطاء عشبي متعرّج فوقه
	soilTexture(canvas, size, Color3.fromRGB(120, 85, 58), seed)
	local top = block.color
	local tr, tg, tb = rgb(top)
	local shade = mix(top, BLACK, 0.3)
	local sr, sg, sb = rgb(shade)

	for x = 0, size - 1 do
		local depth = 4 + math.floor(Pixels.noise(x, 1, seed) * 3)
		for y = 0, depth - 1 do
			local tone = if y == depth - 1 then 0.55 else 0
			Pixels.set(canvas, x, y,
				tr * (1 - tone) + sr * tone,
				tg * (1 - tone) + sg * tone,
				tb * (1 - tone) + sb * tone, 255)
		end
		-- بريق على السطح
		if Pixels.noise(x, 9, seed) > 0.72 then
			local lr, lg, lb = rgb(mix(top, WHITE, 0.3))
			Pixels.set(canvas, x, 0, lr, lg, lb, 255)
		end
	end
end

painters.sand = function(canvas, size, block, seed)
	fillBase(canvas, size, block.color)
	Pixels.speckle(canvas, 0, 0, size, size, seed, 0.16, 0.45)
	-- طبقات أفقية خفيفة
	local band = mix(block.color, BLACK, 0.12)
	local br, bg, bb = rgb(band)
	for y = 3, size - 1, 5 do
		for x = 0, size - 1 do
			if Pixels.noise(x, y, seed) > 0.35 then
				Pixels.set(canvas, x, y, br, bg, bb, 255)
			end
		end
	end
end

painters.layered = function(canvas, size, block, seed)
	fillBase(canvas, size, block.color)
	local dark = mix(block.color, BLACK, 0.22)
	local light = mix(block.color, WHITE, 0.16)
	local dr, dg, db = rgb(dark)
	local lr, lg, lb = rgb(light)
	for y = 0, size - 1 do
		if y % 4 == 0 then
			Pixels.fill(canvas, 0, y, size, 1, dr, dg, db, 255)
		elseif y % 4 == 1 then
			Pixels.fill(canvas, 0, y, size, 1, lr, lg, lb, 255)
		end
	end
	Pixels.speckle(canvas, 0, 0, size, size, seed, 0.12, 0.3)
end

painters.log = function(canvas, size, block, seed)
	fillBase(canvas, size, block.color)
	local dark = mix(block.color, BLACK, 0.34)
	local light = mix(block.color, WHITE, 0.18)
	local dr, dg, db = rgb(dark)
	local lr, lg, lb = rgb(light)

	-- عروق رأسية بعرض متغيّر
	for x = 0, size - 1 do
		local n = Pixels.noise(x, 2, seed)
		if n > 0.74 then
			Pixels.fill(canvas, x, 0, 1, size, dr, dg, db, 255)
		elseif n < 0.18 then
			Pixels.fill(canvas, x, 0, 1, size, lr, lg, lb, 255)
		end
	end
	-- حافتا اللحاء
	Pixels.fill(canvas, 0, 0, 1, size, dr, dg, db, 255)
	Pixels.fill(canvas, size - 1, 0, 1, size, dr, dg, db, 255)
	-- عقدة
	local kx = 4 + math.floor(Pixels.noise(seed, 7, seed) * 6)
	local ky = 4 + math.floor(Pixels.noise(seed, 13, seed) * 7)
	Pixels.ellipse(canvas, kx, ky, 2, 1.6, dr, dg, db, 255)
	Pixels.set(canvas, kx, ky, lr, lg, lb, 255)
end

painters.plank = function(canvas, size, block, seed)
	fillBase(canvas, size, block.color)
	local seam = mix(block.color, BLACK, 0.45)
	local light = mix(block.color, WHITE, 0.16)
	local grain = mix(block.color, BLACK, 0.2)
	local sr, sg, sb = rgb(seam)
	local lr, lg, lb = rgb(light)
	local grainR, grainG, grainB = rgb(grain)

	-- ثلاثة ألواح أفقية طويلة: فاصل غائر ثم حافة مضاءة
	for _, y in { 0, 5, 10 } do
		Pixels.fill(canvas, 0, y, size, 1, sr, sg, sb, 255)
		Pixels.fill(canvas, 0, y + 1, size, 1, lr, lg, lb, 255)
	end

	-- عروق طولية داخل كل لوح (شرطات، لا فواصل كاملة)
	for _, y in { 2, 7, 12 } do
		for x = 0, size - 1 do
			if Pixels.noise(x, y, seed) > 0.66 then
				Pixels.set(canvas, x, y, grainR, grainG, grainB, 255)
			end
		end
	end

	-- مسمار واحد في كل لوح
	local nail = mix(block.color, BLACK, 0.6)
	local nr, ng, nb = rgb(nail)
	Pixels.set(canvas, 2, 3, nr, ng, nb, 255)
	Pixels.set(canvas, size - 3, 8, nr, ng, nb, 255)
	Pixels.set(canvas, 3, 13, nr, ng, nb, 255)
	Pixels.speckle(canvas, 0, 0, size, size, seed, 0.08, 0.22)
end

painters.brick = function(canvas, size, block, seed)
	fillBase(canvas, size, block.color)
	local mortar = mix(block.color, BLACK, 0.45)
	local light = mix(block.color, WHITE, 0.16)
	local mr, mg, mb = rgb(mortar)
	local lr, lg, lb = rgb(light)

	local rowHeight = 4
	for row = 0, math.floor(size / rowHeight) - 1 do
		local y = row * rowHeight
		Pixels.fill(canvas, 0, y, size, 1, mr, mg, mb, 255)
		Pixels.fill(canvas, 0, y + 1, size, 1, lr, lg, lb, 255)
		-- فواصل رأسية مزاحة بين الصفوف
		local offset = if row % 2 == 0 then 0 else math.floor(size / 4)
		for x = offset, size - 1, math.floor(size / 2) do
			Pixels.fill(canvas, x, y, 1, rowHeight, mr, mg, mb, 255)
		end
	end
	Pixels.speckle(canvas, 0, 0, size, size, seed, 0.08, 0.25)
end

painters.ore = function(canvas, size, block, seed)
	local host = if block.id == B.HELLSTONE_ORE then ASH_HOST else STONE_HOST
	rockTexture(canvas, size, host, seed, 0.2)

	local gem = block.color
	local gr, gg, gb = rgb(gem)
	local bright = mix(gem, WHITE, 0.45)
	local br, bg, bb = rgb(bright)
	local edge = mix(gem, BLACK, 0.35)
	local er, eg, eb = rgb(edge)

	-- ثلاثة عناقيد بأحجام مختلفة
	for i = 0, 2 do
		local cx = 3 + math.floor(Pixels.noise(seed + i * 13, 3, seed) * (size - 6))
		local cy = 3 + math.floor(Pixels.noise(seed + i * 13, 9, seed) * (size - 6))
		local radius = 1.4 + Pixels.noise(seed + i, 17, seed) * 1.3
		Pixels.disc(canvas, cx, cy, radius + 0.6, er, eg, eb, 255)
		Pixels.disc(canvas, cx, cy, radius, gr, gg, gb, 255)
		Pixels.set(canvas, cx - 1, cy - 1, br, bg, bb, 255)
	end
end

painters.crystal = function(canvas, size, block, seed)
	rockTexture(canvas, size, mix(STONE_HOST, BLACK, 0.35), seed, 0.18)
	local gem = block.color
	local bright = mix(gem, WHITE, 0.5)
	local br, bg, bb = rgb(bright)
	local dark = mix(gem, BLACK, 0.4)

	-- بلّورة معيّنية الشكل
	local cx, cy = size // 2, size // 2
	for y = 0, size - 1 do
		local spread = 6 - math.floor(math.abs(y - cy) * 0.85)
		if spread > 0 then
			for x = cx - spread, cx + spread do
				local tone = if x < cx then bright elseif x > cx + 1 then dark else gem
				local r, g, b = rgb(tone)
				Pixels.set(canvas, x, y, r, g, b, 255)
			end
		end
	end
	Pixels.line(canvas, cx, 2, cx, size - 3, br, bg, bb, 255)
	Pixels.set(canvas, cx - 2, cy - 2, br, bg, bb, 255)
end

painters.leaves = function(canvas, size, block, seed)
	local base = block.color
	local dark = mix(base, BLACK, 0.32)
	local light = mix(base, WHITE, 0.22)

	Pixels.clear(canvas)
	-- كتل ورقية متداخلة مع فجوات شفافة
	for i = 0, 5 do
		local cx = 2 + math.floor(Pixels.noise(seed + i * 19, 3, seed) * (size - 4))
		local cy = 2 + math.floor(Pixels.noise(seed + i * 19, 11, seed) * (size - 4))
		local radius = 2.2 + Pixels.noise(seed + i, 29, seed) * 1.8
		local tone = if i % 3 == 0 then light elseif i % 3 == 1 then base else dark
		local r, g, b = rgb(tone)
		Pixels.disc(canvas, cx, cy, radius, r, g, b, 255)
	end
	-- املأ الحواف قليلاً حتى لا تبدو البلاطة ممزقة
	local r, g, b = rgb(base)
	for y = 0, size - 1 do
		for x = 0, size - 1 do
			local _, _, _, a = Pixels.get(canvas, x, y)
			if a == 0 and Pixels.noise(x, y, seed + 3) > 0.45 then
				Pixels.set(canvas, x, y, r, g, b, 255)
			end
		end
	end
	Pixels.speckle(canvas, 0, 0, size, size, seed, 0.18, 0.3)
end

painters.glass = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local tint = block.color
	local r, g, b = rgb(tint)
	-- زجاج شبه شفاف
	Pixels.fill(canvas, 0, 0, size, size, r, g, b, 42)
	-- إطار
	local frame = mix(tint, WHITE, 0.5)
	local fr, fg, fb = rgb(frame)
	Pixels.rectOutline(canvas, 0, 0, size, size, fr, fg, fb, 190)
	-- وميض قطري
	for i = 0, 5 do
		Pixels.set(canvas, 3 + i, 3 + i, 255, 255, 255, 150)
		Pixels.set(canvas, 4 + i, 3 + i, 255, 255, 255, 90)
	end
end

painters.liquid = function(canvas, size, block, seed)
	local base = block.color
	local light = mix(base, WHITE, 0.28)
	local dark = mix(base, BLACK, 0.22)
	local r, g, b = rgb(base)
	local alpha = if block.id == B.LAVA then 255 else 205
	Pixels.fill(canvas, 0, 0, size, size, r, g, b, alpha)

	local lr, lg, lb = rgb(light)
	local dr, dg, db = rgb(dark)
	for y = 0, size - 1 do
		for x = 0, size - 1 do
			local wave = math.sin((x + y * 0.6) * 0.9 + y) * 0.5 + 0.5
			if wave > 0.78 then
				Pixels.set(canvas, x, y, lr, lg, lb, alpha)
			elseif wave < 0.16 then
				Pixels.set(canvas, x, y, dr, dg, db, alpha)
			end
		end
	end
	if block.id == B.LAVA then
		-- عروق متوهجة
		local hot = mix(base, Color3.fromRGB(255, 240, 140), 0.7)
		local hr, hg, hb = rgb(hot)
		for i = 0, 2 do
			local y = 2 + i * 5
			Pixels.line(canvas, 0, y, size - 1, y + (if i % 2 == 0 then 2 else -2), hr, hg, hb, 255)
		end
	end
end

painters.snow = function(canvas, size, block, seed)
	fillBase(canvas, size, block.color)
	local shadow = mix(block.color, Color3.fromRGB(150, 180, 220), 0.4)
	local sr, sg, sb = rgb(shadow)
	for y = 0, size - 1 do
		for x = 0, size - 1 do
			if Pixels.noise(x, y, seed) > 0.82 then
				Pixels.set(canvas, x, y, sr, sg, sb, 255)
			elseif Pixels.noise(x, y, seed + 5) > 0.95 then
				Pixels.set(canvas, x, y, 255, 255, 255, 255)
			end
		end
	end
end

painters.ice = function(canvas, size, block, seed)
	local base = block.color
	local r, g, b = rgb(base)
	Pixels.fill(canvas, 0, 0, size, size, r, g, b, 225)
	local light = mix(base, WHITE, 0.55)
	local lr, lg, lb = rgb(light)
	for i = 0, 3 do
		local x = i * 4 + math.floor(Pixels.noise(i, 7, seed) * 3)
		Pixels.line(canvas, x, 0, x + 5, size - 1, lr, lg, lb, 200)
	end
	Pixels.speckle(canvas, 0, 0, size, size, seed, 0.12, 0.25)
end

painters.obsidian = function(canvas, size, block, seed)
	fillBase(canvas, size, block.color)
	local facet = mix(block.color, Color3.fromRGB(150, 120, 220), 0.35)
	local fr, fg, fb = rgb(facet)
	for i = 0, 4 do
		local x0 = math.floor(Pixels.noise(seed + i, 3, seed) * size)
		local y0 = math.floor(Pixels.noise(seed + i, 5, seed) * size)
		Pixels.line(canvas, x0, y0, x0 + 4, y0 + 4, fr, fg, fb, 255)
	end
	Pixels.speckle(canvas, 0, 0, size, size, seed, 0.22, 0.3)
end

painters.bedrock = function(canvas, size, block, seed)
	fillBase(canvas, size, block.color)
	local light = mix(block.color, WHITE, 0.22)
	local dark = mix(block.color, BLACK, 0.6)
	local lr, lg, lb = rgb(light)
	local dr, dg, db = rgb(dark)
	for y = 0, size - 1, 2 do
		for x = 0, size - 1, 2 do
			local n = Pixels.noise(x, y, seed)
			if n > 0.6 then
				Pixels.fill(canvas, x, y, 2, 2, lr, lg, lb, 255)
			elseif n < 0.3 then
				Pixels.fill(canvas, x, y, 2, 2, dr, dg, db, 255)
			end
		end
	end
end

painters.gravel = function(canvas, size, block, seed)
	-- أرضية داكنة بين الحصيّات حتى تبرز كل حصاة بحدّها
	fillBase(canvas, size, mix(block.color, BLACK, 0.42))
	local outline = mix(block.color, BLACK, 0.62)
	local orr, og, ob = rgb(outline)

	for i = 0, 13 do
		local cx = math.floor(Pixels.noise(seed + i * 3, 3, seed) * size)
		local cy = math.floor(Pixels.noise(seed + i * 3, 7, seed) * size)
		local radius = 1.4 + Pixels.noise(seed + i, 11, seed) * 1.1
		local tint = Pixels.noise(seed + i, 17, seed)
		local tone = mix(block.color, if tint > 0.6 then WHITE else BLACK, 0.16 * math.abs(tint - 0.5) * 2)
		local r, g, b = rgb(tone)
		Pixels.disc(canvas, cx, cy, radius + 0.5, orr, og, ob, 255)
		Pixels.disc(canvas, cx, cy, radius, r, g, b, 255)
		-- بريق علوي صغير يعطي استدارة
		Pixels.set(canvas, cx - 1, cy - 1, rgb(mix(tone, WHITE, 0.35)))
	end
end

painters.ash = function(canvas, size, block, seed)
	soilTexture(canvas, size, block.color, seed)
	-- جمرات خافتة
	for i = 0, 2 do
		local x = math.floor(Pixels.noise(seed + i, 19, seed) * size)
		local y = math.floor(Pixels.noise(seed + i, 23, seed) * size)
		Pixels.set(canvas, x, y, 220, 110, 60, 210)
	end
end

painters.cactus = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local base = block.color
	local dark = mix(base, BLACK, 0.3)
	local light = mix(base, WHITE, 0.25)
	local r, g, b = rgb(base)
	local dr, dg, db = rgb(dark)
	local lr, lg, lb = rgb(light)

	Pixels.fill(canvas, 2, 0, size - 4, size, r, g, b, 255)
	Pixels.fill(canvas, 2, 0, 1, size, dr, dg, db, 255)
	Pixels.fill(canvas, size - 3, 0, 1, size, dr, dg, db, 255)
	Pixels.fill(canvas, 5, 0, 1, size, lr, lg, lb, 255)
	Pixels.fill(canvas, 9, 0, 1, size, dr, dg, db, 255)
	-- أشواك
	for y = 1, size - 2, 4 do
		Pixels.set(canvas, 1, y, 240, 240, 220, 255)
		Pixels.set(canvas, size - 2, y + 2, 240, 240, 220, 255)
	end
end

painters.torch = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local stick = Color3.fromRGB(112, 78, 44)
	local sr, sg, sb = rgb(stick)
	local cx = size // 2
	Pixels.fill(canvas, cx - 1, 6, 2, size - 7, sr, sg, sb, 255)
	Pixels.fill(canvas, cx - 1, 6, 1, size - 7, rgb(mix(stick, BLACK, 0.3)))

	-- لهب: نواة بيضاء ثم صفراء ثم برتقالية
	Pixels.ellipse(canvas, cx, 4, 2.6, 3.2, 236, 120, 40, 255)
	Pixels.ellipse(canvas, cx, 4, 1.8, 2.4, 252, 196, 64, 255)
	Pixels.ellipse(canvas, cx, 4, 0.9, 1.4, 255, 246, 200, 255)
end

painters.lantern = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local metal = Color3.fromRGB(120, 110, 96)
	local mr, mg, mb = rgb(metal)
	local cx = size // 2
	Pixels.fill(canvas, cx - 1, 0, 2, 3, mr, mg, mb, 255)
	Pixels.rectOutline(canvas, cx - 4, 3, 9, 10, mr, mg, mb, 255)
	Pixels.fill(canvas, cx - 3, 4, 7, 8, 255, 224, 140, 255)
	Pixels.ellipse(canvas, cx, 8, 2, 3, 255, 250, 210, 255)
	Pixels.fill(canvas, cx - 4, 13, 9, 2, mr, mg, mb, 255)
end

painters.workbench = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local wood = block.color
	local dark = mix(wood, BLACK, 0.35)
	local light = mix(wood, WHITE, 0.2)
	local r, g, b = rgb(wood)
	local dr, dg, db = rgb(dark)
	local lr, lg, lb = rgb(light)

	Pixels.fill(canvas, 0, 3, size, 4, r, g, b, 255) -- السطح
	Pixels.fill(canvas, 0, 3, size, 1, lr, lg, lb, 255)
	Pixels.fill(canvas, 0, 6, size, 1, dr, dg, db, 255)
	Pixels.fill(canvas, 1, 7, 3, size - 7, r, g, b, 255) -- الأرجل
	Pixels.fill(canvas, size - 4, 7, 3, size - 7, r, g, b, 255)
	Pixels.fill(canvas, 1, 7, 1, size - 7, dr, dg, db, 255)
	Pixels.fill(canvas, size - 4, 7, 1, size - 7, dr, dg, db, 255)
	-- منشار ومطرقة صغيران على السطح
	Pixels.line(canvas, 4, 2, 9, 2, 200, 200, 210, 255)
	Pixels.fill(canvas, 11, 1, 3, 2, 150, 150, 160, 255)
end

painters.furnace = function(canvas, size, block, seed)
	rockTexture(canvas, size, block.color, seed, 0.2)
	local dark = mix(block.color, BLACK, 0.65)
	local dr, dg, db = rgb(dark)
	-- فتحة
	Pixels.fill(canvas, 3, 6, size - 6, 7, dr, dg, db, 255)
	Pixels.rectOutline(canvas, 3, 6, size - 6, 7, rgb(mix(block.color, BLACK, 0.35)))
	-- جمر متوهج
	for x = 4, size - 5 do
		local heat = Pixels.noise(x, 3, seed)
		if heat > 0.35 then
			Pixels.set(canvas, x, 11, 240, 140, 50, 255)
			Pixels.set(canvas, x, 12, 220, 90, 40, 255)
		end
	end
	Pixels.fill(canvas, 2, 2, size - 4, 2, rgb(mix(block.color, WHITE, 0.2)))
end

painters.anvil = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local metal = block.color
	local dark = mix(metal, BLACK, 0.4)
	local light = mix(metal, WHITE, 0.28)
	local r, g, b = rgb(metal)
	local dr, dg, db = rgb(dark)
	local lr, lg, lb = rgb(light)

	-- السطح العريض
	Pixels.fill(canvas, 2, 4, size - 4, 3, r, g, b, 255)
	Pixels.fill(canvas, 2, 4, size - 4, 1, lr, lg, lb, 255)
	Pixels.fill(canvas, 2, 6, size - 4, 1, dr, dg, db, 255)
	-- البوق المدبّب يساراً
	Pixels.fill(canvas, 0, 5, 2, 2, r, g, b, 255)
	Pixels.set(canvas, 0, 5, lr, lg, lb, 255)
	-- الخصر الضيّق
	Pixels.fill(canvas, 6, 7, 4, 4, dr, dg, db, 255)
	Pixels.fill(canvas, 6, 7, 1, 4, r, g, b, 255)
	-- القاعدة المتدرّجة
	Pixels.fill(canvas, 3, 11, size - 6, 2, r, g, b, 255)
	Pixels.fill(canvas, 2, 13, size - 4, 2, r, g, b, 255)
	Pixels.fill(canvas, 2, 14, size - 4, 1, dr, dg, db, 255)
end

painters.chest = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local wood = block.color
	local dark = mix(wood, BLACK, 0.38)
	local light = mix(wood, WHITE, 0.2)
	local r, g, b = rgb(wood)
	local dr, dg, db = rgb(dark)
	local lr, lg, lb = rgb(light)

	Pixels.fill(canvas, 1, 3, size - 2, size - 4, r, g, b, 255)
	Pixels.rectOutline(canvas, 1, 3, size - 2, size - 4, dr, dg, db, 255)
	Pixels.fill(canvas, 1, 3, size - 2, 1, lr, lg, lb, 255)
	Pixels.fill(canvas, 1, 7, size - 2, 1, dr, dg, db, 255) -- خط الغطاء
	-- الأحزمة المعدنية والقفل
	local metal = Color3.fromRGB(180, 150, 90)
	local mr, mg, mb = rgb(metal)
	Pixels.fill(canvas, 3, 3, 2, size - 4, mr, mg, mb, 255)
	Pixels.fill(canvas, size - 5, 3, 2, size - 4, mr, mg, mb, 255)
	Pixels.fill(canvas, size // 2 - 1, 6, 3, 4, mr, mg, mb, 255)
	Pixels.set(canvas, size // 2, 8, 40, 30, 20, 255)
end

painters.alchemy = function(canvas, size, block, seed)
	painters.workbench(canvas, size, block, seed)
	-- قوارير ملوّنة على السطح
	Pixels.fill(canvas, 3, 0, 2, 3, 120, 220, 150, 255)
	Pixels.fill(canvas, 7, 0, 2, 3, 220, 110, 150, 255)
	Pixels.fill(canvas, 11, 0, 2, 3, 130, 150, 240, 255)
end

painters.enchant = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local stone = block.color
	local r, g, b = rgb(stone)
	local dark = mix(stone, BLACK, 0.4)
	local dr, dg, db = rgb(dark)

	Pixels.fill(canvas, 1, 6, size - 2, size - 7, r, g, b, 255)
	Pixels.rectOutline(canvas, 1, 6, size - 2, size - 7, dr, dg, db, 255)
	Pixels.fill(canvas, 0, 5, size, 2, rgb(mix(stone, WHITE, 0.25)))
	-- جوهرة معلّقة متوهجة
	Pixels.ellipse(canvas, size // 2, 3, 2.6, 2.6, 200, 160, 255, 220)
	Pixels.ellipse(canvas, size // 2, 3, 1.4, 1.4, 245, 230, 255, 255)
	-- رموز
	for i = 0, 3 do
		Pixels.set(canvas, 3 + i * 3, 9, 210, 180, 255, 210)
		Pixels.set(canvas, 3 + i * 3, 12, 180, 150, 240, 170)
	end
end

painters.platform = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local wood = block.color
	local r, g, b = rgb(wood)
	local dark = mix(wood, BLACK, 0.4)
	local light = mix(wood, WHITE, 0.22)
	Pixels.fill(canvas, 0, 0, size, 4, r, g, b, 255)
	Pixels.fill(canvas, 0, 0, size, 1, rgb(light))
	Pixels.fill(canvas, 0, 3, size, 1, rgb(dark))
	for x = 3, size - 1, 5 do
		Pixels.fill(canvas, x, 0, 1, 4, rgb(dark))
	end
end

painters.ladder = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local wood = block.color
	local r, g, b = rgb(wood)
	local dark = mix(wood, BLACK, 0.38)
	local light = mix(wood, WHITE, 0.28)

	-- القائمان: ظلّ على اليسار وإضاءة على اليمين يعطيان استدارة
	for _, x in { 2, size - 4 } do
		Pixels.fill(canvas, x, 0, 3, size, r, g, b, 255)
		Pixels.fill(canvas, x, 0, 1, size, rgb(dark))
		Pixels.fill(canvas, x + 2, 0, 1, size, rgb(light))
	end

	-- الدرجات: حافة مضاءة أعلى وظلّ أسفل
	for y = 2, size - 1, 5 do
		Pixels.fill(canvas, 3, y, size - 6, 3, r, g, b, 255)
		Pixels.fill(canvas, 3, y, size - 6, 1, rgb(light))
		Pixels.fill(canvas, 3, y + 2, size - 6, 1, rgb(dark))
	end
end

painters.cobweb = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local cx, cy = size // 2, size // 2

	-- خيوط شعاعية بدرجات مختلفة: الأقرب للمركز أنصع
	for i = 0, 7 do
		local angle = i * math.pi / 4
		local bright = if i % 2 == 0 then 248 else 206
		Pixels.line(canvas, cx, cy,
			math.floor(cx + math.cos(angle) * 8),
			math.floor(cy + math.sin(angle) * 8),
			bright, bright, math.min(255, bright + 6), 190)
	end

	-- حلقات لولبية أخفت
	for ring = 3, 7, 2 do
		local tone = 232 - ring * 10
		for i = 0, 15 do
			local angle = i * math.pi / 8
			Pixels.set(canvas,
				math.floor(cx + math.cos(angle) * ring),
				math.floor(cy + math.sin(angle) * ring),
				tone, tone, tone + 6, 170)
		end
	end

	-- عقدة المركز
	Pixels.set(canvas, cx, cy, 255, 255, 255, 230)
end

-- نباتات صغيرة على خلفية شفافة
painters.plant = function(canvas, size, block, seed)
	Pixels.clear(canvas)
	local base = block.color
	local dark = mix(base, BLACK, 0.3)
	local r, g, b = rgb(base)
	local dr, dg, db = rgb(dark)
	local cx = size // 2

	if block.id == B.FLOWER then
		Pixels.fill(canvas, cx, 8, 1, size - 8, 80, 150, 70, 255)
		Pixels.disc(canvas, cx, 6, 2.6, r, g, b, 255)
		Pixels.disc(canvas, cx, 6, 1.1, 255, 236, 150, 255)
		Pixels.set(canvas, cx - 2, 10, 80, 150, 70, 255)
	elseif block.id == B.MUSHROOM or block.id == B.GLOW_MUSHROOM then
		Pixels.fill(canvas, cx - 1, 9, 3, size - 9, 232, 222, 200, 255)
		Pixels.ellipse(canvas, cx, 8, 4, 2.6, r, g, b, 255)
		Pixels.set(canvas, cx - 2, 7, 255, 255, 255, 220)
		Pixels.set(canvas, cx + 2, 8, 255, 255, 255, 200)
	elseif block.id == B.SAPLING then
		Pixels.fill(canvas, cx, 9, 1, size - 9, 120, 88, 52, 255)
		Pixels.disc(canvas, cx, 7, 3, r, g, b, 255)
		Pixels.disc(canvas, cx - 2, 9, 1.6, dr, dg, db, 255)
	elseif block.id == B.VINE then
		local light = mix(base, WHITE, 0.3)
		local lr, lg, lb = rgb(light)
		for y = 0, size - 1 do
			local sway = math.floor(math.sin(y * 0.6) * 1.6)
			Pixels.set(canvas, cx + sway - 1, y, lr, lg, lb, 255) -- حافة مضاءة
			Pixels.set(canvas, cx + sway, y, r, g, b, 255)
			Pixels.set(canvas, cx + sway + 1, y, dr, dg, db, 255) -- ظلّ
			-- ورقة صغيرة كل بضع بكسلات
			if y % 5 == 2 then
				Pixels.set(canvas, cx + sway - 2, y, r, g, b, 255)
				Pixels.set(canvas, cx + sway - 3, y + 1, lr, lg, lb, 255)
			elseif y % 5 == 4 then
				Pixels.set(canvas, cx + sway + 2, y, r, g, b, 255)
			end
		end
	else -- حشائش: شفرات عريضة عند القاعدة تدقّ نحو الطرف وتنحني
		local light = mix(base, WHITE, 0.3)
		for i = 0, 3 do
			local rootX = 2 + i * 4 + math.floor(Pixels.noise(i, 5, seed) * 2)
			local height = 7 + math.floor(Pixels.noise(rootX, 3, seed) * 6)
			local dir = if i % 2 == 0 then 1 else -1
			for y = 0, height - 1 do
				local t = y / math.max(1, height - 1)
				local lean = math.floor(t * t * 3) * dir
				local width = if t < 0.35 then 2 elseif t < 0.75 then 1 else 1
				local tone = if t < 0.25 then dark elseif t > 0.8 then light else base
				local tr, tg, tb = rgb(tone)
				for k = 0, width - 1 do
					Pixels.set(canvas, rootX + lean + k, size - 1 - y, tr, tg, tb, 255)
				end
			end
		end
	end
end

-- ===== توزيع الأنماط على البلاطات =====

local styles: { [number]: string } = {
	[B.STONE] = "rock", [B.CLAY] = "rock", [B.MUD] = "soil",
	[B.DIRT] = "soil", [B.GRASS] = "grass", [B.JUNGLE_GRASS] = "grass",
	[B.SAND] = "sand", [B.SANDSTONE] = "layered", [B.SNOW] = "snow", [B.ICE] = "ice",
	[B.GRAVEL] = "gravel", [B.ASH] = "ash",
	[B.LOG] = "log", [B.LEAVES] = "leaves", [B.PLANK] = "plank",
	[B.STONE_BRICK] = "brick", [B.SAND_BRICK] = "brick", [B.BRICK] = "brick",
	[B.ICE_BRICK] = "brick", [B.HELLSTONE_BRICK] = "brick",
	[B.GLASS] = "glass", [B.OBSIDIAN] = "obsidian", [B.BEDROCK] = "bedrock",
	[B.COAL_ORE] = "ore", [B.COPPER_ORE] = "ore", [B.IRON_ORE] = "ore",
	[B.SILVER_ORE] = "ore", [B.GOLD_ORE] = "ore", [B.DIAMOND_ORE] = "ore",
	[B.MYTHRIL_ORE] = "ore", [B.HELLSTONE_ORE] = "ore", [B.CRYSTAL] = "crystal",
	[B.WATER] = "liquid", [B.LAVA] = "liquid",
	[B.TORCH] = "torch", [B.LANTERN] = "lantern",
	[B.WORKBENCH] = "workbench", [B.FURNACE] = "furnace", [B.ANVIL] = "anvil",
	[B.CHEST] = "chest", [B.ALCHEMY] = "alchemy", [B.ENCHANT_TABLE] = "enchant",
	[B.PLATFORM] = "platform", [B.LADDER] = "ladder", [B.CACTUS] = "cactus",
	[B.COBWEB] = "cobweb",
	[B.GRASS_TUFT] = "plant", [B.FLOWER] = "plant", [B.MUSHROOM] = "plant",
	[B.GLOW_MUSHROOM] = "plant", [B.SAPLING] = "plant", [B.VINE] = "plant",
}

ArtBlocks.painters = painters
ArtBlocks.styles = styles

function ArtBlocks.styleOf(blockId: number): string
	local explicit = styles[blockId]
	if explicit then return explicit end
	-- افتراضي معقول لأي بلاطة جديدة تُضاف لاحقاً بلا نمط
	local block = Blocks.get(blockId)
	if block.liquid then return "liquid" end
	if block.fragile then return "plant" end
	if block.solid then return "rock" end
	return "plant"
end

-- يرسم بلاطة واحدة بلا إضاءة حواف
function ArtBlocks.paint(blockId: number, size: number): Canvas
	local canvas = Pixels.new(size, size)
	local block = Blocks.get(blockId)
	local painter = painters[ArtBlocks.styleOf(blockId)] or painters.rock
	painter(canvas, size, block, blockId * 7919 + 13)
	return canvas
end

-- هل يستفيد هذا النمط من إضاءة الحواف؟ (النباتات والمشاعل لا)
function ArtBlocks.usesEdges(blockId: number): boolean
	local style = ArtBlocks.styleOf(blockId)
	return style ~= "plant" and style ~= "torch" and style ~= "lantern"
		and style ~= "cobweb" and style ~= "ladder" and style ~= "platform"
		and style ~= "liquid" and style ~= "anvil" and style ~= "chest"
		and style ~= "workbench" and style ~= "alchemy" and style ~= "enchant"
end

return ArtBlocks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">ArtItems</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ArtItems — أيقونات العناصر بكسل آرت.

	لا نرسم 119 أيقونة يدوياً: نرسم *أشكالاً* (سيف، معول، قارورة، سبيكة…)
	ونلوّنها بلون العنصر من السجل. النتيجة أيقونة مميّزة لكل عنصر، وأي عنصر
	جديد يحصل على أيقونة تلقائياً بلا عمل فني إضافي.

	عناصر البلاطات تستعمل نقش البلاطة نفسه — كما في تيراريا.
]]

local ArtBlocks = require(script.Parent.ArtBlocks)
local Items = require(script.Parent.Items)
local Pixels = require(script.Parent.Pixels)

local ArtItems = {}

local BLACK = Color3.fromRGB(0, 0, 0)
local WHITE = Color3.fromRGB(255, 255, 255)
local WOOD = Color3.fromRGB(126, 92, 54)

local function rgb(color: Color3): (number, number, number)
	return Pixels.rgb(color)
end

local function mix(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, t)
end

type Shape = (canvas: Pixels.Canvas, size: number, item: Items.Item) -> ()

local shapes: { [string]: Shape } = {}

-- مقبض خشبي قطري مشترك بين الأدوات
local function handle(canvas: Pixels.Canvas, size: number, fromX: number, fromY: number, toX: number, toY: number)
	local r, g, b = rgb(WOOD)
	local dr, dg, db = rgb(mix(WOOD, BLACK, 0.35))
	Pixels.line(canvas, fromX, fromY, toX, toY, r, g, b, 255)
	Pixels.line(canvas, fromX + 1, fromY, toX + 1, toY, dr, dg, db, 255)
end

shapes.sword = function(canvas, size, item)
	local blade = item.color
	local light = mix(blade, WHITE, 0.45)
	local dark = mix(blade, BLACK, 0.4)
	local r, g, b = rgb(blade)
	local lr, lg, lb = rgb(light)
	local dr, dg, db = rgb(dark)

	-- نصل قطري من أسفل اليسار إلى أعلى اليمين
	for i = 0, 9 do
		local x = 4 + i
		local y = 11 - i
		Pixels.set(canvas, x, y, r, g, b, 255)
		Pixels.set(canvas, x, y - 1, lr, lg, lb, 255)
		Pixels.set(canvas, x + 1, y, dr, dg, db, 255)
	end
	Pixels.set(canvas, 14, 1, lr, lg, lb, 255)
	-- الحارس والمقبض
	local guard = mix(blade, Color3.fromRGB(180, 150, 70), 0.55)
	local gr, gg, gb = rgb(guard)
	Pixels.line(canvas, 2, 10, 6, 14, gr, gg, gb, 255)
	Pixels.line(canvas, 2, 13, 5, 10, gr, gg, gb, 255)
	handle(canvas, size, 1, 14, 4, 11)
end

shapes.pickaxe = function(canvas, size, item)
	local head = item.color
	local light = mix(head, WHITE, 0.4)
	local dark = mix(head, BLACK, 0.4)
	local r, g, b = rgb(head)
	local lr, lg, lb = rgb(light)
	local dr, dg, db = rgb(dark)

	handle(canvas, size, 5, 14, 10, 4)
	-- رأس مقوّس
	for i = 0, 5 do
		Pixels.set(canvas, 3 + i, 5 - math.floor(i * 0.4), r, g, b, 255)
		Pixels.set(canvas, 3 + i, 4 - math.floor(i * 0.4), lr, lg, lb, 255)
		Pixels.set(canvas, 12 - i, 5 - math.floor(i * 0.4), r, g, b, 255)
		Pixels.set(canvas, 12 - i, 6 - math.floor(i * 0.4), dr, dg, db, 255)
	end
	Pixels.fill(canvas, 7, 3, 2, 3, lr, lg, lb, 255)
end

shapes.axe = function(canvas, size, item)
	local head = item.color
	local light = mix(head, WHITE, 0.4)
	local dark = mix(head, BLACK, 0.4)
	local r, g, b = rgb(head)
	local lr, lg, lb = rgb(light)
	local dr, dg, db = rgb(dark)

	handle(canvas, size, 5, 14, 9, 4)
	-- شفرة على شكل هلال
	for y = 2, 8 do
		local width = 5 - math.abs(y - 5)
		for x = 0, width do
			Pixels.set(canvas, 9 + x, y, r, g, b, 255)
		end
		Pixels.set(canvas, 9, y, lr, lg, lb, 255)
		Pixels.set(canvas, 9 + width, y, dr, dg, db, 255)
	end
end

shapes.hammer = function(canvas, size, item)
	local head = item.color
	local r, g, b = rgb(head)
	local lr, lg, lb = rgb(mix(head, WHITE, 0.35))
	local dr, dg, db = rgb(mix(head, BLACK, 0.4))
	handle(canvas, size, 6, 14, 8, 6)
	Pixels.fill(canvas, 3, 2, 10, 5, r, g, b, 255)
	Pixels.fill(canvas, 3, 2, 10, 1, lr, lg, lb, 255)
	Pixels.fill(canvas, 3, 6, 10, 1, dr, dg, db, 255)
end

shapes.bow = function(canvas, size, item)
	local wood = item.color
	local r, g, b = rgb(wood)
	local dr, dg, db = rgb(mix(wood, BLACK, 0.35))
	-- قوس منحنٍ
	for y = 2, 13 do
		local bend = math.floor(math.sin((y - 2) / 11 * math.pi) * 4)
		Pixels.set(canvas, 4 + bend, y, r, g, b, 255)
		Pixels.set(canvas, 5 + bend, y, dr, dg, db, 255)
	end
	-- الوتر
	Pixels.line(canvas, 4, 2, 4, 13, 225, 225, 215, 220)
	Pixels.set(canvas, 3, 7, 225, 225, 215, 255)
end

shapes.staff = function(canvas, size, item)
	local gem = item.color
	handle(canvas, size, 4, 15, 10, 5)
	local r, g, b = rgb(gem)
	local lr, lg, lb = rgb(mix(gem, WHITE, 0.55))
	Pixels.disc(canvas, 11, 4, 3.2, r, g, b, 255)
	Pixels.disc(canvas, 11, 4, 1.6, lr, lg, lb, 255)
	Pixels.set(canvas, 10, 3, 255, 255, 255, 255)
	-- شرر
	Pixels.set(canvas, 14, 1, lr, lg, lb, 200)
	Pixels.set(canvas, 8, 1, lr, lg, lb, 160)
end

shapes.arrow = function(canvas, size, item)
	local shaft = Color3.fromRGB(150, 120, 84)
	local r, g, b = rgb(shaft)
	Pixels.line(canvas, 3, 12, 12, 3, r, g, b, 255)
	local tipR, tipG, tipB = rgb(item.color)
	Pixels.fill(canvas, 11, 2, 3, 3, tipR, tipG, tipB, 255)
	Pixels.set(canvas, 13, 2, 255, 255, 255, 220)
	-- الريش
	Pixels.set(canvas, 3, 11, 230, 230, 230, 255)
	Pixels.set(canvas, 2, 12, 230, 230, 230, 255)
	Pixels.set(canvas, 4, 13, 230, 230, 230, 255)
end

local function armorPiece(canvas: Pixels.Canvas, item: Items.Item, kind: string)
	local metal = item.color
	local r, g, b = rgb(metal)
	local lr, lg, lb = rgb(mix(metal, WHITE, 0.35))
	local dr, dg, db = rgb(mix(metal, BLACK, 0.4))

	if kind == "head" then
		Pixels.ellipse(canvas, 8, 7, 5, 4.6, r, g, b, 255)
		Pixels.fill(canvas, 3, 7, 10, 4, r, g, b, 255)
		Pixels.fill(canvas, 4, 8, 8, 2, 30, 26, 34, 255) -- فتحة العينين
		Pixels.ellipse(canvas, 8, 5, 4.4, 3, lr, lg, lb, 255)
		Pixels.fill(canvas, 3, 11, 10, 1, dr, dg, db, 255)
	elseif kind == "chest" then
		Pixels.fill(canvas, 3, 3, 10, 10, r, g, b, 255)
		Pixels.fill(canvas, 3, 3, 10, 2, lr, lg, lb, 255)
		Pixels.fill(canvas, 3, 12, 10, 1, dr, dg, db, 255)
		Pixels.fill(canvas, 1, 4, 2, 5, r, g, b, 255) -- الكتفان
		Pixels.fill(canvas, 13, 4, 2, 5, r, g, b, 255)
		Pixels.fill(canvas, 7, 5, 2, 7, dr, dg, db, 255)
	else
		Pixels.fill(canvas, 2, 7, 5, 6, r, g, b, 255)
		Pixels.fill(canvas, 9, 7, 5, 6, r, g, b, 255)
		Pixels.fill(canvas, 2, 7, 5, 1, lr, lg, lb, 255)
		Pixels.fill(canvas, 9, 7, 5, 1, lr, lg, lb, 255)
		Pixels.fill(canvas, 1, 12, 6, 2, dr, dg, db, 255)
		Pixels.fill(canvas, 9, 12, 6, 2, dr, dg, db, 255)
	end
end

shapes.armor_head = function(canvas, size, item) armorPiece(canvas, item, "head") end
shapes.armor_chest = function(canvas, size, item) armorPiece(canvas, item, "chest") end
shapes.armor_feet = function(canvas, size, item) armorPiece(canvas, item, "feet") end

shapes.potion = function(canvas, size, item)
	local liquid = item.color
	local r, g, b = rgb(liquid)
	local lr, lg, lb = rgb(mix(liquid, WHITE, 0.45))
	-- زجاجة
	Pixels.fill(canvas, 6, 2, 4, 3, 210, 220, 230, 235)
	Pixels.fill(canvas, 6, 1, 4, 1, 150, 120, 80, 255) -- سدادة
	Pixels.ellipse(canvas, 8, 10, 4.6, 4.6, 205, 218, 232, 190)
	Pixels.ellipse(canvas, 8, 11, 3.6, 3.4, r, g, b, 255)
	Pixels.ellipse(canvas, 7, 10, 1.2, 1.2, lr, lg, lb, 255)
	Pixels.set(canvas, 5, 8, 255, 255, 255, 220)
end

shapes.food = function(canvas, size, item)
	local base = item.color
	local r, g, b = rgb(base)
	local lr, lg, lb = rgb(mix(base, WHITE, 0.4))
	local dr, dg, db = rgb(mix(base, BLACK, 0.3))
	Pixels.ellipse(canvas, 8, 9, 5, 4.6, r, g, b, 255)
	Pixels.ellipse(canvas, 6, 7, 1.8, 1.6, lr, lg, lb, 255)
	Pixels.ellipse(canvas, 10, 11, 2, 1.6, dr, dg, db, 255)
	if item.id == "apple" then
		Pixels.fill(canvas, 8, 3, 1, 3, 90, 140, 60, 255)
		Pixels.ellipse(canvas, 10, 4, 2, 1.2, 110, 180, 80, 255)
	end
end

shapes.bar = function(canvas, size, item)
	local metal = item.color
	local r, g, b = rgb(metal)
	local lr, lg, lb = rgb(mix(metal, WHITE, 0.4))
	local dr, dg, db = rgb(mix(metal, BLACK, 0.4))
	-- سبيكة شبه منحرفة
	for y = 0, 4 do
		local inset = 4 - y
		Pixels.fill(canvas, 2 + inset, 6 + y, 12 - inset * 2, 1, r, g, b, 255)
	end
	Pixels.fill(canvas, 6, 6, 4, 1, lr, lg, lb, 255)
	Pixels.fill(canvas, 2, 10, 12, 2, dr, dg, db, 255)
	Pixels.set(canvas, 5, 7, 255, 255, 255, 210)
end

shapes.ore_chunk = function(canvas, size, item)
	local host = Color3.fromRGB(120, 120, 128)
	local hr, hg, hb = rgb(host)
	Pixels.ellipse(canvas, 8, 9, 5.4, 4.6, hr, hg, hb, 255)
	Pixels.ellipse(canvas, 6, 7, 2, 1.6, rgb(mix(host, WHITE, 0.3)))
	local gem = item.color
	local r, g, b = rgb(gem)
	local lr, lg, lb = rgb(mix(gem, WHITE, 0.45))
	for i = 0, 2 do
		local cx = 6 + i * 2
		local cy = 8 + (i % 2) * 2
		Pixels.disc(canvas, cx, cy, 1.4, r, g, b, 255)
		Pixels.set(canvas, cx - 1, cy - 1, lr, lg, lb, 255)
	end
end

shapes.gem = function(canvas, size, item)
	local gem = item.color
	local r, g, b = rgb(gem)
	local lr, lg, lb = rgb(mix(gem, WHITE, 0.5))
	local dr, dg, db = rgb(mix(gem, BLACK, 0.35))
	for y = 3, 12 do
		local spread = if y < 7 then y - 2 else 13 - y
		for x = 8 - spread, 8 + spread do
			local tone = if x < 8 then lr elseif x > 8 then dr else r
			local tg = if x < 8 then lg elseif x > 8 then dg else g
			local tb = if x < 8 then lb elseif x > 8 then db else b
			Pixels.set(canvas, x, y, tone, tg, tb, 255)
		end
	end
	Pixels.set(canvas, 6, 5, 255, 255, 255, 235)
end

shapes.dust = function(canvas, size, item)
	local color = item.color
	local r, g, b = rgb(color)
	local lr, lg, lb = rgb(mix(color, WHITE, 0.5))
	for i = 0, 7 do
		local x = 3 + math.floor(Pixels.noise(i, 3, 77) * 10)
		local y = 3 + math.floor(Pixels.noise(i, 7, 77) * 10)
		Pixels.disc(canvas, x, y, 1.2, r, g, b, 230)
		Pixels.set(canvas, x, y, lr, lg, lb, 255)
	end
	-- بريق رباعي في الوسط
	Pixels.line(canvas, 8, 3, 8, 12, lr, lg, lb, 210)
	Pixels.line(canvas, 3, 8, 12, 8, lr, lg, lb, 210)
end

shapes.coin = function(canvas, size, item)
	local gold = item.color
	local r, g, b = rgb(gold)
	Pixels.disc(canvas, 8, 8, 5, rgb(mix(gold, BLACK, 0.35)))
	Pixels.disc(canvas, 8, 8, 4.2, r, g, b, 255)
	Pixels.disc(canvas, 6.5, 6.5, 1.4, rgb(mix(gold, WHITE, 0.6)))
	Pixels.fill(canvas, 7, 6, 2, 5, rgb(mix(gold, BLACK, 0.2)))
end

shapes.blob = function(canvas, size, item)
	local color = item.color
	local r, g, b = rgb(color)
	Pixels.ellipse(canvas, 8, 10, 5.2, 4, r, g, b, 225)
	Pixels.ellipse(canvas, 6.5, 8.5, 1.6, 1.2, 255, 255, 255, 200)
	Pixels.ellipse(canvas, 8, 12, 4, 1.6, rgb(mix(color, BLACK, 0.3)))
end

shapes.fiber = function(canvas, size, item)
	local color = item.color
	local r, g, b = rgb(color)
	for i = 0, 3 do
		local y = 4 + i * 3
		Pixels.line(canvas, 2, y, 13, y + (if i % 2 == 0 then 2 else -2), r, g, b, 255)
	end
	Pixels.disc(canvas, 8, 8, 2, rgb(mix(color, Color3.fromRGB(255, 255, 255), 0.3)))
end

shapes.bone = function(canvas, size, item)
	local r, g, b = rgb(item.color)
	Pixels.line(canvas, 4, 12, 12, 4, r, g, b, 255)
	Pixels.line(canvas, 5, 12, 13, 4, r, g, b, 255)
	Pixels.disc(canvas, 4, 12, 2, r, g, b, 255)
	Pixels.disc(canvas, 12, 4, 2, r, g, b, 255)
	Pixels.set(canvas, 4, 11, 255, 255, 255, 200)
end

shapes.leaf = function(canvas, size, item)
	local color = item.color
	local r, g, b = rgb(color)
	Pixels.ellipse(canvas, 8, 8, 5, 3.2, r, g, b, 255)
	Pixels.line(canvas, 3, 9, 13, 7, rgb(mix(color, BLACK, 0.35)))
	Pixels.line(canvas, 8, 11, 10, 14, 110, 84, 50, 255)
end

shapes.shard = function(canvas, size, item)
	local color = item.color
	local r, g, b = rgb(color)
	local lr, lg, lb = rgb(mix(color, WHITE, 0.5))
	Pixels.line(canvas, 8, 2, 4, 9, r, g, b, 255)
	Pixels.line(canvas, 8, 2, 12, 9, r, g, b, 255)
	Pixels.line(canvas, 4, 9, 8, 14, r, g, b, 255)
	Pixels.line(canvas, 12, 9, 8, 14, r, g, b, 255)
	for y = 4, 12 do
		local spread = if y < 9 then math.floor((y - 2) * 0.55) else math.floor((14 - y) * 0.75)
		for x = 8 - spread, 8 + spread do
			Pixels.set(canvas, x, y, r, g, b, 210)
		end
	end
	Pixels.line(canvas, 8, 3, 8, 13, lr, lg, lb, 240)
end

shapes.core = function(canvas, size, item)
	local color = item.color
	local r, g, b = rgb(color)
	Pixels.rectOutline(canvas, 3, 3, 10, 10, rgb(mix(color, Color3.fromRGB(0, 0, 0), 0.4)))
	Pixels.fill(canvas, 4, 4, 8, 8, r, g, b, 255)
	Pixels.ellipse(canvas, 8, 8, 2.4, 2.4, rgb(mix(color, WHITE, 0.6)))
	for i = 0, 3 do
		local x = if i % 2 == 0 then 2 else 13
		local y = if i < 2 then 2 else 13
		Pixels.set(canvas, x, y, rgb(mix(color, WHITE, 0.4)))
	end
end

shapes.mirror = function(canvas, size, item)
	local frame = Color3.fromRGB(190, 160, 90)
	Pixels.ellipse(canvas, 8, 6, 5, 5, rgb(frame))
	Pixels.ellipse(canvas, 8, 6, 3.6, 3.6, rgb(item.color))
	Pixels.ellipse(canvas, 6.6, 4.8, 1.2, 1.2, 255, 255, 255, 230)
	Pixels.fill(canvas, 7, 11, 2, 4, rgb(frame))
end

shapes.totem = function(canvas, size, item)
	local color = item.color
	Pixels.ellipse(canvas, 8, 8, 5.6, 5.2, 232, 228, 222, 255)
	Pixels.ellipse(canvas, 8, 8, 3, 3, rgb(color))
	Pixels.ellipse(canvas, 8, 8, 1.4, 1.4, 24, 18, 22, 255)
	Pixels.set(canvas, 6, 6, 255, 255, 255, 240)
	for i = 0, 3 do
		local angle = i * math.pi / 2 + 0.6
		Pixels.set(canvas, math.floor(8 + math.cos(angle) * 7), math.floor(8 + math.sin(angle) * 7), rgb(color))
	end
end

shapes.stone_rune = function(canvas, size, item)
	local color = item.color
	Pixels.ellipse(canvas, 8, 9, 5, 4.4, rgb(color))
	Pixels.ellipse(canvas, 6.4, 7.4, 1.6, 1.2, rgb(mix(color, WHITE, 0.35)))
	Pixels.line(canvas, 6, 10, 10, 6, 150, 220, 255, 235)
	Pixels.line(canvas, 6, 7, 10, 11, 150, 220, 255, 235)
end

shapes.logs = function(canvas, size, item)
	local wood = item.color
	local r, g, b = rgb(wood)
	local dark = mix(wood, BLACK, 0.35)
	local light = mix(wood, WHITE, 0.25)
	-- ثلاثة جذوع مكدّسة مع حلقات في المقطع
	for i = 0, 2 do
		local y = 4 + i * 4
		local x = 2 + (i % 2) * 2
		Pixels.fill(canvas, x, y, 11, 3, r, g, b, 255)
		Pixels.fill(canvas, x, y, 11, 1, rgb(light))
		Pixels.fill(canvas, x, y + 2, 11, 1, rgb(dark))
		Pixels.set(canvas, x + 1, y + 1, rgb(dark))
	end
end

shapes.hide = function(canvas, size, item)
	local base = item.color
	local r, g, b = rgb(base)
	local dark = mix(base, BLACK, 0.3)
	-- جلد ممدود بأطراف غير منتظمة
	Pixels.ellipse(canvas, 8, 8, 5.4, 4.4, r, g, b, 255)
	Pixels.fill(canvas, 1, 4, 3, 2, r, g, b, 255)
	Pixels.fill(canvas, 12, 4, 3, 2, r, g, b, 255)
	Pixels.fill(canvas, 1, 11, 3, 2, r, g, b, 255)
	Pixels.fill(canvas, 12, 11, 3, 2, r, g, b, 255)
	Pixels.ellipse(canvas, 6.5, 6.5, 1.8, 1.4, rgb(mix(base, WHITE, 0.3)))
	Pixels.line(canvas, 4, 11, 12, 10, rgb(dark))
end

shapes.generic = function(canvas, size, item)
	local color = item.color
	Pixels.ellipse(canvas, 8, 8, 5, 5, rgb(color))
	Pixels.ellipse(canvas, 6.4, 6.4, 1.8, 1.8, rgb(mix(color, WHITE, 0.45)))
	Pixels.ellipse(canvas, 9.5, 10, 2, 1.6, rgb(mix(color, BLACK, 0.3)))
end

-- ===== اختيار الشكل =====

local EXPLICIT: { [string]: string } = {
	coin = "coin", gel = "blob", string = "fiber", leather = "hide", bone = "bone",
	herb = "leaf", glow_dust = "dust", magic_essence = "dust", shadow_scale = "shard",
	soul_fragment = "shard", upgrade_core = "core", coal = "ore_chunk", wood = "logs",
	diamond = "gem", magic_mirror = "mirror", eye_totem = "totem", recall_stone = "stone_rune",
	life_crystal = "gem", mana_crystal = "gem",
}

function ArtItems.shapeOf(itemId: string): string
	local explicit = EXPLICIT[itemId]
	if explicit then return explicit end

	local item = Items.get(itemId)
	if not item then return "generic" end

	if item.cat == "armor" then
		return "armor_" .. (item.slot or "chest")
	end
	if item.cat == "ammo" then return "arrow" end
	if item.cat == "tool" then
		if item.tool == "pickaxe" then return "pickaxe" end
		if item.tool == "axe" then return "axe" end
		if item.tool == "hammer" then return "hammer" end
		return "pickaxe"
	end
	if item.cat == "weapon" then
		if item.ranged then return "bow" end
		if item.magic then return "staff" end
		return "sword"
	end
	if item.cat == "consumable" then
		if item.food and not item.heal and not item.buff then return "food" end
		if item.id == "apple" or item.id == "bread" or item.id == "cooked_meat" or item.id == "mushroom" then
			return "food"
		end
		return "potion"
	end
	if item.cat == "material" then
		if string.find(itemId, "_bar", 1, true) then return "bar" end
		if string.find(itemId, "_ore", 1, true) then return "ore_chunk" end
		return "generic"
	end
	return "generic"
end

-- يرسم أيقونة عنصر (16×16). عناصر البلاطات تستعمل نقش البلاطة نفسه.
function ArtItems.paint(itemId: string, size: number): Pixels.Canvas
	local item = Items.get(itemId)
	if not item then
		local canvas = Pixels.new(size, size)
		Pixels.rectOutline(canvas, 2, 2, size - 4, size - 4, 220, 60, 60, 255)
		return canvas
	end

	if item.place then
		return ArtBlocks.paint(item.place, size)
	end

	local canvas = Pixels.new(size, size)
	local shape = shapes[ArtItems.shapeOf(itemId)] or shapes.generic
	shape(canvas, size, item)
	return canvas
end

ArtItems.shapes = shapes

return ArtItems
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">ArtSprites</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ArtSprites — كائنات اللعبة كنقوش بكسل.

	اللاعب والوحوش والمقذوفات كلها مرسومة بكسلاً بكسلاً، بإطارات حركة حقيقية
	(مشي، رفرفة، انضغاط) بدل تحريك مستطيلات. الدروع تُرسم بالرمادي كطبقات
	منفصلة ليُلوّنها ImageColor3 بلون المعدن مع بقاء التظليل.
]]

local Mobs = require(script.Parent.Mobs)
local Pixels = require(script.Parent.Pixels)

local ArtSprites = {}

local BLACK = Color3.fromRGB(0, 0, 0)
local WHITE = Color3.fromRGB(255, 255, 255)

local function rgb(color: Color3): (number, number, number)
	return Pixels.rgb(color)
end

local function mix(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, t)
end

-- ===== اللاعب =====

ArtSprites.PLAYER_W = 26
ArtSprites.PLAYER_H = 45
ArtSprites.PLAYER_FRAMES = { "idle", "walk1", "walk2", "walk3", "walk4", "jump" }

local SKIN = Color3.fromRGB(236, 194, 158)
local SKIN_SHADE = Color3.fromRGB(198, 154, 120)
local HAIR = Color3.fromRGB(92, 58, 38)
local SHIRT = Color3.fromRGB(86, 126, 196)
local SHIRT_SHADE = Color3.fromRGB(58, 92, 152)
local PANTS = Color3.fromRGB(58, 62, 96)
local PANTS_SHADE = Color3.fromRGB(40, 44, 72)
local BOOT = Color3.fromRGB(84, 60, 40)

-- إزاحات الأرجل والذراع لكل إطار (مشي رباعي الإطارات)
-- stride = إزاحة أفقية للقدم، lift = رفع القدم — معاً يعطيان خطوة مقروءة
local PLAYER_POSE: { [string]: { strideFront: number, strideBack: number, liftFront: number, liftBack: number, arm: number, bob: number } } = {
	idle = { strideFront = 0, strideBack = 0, liftFront = 0, liftBack = 0, arm = 0, bob = 0 },
	walk1 = { strideFront = 3, strideBack = -3, liftFront = 0, liftBack = 3, arm = -3, bob = 0 },
	walk2 = { strideFront = 1, strideBack = -1, liftFront = 0, liftBack = 0, arm = -1, bob = 1 },
	walk3 = { strideFront = -3, strideBack = 3, liftFront = 3, liftBack = 0, arm = 3, bob = 0 },
	walk4 = { strideFront = -1, strideBack = 1, liftFront = 0, liftBack = 0, arm = 1, bob = 1 },
	jump = { strideFront = -3, strideBack = 3, liftFront = 4, liftBack = 1, arm = -5, bob = -1 },
}

function ArtSprites.paintPlayer(frame: string): Pixels.Canvas
	local canvas = Pixels.new(ArtSprites.PLAYER_W, ArtSprites.PLAYER_H)
	local pose = PLAYER_POSE[frame] or PLAYER_POSE.idle
	local cx = ArtSprites.PLAYER_W // 2
	local bob = pose.bob

	local sr, sg, sb = rgb(SKIN)
	local ssr, ssg, ssb = rgb(SKIN_SHADE)
	local hr, hg, hb = rgb(HAIR)
	local tr, tg, tb = rgb(SHIRT)
	local tsr, tsg, tsb = rgb(SHIRT_SHADE)
	local pr, pg, pb = rgb(PANTS)
	local psr, psg, psb = rgb(PANTS_SHADE)
	local br, bg, bb = rgb(BOOT)

	-- ===== الأرجل =====
	-- كل رجل: فخذ ثابت من الحوض، ثم ساق تُزاح أفقياً وتُرفع، وحذاء عند طرفها
	local hipY = 30 + bob
	local function drawLeg(baseX: number, stride: number, lift: number, thighR: number, thighG: number, thighB: number)
		local footX = baseX + stride
		local footY = hipY + 10 - lift
		-- الفخذ يصل الحوض بالساق
		for step = 0, 5 do
			local t = step / 5
			local x = math.floor(baseX + stride * t * 0.6)
			Pixels.fill(canvas, x, hipY + step, 4, 2, thighR, thighG, thighB, 255)
		end
		-- الساق
		Pixels.fill(canvas, footX, hipY + 5, 4, math.max(2, 6 - lift), thighR, thighG, thighB, 255)
		-- الحذاء
		Pixels.fill(canvas, footX - 1, footY, 6, 4, br, bg, bb, 255)
		Pixels.fill(canvas, footX - 1, footY + 3, 6, 1, rgb(mix(BOOT, BLACK, 0.35)))
	end

	drawLeg(cx - 5, pose.strideBack, pose.liftBack, psr, psg, psb)
	drawLeg(cx + 1, pose.strideFront, pose.liftFront, pr, pg, pb)

	-- ===== الجذع =====
	local torsoTop = 17 + bob
	Pixels.fill(canvas, cx - 6, torsoTop, 12, 14, tr, tg, tb, 255)
	Pixels.fill(canvas, cx - 6, torsoTop, 12, 2, rgb(mix(SHIRT, WHITE, 0.25)))
	Pixels.fill(canvas, cx + 3, torsoTop, 3, 14, tsr, tsg, tsb, 255)
	Pixels.fill(canvas, cx - 6, torsoTop + 12, 12, 2, tsr, tsg, tsb, 255)
	-- حزام
	Pixels.fill(canvas, cx - 6, torsoTop + 13, 12, 2, rgb(mix(BOOT, BLACK, 0.2)))

	-- ===== الذراع الأمامية =====
	local armTop = torsoTop + 2 + pose.arm
	Pixels.fill(canvas, cx + 5, armTop, 4, 11, tsr, tsg, tsb, 255)
	Pixels.fill(canvas, cx + 5, armTop + 9, 4, 4, sr, sg, sb, 255)

	-- ===== الرأس =====
	local headTop = 4 + bob
	Pixels.fill(canvas, cx - 6, headTop, 12, 12, sr, sg, sb, 255)
	Pixels.fill(canvas, cx + 4, headTop + 1, 2, 11, ssr, ssg, ssb, 255)
	Pixels.fill(canvas, cx - 6, headTop + 11, 12, 1, ssr, ssg, ssb, 255)
	-- شعر
	Pixels.fill(canvas, cx - 7, headTop - 2, 14, 4, hr, hg, hb, 255)
	Pixels.fill(canvas, cx - 7, headTop - 2, 14, 1, rgb(mix(HAIR, WHITE, 0.2)))
	Pixels.fill(canvas, cx - 7, headTop, 2, 6, hr, hg, hb, 255)
	-- عين (باتجاه اليمين)
	Pixels.fill(canvas, cx + 1, headTop + 5, 2, 3, 32, 28, 38, 255)
	Pixels.set(canvas, cx + 1, headTop + 5, 255, 255, 255, 220)
	-- فم
	Pixels.fill(canvas, cx + 2, headTop + 9, 2, 1, ssr, ssg, ssb, 255)
	-- رقبة
	Pixels.fill(canvas, cx - 3, headTop + 12, 6, 2, ssr, ssg, ssb, 255)

	return canvas
end

-- طبقة خوذة رمادية (تُلوَّن لاحقاً بلون المعدن)
function ArtSprites.paintHelmet(frame: string): Pixels.Canvas
	local canvas = Pixels.new(ArtSprites.PLAYER_W, ArtSprites.PLAYER_H)
	local pose = PLAYER_POSE[frame] or PLAYER_POSE.idle
	local cx = ArtSprites.PLAYER_W // 2
	local headTop = 4 + pose.bob

	Pixels.fill(canvas, cx - 7, headTop - 3, 14, 7, 200, 200, 200, 255)
	Pixels.fill(canvas, cx - 7, headTop - 3, 14, 2, 245, 245, 245, 255)
	Pixels.fill(canvas, cx - 7, headTop + 4, 3, 7, 170, 170, 170, 255)
	Pixels.fill(canvas, cx + 4, headTop + 4, 3, 7, 140, 140, 140, 255)
	-- قمة الخوذة
	Pixels.fill(canvas, cx - 1, headTop - 5, 3, 3, 225, 225, 225, 255)
	return canvas
end

function ArtSprites.paintChestplate(frame: string): Pixels.Canvas
	local canvas = Pixels.new(ArtSprites.PLAYER_W, ArtSprites.PLAYER_H)
	local pose = PLAYER_POSE[frame] or PLAYER_POSE.idle
	local cx = ArtSprites.PLAYER_W // 2
	local torsoTop = 17 + pose.bob

	Pixels.fill(canvas, cx - 7, torsoTop - 1, 14, 13, 200, 200, 200, 255)
	Pixels.fill(canvas, cx - 7, torsoTop - 1, 14, 2, 245, 245, 245, 255)
	Pixels.fill(canvas, cx + 3, torsoTop - 1, 4, 13, 150, 150, 150, 255)
	Pixels.fill(canvas, cx - 7, torsoTop + 10, 14, 2, 130, 130, 130, 255)
	-- كتفان
	Pixels.fill(canvas, cx - 9, torsoTop, 3, 5, 215, 215, 215, 255)
	Pixels.fill(canvas, cx + 6, torsoTop, 3, 5, 175, 175, 175, 255)
	return canvas
end

-- ===== الوحوش =====

local MOB_SHAPE: { [string]: string } = {
	slime = "blob", ice_slime = "blob", sand_slime = "blob",
	zombie = "humanoid", skeleton = "humanoid", stone_golem = "humanoid",
	bat = "flyer", cave_wasp = "flyer", lava_imp = "flyer",
	demon_eye = "eye", eye_of_depths = "eye",
	spider = "crawler", shadow_crawler = "crawler",
}

function ArtSprites.shapeOf(mobId: string): string
	return MOB_SHAPE[mobId] or "humanoid"
end

function ArtSprites.mobFrames(mobId: string): number
	local shape = ArtSprites.shapeOf(mobId)
	if shape == "humanoid" then return 4 end
	return 2
end

function ArtSprites.mobSize(mobId: string): (number, number)
	local def = Mobs.get(mobId)
	if not def then return 16, 16 end
	return math.max(8, math.floor(def.w * 16 + 0.5)), math.max(8, math.floor(def.h * 16 + 0.5))
end

local function drawBlob(canvas: Pixels.Canvas, w: number, h: number, def: Mobs.MobDef, frame: number)
	local squash = if frame == 1 then 1.0 else 0.86
	local bodyH = math.floor(h * squash)
	local top = h - bodyH
	local cx = w / 2 - 0.5
	local cy = top + bodyH / 2

	local r, g, b = rgb(def.color)
	local dark = mix(def.color, BLACK, 0.3)
	local light = mix(def.color, WHITE, 0.35)

	Pixels.ellipse(canvas, cx, cy, w / 2 - 0.5, bodyH / 2 - 0.5, r, g, b, 232)
	Pixels.ellipse(canvas, cx, cy + bodyH * 0.22, w / 2 - 1.5, bodyH * 0.26, rgb(dark))
	Pixels.ellipse(canvas, cx - w * 0.2, cy - bodyH * 0.22, w * 0.16, bodyH * 0.18, rgb(light))

	-- عينان
	local eyeY = math.floor(cy - bodyH * 0.05)
	local eyeDx = math.floor(w * 0.17)
	for _, dx in { -eyeDx, eyeDx } do
		Pixels.fill(canvas, math.floor(cx + dx) - 1, eyeY - 1, 3, 3, 22, 20, 28, 255)
		Pixels.set(canvas, math.floor(cx + dx) - 1, eyeY - 1, 255, 255, 255, 220)
	end
	-- فم
	Pixels.fill(canvas, math.floor(cx) - 1, eyeY + 3, 3, 1, 22, 20, 28, 200)
end

local function drawHumanoid(canvas: Pixels.Canvas, w: number, h: number, def: Mobs.MobDef, frame: number)
	local swing = ({ 0, 3, 0, -3 })[frame] or 0
	local cx = w // 2
	local r, g, b = rgb(def.color)
	local ar, ag, ab = rgb(def.accent)
	local dark = mix(def.color, BLACK, 0.32)
	local light = mix(def.color, WHITE, 0.22)

	local headH = math.floor(h * 0.26)
	local torsoH = math.floor(h * 0.36)
	local legH = h - headH - torsoH - 1

	-- أرجل
	local legTop = headH + torsoH
	Pixels.fill(canvas, cx - math.floor(w * 0.26), legTop + math.max(0, swing), math.floor(w * 0.2), legH - math.abs(swing) // 2, ar, ag, ab, 255)
	Pixels.fill(canvas, cx + math.floor(w * 0.06), legTop + math.max(0, -swing), math.floor(w * 0.2), legH - math.abs(swing) // 2, ar, ag, ab, 255)

	-- جذع
	Pixels.fill(canvas, cx - math.floor(w * 0.3), headH, math.floor(w * 0.6), torsoH, r, g, b, 255)
	Pixels.fill(canvas, cx - math.floor(w * 0.3), headH, math.floor(w * 0.6), 2, rgb(light))
	Pixels.fill(canvas, cx + math.floor(w * 0.14), headH, math.floor(w * 0.16), torsoH, rgb(dark))

	-- ذراع ممدودة أمامها (مشية الزومبي)
	Pixels.fill(canvas, cx + math.floor(w * 0.24), headH + 2 - swing, math.floor(w * 0.24), math.floor(torsoH * 0.45), r, g, b, 255)

	-- رأس
	Pixels.fill(canvas, cx - math.floor(w * 0.26), 1, math.floor(w * 0.52), headH - 1, r, g, b, 255)
	Pixels.fill(canvas, cx - math.floor(w * 0.26), 1, math.floor(w * 0.52), 1, rgb(light))
	Pixels.fill(canvas, cx + math.floor(w * 0.12), 1, math.floor(w * 0.14), headH - 1, rgb(dark))

	-- عينان متوهجتان
	local eyeY = math.floor(headH * 0.5)
	Pixels.fill(canvas, cx - math.floor(w * 0.16), eyeY, 2, 2, 226, 62, 62, 255)
	Pixels.fill(canvas, cx + math.floor(w * 0.06), eyeY, 2, 2, 226, 62, 62, 255)
end

local function drawFlyer(canvas: Pixels.Canvas, w: number, h: number, def: Mobs.MobDef, frame: number)
	local cx = w / 2 - 0.5
	local cy = h / 2
	local r, g, b = rgb(def.color)
	local ar, ag, ab = rgb(def.accent)
	local light = mix(def.color, WHITE, 0.3)

	-- جناحان غشائيان: مثلّثان متصلان بالجسم، أعلى في إطار وأسفل في الآخر
	local up = frame == 1
	local tipY = if up then cy - h * 0.42 else cy + h * 0.3
	local membrane = mix(def.accent, BLACK, 0.15)
	local mr, mg, mb = rgb(membrane)

	for side = -1, 1, 2 do
		local rootX = cx + side * w * 0.16
		local tipX = cx + side * w * 0.48
		-- املأ الغشاء بخطوط من الجذر إلى الحافة
		for k = 0, 6 do
			local t = k / 6
			Pixels.line(canvas,
				math.floor(rootX), math.floor(cy - h * 0.06),
				math.floor(rootX + (tipX - rootX) * (0.45 + t * 0.55)),
				math.floor(cy + (tipY - cy) * t),
				mr, mg, mb, 245)
		end
		-- عظام الجناح أغمق
		Pixels.line(canvas, math.floor(rootX), math.floor(cy - h * 0.06),
			math.floor(tipX), math.floor(tipY), ar, ag, ab, 255)
	end

	-- جسم بيضاوي وأذنان صغيرتان
	Pixels.ellipse(canvas, cx, cy, w * 0.2, h * 0.3, r, g, b, 255)
	Pixels.ellipse(canvas, cx - w * 0.06, cy - h * 0.12, w * 0.08, h * 0.1, rgb(light))
	Pixels.set(canvas, math.floor(cx - w * 0.12), math.floor(cy - h * 0.3), ar, ag, ab, 255)
	Pixels.set(canvas, math.floor(cx + w * 0.12), math.floor(cy - h * 0.3), ar, ag, ab, 255)

	-- عينان
	Pixels.set(canvas, math.floor(cx - w * 0.08), math.floor(cy - h * 0.06), 250, 226, 96, 255)
	Pixels.set(canvas, math.floor(cx + w * 0.08), math.floor(cy - h * 0.06), 250, 226, 96, 255)
end

local function drawCrawler(canvas: Pixels.Canvas, w: number, h: number, def: Mobs.MobDef, frame: number)
	local cx = w / 2 - 0.5
	local cy = h * 0.45
	local r, g, b = rgb(def.color)
	local ar, ag, ab = rgb(def.accent)
	local light = mix(def.color, WHITE, 0.25)

	-- أرجل (أربع لكل جانب بزوايا متبادلة)
	local phase = if frame == 1 then 1 else -1
	for i = 0, 3 do
		local offset = (i - 1.5) * (w * 0.16)
		local drop = h * (0.28 + (i % 2) * 0.12) * (if i % 2 == 0 then 1 else phase * 0.8)
		Pixels.line(canvas,
			math.floor(cx - w * 0.16), math.floor(cy),
			math.floor(cx - w * 0.42 + offset * 0.3), math.floor(cy + drop),
			ar, ag, ab, 255)
		Pixels.line(canvas,
			math.floor(cx + w * 0.16), math.floor(cy),
			math.floor(cx + w * 0.42 + offset * 0.3), math.floor(cy + drop),
			ar, ag, ab, 255)
	end

	-- بطن ورأس
	Pixels.ellipse(canvas, cx - w * 0.1, cy, w * 0.26, h * 0.3, r, g, b, 255)
	Pixels.ellipse(canvas, cx + w * 0.22, cy - h * 0.04, w * 0.16, h * 0.2, rgb(light))
	-- عيون حمراء
	Pixels.set(canvas, math.floor(cx + w * 0.26), math.floor(cy - h * 0.1), 230, 70, 70, 255)
	Pixels.set(canvas, math.floor(cx + w * 0.3), math.floor(cy), 230, 70, 70, 255)
end

local function drawEye(canvas: Pixels.Canvas, w: number, h: number, def: Mobs.MobDef, frame: number)
	local cx = w / 2 - 0.5
	local cy = h / 2 - 0.5
	local radius = math.min(w, h) * 0.42
	local pulse = if frame == 1 then 1 else 0.93

	local r, g, b = rgb(def.color)
	local ar, ag, ab = rgb(def.accent)

	-- أهداب/زوائد حول العين (للزعيم)
	if w >= 40 then
		for i = 0, 7 do
			local angle = i * math.pi / 4 + (if frame == 1 then 0 else 0.2)
			Pixels.line(canvas,
				math.floor(cx + math.cos(angle) * radius * 0.9),
				math.floor(cy + math.sin(angle) * radius * 0.9),
				math.floor(cx + math.cos(angle) * radius * 1.35),
				math.floor(cy + math.sin(angle) * radius * 1.35),
				ar, ag, ab, 255)
		end
	end

	-- مقلة
	Pixels.ellipse(canvas, cx, cy, radius, radius * pulse, r, g, b, 255)
	Pixels.ellipse(canvas, cx, cy, radius * 0.92, radius * pulse * 0.92, 245, 242, 238, 255)
	-- عروق
	for i = 0, 4 do
		local angle = i * 1.25 + 0.4
		Pixels.line(canvas,
			math.floor(cx + math.cos(angle) * radius * 0.4),
			math.floor(cy + math.sin(angle) * radius * 0.4),
			math.floor(cx + math.cos(angle) * radius * 0.88),
			math.floor(cy + math.sin(angle) * radius * 0.88),
			220, 120, 120, 190)
	end
	-- قزحية وبؤبؤ (تنظر لليمين)
	local irisX = cx + radius * 0.28
	Pixels.ellipse(canvas, irisX, cy, radius * 0.42, radius * 0.42, ar, ag, ab, 255)
	Pixels.ellipse(canvas, irisX, cy, radius * 0.2, radius * 0.24, 18, 14, 20, 255)
	Pixels.ellipse(canvas, irisX - radius * 0.16, cy - radius * 0.16, radius * 0.1, radius * 0.1, 255, 255, 255, 235)
end

function ArtSprites.paintMob(mobId: string, frame: number): Pixels.Canvas
	local def = Mobs.get(mobId)
	local w, h = ArtSprites.mobSize(mobId)
	local canvas = Pixels.new(w, h)
	if not def then return canvas end

	local shape = ArtSprites.shapeOf(mobId)
	if shape == "blob" then
		drawBlob(canvas, w, h, def, frame)
	elseif shape == "flyer" then
		drawFlyer(canvas, w, h, def, frame)
	elseif shape == "crawler" then
		drawCrawler(canvas, w, h, def, frame)
	elseif shape == "eye" then
		drawEye(canvas, w, h, def, frame)
	else
		drawHumanoid(canvas, w, h, def, frame)
	end
	return canvas
end

-- ===== المقذوفات =====

ArtSprites.PROJECTILE_SIZE = 16

function ArtSprites.paintProjectile(projId: string): Pixels.Canvas
	local size = ArtSprites.PROJECTILE_SIZE
	local canvas = Pixels.new(size, size)
	local def = Mobs.projectiles[projId]
	local color = if def then def.color else Color3.fromRGB(230, 230, 230)
	local r, g, b = rgb(color)
	local light = mix(color, WHITE, 0.5)
	local lr, lg, lb = rgb(light)
	local cy = size // 2

	if projId == "arrow" or projId == "fire_arrow" or projId == "bone_shot" then
		-- سهم أفقي يتجه لليمين
		Pixels.fill(canvas, 2, cy - 1, 10, 2, r, g, b, 255)
		Pixels.fill(canvas, 11, cy - 2, 4, 4, lr, lg, lb, 255)
		Pixels.set(canvas, 14, cy, 255, 255, 255, 255)
		Pixels.fill(canvas, 1, cy - 3, 3, 2, 235, 235, 235, 235)
		Pixels.fill(canvas, 1, cy + 1, 3, 2, 235, 235, 235, 235)
		if projId == "fire_arrow" then
			Pixels.ellipse(canvas, 4, cy, 3, 2.4, 250, 150, 60, 170)
		end
	else
		-- كرة طاقة متوهّجة
		Pixels.disc(canvas, size / 2, cy, 5.4, r, g, b, 120)
		Pixels.disc(canvas, size / 2, cy, 4, r, g, b, 220)
		Pixels.disc(canvas, size / 2, cy, 2.4, lr, lg, lb, 255)
		Pixels.disc(canvas, size / 2 - 1, cy - 1, 1.2, 255, 255, 255, 255)
	end
	return canvas
end

return ArtSprites
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">ArtUI</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ArtUI — إطارات الواجهة بأسلوب بكسل (9-slice).

	نرسم إطاراً صغيراً بحواف مشطوفة ثم نمدّده بـ ScaleType.Slice، فيبقى
	السُّمك ثابتاً والزوايا حادة مهما كبر العنصر — هذا سرّ مظهر واجهات
	الألعاب البكسلية.
]]

local Pixels = require(script.Parent.Pixels)

local ArtUI = {}

ArtUI.PANEL = 24 -- إطار 24×24، مركز الشريحة 8..16
ArtUI.SLICE = 8

local function bevel(canvas: Pixels.Canvas, size: number, fill: { number }, light: { number }, dark: { number }, edge: { number })
	-- الحشوة
	Pixels.fill(canvas, 0, 0, size, size, fill[1], fill[2], fill[3], fill[4] or 255)
	-- حدّ خارجي داكن
	Pixels.rectOutline(canvas, 0, 0, size, size, edge[1], edge[2], edge[3], 255)
	-- شطف داخلي: فاتح أعلى/يسار، داكن أسفل/يمين
	Pixels.fill(canvas, 1, 1, size - 2, 2, light[1], light[2], light[3], 255)
	Pixels.fill(canvas, 1, 1, 2, size - 2, light[1], light[2], light[3], 255)
	Pixels.fill(canvas, 1, size - 3, size - 2, 2, dark[1], dark[2], dark[3], 255)
	Pixels.fill(canvas, size - 3, 1, 2, size - 2, dark[1], dark[2], dark[3], 255)
	-- ظلّ داخلي ممزوج: يعمّق الحافة بلا أن يمحو الشطف تحته
	Pixels.blendRectOutline(canvas, 1, 1, size - 2, size - 2, edge[1], edge[2], edge[3], 70)
end

-- لوحة رئيسية (نوافذ المخزون والمحطات)
function ArtUI.panel(): Pixels.Canvas
	local size = ArtUI.PANEL
	local canvas = Pixels.new(size, size)
	bevel(canvas, size,
		{ 34, 32, 44, 245 },
		{ 66, 62, 84 },
		{ 18, 16, 24 },
		{ 10, 9, 14 })
	return canvas
end

-- خانة مخزون (غائرة)
function ArtUI.slot(): Pixels.Canvas
	local size = ArtUI.PANEL
	local canvas = Pixels.new(size, size)
	bevel(canvas, size,
		{ 52, 50, 66, 255 },
		{ 24, 22, 32 },
		{ 82, 78, 102 },
		{ 12, 11, 16 })
	return canvas
end

-- خانة مختارة (متوهجة)
function ArtUI.slotActive(): Pixels.Canvas
	local size = ArtUI.PANEL
	local canvas = Pixels.new(size, size)
	bevel(canvas, size,
		{ 78, 96, 148, 255 },
		{ 150, 180, 240 },
		{ 40, 52, 90 },
		{ 14, 18, 30 })
	return canvas
end

-- زر بارز
function ArtUI.button(): Pixels.Canvas
	local size = ArtUI.PANEL
	local canvas = Pixels.new(size, size)
	bevel(canvas, size,
		{ 62, 60, 78, 255 },
		{ 104, 100, 128 },
		{ 26, 24, 34 },
		{ 12, 11, 16 })
	return canvas
end

-- إطار شريط (حياة/مانا/تقدّم)
function ArtUI.barFrame(): Pixels.Canvas
	local size = ArtUI.PANEL
	local canvas = Pixels.new(size, size)
	Pixels.fill(canvas, 0, 0, size, size, 18, 16, 24, 255)
	Pixels.rectOutline(canvas, 0, 0, size, size, 8, 7, 12, 255)
	Pixels.fill(canvas, 1, 1, size - 2, 1, 48, 44, 60, 255)
	Pixels.fill(canvas, 1, size - 2, size - 2, 1, 8, 7, 12, 255)
	return canvas
end

-- تعبئة شريط (تدرّج أفقي خفيف يُلوَّن بـ ImageColor3)
function ArtUI.barFill(): Pixels.Canvas
	local size = ArtUI.PANEL
	local canvas = Pixels.new(size, size)
	Pixels.fill(canvas, 0, 0, size, size, 255, 255, 255, 255)
	Pixels.fill(canvas, 0, 0, size, 2, 255, 255, 255, 255)
	Pixels.fill(canvas, 0, 2, size, 3, 216, 216, 216, 255)
	Pixels.fill(canvas, 0, size - 3, size, 3, 176, 176, 176, 255)
	return canvas
end

-- مراحل تشقّق البلاطة أثناء التعدين (شفافة، تُرسم فوق البلاطة)
function ArtUI.crack(stage: number): Pixels.Canvas
	local size = 16
	local canvas = Pixels.new(size, size)
	local density = stage / 4

	-- شقّان رئيسيان يمتدّان مع التقدّم
	local mainLength = math.floor(3 + density * 12)
	Pixels.line(canvas, 8, 2, 8 - math.floor(density * 4), 2 + mainLength, 20, 18, 24, 235)
	Pixels.line(canvas, 7, 3, 7 + math.floor(density * 5), 3 + mainLength, 20, 18, 24, 200)

	-- تفرّعات تظهر تدريجياً
	local branches = stage * 2
	for i = 1, branches do
		local t = i / (branches + 1)
		local y = math.floor(3 + t * mainLength)
		local dir = if i % 2 == 0 then 1 else -1
		local length = 2 + math.floor(density * 4)
		Pixels.line(canvas, 8, y, 8 + dir * length, y + dir, 20, 18, 24, 215)
	end

	-- شظايا متناثرة في المراحل الأخيرة
	if stage >= 3 then
		for i = 0, 5 do
			local x = math.floor(Pixels.noise(i, stage, 31) * size)
			local y = math.floor(Pixels.noise(i, stage + 7, 31) * size)
			Pixels.set(canvas, x, y, 20, 18, 24, 190)
		end
	end
	return canvas
end

ArtUI.pieces = {
	panel = ArtUI.panel,
	slot = ArtUI.slot,
	slot_active = ArtUI.slotActive,
	button = ArtUI.button,
	bar_frame = ArtUI.barFrame,
	bar_fill = ArtUI.barFill,
	crack1 = function() return ArtUI.crack(1) end,
	crack2 = function() return ArtUI.crack(2) end,
	crack3 = function() return ArtUI.crack(3) end,
	crack4 = function() return ArtUI.crack(4) end,
}

return ArtUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Blocks</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Blocks — سجل البلاطات.
	كل بلاطة لها: لون، صلابة، الأداة المطلوبة، قوة المعول اللازمة، الضوء المنبعث،
	مقدار حجب الضوء، وما تُسقطه عند الكسر.

	ملاحظات:
	* `pick` = قوة المعول المطلوبة؛ إن كانت قوة معول اللاعب أقل فلن يكسر البلاطة.
	* `opacity` = كم نقطة ضوء تُفقد عند مرور الضوء خلال البلاطة (0..15).
	* `hard`   = زمن الكسر الأساسي بالثواني (يُقسم على كفاءة الأداة).
]]

local Blocks = {}

export type Block = {
	id: number,
	name: string,
	color: Color3,
	shade: number, -- مقدار التنويع العشوائي للون بين البلاطات
	solid: boolean,
	opacity: number,
	light: number,
	hard: number,
	tool: string?, -- "pickaxe" | "axe" | "hammer"
	pick: number,
	drop: number?, -- معرّف العنصر الساقط (افتراضياً عنصر البلاطة نفسها)
	dropChance: number?,
	liquid: boolean?,
	platform: boolean?, -- منصة: تُعبر من الأسفل ويُقف عليها
	climb: boolean?,
	attach: boolean?, -- تحتاج بلاطة مجاورة صلبة لتبقى
	station: string?, -- محطة تصنيع
	container: boolean?,
	fragile: boolean?, -- تُكسر فوراً (أعشاب، زهور)
	burn: number?, -- ضرر لمس (الحمم)
	sound: string?,
}

local function C(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- ===== المعرّفات =====
local ID = {
	AIR = 0,
	DIRT = 1,
	GRASS = 2,
	STONE = 3,
	CLAY = 4,
	SAND = 5,
	SANDSTONE = 6,
	SNOW = 7,
	ICE = 8,
	MUD = 9,
	JUNGLE_GRASS = 10,
	GRAVEL = 11,
	ASH = 12,

	LOG = 20,
	LEAVES = 21,
	PLANK = 22,
	STONE_BRICK = 23,
	GLASS = 24,
	SAND_BRICK = 25,
	BRICK = 30,
	ICE_BRICK = 26,
	HELLSTONE_BRICK = 27,
	OBSIDIAN = 28,
	BEDROCK = 29,

	COAL_ORE = 40,
	COPPER_ORE = 41,
	IRON_ORE = 42,
	SILVER_ORE = 43,
	GOLD_ORE = 44,
	DIAMOND_ORE = 45,
	MYTHRIL_ORE = 46,
	HELLSTONE_ORE = 47,
	CRYSTAL = 48,

	TORCH = 60,
	WORKBENCH = 61,
	FURNACE = 62,
	ANVIL = 63,
	CHEST = 64,
	PLATFORM = 65,
	LADDER = 66,
	LANTERN = 67,
	ALCHEMY = 68,
	ENCHANT_TABLE = 69,

	GRASS_TUFT = 80,
	FLOWER = 81,
	MUSHROOM = 82,
	GLOW_MUSHROOM = 83,
	CACTUS = 84,
	VINE = 85,
	COBWEB = 86,
	SAPLING = 87,

	WATER = 100,
	LAVA = 101,
}
Blocks.ID = ID

local defs: { Block } = {}

local function def(block: Block)
	defs[block.id] = block
end

-- ===== التربة والحجر =====
def({ id = ID.AIR, name = "هواء", color = C(0, 0, 0), shade = 0, solid = false, opacity = 1, light = 0, hard = 0, pick = 0 })
def({ id = ID.DIRT, name = "تراب", color = C(120, 85, 58), shade = 10, solid = true, opacity = 15, light = 0, hard = 0.5, tool = "pickaxe", pick = 0, sound = "soft" })
def({ id = ID.GRASS, name = "عشب", color = C(94, 152, 70), shade = 12, solid = true, opacity = 15, light = 0, hard = 0.55, tool = "pickaxe", pick = 0, drop = ID.DIRT, sound = "soft" })
def({ id = ID.STONE, name = "حجر", color = C(122, 122, 130), shade = 12, solid = true, opacity = 15, light = 0, hard = 1.1, tool = "pickaxe", pick = 0, sound = "hard" })

        <Item class="Folder" referent="49">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Hud — الواجهة الدائمة: الأشرطة، شريط الأدوات، الساعة، التعزيزات،
	شريط الزعيم، الإشعارات، شاشة الموت، وأزرار اللمس.
]]

local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Buffs = require(Shared.Buffs)
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local Upgrades = require(Shared.Upgrades)
local Util = require(Shared.Util)
local WorldGen = require(Shared.WorldGen)

local State = require(script.Parent.Parent.State)
local Theme = require(script.Parent.Theme)

local Hud = {}

local root: Frame
local hpBar: Theme.Bar
local manaBar: Theme.Bar
local foodBar: Theme.Bar
local defenseLabel: TextLabel
local clockLabel: TextLabel
local depthLabel: TextLabel
local coinLabel: TextLabel
local buffRow: Frame
local buffIcons: { Frame } = {}
local buffSignature = ""
local hotbarSlots: { { slot: Theme.Slot, icon: ImageLabel, count: TextLabel, key: TextLabel, glow: UIStroke } } = {}
local hotbarName: TextLabel
local bossFrame: Frame
local bossBar: Theme.Bar
local bossName: TextLabel
local notifyRoot: Frame
local notifications: { { frame: Frame, life: number } } = {}
local deathFrame: Frame
local deathLabel: TextLabel
local respawnButton: TextButton
local wallModeLabel: TextLabel
local loadingLabel: TextLabel
local touchRoot: Frame

local onHotbarSelect: ((number) -> ())? = nil
local onToggleInventory: (() -> ())? = nil

-- ===== البناء =====

local function buildStats(parent: Instance)
	local box = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.fromOffset(260, 120),
		ZIndex = 30,
	}, parent)

	hpBar = Theme.bar(box, Theme.colors.hpBack, Theme.colors.hp, 230, 22)
	hpBar.root.Position = UDim2.fromOffset(0, 0)

	manaBar = Theme.bar(box, Theme.colors.manaBack, Theme.colors.mana, 180, 16)
	manaBar.root.Position = UDim2.fromOffset(0, 28)

	foodBar = Theme.bar(box, Theme.colors.foodBack, Theme.colors.food, 140, 12)
	foodBar.root.Position = UDim2.fromOffset(0, 50)

	defenseLabel = Theme.label(box, "", 14, Theme.colors.textDim)
	defenseLabel.Position = UDim2.fromOffset(0, 66)
	defenseLabel.Size = UDim2.fromOffset(230, 18)
	defenseLabel.TextXAlignment = Enum.TextXAlignment.Left

	buffRow = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 88),
		Size = UDim2.fromOffset(240, 26),
		ZIndex = 30,
	}, box)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 4)
	layout.Parent = buffRow
end

local function buildInfo(parent: Instance)
	local box = Theme.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 14),
		Size = UDim2.fromOffset(260, 90),
		ZIndex = 30,
	}, parent)

	clockLabel = Theme.label(box, "", 18, Theme.colors.text)
	clockLabel.Size = UDim2.fromOffset(260, 24)
	clockLabel.Font = Theme.fontBold

	depthLabel = Theme.label(box, "", 14, Theme.colors.textDim)
	depthLabel.Position = UDim2.fromOffset(0, 26)
	depthLabel.Size = UDim2.fromOffset(260, 20)

	coinLabel = Theme.label(box, "", 15, Theme.colors.gold)
	coinLabel.Position = UDim2.fromOffset(0, 48)
	coinLabel.Size = UDim2.fromOffset(260, 20)

	wallModeLabel = Theme.label(box, "", 13, Theme.colors.slotActive)
	wallModeLabel.Position = UDim2.fromOffset(0, 68)
	wallModeLabel.Size = UDim2.fromOffset(260, 18)

	loadingLabel = Theme.label(box, "", 12, Theme.colors.textDim)
	loadingLabel.Position = UDim2.fromOffset(0, 86)
	loadingLabel.Size = UDim2.fromOffset(260, 18)
end

local function buildHotbar(parent: Instance)
	local slotSize = 54
	local gap = 6
	local total = Config.HOTBAR * slotSize + (Config.HOTBAR - 1) * gap

	local box = Theme.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(total, slotSize + 22),
		ZIndex = 30,
	}, parent)

	hotbarName = Theme.label(box, "", 15, Theme.colors.text)
	hotbarName.AnchorPoint = Vector2.new(0.5, 0)
	hotbarName.Position = UDim2.new(0.5, 0, 0, 0)
	hotbarName.Size = UDim2.fromOffset(360, 18)
	hotbarName.TextXAlignment = Enum.TextXAlignment.Center
	hotbarName.Font = Theme.fontBold

	for i = 1, Config.HOTBAR do
		local slot = Theme.slotButton(box, slotSize, UDim2.fromOffset((i - 1) * (slotSize + gap), 20))
		local glow = Theme.stroke(slot.button, Color3.fromRGB(10, 10, 14), 2)
		glow.Transparency = 1

		local icon = Theme.itemIcon(slot.button, math.floor(slotSize * 0.66), 33)

		local count = Theme.new("TextLabel", {
			BackgroundTransparency = 1,
			Font = Theme.fontNumber,
			Text = "",
			TextSize = 13,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextStrokeTransparency = 0.2,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -3, 1, -1),
			Size = UDim2.fromOffset(40, 16),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 34,
		}, slot.button)

		local key = Theme.new("TextLabel", {
			BackgroundTransparency = 1,
			Font = Theme.fontNumber,
			Text = tostring(i % 10),
			TextSize = 11,
			TextColor3 = Theme.colors.textDim,
			Position = UDim2.fromOffset(4, 2),
			Size = UDim2.fromOffset(16, 14),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 34,
		}, slot.button)

		slot.button.MouseButton1Click:Connect(function()
			if onHotbarSelect then onHotbarSelect(i) end
		end)

		table.insert(hotbarSlots, { slot = slot, icon = icon, count = count, key = key, glow = glow })
	end
end

local function buildBoss(parent: Instance)
	bossFrame = Theme.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(460, 46),
		Visible = false,
		ZIndex = 34,
	}, parent)

	bossName = Theme.label(bossFrame, "", 18, Color3.fromRGB(255, 210, 210))
	bossName.Size = UDim2.fromOffset(460, 20)
	bossName.TextXAlignment = Enum.TextXAlignment.Center
	bossName.Font = Theme.fontBold

	bossBar = Theme.bar(bossFrame, Color3.fromRGB(58, 16, 20), Color3.fromRGB(228, 58, 62), 460, 20)
	bossBar.root.Position = UDim2.fromOffset(0, 24)
end

local function buildNotify(parent: Instance)
	notifyRoot = Theme.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.fromOffset(520, 200),
		ZIndex = 36,
	}, parent)
	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 6)
	layout.Parent = notifyRoot
end

local function buildDeath(parent: Instance)
	deathFrame = Theme.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 40,
	}, parent)

	deathLabel = Theme.label(deathFrame, "لقد مِتّ", 44, Color3.fromRGB(232, 72, 72))
	deathLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	deathLabel.Position = UDim2.fromScale(0.5, 0.42)
	deathLabel.Size = UDim2.fromOffset(600, 60)
	deathLabel.TextXAlignment = Enum.TextXAlignment.Center
	deathLabel.Font = Theme.fontBold
	deathLabel.ZIndex = 41

	respawnButton = Theme.button(deathFrame, "العودة للحياة", UDim2.fromOffset(220, 48), UDim2.fromScale(0.5, 0.55))
	respawnButton.AnchorPoint = Vector2.new(0.5, 0.5)
	respawnButton.TextSize = 18
	respawnButton.ZIndex = 42
	respawnButton.MouseButton1Click:Connect(function()
		Net.get("Respawn"):FireServer()
	end)
end

local function buildTouch(parent: Instance)
	touchRoot = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = UserInputService.TouchEnabled,
		ZIndex = 35,
	}, parent)

	local function touchButton(text: string, position: UDim2, size: Vector2, action: string)
		local button = Theme.new("TextButton", {
			BackgroundColor3 = Theme.colors.panelLight,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			Text = text,
			Font = Theme.fontBold,
			TextSize = 22,
			TextColor3 = Theme.colors.text,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = UDim2.fromOffset(size.X, size.Y),
			AutoButtonColor = false,
			ZIndex = 35,
		}, touchRoot)
		Theme.corner(button, 14)
		Theme.stroke(button, Color3.fromRGB(10, 10, 14), 2)

		button.InputBegan:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch then
				Hud.touchAction(action, true)
				button.BackgroundTransparency = 0.1
			end
		end)
		button.InputEnded:Connect(function(io)
			if io.UserInputType == Enum.UserInputType.Touch then
				Hud.touchAction(action, false)
				button.BackgroundTransparency = 0.35
			end
		end)
		return button
	end

	touchButton("◀", UDim2.new(0, 72, 1, -170), Vector2.new(70, 70), "left")
	touchButton("▶", UDim2.new(0, 156, 1, -170), Vector2.new(70, 70), "right")
	touchButton("▼", UDim2.new(0, 114, 1, -96), Vector2.new(70, 60), "down")
	touchButton("▲", UDim2.new(1, -90, 1, -180), Vector2.new(80, 80), "jump")
	touchButton("⛏", UDim2.new(1, -186, 1, -120), Vector2.new(76, 76), "primary")
	touchButton("⚔", UDim2.new(1, -96, 1, -96), Vector2.new(70, 66), "secondary")

	local invButton = Theme.button(touchRoot, "🎒", UDim2.fromOffset(60, 50), UDim2.new(1, -80, 0, 120))
	invButton.AnchorPoint = Vector2.new(0.5, 0.5)
	invButton.TextSize = 24
	invButton.MouseButton1Click:Connect(function()
		if onToggleInventory then onToggleInventory() end
	end)
end

local touchCallback: ((string, boolean) -> ())? = nil

function Hud.touchAction(action: string, down: boolean)
	if touchCallback then touchCallback(action, down) end
end

function Hud.onTouch(fn: (string, boolean) -> ())
	touchCallback = fn
end

function Hud.onHotbar(fn: (number) -> ())
	onHotbarSelect = fn
end

function Hud.onInventoryButton(fn: () -> ())
	onToggleInventory = fn
end

function Hud.build(parent: Instance)
	root = Theme.new("Frame", {
		Name = "Hud",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 30,
	}, parent)

	buildStats(root)
	buildInfo(root)
	buildHotbar(root)
	buildBoss(root)
	buildNotify(root)
	buildDeath(root)
	buildTouch(root)
end

-- ===== التحديث =====

local BIOME_NAMES = {
	forest = "غابة",
	desert = "صحراء",
	snow = "أرض ثلجية",
	jungle = "أدغال",
	plains = "سهول",
}

local function layerName(y: number): string
	if y >= Config.HELL_Y then return "الجحيم" end
	if y >= Config.CAVERN_Y then return "الأعماق" end
	if y >= Config.SURFACE + 40 then return "تحت الأرض" end
	if y >= Config.SURFACE - 20 then return "السطح" end
	return "السماء"
end

function Hud.update(dt: number)
	Theme.setBar(hpBar, State.hp, State.maxHp)
	Theme.setBar(manaBar, State.mana, State.maxMana)
	Theme.setBar(foodBar, State.food, Config.FOOD_MAX, string.format("طعام %d%%", math.floor(State.food)))
	defenseLabel.Text = string.format("الدفاع: %d   |   القتلى: %d", State.defense, State.kills)

	clockLabel.Text = string.format("%s — اليوم %d", Util.clock(State.time), State.day)
	local depth = math.floor(State.body.y - Config.SURFACE)
	local biome = BIOME_NAMES[WorldGen.biomeAt(State.seed, math.floor(State.body.x))] or ""
	depthLabel.Text = string.format("%s · %s · العمق %d م", layerName(State.body.y), biome, math.max(0, depth))

	local coins = 0
	for i = 1, Config.INV_SLOTS do
		local stack = State.slots[i]
		if stack and stack.id == "coin" then coins += stack.n end
	end
	coinLabel.Text = string.format("العملات: %d", coins)

	-- التعزيزات: نعيد البناء فقط عند تغيّر المجموعة، ونحدّث العدّاد نصياً كل إطار
	local parts = {}
	for _, buff in State.buffs do
		table.insert(parts, buff.id)
	end
	table.sort(parts)
	local signature = table.concat(parts, ",")
	if signature ~= buffSignature then
		buffSignature = signature
		for _, icon in buffIcons do icon:Destroy() end
		table.clear(buffIcons)
		for _, buff in State.buffs do
			local def = Buffs.get(buff.id)
			if def then
				local icon = Theme.new("Frame", {
					Name = buff.id,
					BackgroundColor3 = def.color,
					BorderSizePixel = 0,
					Size = UDim2.fromOffset(26, 26),
					ZIndex = 31,
				}, buffRow)
				Theme.corner(icon, 5)
				Theme.stroke(icon, Color3.fromRGB(10, 10, 14), 1.5)
				Theme.new("TextLabel", {
					Name = "Timer",
					BackgroundTransparency = 1,
					Font = Theme.fontNumber,
					Text = "",
					TextSize = 10,
					TextColor3 = Color3.fromRGB(20, 20, 24),
					Size = UDim2.fromScale(1, 1),
					ZIndex = 32,
				}, icon)
				table.insert(buffIcons, icon)
			end
		end
	end
	for _, buff in State.buffs do
		local icon = buffRow:FindFirstChild(buff.id)
		if icon then
			local timer = icon:FindFirstChild("Timer")
			if timer and timer:IsA("TextLabel") then
				timer.Text = tostring(math.ceil(buff.t))
			end
		end
	end

	-- شريط الأدوات
	for i, entry in hotbarSlots do
		local stack = State.slots[i]
		Theme.setSlotState(entry.slot, if i == State.hotbar then "active" else "normal")
		if stack then
			Theme.setItemIcon(entry.icon, stack.id)
			entry.count.Text = if stack.n > 1 then tostring(stack.n) else ""
			-- توهّج حول الأغراض المطوّرة أو المسحورة
			if Upgrades.isModified(stack) then
				entry.glow.Color = Upgrades.displayColor(stack)
				entry.glow.Thickness = 2
				entry.glow.Transparency = 0.15
			else
				entry.glow.Transparency = 1
			end
		else
			Theme.setItemIcon(entry.icon, nil)
			entry.count.Text = ""
			entry.glow.Transparency = 1
		end
	end

	local held = State.heldItem()
	if held and Items.get(held.id) then
		hotbarName.Text = Upgrades.displayName(held)
		hotbarName.TextColor3 = Upgrades.displayColor(held)
	else
		hotbarName.Text = ""
	end

	loadingLabel.Text = if State.pending > 0
		then string.format("جارٍ تحميل العالم… (%d)", State.pending)
		else ""

	-- الزعيم
	if State.boss and State.boss.active then
		bossFrame.Visible = true
		bossName.Text = State.boss.name or "زعيم"
		Theme.setBar(bossBar, State.boss.hp or 0, State.boss.maxHp or 1)
	else
		bossFrame.Visible = false
	end

	-- شاشة الموت
	deathFrame.Visible = State.dead
	if State.dead then
		local remaining = math.max(0, State.respawnIn)
		if remaining > 0.1 then
			respawnButton.Text = string.format("العودة خلال %.0f", remaining)
			respawnButton.AutoButtonColor = false
		else
			respawnButton.Text = "العودة للحياة"
			respawnButton.AutoButtonColor = true
		end
	end

	-- الإشعارات
	for i = #notifications, 1, -1 do
		local entry = notifications[i]
		entry.life -= dt
		if entry.life <= 0 then
			entry.frame:Destroy()
			table.remove(notifications, i)
		elseif entry.life < 0.6 then
			entry.frame.BackgroundTransparency = 1 - entry.life / 0.6 * 0.85
			for _, child in entry.frame:GetChildren() do
				if child:IsA("TextLabel") then
					child.TextTransparency = 1 - entry.life / 0.6
				end
			end
		end
	end
end

function Hud.setWallMode(enabled: boolean)
	wallModeLabel.Text = if enabled then "وضع الجدران: مُفعّل (F)" else ""
end

function Hud.notify(text: string, color: Color3?, big: boolean?)
	local frame = Theme.new("Frame", {
		BackgroundColor3 = Theme.colors.panel,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(if big then 460 else 380, if big then 40 else 32),
		ZIndex = 36,
	}, notifyRoot)
	Theme.corner(frame, 8)
	Theme.stroke(frame, color or Theme.colors.border, 1.5)

	Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = if big then Theme.fontBold else Theme.font,
		Text = text,
		TextSize = if big then 18 else 15,
		TextColor3 = color or Theme.colors.text,
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 37,
	}, frame)

	table.insert(notifications, { frame = frame, life = if big then 5 else 3.2 })
	if #notifications > 6 then
		local oldest = table.remove(notifications, 1)
		if oldest then oldest.frame:Destroy() end
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Panels — نوافذ المخزون والمحطات والمتجر، مع تلميحات العناصر.

	نافذة المحطة واحدة بتبويبات، ويتغيّر محتواها حسب ما تفاعلت معه:
		تصنيع  — لكل المحطات (مع بحث)
		صهر    — الفرن: مُدخل + وقود + ناتج + شريط تقدّم حيّ
		تطوير  — السندان: رفع مستوى الأداة/الدرع (+1 حتى +5)
		سحر    — طاولة السحر: منح صفة عشوائية قابلة لإعادة الرمي

	التفاعل موحّد: نقرة لاختيار خانة ثم نقرة على الهدف. يعمل بالفأرة واللمس.
]]

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Config = require(Shared.Config)
local Inventory = require(Shared.Inventory)
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local Recipes = require(Shared.Recipes)
local Smelting = require(Shared.Smelting)
local Upgrades = require(Shared.Upgrades)
local World = require(Shared.World)

local ClientWorld = require(script.Parent.Parent.ClientWorld)
local State = require(script.Parent.Parent.State)
local Theme = require(script.Parent.Theme)

local Panels = {}

local SLOT = 46
local GAP = 5
local STATION_RANGE = 7

-- ===== المراجع =====
local root: Frame
local invPanel: Frame
local stationPanel: Frame
local shopPanel: Frame
local tooltip: Frame
local tooltipTitle: TextLabel
local tooltipBody: TextLabel

type SlotView = { slot: Theme.Slot, button: TextButton, icon: ImageLabel, count: TextLabel, glow: UIStroke }

local slotButtons: { SlotView } = {}
local armorButtons: { [string]: SlotView } = {}

local stationTitle: TextLabel
local tabRow: Frame
local tabButtons: { [string]: TextButton } = {}
local contentFrames: { [string]: Frame } = {}

local craftList: ScrollingFrame
local craftRows: { Frame } = {}
local craftSearch: TextBox
local stationHint: TextLabel

local furnaceSlots: { [string]: SlotView } = {}
local chestSlots: { SlotView } = {}
local chestHint: TextLabel
local furnaceProgress: Theme.Bar
local furnaceBurn: Theme.Bar
local furnaceHint: TextLabel

local modTarget: { [string]: TextLabel } = {}
local modCost: { [string]: TextLabel } = {}
local modButton: { [string]: TextButton } = {}
local modPreview: { [string]: TextLabel } = {}

local shopList: ScrollingFrame
local shopCoins: TextLabel

-- ===== الحالة =====
local selected: number? = nil
local shopData: any = nil
local stationData: any = nil
local activeTab = "craft"
local craftDirty = true
local craftRefresh = 0
local stationSignature = ""
local searchText = ""

local TAB_NAMES = { craft = "تصنيع", smelt = "صهر", upgrade = "تطوير", enchant = "سحر", chest = "صندوق" }
local STATION_NAMES = {
	workbench = "طاولة العمل",
	furnace = "الفرن",
	anvil = "السندان",
	alchemy = "طاولة الخيمياء",
	enchant = "طاولة السحر",
	chest = "الصندوق",
}

local CHEST_COLS = 9
local CHEST_ROWS = 3

-- ===== أدوات مشتركة =====

local function stackOf(data: any): Inventory.Stack?
	if type(data) ~= "table" or type(data.id) ~= "string" then return nil end
	local stack: Inventory.Stack = { id = data.id, n = data.n or 1 }
	if type(data.lvl) == "number" then
		stack.up = Upgrades.normalize({ lvl = data.lvl, aff = data.aff })
	end
	return stack
end

local function makeSlot(parent: Instance, position: UDim2, size: number?): SlotView
	local edge = size or SLOT
	local slot = Theme.slotButton(parent, edge, position)
	local glow = Theme.stroke(slot.button, Color3.fromRGB(10, 10, 14), 2)
	glow.Transparency = 1

	local icon = Theme.itemIcon(slot.button, math.floor(edge * 0.66), 33)

	local count = Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.fontNumber,
		Text = "",
		TextSize = 12,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextStrokeTransparency = 0.2,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -3, 1, -1),
		Size = UDim2.fromOffset(38, 14),
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 34,
	}, slot.button)

	return { slot = slot, button = slot.button, icon = icon, count = count, glow = glow }
end

local function paintSlot(view: SlotView, stack: Inventory.Stack?, state: string?)
	if stack then
		Theme.setItemIcon(view.icon, stack.id)
		view.count.Text = if stack.n > 1 then tostring(stack.n) else ""
		if Upgrades.isModified(stack) then
			view.glow.Color = Upgrades.displayColor(stack)
			view.glow.Transparency = 0.15
		else
			view.glow.Transparency = 1
		end
	else
		Theme.setItemIcon(view.icon, nil)
		view.count.Text = ""
		view.glow.Transparency = 1
	end
	Theme.setSlotState(view.slot, state or "normal")
end

-- ===== التلميح =====

local function buildTooltip(parent: Instance)
	tooltip = Theme.panel(parent, "Tooltip")
	tooltip.Size = UDim2.fromOffset(280, 120)
	tooltip.Visible = false
	tooltip.ZIndex = 60
	Theme.padding(tooltip, 10)

	tooltipTitle = Theme.label(tooltip, "", 16, Theme.colors.text)
	tooltipTitle.Size = UDim2.new(1, 0, 0, 20)
	tooltipTitle.Font = Theme.fontBold
	tooltipTitle.ZIndex = 61

	tooltipBody = Theme.label(tooltip, "", 13, Theme.colors.textDim)
	tooltipBody.Position = UDim2.fromOffset(0, 24)
	tooltipBody.Size = UDim2.new(1, 0, 1, -24)
	tooltipBody.TextYAlignment = Enum.TextYAlignment.Top
	tooltipBody.TextWrapped = true
	tooltipBody.ZIndex = 61
end

local function describe(stack: Inventory.Stack): string
	local item = Items.get(stack.id)
	if not item then return stack.id end
	local lines = {}

	if item.cat == "block" then table.insert(lines, "بلاطة قابلة للبناء") end

	-- الأرقام المعروضة هي الفعلية بعد التطوير والصفة
	if item.damage then table.insert(lines, string.format("الضرر: %d", Upgrades.damage(stack))) end
	if item.pick and item.pick > 0 then
		table.insert(lines, string.format("قوة المعول: %d", item.pick + Upgrades.powerBonus(stack)))
	end
	if item.axe and item.axe > 0 then
		table.insert(lines, string.format("قوة الفأس: %d", item.axe + Upgrades.powerBonus(stack)))
	end
	if item.useTime then table.insert(lines, string.format("زمن الاستخدام: %.2fث", Upgrades.useTime(stack))) end
	if item.defense then table.insert(lines, string.format("الدفاع: %d", Upgrades.defense(stack))) end
	if item.setBonus then table.insert(lines, "طقم كامل: +6 دفاع") end
	if item.heal then table.insert(lines, string.format("يستعيد %d حياة", item.heal)) end
	if item.restoreMana then table.insert(lines, string.format("يستعيد %d مانا", item.restoreMana)) end
	if item.food then table.insert(lines, string.format("يشبع %d", item.food)) end
	if item.mana then table.insert(lines, string.format("كلفة المانا: %d", item.mana)) end
	if item.ranged then table.insert(lines, "يحتاج ذخيرة: سهام") end

	local affix = Upgrades.affixOf(stack)
	if affix then
		table.insert(lines, "✦ " .. affix.name .. ": " .. affix.desc)
	end
	local level = Upgrades.levelOf(stack)
	if level > 0 then
		table.insert(lines, string.format("مستوى التطوير: +%d / +%d", level, Upgrades.MAX_LEVEL))
	end
	if Upgrades.canModify(stack.id) and level == 0 and not affix then
		table.insert(lines, "قابل للتطوير على السندان وللسحر على طاولة السحر")
	end

	local smelt = Smelting.recipeFor(stack.id)
	if smelt then
		table.insert(lines, string.format("يُصهر إلى: %s (%.0fث)", Items.name(smelt.out), smelt.time))
	end
	local fuel = Smelting.fuelValue(stack.id)
	if fuel > 0 then
		table.insert(lines, string.format("وقود: %.0f ثانية", fuel))
	end

	if item.desc then table.insert(lines, item.desc) end
	table.insert(lines, string.format("القيمة: %d عملة", item.value))
	return table.concat(lines, "\n")
end

local function showTooltip(stack: Inventory.Stack?)
	if not stack or not Items.get(stack.id) then
		tooltip.Visible = false
		return
	end
	tooltip.Visible = true
	tooltipTitle.Text = Upgrades.displayName(stack)
	tooltipTitle.TextColor3 = Upgrades.displayColor(stack)
	tooltipBody.Text = describe(stack)
	local lineCount = select(2, string.gsub(tooltipBody.Text, "\n", "")) + 1
	tooltip.Size = UDim2.fromOffset(280, 40 + lineCount * 16)
end

local function hookTooltip(button: GuiButton, getter: () -> Inventory.Stack?)
	button.MouseEnter:Connect(function() showTooltip(getter()) end)
	button.MouseLeave:Connect(function() showTooltip(nil) end)
end

-- ===== المخزون =====

local function slotClicked(index: number, alternate: boolean)
	local stack = State.slots[index]

	if alternate then
		if stack then
			local item = Items.get(stack.id)
			if item and item.cat == "armor" then
				Net.get("InvAction"):FireServer("equip", index)
			else
				Net.get("InvAction"):FireServer("drop", index,
					if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then "all" else 1)
			end
		end
		selected = nil
		return
	end

	if selected == nil then
		if stack then selected = index end
	elseif selected == index then
		selected = nil
	else
		Net.get("InvAction"):FireServer("swap", selected, index)
		selected = nil
	end
end

local function buildInventory(parent: Instance)
	local width = Config.HOTBAR * SLOT + (Config.HOTBAR - 1) * GAP
	local height = (Config.INV_ROWS + 1) * SLOT + Config.INV_ROWS * GAP

	invPanel = Theme.panel(parent, "Inventory")
	invPanel.Size = UDim2.fromOffset(width + 150, height + 70)
	invPanel.Position = UDim2.fromOffset(30, 90)
	Theme.padding(invPanel, 14)

	local title = Theme.label(invPanel, "المخزون", 18, Theme.colors.text)
	title.Size = UDim2.new(1, 0, 0, 22)
	title.Font = Theme.fontBold

	local sortButton = Theme.button(invPanel, "ترتيب", UDim2.fromOffset(74, 24), UDim2.fromOffset(0, 0))
	sortButton.MouseButton1Click:Connect(function()
		Net.get("InvAction"):FireServer("sort")
	end)

	-- خانات الدرع
	local armorBox = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.fromOffset(130, height),
		ZIndex = 31,
	}, invPanel)

	local slotNames = { head = "الرأس", chest = "الصدر", feet = "القدم" }
	for i, slotName in { "head", "chest", "feet" } do
		local label = Theme.label(armorBox, slotNames[slotName], 12, Theme.colors.textDim)
		label.Position = UDim2.fromOffset(0, (i - 1) * (SLOT + 22))
		label.Size = UDim2.fromOffset(120, 16)

		local view = makeSlot(armorBox, UDim2.fromOffset(120 - SLOT, (i - 1) * (SLOT + 22) + 18))
		view.button.MouseButton1Click:Connect(function()
			Net.get("InvAction"):FireServer("unequip", slotName)
		end)
		hookTooltip(view.button, function() return State.armor[slotName] end)
		armorButtons[slotName] = view
	end

	-- شبكة الخانات
	local grid = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(140, 32),
		Size = UDim2.fromOffset(width, height),
		ZIndex = 31,
	}, invPanel)

	for i = 1, Config.INV_SLOTS do
		local col = (i - 1) % Config.HOTBAR
		local row = (i - 1) // Config.HOTBAR
		local view = makeSlot(grid, UDim2.fromOffset(col * (SLOT + GAP), row * (SLOT + GAP)))
		view.button.MouseButton1Click:Connect(function() slotClicked(i, false) end)
		view.button.MouseButton2Click:Connect(function() slotClicked(i, true) end)
		hookTooltip(view.button, function() return State.slots[i] end)
		table.insert(slotButtons, view)
	end
end

-- ===== المحطات القريبة =====

local function stationsNear(): { [string]: boolean }
	local found: { [string]: boolean } = {}
	if not ClientWorld.isReady() then return found end
	local world = ClientWorld.get()
	local cx, cy = math.floor(State.body.x), math.floor(State.body.y)
	for ty = cy - STATION_RANGE, cy + STATION_RANGE do
		for tx = cx - STATION_RANGE, cx + STATION_RANGE do
			local block = Blocks.get(World.fg(world, tx, ty))
			if block.station then found[block.station] = true end
		end
	end
	return found
end

-- ===== تبويب التصنيع =====

local function refreshCrafting()
	for _, row in craftRows do row:Destroy() end
	table.clear(craftRows)

	local stations = stationsNear()
	local keys = {}
	for station in stations do table.insert(keys, station) end
	table.sort(keys)
	stationSignature = table.concat(keys, ",")

	local names = {}
	for _, station in keys do
		table.insert(names, STATION_NAMES[station] or station)
	end
	stationHint.Text = if #names > 0
		then "المحطات القريبة: " .. table.concat(names, "، ")
		else "لا توجد محطات قريبة — الوصفات اليدوية فقط"

	local query = string.lower(searchText)
	local available = Recipes.available(stations)
	local order = 0
	local totalHeight = 0

	for _, recipe in available do
		local outItem = Items.get(recipe.out.id)
		if outItem then
			local matches = query == "" or string.find(string.lower(outItem.name), query, 1, true) ~= nil
				or string.find(recipe.out.id, query, 1, true) ~= nil
			if matches then
				local canCraft = Inventory.canCraft(State.slots, recipe)
				order += 1
				local row = Theme.new("Frame", {
					BackgroundColor3 = Theme.colors.panelLight,
					BackgroundTransparency = if canCraft then 0.1 else 0.55,
					BorderSizePixel = 0,
					Size = UDim2.new(1, -8, 0, 54),
					LayoutOrder = if canCraft then order else order + 1000,
					ZIndex = 32,
				}, craftList)
				Theme.corner(row, 7)

				local icon = Theme.itemIcon(row, 30, 33)
				icon.AnchorPoint = Vector2.new(1, 0.5)
				icon.Position = UDim2.new(1, -8, 0.5, 0)
				Theme.setItemIcon(icon, recipe.out.id)

				local name = Theme.label(row, string.format("%s ×%d", outItem.name, recipe.out.n), 14,
					Items.RARITY_COLORS[outItem.rarity] or Theme.colors.text)
				name.Position = UDim2.fromOffset(0, 6)
				name.Size = UDim2.new(1, -48, 0, 18)
				name.Font = Theme.fontBold

				local parts = {}
				for _, ingredient in recipe.ins do
					local have = Inventory.count(State.slots, ingredient.id)
					table.insert(parts, string.format("%s %d/%d", Items.name(ingredient.id), have, ingredient.n))
				end
				local ingredients = Theme.label(row, table.concat(parts, " · "), 11,
					if canCraft then Theme.colors.good else Theme.colors.textDim)
				ingredients.Position = UDim2.fromOffset(0, 26)
				ingredients.Size = UDim2.new(1, -48, 0, 24)
				ingredients.TextWrapped = true

				local button = Theme.new("TextButton", {
					BackgroundTransparency = 1,
					Text = "",
					Size = UDim2.fromScale(1, 1),
					ZIndex = 34,
				}, row)
				button.MouseButton1Click:Connect(function()
					Net.get("Craft"):FireServer(recipe.key, 1)
				end)
				button.MouseButton2Click:Connect(function()
					Net.get("Craft"):FireServer(recipe.key, 10)
				end)
				hookTooltip(button, function() return { id = recipe.out.id, n = recipe.out.n } end)

				table.insert(craftRows, row)
				totalHeight += 59
			end
		end
	end

	craftList.CanvasSize = UDim2.fromOffset(0, totalHeight)
end

local function buildCraftTab(parent: Instance): Frame
	local frame = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = true,
		ZIndex = 31,
	}, parent)

	craftSearch = Theme.new("TextBox", {
		BackgroundColor3 = Theme.colors.slot,
		BorderSizePixel = 0,
		Font = Theme.font,
		PlaceholderText = "ابحث عن وصفة…",
		Text = "",
		TextSize = 13,
		TextColor3 = Theme.colors.text,
		PlaceholderColor3 = Theme.colors.textDim,
		ClearTextOnFocus = false,
		Size = UDim2.new(1, 0, 0, 26),
		ZIndex = 32,
	}, frame)
	Theme.corner(craftSearch, 6)
	craftSearch:GetPropertyChangedSignal("Text"):Connect(function()
		searchText = craftSearch.Text
		craftDirty = true
	end)

	stationHint = Theme.label(frame, "", 12, Theme.colors.textDim)
	stationHint.Position = UDim2.fromOffset(0, 30)
	stationHint.Size = UDim2.new(1, 0, 0, 18)

	craftList = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -52),
		CanvasSize = UDim2.fromOffset(0, 0),
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.colors.slotHover,
		ZIndex = 31,
	}, frame)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 5)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = craftList

	return frame
end

-- ===== تبويب الفرن =====

local function furnaceAction(slotName: string)
	if not stationData then return end
	local x, y = stationData.x, stationData.y
	if slotName ~= "output" and selected then
		Net.get("Station"):FireServer("give", x, y, selected, slotName)
		selected = nil
	else
		Net.get("Station"):FireServer("take", x, y, slotName)
	end
end

local function buildSmeltTab(parent: Instance): Frame
	local frame = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 31,
	}, parent)

	local big = 58
	local labels = { input = "المادة", fuel = "الوقود", output = "الناتج" }
	local positions = {
		input = UDim2.fromOffset(0, 22),
		fuel = UDim2.fromOffset(0, 22 + big + 34),
		output = UDim2.new(1, -big, 0, 22 + (big + 34) / 2),
	}

	for _, slotName in { "input", "fuel", "output" } do
		local caption = Theme.label(frame, labels[slotName], 12, Theme.colors.textDim)
		caption.Position = positions[slotName] - UDim2.fromOffset(0, 18)
		caption.Size = UDim2.fromOffset(big, 16)
		caption.TextXAlignment = Enum.TextXAlignment.Center

		local view = makeSlot(frame, positions[slotName], big)
		view.button.MouseButton1Click:Connect(function() furnaceAction(slotName) end)
		hookTooltip(view.button, function()
			return if stationData then stackOf(stationData[slotName]) else nil
		end)
		furnaceSlots[slotName] = view
	end

	furnaceProgress = Theme.bar(frame, Color3.fromRGB(60, 44, 26), Color3.fromRGB(240, 170, 70), 150, 18)
	furnaceProgress.root.Position = UDim2.fromOffset(big + 16, 22 + big / 2 - 9)

	furnaceBurn = Theme.bar(frame, Color3.fromRGB(52, 30, 24), Color3.fromRGB(230, 96, 48), 150, 12)
	furnaceBurn.root.Position = UDim2.fromOffset(big + 16, 22 + big / 2 + 16)

	furnaceHint = Theme.label(frame, "", 12, Theme.colors.textDim)
	furnaceHint.Position = UDim2.fromOffset(0, 22 + (big + 34) + big + 14)
	furnaceHint.Size = UDim2.new(1, 0, 0, 54)
	furnaceHint.TextWrapped = true
	furnaceHint.TextYAlignment = Enum.TextYAlignment.Top

	local reference = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 22 + (big + 34) + big + 72),
		Size = UDim2.new(1, 0, 1, -(22 + (big + 34) + big + 72)),
		CanvasSize = UDim2.fromOffset(0, 0),
		ScrollBarThickness = 6,
		ZIndex = 31,
	}, frame)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 3)
	layout.Parent = reference

	local height = 0
	for _, entry in Smelting.list() do
		local row = Theme.label(reference, string.format("%s ← %s ×%d (%.0fث)",
			Items.name(entry.out), Items.name(entry.input), entry.n, entry.time), 11, Theme.colors.textDim)
		row.Size = UDim2.new(1, -8, 0, 16)
		height += 19
	end
	reference.CanvasSize = UDim2.fromOffset(0, height)

	return frame
end

-- ===== تبويب الصندوق =====

local function chestClicked(index: number)
	if not stationData then return end
	local x, y = stationData.x, stationData.y

	if selected then
		Net.get("Station"):FireServer("chest_swap", x, y, selected, index)
		selected = nil
		return
	end

	-- بلا اختيار: أخرِج الكومة إلى أول خانة فارغة في المخزون
	local slots = stationData.slots or {}
	if not slots[index] then return end
	for i = 1, Config.INV_SLOTS do
		if not State.slots[i] then
			Net.get("Station"):FireServer("chest_swap", x, y, i, index)
			return
		end
	end
end

local function buildChestTab(parent: Instance): Frame
	local frame = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 31,
	}, parent)

	local intro = Theme.label(frame,
		"اختر خانة من مخزونك ثم انقر خانة في الصندوق للتبديل، أو انقر كومة في الصندوق لسحبها.",
		12, Theme.colors.textDim)
	intro.Size = UDim2.new(1, 0, 0, 32)
	intro.TextWrapped = true

	local slotSize = 38
	local gap = 4
	local grid = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.fromOffset(CHEST_COLS * (slotSize + gap), CHEST_ROWS * (slotSize + gap)),
		ZIndex = 31,
	}, frame)

	for i = 1, CHEST_COLS * CHEST_ROWS do
		local col = (i - 1) % CHEST_COLS
		local row = (i - 1) // CHEST_COLS
		local view = makeSlot(grid, UDim2.fromOffset(col * (slotSize + gap), row * (slotSize + gap)), slotSize)
		view.button.MouseButton1Click:Connect(function() chestClicked(i) end)
		hookTooltip(view.button, function()
			if not stationData then return nil end
			return stackOf((stationData.slots or {})[i])
		end)
		table.insert(chestSlots, view)
	end

	local deposit = Theme.button(frame, "أودِع المتماثل",
		UDim2.fromOffset(150, 30), UDim2.fromOffset(0, 38 + CHEST_ROWS * (slotSize + gap) + 10))
	deposit.MouseButton1Click:Connect(function()
		if stationData then
			Net.get("Station"):FireServer("chest_deposit", stationData.x, stationData.y)
		end
	end)

	chestHint = Theme.label(frame, "", 12, Theme.colors.textDim)
	chestHint.Position = UDim2.fromOffset(0, 38 + CHEST_ROWS * (slotSize + gap) + 48)
	chestHint.Size = UDim2.new(1, 0, 0, 36)
	chestHint.TextWrapped = true

	return frame
end

-- ===== تبويبا التطوير والسحر =====

local function buildModTab(parent: Instance, kind: string): Frame
	local frame = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 31,
	}, parent)

	local intro = Theme.label(frame,
		if kind == "upgrade"
			then "اختر أداة أو درعاً من المخزون، ثم طوّره. النجاح مضمون دائماً."
			else "اختر أداة أو درعاً، ثم امنحه صفة سحرية. يمكنك إعادة الرمي للحصول على صفة أخرى.",
		12, Theme.colors.textDim)
	intro.Position = UDim2.fromOffset(0, 0)
	intro.Size = UDim2.new(1, 0, 0, 34)
	intro.TextWrapped = true

	modTarget[kind] = Theme.label(frame, "لم تختر عنصراً", 16, Theme.colors.text)
	modTarget[kind].Position = UDim2.fromOffset(0, 42)
	modTarget[kind].Size = UDim2.new(1, 0, 0, 22)
	modTarget[kind].Font = Theme.fontBold

	modPreview[kind] = Theme.label(frame, "", 12, Theme.colors.textDim)
	modPreview[kind].Position = UDim2.fromOffset(0, 66)
	modPreview[kind].Size = UDim2.new(1, 0, 0, 50)
	modPreview[kind].TextWrapped = true
	modPreview[kind].TextYAlignment = Enum.TextYAlignment.Top

	modCost[kind] = Theme.label(frame, "", 13, Theme.colors.gold)
	modCost[kind].Position = UDim2.fromOffset(0, 120)
	modCost[kind].Size = UDim2.new(1, 0, 0, 40)
	modCost[kind].TextWrapped = true
	modCost[kind].TextYAlignment = Enum.TextYAlignment.Top

	modButton[kind] = Theme.button(frame,
		if kind == "upgrade" then "طوّر" else "اسحر",
		UDim2.new(1, 0, 0, 34), UDim2.fromOffset(0, 166))
	modButton[kind].TextSize = 16
	modButton[kind].MouseButton1Click:Connect(function()
		if not stationData or not selected then return end
		Net.get("Station"):FireServer(kind, stationData.x, stationData.y, selected)
	end)

	-- مرجع الصفات المتاحة
	local pool = if kind == "enchant" then "الصفات الممكنة:" else "كل مستوى: +12% للأرقام، +4 قوة أداة، −3% زمن استخدام."
	local poolLabel = Theme.label(frame, pool, 12, Theme.colors.textDim)
	poolLabel.Position = UDim2.fromOffset(0, 210)
	poolLabel.Size = UDim2.new(1, 0, 0, 18)

	if kind == "enchant" then
		local list = Theme.new("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 230),
			Size = UDim2.new(1, 0, 1, -230),
			CanvasSize = UDim2.fromOffset(0, 0),
			ScrollBarThickness = 6,
			ZIndex = 31,
		}, frame)
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 3)
		layout.Parent = list

		local height = 0
		local groupNames = { weapon = "الأسلحة", tool = "الأدوات", armor = "الدروع" }
		for _, group in { "weapon", "tool", "armor" } do
			local header = Theme.label(list, groupNames[group], 12, Theme.colors.text)
			header.Size = UDim2.new(1, -8, 0, 18)
			header.Font = Theme.fontBold
			height += 21
			for _, affix in Upgrades.pools[group] do
				local row = Theme.label(list, "✦ " .. affix.name .. " — " .. affix.desc, 11, affix.color)
				row.Size = UDim2.new(1, -8, 0, 16)
				height += 19
			end
		end
		list.CanvasSize = UDim2.fromOffset(0, height)
	end

	return frame
end

local function refreshModTab(kind: string)
	local targetLabel = modTarget[kind]
	local previewLabel = modPreview[kind]
	local costLabel = modCost[kind]
	local button = modButton[kind]
	if not targetLabel then return end

	local stack = if selected then State.slots[selected] else nil

	if not stack then
		targetLabel.Text = "لم تختر عنصراً"
		targetLabel.TextColor3 = Theme.colors.textDim
		previewLabel.Text = "انقر على أداة أو درع في المخزون لاختياره."
		costLabel.Text = ""
		button.AutoButtonColor = false
		button.BackgroundColor3 = Theme.colors.slot
		return
	end

	if not Upgrades.canModify(stack.id) then
		targetLabel.Text = Upgrades.displayName(stack)
		targetLabel.TextColor3 = Theme.colors.bad
		previewLabel.Text = "هذا العنصر غير قابل للتطوير أو السحر — الأدوات والأسلحة والدروع فقط."
		costLabel.Text = ""
		button.AutoButtonColor = false
		button.BackgroundColor3 = Theme.colors.slot
		return
	end

	targetLabel.Text = Upgrades.displayName(stack)
	targetLabel.TextColor3 = Upgrades.displayColor(stack)

	local level = Upgrades.levelOf(stack)
	local affix = Upgrades.affixOf(stack)
	local lines = {}
	table.insert(lines, string.format("المستوى الحالي: +%d / +%d", level, Upgrades.MAX_LEVEL))
	table.insert(lines, if affix then "الصفة الحالية: " .. affix.name .. " — " .. affix.desc else "بلا صفة سحرية")
	previewLabel.Text = table.concat(lines, "\n")

	local cost = if kind == "upgrade"
		then Upgrades.upgradeCost(stack.id, level)
		else Upgrades.enchantCost(stack.id)

	if not cost then
		costLabel.Text = "بلغ هذا العنصر أقصى تطوير."
		costLabel.TextColor3 = Theme.colors.textDim
		button.AutoButtonColor = false
		button.BackgroundColor3 = Theme.colors.slot
		return
	end

	local haveMaterial = Inventory.count(State.slots, cost.material)
	local haveCoins = Inventory.count(State.slots, "coin")
	local affordable = haveMaterial >= cost.amount and haveCoins >= cost.coins

	costLabel.Text = string.format("الكلفة: %s %d/%d · عملات %d/%d",
		Items.name(cost.material), haveMaterial, cost.amount, haveCoins, cost.coins)
	costLabel.TextColor3 = if affordable then Theme.colors.good else Theme.colors.bad
	button.AutoButtonColor = affordable
	button.BackgroundColor3 = if affordable then Theme.colors.panelLight else Theme.colors.slot
end

-- ===== نافذة المحطة =====

local function setTab(tab: string)
	activeTab = tab
	for name, frame in contentFrames do
		frame.Visible = name == tab
	end
	for name, button in tabButtons do
		button.BackgroundColor3 = if name == tab then Theme.colors.slotActive else Theme.colors.panelLight
	end
	if tab == "craft" then craftDirty = true end
end

local function setAvailableTabs(tabs: { string })
	local x = 0
	local present: { [string]: boolean } = {}
	for _, tab in tabs do present[tab] = true end

	for name, button in tabButtons do
		button.Visible = present[name] == true
	end
	for _, tab in tabs do
		local button = tabButtons[tab]
		if button then
			button.Position = UDim2.fromOffset(x, 0)
			x += 84
		end
	end

	if not present[activeTab] then
		setTab(tabs[1] or "craft")
	else
		setTab(activeTab)
	end
end

local function buildStation(parent: Instance)
	stationPanel = Theme.panel(parent, "Station")
	stationPanel.Size = UDim2.fromOffset(400, 500)
	stationPanel.Position = UDim2.new(1, -430, 0, 90)
	Theme.padding(stationPanel, 12)

	stationTitle = Theme.label(stationPanel, "التصنيع", 18, Theme.colors.text)
	stationTitle.Size = UDim2.new(1, 0, 0, 22)
	stationTitle.Font = Theme.fontBold

	tabRow = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 28),
		ZIndex = 31,
	}, stationPanel)

	for _, tab in { "craft", "smelt", "chest", "upgrade", "enchant" } do
		local button = Theme.button(tabRow, TAB_NAMES[tab], UDim2.fromOffset(78, 26), UDim2.fromOffset(0, 0))
		button.Visible = false
		button.MouseButton1Click:Connect(function() setTab(tab) end)
		tabButtons[tab] = button
	end

	local content = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 1, -60),
		ZIndex = 31,
	}, stationPanel)

	contentFrames.craft = buildCraftTab(content)
	contentFrames.smelt = buildSmeltTab(content)
	contentFrames.chest = buildChestTab(content)
	contentFrames.upgrade = buildModTab(content, "upgrade")
	contentFrames.enchant = buildModTab(content, "enchant")
end

-- ===== المتجر =====

local function refreshShop()
	if not shopData then return end
	for _, child in shopList:GetChildren() do
		if child:IsA("Frame") then child:Destroy() end
	end

	shopCoins.Text = string.format("عملاتك: %d", shopData.coins or 0)
	local height = 0
	for _, entry in shopData.stock or {} do
		local item = Items.get(entry.id)
		if item and entry.price > 0 then
			local row = Theme.new("Frame", {
				BackgroundColor3 = Theme.colors.panelLight,
				BackgroundTransparency = 0.1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, -8, 0, 38),
				ZIndex = 32,
			}, shopList)
			Theme.corner(row, 6)

			local icon = Theme.itemIcon(row, 26, 33)
			icon.AnchorPoint = Vector2.new(1, 0.5)
			icon.Position = UDim2.new(1, -6, 0.5, 0)
			Theme.setItemIcon(icon, entry.id)

			local label = Theme.label(row, string.format("%s — %d عملة", item.name, entry.price), 13, Theme.colors.text)
			label.Position = UDim2.fromOffset(76, 0)
			label.Size = UDim2.new(1, -110, 1, 0)

			local buy1 = Theme.button(row, "شراء", UDim2.fromOffset(50, 24), UDim2.fromOffset(4, 7))
			buy1.MouseButton1Click:Connect(function()
				Net.get("Shop"):FireServer("buy", entry.id, 1)
			end)
			local buy10 = Theme.button(row, "×10", UDim2.fromOffset(38, 24), UDim2.fromOffset(56, 7))
			buy10.MouseButton1Click:Connect(function()
				Net.get("Shop"):FireServer("buy", entry.id, 10)
			end)

			height += 42
		end
	end
	shopList.CanvasSize = UDim2.fromOffset(0, height)
end

local function buildShop(parent: Instance)
	shopPanel = Theme.panel(parent, "Shop")
	shopPanel.Size = UDim2.fromOffset(360, 420)
	shopPanel.Position = UDim2.new(0.5, -180, 0.5, -210)
	shopPanel.Visible = false
	Theme.padding(shopPanel, 12)

	local title = Theme.label(shopPanel, "متجر التاجر", 18, Theme.colors.text)
	title.Size = UDim2.new(1, 0, 0, 22)
	title.Font = Theme.fontBold

	shopCoins = Theme.label(shopPanel, "", 13, Theme.colors.gold)
	shopCoins.Position = UDim2.fromOffset(0, 24)
	shopCoins.Size = UDim2.new(1, 0, 0, 18)

	local closeButton = Theme.button(shopPanel, "إغلاق", UDim2.fromOffset(70, 24), UDim2.fromOffset(0, 0))
	closeButton.MouseButton1Click:Connect(function()
		shopPanel.Visible = false
		State.shopOpen = false
	end)

	shopList = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 1, -84),
		CanvasSize = UDim2.fromOffset(0, 0),
		ScrollBarThickness = 6,
		ZIndex = 31,
	}, shopPanel)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.Parent = shopList

	local sellButton = Theme.button(shopPanel, "بيع العنصر المحدد", UDim2.new(1, 0, 0, 30), UDim2.new(0, 0, 1, -30))
	sellButton.MouseButton1Click:Connect(function()
		if not selected then return end
		local stack = State.slots[selected]
		if stack then
			Net.get("Shop"):FireServer("sell", stack.id, stack.n)
			selected = nil
		end
	end)
end

-- ===== الواجهة العامة =====

function Panels.build(parent: Instance)
	root = Theme.new("Frame", {
		Name = "Panels",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 30,
	}, parent)

	buildInventory(root)
	buildStation(root)
	buildShop(parent)
	buildTooltip(parent)
	setAvailableTabs({ "craft" })
end

function Panels.setOpen(open: boolean)
	root.Visible = open
	State.uiOpen = open
	if not open then
		selected = nil
		showTooltip(nil)
		if stationData then
			Net.get("Station"):FireServer("close")
			stationData = nil
		end
		stationTitle.Text = "التصنيع"
		setAvailableTabs({ "craft" })
	else
		craftDirty = true
	end
end

function Panels.isOpen(): boolean
	return root.Visible
end

-- استُدعيت عند فتح محطة من العالم (الزر الأيمن على البلاطة)
function Panels.openStation(payload: any)
	if type(payload) ~= "table" or payload.open ~= true then
		stationData = nil
		if root.Visible then
			stationTitle.Text = "التصنيع"
			setAvailableTabs({ "craft" })
		end
		return
	end

	stationData = payload
	root.Visible = true
	State.uiOpen = true
	stationTitle.Text = STATION_NAMES[payload.kind] or "محطة"

	local tabs = { "craft" }
	if payload.kind == "furnace" then
		table.insert(tabs, "smelt")
	elseif payload.kind == "anvil" then
		table.insert(tabs, "upgrade")
	elseif payload.kind == "enchant" then
		table.insert(tabs, "enchant")
	elseif payload.kind == "chest" then
		tabs = { "chest", "craft" }
	end

	-- افتح مباشرة على التبويب المميّز لهذه المحطة
	local preferred = if payload.kind == "chest" then "chest" else tabs[#tabs]
	activeTab = preferred
	setAvailableTabs(tabs)
	craftDirty = true
end

function Panels.closeAll()
	Panels.setOpen(false)
	shopPanel.Visible = false
	State.shopOpen = false
end

function Panels.openShop(payload: any)
	shopData = payload
	if payload.open then
		shopPanel.Visible = true
		State.shopOpen = true
		refreshShop()
	else
		shopPanel.Visible = false
		State.shopOpen = false
	end
end

function Panels.onInventoryChanged()
	craftDirty = true
	if shopPanel.Visible and shopData then
		shopData.coins = Inventory.count(State.slots, "coin")
		shopCoins.Text = string.format("عملاتك: %d", shopData.coins)
	end
end

function Panels.update(dt: number)
	if not root.Visible then return end

	for i, view in slotButtons do
		local state = if selected == i then "active"
			elseif i <= Config.HOTBAR then "hover"
			else "normal"
		paintSlot(view, State.slots[i], state)
	end

	for slotName, view in armorButtons do
		paintSlot(view, State.armor[slotName])
	end

	if activeTab == "craft" then
		craftRefresh -= dt
		if craftRefresh <= 0 then
			craftRefresh = 0.35
			local stations = stationsNear()
			local keys = {}
			for station in stations do table.insert(keys, station) end
			table.sort(keys)
			if table.concat(keys, ",") ~= stationSignature then craftDirty = true end
		end
		if craftDirty then
			craftDirty = false
			refreshCrafting()
		end

	elseif activeTab == "smelt" then
		if stationData then
			for slotName, view in furnaceSlots do
				paintSlot(view, stackOf(stationData[slotName]))
			end
			local progressMax = stationData.progressMax or 0
			Theme.setBar(furnaceProgress, stationData.progress or 0, math.max(0.01, progressMax),
				if progressMax > 0 then string.format("%.0f%%", (stationData.progress or 0) / progressMax * 100) else "متوقف")
			local burnMax = stationData.burnMax or 0
			Theme.setBar(furnaceBurn, stationData.burn or 0, math.max(0.01, burnMax),
				if (stationData.burn or 0) > 0 then string.format("وقود %.0fث", stationData.burn) else "بلا وقود")

			local input = stackOf(stationData.input)
			local smelt = Smelting.recipeFor(if input then input.id else nil)
			if not input then
				furnaceHint.Text = "ضع مادة خاماً في خانة المادة، ووقوداً (فحم أو خشب) في خانة الوقود."
			elseif not smelt then
				furnaceHint.Text = "هذه المادة لا تُصهر."
			elseif (stationData.burn or 0) <= 0 and Smelting.fuelValue(if stackOf(stationData.fuel) then (stackOf(stationData.fuel) :: Inventory.Stack).id else nil) <= 0 then
				furnaceHint.Text = "الفرن بحاجة إلى وقود."
			else
				furnaceHint.Text = string.format("يصهر %s ← %s. الفرن يعمل حتى وأنت بعيد عنه.",
					Items.name(input.id), Items.name(smelt.out))
			end
		end

	elseif activeTab == "chest" then
		if stationData then
			local slots = stationData.slots or {}
			local used = 0
			for i, view in chestSlots do
				local stack = stackOf(slots[i])
				if stack then used += 1 end
				paintSlot(view, stack)
			end
			chestHint.Text = string.format("ممتلئ: %d / %d خانة", used, #chestSlots)
		end

	elseif activeTab == "upgrade" or activeTab == "enchant" then
		refreshModTab(activeTab)
	end

	if tooltip.Visible then
		local mouse = UserInputService:GetMouseLocation()
		local inset = GuiService:GetGuiInset()
		tooltip.Position = UDim2.fromOffset(mouse.X + inset.X + 18, mouse.Y + inset.Y + 12)
	end
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Theme — لغة الواجهة البكسلية.

	كل لوحة وزر وخانة تُرسم بإطار تسعي (9-slice) مولّد بكسلاً بكسلاً: حافة
	مشطوفة فاتحة أعلى/يسار وداكنة أسفل/يمين، فتبقى الحواف حادّة وسُمكها ثابت
	مهما تمدّد العنصر.

	ملاحظة عن الخطوط: النص العربي يحتاج خطاً يدعم العربية، وخطوط روبلوكس
	البكسلية (Arcade) لا تدعمها. لذلك: أرقام الواجهة بخط بكسلي، والنصوص
	العربية بخط واضح — وهو حلّ وسط مقصود لا إهمال.
]]

local Atlas = require(script.Parent.Parent.Atlas)

local Theme = {}

Theme.font = Enum.Font.GothamMedium
Theme.fontBold = Enum.Font.GothamBold
Theme.fontNumber = Enum.Font.Arcade -- للأرقام فقط (لا يدعم العربية)

Theme.colors = {
	panel = Color3.fromRGB(34, 32, 44),
	panelLight = Color3.fromRGB(62, 60, 78),
	slot = Color3.fromRGB(52, 50, 66),
	slotHover = Color3.fromRGB(74, 72, 94),
	slotActive = Color3.fromRGB(120, 150, 220),
	border = Color3.fromRGB(10, 9, 14),
	text = Color3.fromRGB(238, 238, 244),
	textDim = Color3.fromRGB(166, 166, 182),
	hp = Color3.fromRGB(226, 64, 74),
	hpBack = Color3.fromRGB(78, 26, 30),
	mana = Color3.fromRGB(86, 124, 236),
	manaBack = Color3.fromRGB(28, 38, 84),
	food = Color3.fromRGB(224, 158, 78),
	foodBack = Color3.fromRGB(78, 52, 24),
	good = Color3.fromRGB(120, 226, 140),
	bad = Color3.fromRGB(232, 96, 96),
	gold = Color3.fromRGB(246, 210, 96),
}

function Theme.new(className: string, props: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if parent then instance.Parent = parent end
	return instance
end

-- خلفية تسعية تملأ العنصر الأب
function Theme.slice(parent: GuiObject, piece: string, zindex: number): ImageLabel
	local image = Instance.new("ImageLabel")
	image.Name = "Skin"
	image.BackgroundTransparency = 1
	image.BorderSizePixel = 0
	image.Size = UDim2.fromScale(1, 1)
	image.ZIndex = zindex
	image.Parent = parent
	Atlas.applySlice(image, piece)
	return image
end

-- متوافقة مع النداءات القديمة: لا زوايا دائرية في أسلوب البكسل
function Theme.corner(_instance: GuiObject, _radius: number?) end

function Theme.stroke(instance: GuiObject, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Theme.colors.border
	stroke.Thickness = thickness or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
	return stroke
end

function Theme.padding(instance: GuiObject, amount: number): UIPadding
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, amount)
	padding.PaddingBottom = UDim.new(0, amount)
	padding.PaddingLeft = UDim.new(0, amount)
	padding.PaddingRight = UDim.new(0, amount)
	padding.Parent = instance
	return padding
end

-- لوحة: إطار شفاف تملؤه خلفية تسعية، فتبقى الأبناء كما هي
function Theme.panel(parent: Instance, name: string): Frame
	local frame = Theme.new("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 30,
	}, parent)
	Theme.slice(frame, "panel", 29)
	return frame
end

function Theme.label(parent: Instance, text: string, size: number, color: Color3?): TextLabel
	return Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.font,
		Text = text,
		TextSize = size,
		TextColor3 = color or Theme.colors.text,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 32,
	}, parent)
end

-- تسمية رقمية بخط بكسلي
function Theme.number(parent: Instance, text: string, size: number, color: Color3?): TextLabel
	return Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.fontNumber,
		Text = text,
		TextSize = size,
		TextColor3 = color or Theme.colors.text,
		TextStrokeTransparency = 0.2,
		ZIndex = 33,
	}, parent)
end

function Theme.button(parent: Instance, text: string, size: UDim2, position: UDim2): TextButton
	local button = Theme.new("TextButton", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.fontBold,
		Text = text,
		TextSize = 14,
		TextColor3 = Theme.colors.text,
		Size = size,
		Position = position,
		AutoButtonColor = false,
		ZIndex = 33,
	}, parent)
	local skin = Theme.slice(button, "button", 32)

	button.MouseEnter:Connect(function()
		skin.ImageColor3 = Color3.fromRGB(150, 150, 170)
	end)
	button.MouseLeave:Connect(function()
		skin.ImageColor3 = Color3.fromRGB(255, 255, 255)
	end)
	return button
end

-- خانة مخزون بكسلية
export type Slot = { button: TextButton, skin: ImageLabel }

function Theme.slotButton(parent: Instance, size: number, position: UDim2): Slot
	local button = Theme.new("TextButton", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(size, size),
		Position = position,
		ZIndex = 32,
	}, parent)
	local skin = Theme.slice(button, "slot", 31)
	return { button = button, skin = skin }
end

function Theme.setSlotState(slot: Slot, state: string)
	if state == "active" then
		Atlas.applySlice(slot.skin, "slot_active")
		slot.skin.ImageColor3 = Color3.fromRGB(255, 255, 255)
	else
		Atlas.applySlice(slot.skin, "slot")
		slot.skin.ImageColor3 = if state == "hover"
			then Color3.fromRGB(190, 190, 210)
			else Color3.fromRGB(255, 255, 255)
	end
end

-- ===== الأشرطة =====

export type Bar = { root: Frame, fill: ImageLabel, label: TextLabel }

function Theme.bar(parent: Instance, back: Color3, front: Color3, width: number, height: number): Bar
	local root = Theme.new("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(width, height),
		ZIndex = 31,
	}, parent)

	local frame = Theme.slice(root, "bar_frame", 31)
	frame.ImageColor3 = back

	local fill = Theme.new("ImageLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
		ImageColor3 = front,
		ZIndex = 32,
	}, root)
	Atlas.applyUI(fill, "bar_fill")
	fill.ScaleType = Enum.ScaleType.Stretch

	local label = Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.fontNumber,
		Text = "",
		TextSize = math.max(10, height - 6),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextStrokeTransparency = 0.25,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 34,
	}, root)

	return { root = root, fill = fill, label = label }
end

function Theme.setBar(bar: Bar, value: number, max: number, text: string?)
	local ratio = math.clamp(value / math.max(1, max), 0, 1)
	bar.fill.Size = UDim2.new(ratio, -4, 1, -4)
	bar.label.Text = text or string.format("%d / %d", math.floor(value), math.floor(max))
end

-- ===== أيقونة عنصر من الأطلس =====

function Theme.itemIcon(parent: Instance, size: number, zindex: number): ImageLabel
	local icon = Theme.new("ImageLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromOffset(size, size),
		Visible = false,
		ZIndex = zindex,
	}, parent)
	Atlas.apply(icon, "items")
	return icon
end

function Theme.setItemIcon(icon: ImageLabel, itemId: string?)
	if not itemId then
		icon.Visible = false
		return
	end
	icon.Visible = true
	Atlas.setRect(icon, Atlas.itemRect(itemId))
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="53">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">0</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>

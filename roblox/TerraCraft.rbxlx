  <Item class="ServerScriptService" referent="25">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="26">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	نقطة إقلاع الخادم.
	الترتيب مهم: الشبكة -> الحفظ -> الوقت -> العالم -> اللاعبون -> الكيانات -> التصنيع.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

-- أنشئ قنوات الشبكة قبل أي شيء آخر
Net.init()

local Services = require(script.Services)

Services.Save = require(script.SaveService)
Services.Time = require(script.TimeService)
Services.World = require(script.WorldService)
Services.Player = require(script.PlayerService)
Services.Entity = require(script.EntityService)
Services.Craft = require(script.CraftService)
Services.Station = require(script.StationService)

-- لا شخصيات Roblox: اللعبة ثنائية الأبعاد بالكامل عبر الواجهة.
-- نضبطها هنا لا في ملف Rojo لأنها خاصية على خدمة Players وليست StarterPlayer.
Players.CharacterAutoLoads = false
for _, player in Players:GetPlayers() do
	if player.Character then
		player.Character:Destroy()
	end
end

Services.Time.start()
Services.World.start()
Services.Player.start()
Services.Entity.start()
Services.Craft.start()
Services.Station.start()

print(string.format(
	"[TerraCraft] الخادم جاهز | البذرة: %d | نقطة الظهور: %d, %d",
	Services.World.getSeed(),
	math.floor((select(1, Services.World.getSpawn()))),
	math.floor((select(2, Services.World.getSpawn())))
))
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">CraftService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	CraftService — التصنيع ومتجر التاجر.
	محطات التصنيع تُكتشف من العالم حول اللاعب (لا يثق الخادم بما يرسله العميل).
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Inventory = require(Shared.Inventory)
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local Recipes = require(Shared.Recipes)
local Util = require(Shared.Util)
local World = require(Shared.World)

local Services = require(script.Parent.Services)

local CraftService = {}

local STATION_RANGE = 7

-- المحطات المتاحة حول اللاعب
function CraftService.stationsNear(x: number, y: number): { [string]: boolean }
	local found: { [string]: boolean } = {}
	local world = Services.World.getWorld()
	local cx, cy = math.floor(x), math.floor(y)
	for ty = cy - STATION_RANGE, cy + STATION_RANGE do
		for tx = cx - STATION_RANGE, cx + STATION_RANGE do
			local block = Blocks.get(World.fg(world, tx, ty))
			if block.station then
				found[block.station] = true
			end
		end
	end
	return found
end

local function handleCraft(player: Player, key: string, times: number?)
	local state = Services.Player.get(player)
	if not state or state.dead then return end
	if type(key) ~= "string" then return end

	local recipe = Recipes.byKey[key]
	if not recipe then return end

	local stations = CraftService.stationsNear(state.body.x, state.body.y)
	if recipe.station and not stations[recipe.station] then
		Net.get("Notify"):FireClient(player, { text = "تحتاج محطة تصنيع مناسبة", color = { 230, 170, 90 } })
		return
	end

	local count = math.clamp(math.floor(tonumber(times) or 1), 1, 50)
	local crafted = 0
	for _ = 1, count do
		if not Inventory.craft(state.slots, recipe) then break end
		crafted += 1
	end

	if crafted > 0 then
		Services.Player.syncInventory(player)
		Net.get("Fx"):FireClient(player, {
			kind = "craft", x = state.body.x, y = state.body.y,
			item = recipe.out.id, count = recipe.out.n * crafted,
		})
	else
		Net.get("Notify"):FireClient(player, { text = "المواد غير كافية", color = { 230, 120, 100 } })
	end
end

-- ===== المتجر =====
-- التاجر متاح قرب نقطة الظهور. الشراء بالعملات التي تسقط من الوحوش.

local SHOP_STOCK = {
	{ id = "torch", price = 2 },
	{ id = "arrow", price = 3 },
	{ id = "rope_placeholder", price = 0 }, -- محجوز
	{ id = "health_potion", price = 45 },
	{ id = "mana_potion", price = 40 },
	{ id = "apple", price = 8 },
	{ id = "bread", price = 14 },
	{ id = "glass", price = 10 },
	{ id = "wood_bow", price = 90 },
	{ id = "iron_bar", price = 65 },
	{ id = "recall_stone", price = 120 },
	{ id = "life_crystal", price = 900 },
}

local stock = {}
for _, entry in SHOP_STOCK do
	if Items.get(entry.id) then
		table.insert(stock, entry)
	end
end

function CraftService.shopStock()
	return stock
end

local function nearTrader(state: any): boolean
	return Util.dist(state.body.x, state.body.y, state.spawnX, state.spawnY) < 26
end

local function handleShop(player: Player, action: string, id: string, qty: number?)
	local state = Services.Player.get(player)
	if not state or state.dead then return end

	if action == "open" then
		Net.get("Shop"):FireClient(player, {
			open = nearTrader(state),
			stock = stock,
			coins = Inventory.count(state.slots, "coin"),
		})
		return
	end

	if not nearTrader(state) then
		Net.get("Notify"):FireClient(player, { text = "التاجر قرب نقطة الظهور فقط", color = { 220, 180, 100 } })
		return
	end

	local amount = math.clamp(math.floor(tonumber(qty) or 1), 1, 99)

	if action == "buy" then
		local entry = nil
		for _, candidate in stock do
			if candidate.id == id then
				entry = candidate
				break
			end
		end
		if not entry or entry.price <= 0 then return end

		local total = entry.price * amount
		if Inventory.count(state.slots, "coin") < total then
			Net.get("Notify"):FireClient(player, { text = "العملات غير كافية", color = { 230, 120, 100 } })
			return
		end
		if not Inventory.hasRoom(state.slots, id, amount) then
			Net.get("Notify"):FireClient(player, { text = "المخزون ممتلئ", color = { 230, 120, 100 } })
			return
		end
		Inventory.remove(state.slots, "coin", total)
		Inventory.add(state.slots, id, amount)
		Services.Player.syncInventory(player)
		Net.get("Shop"):FireClient(player, { open = true, stock = stock, coins = Inventory.count(state.slots, "coin") })
		return
	end

	if action == "sell" then
		local item = Items.get(id)
		if not item or item.value <= 0 or id == "coin" then return end
		local have = Inventory.count(state.slots, id)
		amount = math.min(amount, have)
		if amount <= 0 then return end
		local payout = math.max(1, math.floor(item.value * 0.4)) * amount
		if not Inventory.remove(state.slots, id, amount) then return end
		Inventory.add(state.slots, "coin", payout)
		Services.Player.syncInventory(player)
		Net.get("Shop"):FireClient(player, { open = true, stock = stock, coins = Inventory.count(state.slots, "coin") })
		return
	end
end

function CraftService.start()
	Net.get("Craft").OnServerEvent:Connect(handleCraft)
	Net.get("Shop").OnServerEvent:Connect(handleShop)
end

return CraftService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">EntityService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	EntityService — كل ما يتحرك في العالم عدا اللاعبين:
	الوحوش، الأغراض الساقطة، المقذوفات، والزعماء.

	المحاكاة كاملة على الخادم بمعدل 20 مرة/ثانية، والبثّ 14 مرة/ثانية
	للاعبين القريبين فقط، مع استيفاء (interpolation) على العميل.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Config = require(Shared.Config)
local Inventory = require(Shared.Inventory)
local Items = require(Shared.Items)
local Mobs = require(Shared.Mobs)
local Net = require(Shared.Net)
local Physics = require(Shared.Physics)
local Upgrades = require(Shared.Upgrades)
local Util = require(Shared.Util)
local World = require(Shared.World)
local WorldGen = require(Shared.WorldGen)

local Services = require(script.Parent.Services)

local EntityService = {}

export type Entity = {
	id: number,
	kind: string, -- mob | item | proj
	type: string,
	body: Physics.Body,
	hp: number,
	maxHp: number,
	def: Mobs.MobDef?,
	facing: number,
	anim: string,
	age: number,
	life: number,
	target: Player?,
	attackCd: number,
	jumpCd: number,
	wander: number,
	owner: Player?,
	damage: number,
	knockback: number,
	pierce: number,
	hitList: { [number]: boolean },
	itemId: string?,
	itemUpgrade: Upgrades.Upgrade?,
	count: number,
	pickupDelay: number,
	boss: boolean,
	phase: number,
	stateTimer: number,
	moveDir: number,
	dead: boolean,
}

local entities: { [number]: Entity } = {}
local nextId = 1
local bossId: number? = nil
local spawnTimer = 0

local function world(): World.World
	return Services.World.getWorld()
end

-- ===== إنشاء الكيانات =====

local function register(entity: Entity): Entity
	entities[entity.id] = entity
	return entity
end

local function newEntity(kind: string, typeId: string, x: number, y: number, w: number, h: number): Entity
	local id = nextId
	nextId += 1
	return {
		id = id,
		kind = kind,
		type = typeId,
		body = Physics.newBody(x, y, w, h),
		hp = 1,
		maxHp = 1,
		def = nil,
		facing = 1,
		anim = "idle",
		age = 0,
		life = math.huge,
		target = nil,
		attackCd = 0,
		jumpCd = 0,
		wander = 0,
		owner = nil,
		damage = 0,
		knockback = 0,
		pierce = 0,
		hitList = {},
		itemId = nil,
		itemUpgrade = nil,
		count = 1,
		pickupDelay = 0,
		boss = false,
		phase = 1,
		stateTimer = 0,
		moveDir = 1,
		dead = false,
	}
end

function EntityService.spawnMob(typeId: string, x: number, y: number, hpScale: number?): Entity?
	local def = Mobs.get(typeId)
	if not def then return nil end
	local entity = newEntity("mob", typeId, x, y, def.w, def.h)
	entity.def = def
	entity.maxHp = math.floor(def.hp * (hpScale or 1))
	entity.hp = entity.maxHp
	entity.damage = def.damage
	entity.boss = def.boss == true
	entity.body.stepUp = true
	return register(entity)
end

function EntityService.spawnBoss(typeId: string, x: number, y: number)
	if bossId then return end
	local playerCount = math.max(1, #Players:GetPlayers())
	local entity = EntityService.spawnMob(typeId, x, y, 1 + (playerCount - 1) * 0.55)
	if not entity then return end
	bossId = entity.id
	local def = entity.def
	Net.get("Boss"):FireAllClients({
		active = true, id = entity.id,
		name = if def then def.name else "زعيم",
		hp = entity.hp, maxHp = entity.maxHp,
	})
	Net.get("Notify"):FireAllClients({
		text = ((def and def.name) or "زعيم") .. " استيقظ!",
		color = { 220, 60, 70 }, big = true,
	})
end

function EntityService.bossActive(): boolean
	return bossId ~= nil
end

function EntityService.spawnItem(x: number, y: number, itemId: string, count: number, vx: number?, vy: number?, owner: Player?, upgrade: Upgrades.Upgrade?): Entity?
	if not Items.get(itemId) or count <= 0 then return nil end

	-- ادمج مع غرض قريب من النوع نفسه (لا ندمج المطوّر أبداً)
	for _, other in entities do
		if other.kind == "item" and other.itemId == itemId and not other.dead
			and other.itemUpgrade == nil and upgrade == nil then
			if Util.dist2(other.body.x, other.body.y, x, y) < 9 then
				local max = Items.maxStack(itemId)
				if other.count + count <= max then
					other.count += count
					return other
				end
			end
		end
	end

	local entity = newEntity("item", itemId, x, y, 0.7, 0.7)
	entity.itemId = itemId
	entity.itemUpgrade = upgrade
	entity.count = count
	entity.life = Config.ITEM_DESPAWN
	entity.pickupDelay = if owner then Config.PICKUP_DELAY * 2 else Config.PICKUP_DELAY
	entity.owner = owner
	entity.body.vx = vx or (math.random() - 0.5) * 5
	entity.body.vy = vy or -6
	return register(entity)
end

function EntityService.spawnProjectile(typeId: string, x: number, y: number, vx: number, vy: number, damage: number, knockback: number, owner: Player?): Entity?
	local def = Mobs.projectiles[typeId]
	if not def then return nil end
	local entity = newEntity("proj", typeId, x, y, def.w, def.h)
	entity.body.vx = vx
	entity.body.vy = vy
	entity.body.stepUp = false
	entity.damage = damage
	entity.knockback = knockback
	entity.pierce = def.pierce
	entity.life = def.life
	entity.owner = owner
	entity.facing = if vx >= 0 then 1 else -1
	return register(entity)
end

-- هل يشغل وحش هذه البلاطة؟ (لمنع البناء داخله)
function EntityService.blockedBy(tx: number, ty: number): boolean
	for _, entity in entities do
		if entity.kind == "mob" and not entity.dead then
			local body = entity.body
			if math.abs(body.x - (tx + 0.5)) < (body.w / 2 + 0.5)
				and math.abs(body.y - (ty + 0.5)) < (body.h / 2 + 0.5) then
				return true
			end
		end
	end
	return false
end

-- ===== الضرر =====

local function dropLoot(entity: Entity)
	local def = entity.def
	if not def then return end
	for _, drop in def.drops do
		if math.random() <= drop.chance then
			local count = math.random(drop.min, drop.max)
			if count > 0 then
				EntityService.spawnItem(entity.body.x, entity.body.y, drop.id, count)
			end
		end
	end
	local coins = math.random(def.coins.min, def.coins.max)
	if coins > 0 then
		EntityService.spawnItem(entity.body.x, entity.body.y, "coin", coins)
	end
end

function EntityService.damageMob(entity: Entity, amount: number, kbx: number, kby: number, byPlayer: Player?, crit: boolean?)
	if entity.dead or entity.kind ~= "mob" then return end
	local def = entity.def
	local defense = if def then def.defense else 0
	local final = math.max(1, amount - defense * 0.5)
	entity.hp -= final

	local resist = if def then def.knockbackResist else 0
	entity.body.vx += kbx * (1 - resist)
	entity.body.vy += kby * (1 - resist)

	Net.get("Hit"):FireAllClients({
		kind = "mob", x = entity.body.x, y = entity.body.y - entity.body.h / 2,
		amount = math.floor(final + 0.5), crit = crit == true, id = entity.id,
	})

	if entity.boss and bossId == entity.id then
		Net.get("Boss"):FireAllClients({
			active = true, id = entity.id,
			name = if def then def.name else "زعيم",
			hp = math.max(0, entity.hp), maxHp = entity.maxHp,
		})
	end

	if entity.hp <= 0 then
		entity.dead = true
		dropLoot(entity)
		Net.get("Fx"):FireAllClients({ kind = "mob_death", x = entity.body.x, y = entity.body.y, mob = entity.type })

		if byPlayer then
			local state = Services.Player.get(byPlayer)
			if state then
				state.kills += 1
			end
		end

		if entity.boss and bossId == entity.id then
			bossId = nil
			Net.get("Boss"):FireAllClients({ active = false })
			Net.get("Notify"):FireAllClients({
				text = ((def and def.name) or "الزعيم") .. " هُزم!",
				color = { 120, 230, 140 }, big = true,
			})
		end
	end
end

-- ضربة قريبة من لاعب
-- يُعيد مجموع الضرر الموقع (يحتاجه امتصاص الحياة في PlayerService)
function EntityService.meleeHit(player: Player, hx: number, hy: number, reach: number, damage: number, knockback: number, dx: number, dy: number, crit: boolean): number
	local hit = false
	local dealt = 0
	for _, entity in entities do
		if entity.kind == "mob" and not entity.dead then
			local body = entity.body
			if Util.dist(body.x, body.y, hx, hy) <= reach + math.max(body.w, body.h) / 2 then
				EntityService.damageMob(entity, damage, dx * knockback * 3, dy * knockback * 1.4 - 5, player, crit)
				dealt += damage
				hit = true
			end
		end
	end

	-- الضربة تكسر خيوط العنكبوت والنباتات الهشة أمام اللاعب
	if not hit then
		local tx, ty = math.floor(hx), math.floor(hy)
		local id = World.fg(world(), tx, ty)
		local block = Blocks.get(id)
		if block.fragile and id ~= Blocks.ID.AIR then
			Services.World.setTile(tx, ty, Blocks.ID.AIR, World.bg(world(), tx, ty))
			local drop = Items.fromBlock(id)
			if drop then EntityService.spawnItem(tx + 0.5, ty + 0.5, drop, 1) end
		end
	end

	return dealt
end

-- ===== الذكاء الاصطناعي =====

local function nearestPlayer(x: number, y: number, maxDist: number): (Player?, number)
	local best: Player? = nil
	local bestDist = maxDist
	for player, state in Services.Player.all() do
		if not state.dead then
			local d = Util.dist(x, y, state.body.x, state.body.y)
			if d < bestDist then
				best = player
				bestDist = d
			end
		end
	end
	return best, bestDist
end

local function tryAttackPlayer(entity: Entity, dt: number)
	entity.attackCd -= dt
	if entity.attackCd > 0 then return end
	local def = entity.def
	if not def then return end

	for player, state in Services.Player.all() do
		if not state.dead then
			local body = state.body
			if math.abs(body.x - entity.body.x) < (body.w + entity.body.w) / 2 + 0.2
				and math.abs(body.y - entity.body.y) < (body.h + entity.body.h) / 2 + 0.2 then
				entity.attackCd = def.attackCd
				local dir = Util.sign(body.x - entity.body.x)
				if dir == 0 then dir = entity.facing end
				Services.Player.damage(player, entity.damage, def.name, dir * 9, -8)

				-- صفة «شائك» على الدرع ترتدّ جزءاً من الضرر
				local thorns = Upgrades.armorBonus(state.armor).thorns
				if thorns > 0 then
					EntityService.damageMob(entity, entity.damage * thorns, -dir * 4, -3, player, false)
				end
				return
			end
		end
	end
end

local function aiWalker(entity: Entity, dt: number, climb: boolean)
	local def = entity.def
	if not def then return end
	local target = nearestPlayer(entity.body.x, entity.body.y, def.detect)
	local body = entity.body

	if target then
		local state = Services.Player.get(target)
		if state then
			local dir = Util.sign(state.body.x - body.x)
			entity.facing = if dir == 0 then entity.facing else dir
			body.vx = Util.approach(body.vx, dir * def.speed, 40 * dt)

			-- اقفز فوق العوائق أو الفجوات
			entity.jumpCd -= dt
			local aheadX = math.floor(body.x + dir * (body.w / 2 + 0.6))
			local feetY = math.floor(body.y + body.h / 2 - 0.1)
			local blockedAhead = Blocks.isSolid(World.fg(world(), aheadX, feetY))
			local gapAhead = not Blocks.isSolid(World.fg(world(), aheadX, feetY + 1))
			local higher = state.body.y < body.y - 2

			if body.onGround and entity.jumpCd <= 0 and (blockedAhead or gapAhead or higher) then
				body.vy = -def.jump
				entity.jumpCd = 0.45
			end

			-- العناكب تتسلق الجدران
			if climb and blockedAhead and not body.onGround then
				body.vy = math.min(body.vy, -def.speed * 0.7)
			end
		end
	else
		-- تجوال
		entity.wander -= dt
		if entity.wander <= 0 then
			entity.wander = math.random(120, 320) / 100
			entity.moveDir = if math.random() < 0.5 then -1 else 1
			if math.random() < 0.3 then entity.moveDir = 0 end
		end
		body.vx = Util.approach(body.vx, entity.moveDir * def.speed * 0.4, 20 * dt)
		if entity.moveDir ~= 0 then entity.facing = entity.moveDir end
	end

	entity.anim = if math.abs(body.vx) > 0.5 then "walk" else "idle"
	tryAttackPlayer(entity, dt)
end

local function aiJumper(entity: Entity, dt: number)
	local def = entity.def
	if not def then return end
	local body = entity.body
	local target = nearestPlayer(body.x, body.y, def.detect)

	entity.jumpCd -= dt
	if body.onGround then
		body.vx = Util.approach(body.vx, 0, 30 * dt)
		if entity.jumpCd <= 0 then
			entity.jumpCd = math.random(80, 170) / 100
			local dir = entity.moveDir
			if target then
				local state = Services.Player.get(target)
				if state then dir = Util.sign(state.body.x - body.x) end
			else
				dir = if math.random() < 0.5 then -1 else 1
			end
			if dir == 0 then dir = 1 end
			entity.facing = dir
			entity.moveDir = dir
			body.vy = -def.jump
			body.vx = dir * def.speed
		end
	end

	entity.anim = if body.onGround then "idle" else "jump"
	tryAttackPlayer(entity, dt)
end

local function aiFlyer(entity: Entity, dt: number)
	local def = entity.def
	if not def then return end
	local body = entity.body -- الطيران: الجاذبية معطّلة في Physics.step عبر noGravity
	local target, dist = nearestPlayer(body.x, body.y, def.detect)

	if target then
		local state = Services.Player.get(target)
		if state then
			local dx = state.body.x - body.x
			local dy = (state.body.y - 0.5) - body.y
			local len = math.max(0.001, math.sqrt(dx * dx + dy * dy))
			local wobble = math.sin(entity.age * 3.2) * 0.35
			body.vx = Util.approach(body.vx, dx / len * def.speed, 30 * dt)
			body.vy = Util.approach(body.vy, dy / len * def.speed + wobble * def.speed, 30 * dt)
			entity.facing = if dx >= 0 then 1 else -1

			-- المقذوفات (عفريت الحمم)
			if def.projectile then
				entity.attackCd -= dt
				if entity.attackCd <= 0 and dist < def.detect * 0.8
					and Physics.lineOfSight(world(), body.x, body.y, state.body.x, state.body.y) then
					entity.attackCd = def.attackCd
					local speed = 22
					EntityService.spawnProjectile(def.projectile, body.x, body.y, dx / len * speed, dy / len * speed, def.damage, 4, nil)
				end
			end
		end
	else
		entity.wander -= dt
		if entity.wander <= 0 then
			entity.wander = math.random(100, 260) / 100
			entity.moveDir = if math.random() < 0.5 then -1 else 1
		end
		body.vx = Util.approach(body.vx, entity.moveDir * def.speed * 0.35, 12 * dt)
		body.vy = Util.approach(body.vy, math.sin(entity.age * 1.6) * 2.5, 12 * dt)
		entity.facing = entity.moveDir
	end

	entity.anim = "fly"
	tryAttackPlayer(entity, dt)
end

local function aiShooter(entity: Entity, dt: number)
	local def = entity.def
	if not def then return end
	local body = entity.body
	local target, dist = nearestPlayer(body.x, body.y, def.detect)

	if target then
		local state = Services.Player.get(target)
		if state then
			local dir = Util.sign(state.body.x - body.x)
			entity.facing = if dir == 0 then entity.facing else dir

			-- يحافظ على مسافة متوسطة
			local desired = 9
			if dist < desired - 2 then
				body.vx = Util.approach(body.vx, -dir * def.speed, 40 * dt)
			elseif dist > desired + 3 then
				body.vx = Util.approach(body.vx, dir * def.speed, 40 * dt)
			else
				body.vx = Util.approach(body.vx, 0, 40 * dt)
			end

			entity.jumpCd -= dt
			local aheadX = math.floor(body.x + Util.sign(body.vx) * (body.w / 2 + 0.6))
			local feetY = math.floor(body.y + body.h / 2 - 0.1)
			if body.onGround and entity.jumpCd <= 0 and Blocks.isSolid(World.fg(world(), aheadX, feetY)) then
				body.vy = -def.jump
				entity.jumpCd = 0.5
			end

			entity.attackCd -= dt
			if entity.attackCd <= 0 and def.projectile
				and Physics.lineOfSight(world(), body.x, body.y - 0.5, state.body.x, state.body.y) then
				entity.attackCd = def.attackCd
				local dx = state.body.x - body.x
				local dy = state.body.y - body.y
				local len = math.max(0.001, math.sqrt(dx * dx + dy * dy))
				local speed = 26
				EntityService.spawnProjectile(def.projectile, body.x + dx / len, body.y - 0.4, dx / len * speed, dy / len * speed - 3, def.damage, 3, nil)
			end
		end
	else
		aiWalker(entity, dt, false)
		return
	end

	entity.anim = if math.abs(body.vx) > 0.5 then "walk" else "idle"
	tryAttackPlayer(entity, dt)
end

local function aiBoss(entity: Entity, dt: number)
	local def = entity.def
	if not def then return end
	local body = entity.body
	local target = nearestPlayer(body.x, body.y, 400)
	entity.stateTimer -= dt

	local hpPct = entity.hp / entity.maxHp
	local newPhase = if hpPct < 0.35 then 3 elseif hpPct < 0.7 then 2 else 1
	if newPhase ~= entity.phase then
		entity.phase = newPhase
		entity.stateTimer = 0
		Net.get("Fx"):FireAllClients({ kind = "boss_phase", x = body.x, y = body.y, phase = newPhase })
	end

	if not target then
		-- لا لاعبين: يختفي الزعيم
		body.vy = -8
		entity.life = math.min(entity.life, 6)
		return
	end

	local state = Services.Player.get(target)
	if not state then return end
	local dx = state.body.x - body.x
	local dy = state.body.y - body.y
	local len = math.max(0.001, math.sqrt(dx * dx + dy * dy))
	entity.facing = if dx >= 0 then 1 else -1

	local speed = def.speed * (1 + (entity.phase - 1) * 0.35)

	if entity.anim == "charge" then
		-- اندفاع مستقيم
		if entity.stateTimer <= 0 then
			entity.anim = "hover"
			entity.stateTimer = 2.2 - entity.phase * 0.35
		end
	elseif entity.stateTimer <= 0 then
		local roll = math.random()
		if roll < 0.45 then
			entity.anim = "charge"
			entity.stateTimer = 1.1
			body.vx = dx / len * speed * 2.1
			body.vy = dy / len * speed * 2.1
			Net.get("Fx"):FireAllClients({ kind = "boss_charge", x = body.x, y = body.y })
		elseif roll < 0.8 and entity.phase >= 2 then
			-- وابل مقذوفات
			for i = -2, 2 do
				local angle = math.atan2(dy, dx) + i * 0.18
				EntityService.spawnProjectile("blood_shot", body.x, body.y,
					math.cos(angle) * 24, math.sin(angle) * 24, def.damage * 0.7, 3, nil)
			end
			entity.anim = "hover"
			entity.stateTimer = 1.8
		else
			-- استدعاء أتباع
			if entity.phase >= 2 then
				for i = 1, 2 do
					EntityService.spawnMob("demon_eye", body.x + math.random(-4, 4), body.y + math.random(-3, 3))
				end
			end
			entity.anim = "hover"
			entity.stateTimer = 2.4
		end
	else
		-- تحويم حول اللاعب
		local orbit = math.sin(entity.age * 1.4) * 5
		local targetX = state.body.x - dx / len * 8
		local targetY = state.body.y - 9 + orbit
		body.vx = Util.approach(body.vx, (targetX - body.x) * 1.8, 60 * dt)
		body.vy = Util.approach(body.vy, (targetY - body.y) * 1.8, 60 * dt)
		body.vx = math.clamp(body.vx, -speed, speed)
		body.vy = math.clamp(body.vy, -speed, speed)
		entity.anim = "hover"
	end

	tryAttackPlayer(entity, dt)
end

-- ===== التحديث =====

local function updateMob(entity: Entity, dt: number)
	local def = entity.def
	if not def then return end

	if def.ai == "walker" then
		aiWalker(entity, dt, false)
	elseif def.ai == "climber" then
		aiWalker(entity, dt, true)
	elseif def.ai == "jumper" then
		aiJumper(entity, dt)
	elseif def.ai == "flyer" then
		aiFlyer(entity, dt)
	elseif def.ai == "shooter" then
		aiShooter(entity, dt)
	elseif def.ai == "boss" then
		aiBoss(entity, dt)
	end

	local flying = def.ai == "flyer" or def.ai == "boss"
	Physics.step(world(), entity.body, dt, {
		noGravity = flying,
		ignorePlatforms = flying,
	})

	if not flying then
		-- احتكاك أرضي
		if entity.body.onGround then
			entity.body.vx = Util.approach(entity.body.vx, 0, 12 * dt)
		end
	end

	-- ضرر البيئة (الحمم تؤذي غير سكان الجحيم)
	if def.layer ~= "hell" then
		local burn = Physics.contactDamage(world(), entity.body)
		if burn > 0 then
			entity.hp -= burn * dt * 4
			if entity.hp <= 0 then
				entity.dead = true
				dropLoot(entity)
			end
		end
	end

	-- الوحوش الليلية تحترق عند الفجر في العراء
	if def.flee and not Services.Time.isNight() then
		local surface = World.surfaceY(world(), math.floor(entity.body.x))
		if entity.body.y < surface then
			entity.hp -= 12 * dt
			if entity.hp <= 0 then
				entity.dead = true
				Net.get("Fx"):FireAllClients({ kind = "burn_away", x = entity.body.x, y = entity.body.y })
			end
		end
	end
end

local function updateItem(entity: Entity, dt: number)
	Physics.step(world(), entity.body, dt, {})
	if entity.body.onGround then
		entity.body.vx = Util.approach(entity.body.vx, 0, 22 * dt)
	end

	entity.pickupDelay -= dt
	if entity.pickupDelay > 0 then return end

	for player, state in Services.Player.all() do
		if not state.dead then
			local d = Util.dist(entity.body.x, entity.body.y, state.body.x, state.body.y)
			if d < Config.PICKUP_RANGE then
				local itemId = entity.itemId
				if itemId then
					local leftover
					if entity.itemUpgrade then
						-- غرض مطوّر: يحتاج خانة كاملة ولا يندمج
						local placed = Inventory.addStack(state.slots, {
							id = itemId, n = entity.count, up = entity.itemUpgrade,
						})
						leftover = if placed then 0 else entity.count
					else
						leftover = Inventory.add(state.slots, itemId, entity.count)
					end
					local picked = entity.count - leftover
					if picked > 0 then
						entity.count = leftover
						Services.Player.syncInventory(player)
						Net.get("Fx"):FireClient(player, {
							kind = "pickup", x = entity.body.x, y = entity.body.y,
							item = itemId, count = picked,
						})
						if leftover <= 0 then
							entity.dead = true
						end
					end
				end
				break
			elseif d < Config.PICKUP_RANGE * 3 then
				-- انجذاب نحو اللاعب
				local dx = state.body.x - entity.body.x
				local dy = state.body.y - entity.body.y
				local len = math.max(0.001, math.sqrt(dx * dx + dy * dy))
				entity.body.vx = Util.approach(entity.body.vx, dx / len * 14, 60 * dt)
				entity.body.vy = Util.approach(entity.body.vy, dy / len * 14, 60 * dt)
			end
		end
	end
end

local function updateProjectile(entity: Entity, dt: number)
	local def = Mobs.projectiles[entity.type]
	if not def then
		entity.dead = true
		return
	end

	local body = entity.body
	body.vy += def.gravity * dt
	body.x += body.vx * dt
	body.y += body.vy * dt
	entity.facing = if body.vx >= 0 then 1 else -1

	-- اصطدام بالبلاطات
	if Blocks.isSolid(World.fg(world(), math.floor(body.x), math.floor(body.y))) then
		entity.dead = true
		Net.get("Fx"):FireAllClients({ kind = "proj_hit", x = body.x, y = body.y, proj = entity.type })
		return
	end

	if not World.inBounds(math.floor(body.x), math.floor(body.y)) then
		entity.dead = true
		return
	end

	-- الإصابة
	if entity.owner then
		for _, other in entities do
			if other.kind == "mob" and not other.dead and not entity.hitList[other.id] then
				local ob = other.body
				if math.abs(ob.x - body.x) < (ob.w + body.w) / 2
					and math.abs(ob.y - body.y) < (ob.h + body.h) / 2 then
					entity.hitList[other.id] = true
					local dirX = Util.sign(body.vx)
					EntityService.damageMob(other, entity.damage, dirX * entity.knockback * 2.5, -4, entity.owner, false)
					if entity.type == "fire_arrow" then
						-- (تأثير الحرق يُحاكى كضرر إضافي فوري مبسّط)
						EntityService.damageMob(other, entity.damage * 0.4, 0, 0, entity.owner, false)
					end
					if entity.pierce > 0 then
						entity.pierce -= 1
					else
						entity.dead = true
						Net.get("Fx"):FireAllClients({ kind = "proj_hit", x = body.x, y = body.y, proj = entity.type })
						return
					end
				end
			end
		end
	else
		for player, state in Services.Player.all() do
			if not state.dead then
				local pb = state.body
				if math.abs(pb.x - body.x) < (pb.w + body.w) / 2
					and math.abs(pb.y - body.y) < (pb.h + body.h) / 2 then
					Services.Player.damage(player, entity.damage, "مقذوف", Util.sign(body.vx) * 6, -5)
					entity.dead = true
					Net.get("Fx"):FireAllClients({ kind = "proj_hit", x = body.x, y = body.y, proj = entity.type })
					return
				end
			end
		end
	end
end

-- ===== الظهور التلقائي =====

local function layerAt(y: number): string
	if y >= Config.HELL_Y then return "hell" end
	if y >= Config.CAVERN_Y then return "cavern" end
	if y >= Config.SURFACE + 40 then return "underground" end
	return "surface"
end

local function countMobs(): number
	local n = 0
	for _, entity in entities do
		if entity.kind == "mob" and not entity.dead and not entity.boss then n += 1 end
	end
	return n
end

local function trySpawnAround(state: any)
	local w = world()
	local seed = Services.World.getSeed()
	local px, py = math.floor(state.body.x), math.floor(state.body.y)

	for _ = 1, 8 do
		local angle = math.random() * math.pi * 2
		local radius = math.random(Config.MOB_SPAWN_MIN, Config.MOB_SPAWN_MAX)
		local x = px + math.floor(math.cos(angle) * radius)
		local y = py + math.floor(math.sin(angle) * radius * 0.7)

		if World.inBounds(x, y) and World.fg(w, x, y) == Blocks.ID.AIR then
			-- يجب أن يكون هناك مكان كافٍ
			if World.fg(w, x, y - 1) == Blocks.ID.AIR and World.fg(w, x, y - 2) == Blocks.ID.AIR then
				local layer = layerAt(y)
				local biome = WorldGen.biomeAt(seed, x)
				local night = Services.Time.isNight()
				local onGround = Blocks.isSolid(World.fg(w, x, y + 1))

				-- لا تظهر الوحوش في وضح النهار على السطح
				if layer == "surface" and not night then return end

				local candidates = {}
				for _, def in Mobs.list do
					if def.weight > 0 and not def.boss then
						local layerOk = def.layer == "any" or def.layer == layer
							or (def.layer == "underground" and (layer == "underground" or layer == "cavern"))
						local nightOk = not def.night or night
						local depthOk = not def.minDepth or y >= def.minDepth
						local biomeOk = true
						if def.biomes then
							biomeOk = false
							for _, b in def.biomes do
								if b == biome then
									biomeOk = true
									break
								end
							end
						end
						local moveOk = def.ai == "flyer" or onGround
						if layerOk and nightOk and depthOk and biomeOk and moveOk then
							table.insert(candidates, def)
						end
					end
				end

				if #candidates > 0 then
					local pick = Util.weightedPick(candidates :: any, math.random())
					if pick then
						local scale = 1
						if Services.Time.isBloodMoon() then scale = 1.5 end
						if y >= Config.CAVERN_Y then scale *= 1.15 end
						local mob = EntityService.spawnMob(pick.id, x + 0.5, y - pick.h / 2, scale)
						if mob and Services.Time.isBloodMoon() then
							mob.damage = math.floor(mob.damage * 1.3)
						end
						return
					end
				end
			end
		end
	end
end

local function spawnTick(dt: number)
	spawnTimer -= dt
	if spawnTimer > 0 then return end
	spawnTimer = Config.SPAWN_INTERVAL

	local players = Services.Player.all()
	local playerCount = 0
	for _ in players do playerCount += 1 end
	if playerCount == 0 then return end

	local cap = Config.MOB_CAP_PER_PLAYER * playerCount
	if Services.Time.isBloodMoon() then cap = math.floor(cap * 1.6) end
	if countMobs() >= cap then return end

	for _, state in players do
		if not state.dead then
			trySpawnAround(state)
		end
	end
end

-- ===== البثّ =====

local KIND_CODE = { mob = 1, item = 2, proj = 3 }

local function replicate()
	local packets: { [Player]: { any } } = {}
	for player in Services.Player.all() do
		packets[player] = {}
	end

	for _, entity in entities do
		if not entity.dead then
			local body = entity.body
			local packet = {
				i = entity.id,
				k = KIND_CODE[entity.kind],
				t = entity.type,
				x = math.floor(body.x * 32) / 32,
				y = math.floor(body.y * 32) / 32,
				f = entity.facing,
				a = entity.anim,
			}
			if entity.kind == "mob" then
				packet.h = math.floor(entity.hp / math.max(1, entity.maxHp) * 100)
			elseif entity.kind == "item" then
				packet.n = entity.count
			end

			for targetPlayer, state in Services.Player.all() do
				if math.abs(body.x - state.body.x) < 52 and math.abs(body.y - state.body.y) < 34 then
					local bucket = packets[targetPlayer]
					if bucket then table.insert(bucket, packet) end
				end
			end
		end
	end

	local remote = Net.get("Entities")
	for player, bucket in packets do
		remote:FireClient(player, bucket)
	end
end

-- ===== الحلقة الرئيسية =====

function EntityService.start()
	local accumulator = 0
	local replicateTimer = 0

	RunService.Heartbeat:Connect(function(frameDt)
		accumulator += frameDt
		local steps = 0
		while accumulator >= Config.MOB_TICK and steps < 4 do
			accumulator -= Config.MOB_TICK
			steps += 1
			local dt = Config.MOB_TICK

			local ok, err = pcall(function()
				for id, entity in entities do
					if entity.dead then
						entities[id] = nil
						continue
					end

					entity.age += dt
					entity.life -= dt
					if entity.life <= 0 then
						entity.dead = true
						if entity.boss and bossId == entity.id then
							bossId = nil
							Net.get("Boss"):FireAllClients({ active = false })
						end
						entities[id] = nil
						continue
					end

					if entity.kind == "mob" then
						updateMob(entity, dt)
					elseif entity.kind == "item" then
						updateItem(entity, dt)
					elseif entity.kind == "proj" then
						updateProjectile(entity, dt)
					end

					-- إزالة البعيدين جداً
					if entity.kind == "mob" and not entity.boss then
						local _, dist = nearestPlayer(entity.body.x, entity.body.y, 999)
						if dist > 95 then
							entities[id] = nil
						end
					end
				end

				spawnTick(dt)
			end)
			if not ok then
				warn("[EntityService] خطأ في المحاكاة: " .. tostring(err))
			end
		end

		replicateTimer += frameDt
		if replicateTimer >= 1 / Config.ENTITY_HZ then
			replicateTimer = 0
			local ok, err = pcall(replicate)
			if not ok then warn("[EntityService] خطأ في البثّ: " .. tostring(err)) end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		for _, entity in entities do
			if entity.owner == player then entity.owner = nil end
		end
	end)
end

function EntityService.count(): number
	local n = 0
	for _ in entities do n += 1 end
	return n
end

return EntityService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	PlayerService — حالة اللاعبين: المخزون، الإحصاءات، الحركة، استخدام العناصر، الحفظ.

	الحركة: يتنبأ العميل محلياً (استجابة فورية) والخادم يتحقق من المعقولية
	(سرعة قصوى + عدم الاختراق داخل الصخر) فيمنع الطيران والانتقال اللحظي
	دون أن يُدخل تأخيراً محسوساً على اللعب.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Buffs = require(Shared.Buffs)
local Config = require(Shared.Config)
local Inventory = require(Shared.Inventory)
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local Physics = require(Shared.Physics)
local Upgrades = require(Shared.Upgrades)
local Util = require(Shared.Util)
local World = require(Shared.World)

local Services = require(script.Parent.Services)
local SaveService = require(script.Parent.SaveService)

local PlayerService = {}

export type PlayerState = {
	player: Player,
	body: Physics.Body,
	slots: Inventory.Slots,
	armor: { [string]: Inventory.Stack? },
	hotbar: number,
	hp: number,
	maxHp: number,
	mana: number,
	maxMana: number,
	food: number,
	buffs: { [string]: number },
	dead: boolean,
	respawnAt: number,
	spawnX: number,
	spawnY: number,
	lastDamage: number,
	lastAttack: number,
	lastUse: number,
	facing: number,
	anim: string,
	fallPeak: number,
	aimX: number,
	aimY: number,
	underwater: number,
	kills: number,
	deaths: number,
	blocksMined: number,
	joinedAt: number,
	loaded: boolean,
	dirty: boolean,
}

local states: { [Player]: PlayerState } = {}

function PlayerService.get(player: Player): PlayerState?
	return states[player]
end

function PlayerService.all(): { [Player]: PlayerState }
	return states
end

function PlayerService.heldItem(player: Player): Inventory.Stack?
	local state = states[player]
	if not state then return nil end
	return state.slots[state.hotbar]
end

-- ===== الإحصاءات =====

function PlayerService.buffAggregate(player: Player): Buffs.Aggregate
	local state = states[player]
	if not state then return Buffs.aggregate({}) end
	return Buffs.aggregate(state.buffs)
end

function PlayerService.defense(state: PlayerState): number
	-- Upgrades.armorBonus يحسب دفاع كل قطعة مع تطويرها وصفتها السحرية
	local total = Upgrades.armorBonus(state.armor).defense
	local setName: string? = nil
	local setCount = 0
	for _, slot in { "head", "chest", "feet" } do
		local stack = state.armor[slot]
		if stack then
			local item = Items.get(stack.id)
			if item and item.setBonus then
				if setName == nil or setName == item.setBonus then
					setName = item.setBonus
					setCount += 1
				end
			end
		end
	end
	if setCount == 3 then
		total += 6 -- مكافأة الطقم الكامل
	end
	total += Buffs.aggregate(state.buffs).defense
	return total
end

-- المانا القصوى الفعّالة = المحفوظة + مكافآت الدرع المسحور
function PlayerService.effectiveMaxMana(state: PlayerState): number
	return state.maxMana + Upgrades.armorBonus(state.armor).mana
end

function PlayerService.syncStats(player: Player)
	local state = states[player]
	if not state then return end
	local buffList = {}
	for id, remaining in state.buffs do
		if remaining > 0 then
			table.insert(buffList, { id = id, t = math.floor(remaining * 10) / 10 })
		end
	end
	Net.get("Stats"):FireClient(player, {
		hp = math.floor(state.hp + 0.5),
		maxHp = state.maxHp,
		mana = math.floor(state.mana + 0.5),
		maxMana = PlayerService.effectiveMaxMana(state),
		food = math.floor(state.food + 0.5),
		defense = PlayerService.defense(state),
		dead = state.dead,
		respawnIn = math.max(0, state.respawnAt - os.clock()),
		buffs = buffList,
		kills = state.kills,
		deaths = state.deaths,
		mined = state.blocksMined,
	})
end

function PlayerService.syncInventory(player: Player)
	local state = states[player]
	if not state then return end
	local armor = {}
	for slot, stack in state.armor do
		if stack then armor[slot] = { stack.id, stack.n } end
	end
	Net.get("Inventory"):FireClient(player, {
		slots = Inventory.toNetwork(state.slots),
		armor = armor,
		hotbar = state.hotbar,
	})
	state.dirty = true
end

-- ===== إعطاء العناصر =====

function PlayerService.giveItem(player: Player, id: string, count: number, dropX: number?, dropY: number?)
	local state = states[player]
	if not state then return end
	local leftover = Inventory.add(state.slots, id, count)
	if leftover > 0 and dropX and dropY and Services.Entity then
		Services.Entity.spawnItem(dropX, dropY, id, leftover)
	end
	PlayerService.syncInventory(player)
end

-- ===== الضرر والموت =====

function PlayerService.damage(player: Player, amount: number, source: string?, knockX: number?, knockY: number?)
	local state = states[player]
	if not state or state.dead then return end
	local now = os.clock()
	if now - state.lastDamage < Config.IFRAMES and source ~= "environment" then return end

	local defense = PlayerService.defense(state)
	local final = math.max(1, amount - defense * 0.5)
	state.hp -= final
	state.lastDamage = now

	if knockX then state.body.vx += knockX end
	if knockY then state.body.vy += knockY end

	Net.get("Hit"):FireAllClients({
		kind = "player", x = state.body.x, y = state.body.y,
		amount = math.floor(final + 0.5), player = player.UserId,
	})

	if state.hp <= 0 then
		PlayerService.kill(player, source)
	else
		PlayerService.syncStats(player)
	end
end

function PlayerService.kill(player: Player, source: string?)
	local state = states[player]
	if not state or state.dead then return end
	state.hp = 0
	state.dead = true
	state.deaths += 1
	state.respawnAt = os.clock() + Config.RESPAWN_TIME
	state.body.vx, state.body.vy = 0, 0

	-- عقوبة الموت: نصف العملات تتناثر
	local coins = Inventory.count(state.slots, "coin")
	if coins > 0 then
		local lost = math.floor(coins / 2)
		if lost > 0 and Inventory.remove(state.slots, "coin", lost) then
			if Services.Entity then
				Services.Entity.spawnItem(state.body.x, state.body.y, "coin", lost)
			end
		end
	end

	PlayerService.syncInventory(player)
	PlayerService.syncStats(player)
	Net.get("Fx"):FireAllClients({ kind = "death", x = state.body.x, y = state.body.y })
	Net.get("Notify"):FireClient(player, { text = "لقد مِتّ! " .. (source or ""), color = { 220, 70, 70 }, big = true })
end

function PlayerService.respawn(player: Player)
	local state = states[player]
	if not state then return end
	if state.dead and os.clock() < state.respawnAt then return end

	state.dead = false
	state.hp = state.maxHp
	state.mana = state.maxMana
	state.food = math.max(state.food, 45)
	state.body.x = state.spawnX
	state.body.y = state.spawnY
	state.body.vx, state.body.vy = 0, 0
	table.clear(state.buffs)

	Net.get("Respawn"):FireClient(player, state.body.x, state.body.y)
	PlayerService.syncStats(player)
end

function PlayerService.heal(player: Player, amount: number)
	local state = states[player]
	if not state or state.dead then return end
	state.hp = math.min(state.maxHp, state.hp + amount)
	Net.get("Hit"):FireClient(player, { kind = "heal", x = state.body.x, y = state.body.y, amount = amount })
	PlayerService.syncStats(player)
end

-- ===== استخدام العناصر =====

local function useConsumable(player: Player, state: PlayerState, item: Items.Item, slotIndex: number): boolean
	local agg = Buffs.aggregate(state.buffs)
	if item.heal and item.heal > 0 and item.buff == "potion_sickness" and agg.blockPotion then
		Net.get("Notify"):FireClient(player, { text = "ما زلت مُجهداً من الجرعة السابقة", color = { 200, 160, 200 } })
		return false
	end

	local used = false
	if item.heal then
		state.hp = math.min(state.maxHp, state.hp + item.heal)
		used = true
	end
	if item.restoreMana then
		state.mana = math.min(state.maxMana, state.mana + item.restoreMana)
		used = true
	end
	if item.food then
		state.food = math.min(Config.FOOD_MAX, state.food + item.food)
		state.buffs.well_fed = math.max(state.buffs.well_fed or 0, 120)
		used = true
	end
	if item.buff then
		state.buffs[item.buff] = math.max(state.buffs[item.buff] or 0, item.buffTime or 60)
		used = true
	end

	if item.id == "life_crystal" then
		if state.maxHp >= 300 then
			Net.get("Notify"):FireClient(player, { text = "بلغت الحد الأقصى للحياة", color = { 240, 120, 140 } })
			return false
		end
		state.maxHp = math.min(300, state.maxHp + 20)
		state.hp = math.min(state.maxHp, state.hp + 20)
		used = true
	elseif item.id == "mana_crystal" then
		if state.maxMana >= 200 then
			Net.get("Notify"):FireClient(player, { text = "بلغت الحد الأقصى للمانا", color = { 140, 160, 250 } })
			return false
		end
		state.maxMana = math.min(200, state.maxMana + 20)
		state.mana = state.maxMana
		used = true
	end

	if used then
		Inventory.removeFromSlot(state.slots, slotIndex, 1)
		PlayerService.syncInventory(player)
		PlayerService.syncStats(player)
		Net.get("Fx"):FireAllClients({ kind = "consume", x = state.body.x, y = state.body.y, item = item.id })
	end
	return used
end

local function useSpecial(player: Player, state: PlayerState, item: Items.Item, slotIndex: number): boolean
	if item.id == "magic_mirror" or item.id == "recall_stone" then
		state.body.x = state.spawnX
		state.body.y = state.spawnY
		state.body.vx, state.body.vy = 0, 0
		Net.get("Respawn"):FireClient(player, state.body.x, state.body.y)
		Net.get("Fx"):FireAllClients({ kind = "teleport", x = state.body.x, y = state.body.y })
		if item.id == "recall_stone" then
			Inventory.removeFromSlot(state.slots, slotIndex, 1)
			PlayerService.syncInventory(player)
		end
		return true
	end

	if item.summon then
		if item.nightOnly and not Services.Time.isNight() then
			Net.get("Notify"):FireClient(player, { text = "يُستخدم ليلاً فقط", color = { 200, 120, 200 } })
			return false
		end
		if Services.Entity.bossActive() then
			Net.get("Notify"):FireClient(player, { text = "هناك زعيم حيّ بالفعل!", color = { 220, 90, 90 } })
			return false
		end
		Inventory.removeFromSlot(state.slots, slotIndex, 1)
		PlayerService.syncInventory(player)
		Services.Entity.spawnBoss(item.summon, state.body.x, state.body.y - 14)
		return true
	end

	return false
end

local function attack(player: Player, state: PlayerState, aimX: number, aimY: number)
	local stack = state.slots[state.hotbar]
	local item = if stack then Items.get(stack.id) else nil
	local now = os.clock()

	local damage = 6
	local useTime = 0.35
	local knockback = 3
	local crit = 0.03

	if item then
		-- كل هذه تمرّ عبر Upgrades لتشمل مستوى التطوير والصفة السحرية
		damage = if item.damage then Upgrades.damage(stack) else damage
		useTime = Upgrades.useTime(stack)
		knockback = Upgrades.knockback(stack)
		crit = Upgrades.crit(stack)
	end

	if now - state.lastAttack < useTime * 0.85 then return end
	state.lastAttack = now

	local dx, dy = aimX - state.body.x, aimY - state.body.y
	local len = math.max(0.001, math.sqrt(dx * dx + dy * dy))
	dx, dy = dx / len, dy / len
	state.facing = if dx >= 0 then 1 else -1

	-- سلاح بعيد المدى
	if item and item.ranged then
		local ammoSlot, ammoId = nil, nil
		for i = 1, Config.INV_SLOTS do
			local candidate = state.slots[i]
			if candidate then
				local candidateItem = Items.get(candidate.id)
				if candidateItem and candidateItem.ammo == item.ranged then
					ammoSlot, ammoId = i, candidate.id
					break
				end
			end
		end
		if not ammoSlot or not ammoId then
			Net.get("Notify"):FireClient(player, { text = "لا توجد ذخيرة", color = { 220, 180, 90 } })
			return
		end
		local ammoItem = Items.get(ammoId)
		Inventory.removeFromSlot(state.slots, ammoSlot, 1)
		PlayerService.syncInventory(player)

		local speed = item.shootSpeed or 34
		Services.Entity.spawnProjectile(
			ammoId,
			state.body.x + dx * 1.2,
			state.body.y + dy * 1.2 - 0.3,
			dx * speed,
			dy * speed,
			damage + ((ammoItem and ammoItem.damage) or 0),
			knockback,
			player
		)
		return
	end

	-- سلاح سحري
	if item and item.magic then
		local cost = item.mana or 0
		if state.mana < cost then
			Net.get("Notify"):FireClient(player, { text = "المانا غير كافية", color = { 120, 150, 250 } })
			return
		end
		state.mana -= cost
		PlayerService.syncStats(player)
		local speed = item.shootSpeed or 30
		Services.Entity.spawnProjectile(
			item.magic,
			state.body.x + dx * 1.2,
			state.body.y + dy * 1.2 - 0.3,
			dx * speed,
			dy * speed,
			damage,
			knockback,
			player
		)
		return
	end

	-- ضربة قريبة
	local reach = 3.0 + Upgrades.reachBonus(stack) * 0.5
	local hitX = state.body.x + dx * reach * 0.6
	local hitY = state.body.y + dy * reach * 0.6
	local isCrit = math.random() < crit
	local finalDamage = if isCrit then damage * 2 else damage

	local dealt = Services.Entity.meleeHit(player, hitX, hitY, reach, finalDamage, knockback, dx, dy, isCrit)

	-- صفة «مصّاص»: تشفي نسبة من الضرر الموقع
	local lifesteal = Upgrades.lifesteal(stack)
	if lifesteal > 0 and dealt > 0 then
		local healed = math.max(1, math.floor(dealt * lifesteal))
		state.hp = math.min(state.maxHp, state.hp + healed)
		Net.get("Hit"):FireClient(player, { kind = "heal", x = state.body.x, y = state.body.y, amount = healed })
	end
	Net.get("Fx"):FireAllClients({
		kind = "swing", x = state.body.x, y = state.body.y,
		dx = dx, dy = dy, item = if item then item.id else "hand", player = player.UserId,
	})
end

local function handleUseItem(player: Player, mode: string, aimX: number, aimY: number)
	local state = states[player]
	if not state or state.dead then return end
	if type(aimX) ~= "number" or type(aimY) ~= "number" then return end
	if Util.dist(state.body.x, state.body.y, aimX, aimY) > 60 then return end

	state.aimX, state.aimY = aimX, aimY

	if mode == "attack" then
		attack(player, state, aimX, aimY)
		return
	end

	if mode == "use" then
		local stack = state.slots[state.hotbar]
		if not stack then return end
		local item = Items.get(stack.id)
		if not item then return end
		local now = os.clock()
		if now - state.lastUse < (item.useTime or 0.4) then return end
		state.lastUse = now

		if item.cat == "consumable" then
			useConsumable(player, state, item, state.hotbar)
		elseif item.cat == "misc" then
			useSpecial(player, state, item, state.hotbar)
		end
	end
end

-- ===== أفعال المخزون =====

local function handleInvAction(player: Player, action: string, a: any, b: any)
	local state = states[player]
	if not state then return end

	if action == "hotbar" then
		if type(a) == "number" and a >= 1 and a <= Config.HOTBAR then
			state.hotbar = math.floor(a)
		end
		return
	end

	if action == "swap" then
		if type(a) ~= "number" or type(b) ~= "number" then return end
		a, b = math.floor(a), math.floor(b)
		if a < 1 or a > Config.INV_SLOTS or b < 1 or b > Config.INV_SLOTS then return end
		Inventory.swap(state.slots, a, b)
		PlayerService.syncInventory(player)
		return
	end

	if action == "drop" then
		if type(a) ~= "number" then return end
		a = math.floor(a)
		if a < 1 or a > Config.INV_SLOTS then return end
		local stack = state.slots[a]
		if not stack then return end
		local amount = if b == "all" then stack.n else 1
		local id = stack.id
		local upgrade = if stack.up then { lvl = stack.up.lvl, aff = stack.up.aff } else nil
		local taken = Inventory.removeFromSlot(state.slots, a, amount)
		if taken > 0 then
			Services.Entity.spawnItem(
				state.body.x + state.facing * 1.2,
				state.body.y - 0.5,
				id, taken, state.facing * 7, -6, player, upgrade
			)
			PlayerService.syncInventory(player)
		end
		return
	end

	if action == "equip" then
		if type(a) ~= "number" then return end
		a = math.floor(a)
		local stack = state.slots[a]
		if not stack then return end
		local item = Items.get(stack.id)
		if not item or item.cat ~= "armor" or not item.slot then return end
		local current = state.armor[item.slot]
		state.armor[item.slot] = { id = stack.id, n = 1 }
		state.slots[a] = current
		PlayerService.syncInventory(player)
		PlayerService.syncStats(player)
		return
	end

	if action == "unequip" then
		if type(a) ~= "string" then return end
		local stack = state.armor[a]
		if not stack then return end
		if Inventory.add(state.slots, stack.id, 1) == 0 then
			state.armor[a] = nil
			PlayerService.syncInventory(player)
			PlayerService.syncStats(player)
		end
		return
	end

	if action == "sort" then
		local collected: { Inventory.Stack } = {}
		for i = Config.HOTBAR + 1, Config.INV_SLOTS do
			local stack = state.slots[i]
			if stack then
				table.insert(collected, stack)
				state.slots[i] = nil
			end
		end
		table.sort(collected, function(left, right)
			local li, ri = Items.get(left.id), Items.get(right.id)
			if not li or not ri then return false end
			if li.cat ~= ri.cat then return li.cat < ri.cat end
			if li.rarity ~= ri.rarity then return li.rarity > ri.rarity end
			return left.id < right.id
		end)
		for _, stack in collected do
			Inventory.add(state.slots, stack.id, stack.n)
		end
		PlayerService.syncInventory(player)
		return
	end
end

-- ===== الحركة =====

local function handlePlayerState(player: Player, x: number, y: number, vx: number, vy: number, facing: number, anim: string)
	local state = states[player]
	if not state or state.dead then return end
	if type(x) ~= "number" or type(y) ~= "number" then return end
	if x ~= x or y ~= y then return end -- NaN
	if not World.inBounds(math.floor(x), math.floor(y)) then return end

	local body = state.body
	local dt = math.max(1 / 60, 1 / Config.STATE_HZ)
	local agg = Buffs.aggregate(state.buffs)
	local armorSpeed = Upgrades.armorBonus(state.armor).speed
	local maxStep = (Config.WALK_SPEED * agg.speed * armorSpeed + Config.MAX_FALL) * dt * 2.2 + 2.5
	local delta = Util.dist(body.x, body.y, x, y)

	if delta > maxStep then
		-- حركة غير معقولة: أعد اللاعب لموضعه الأخير المعروف
		Net.get("Respawn"):FireClient(player, body.x, body.y)
		return
	end

	local world = Services.World.getWorld()
	if Physics.boxOverlapsSolid(world, x, y, body.w, body.h) then
		-- داخل الصخر: اسمح فقط إن كان الموضع السابق أيضاً داخل الصخر (خروج من حشر)
		if not Physics.boxOverlapsSolid(world, body.x, body.y, body.w, body.h) then
			Net.get("Respawn"):FireClient(player, body.x, body.y)
			return
		end
	end

	local prevY = body.y
	body.x, body.y = x, y
	body.vx = if type(vx) == "number" then vx else 0
	body.vy = if type(vy) == "number" then vy else 0
	state.facing = if facing == -1 then -1 else 1
	state.anim = if type(anim) == "string" then anim else "idle"

	-- ضرر السقوط يُحسب على الخادم من ذروة سرعة الهبوط المرصودة
	local falling = (y - prevY) / dt
	if falling > state.fallPeak then state.fallPeak = falling end

	local grounded = Physics.boxOverlapsSolid(world, body.x, body.y + 0.12, body.w, body.h)
	local inLiquid = Blocks.isLiquid(World.fg(world, math.floor(body.x), math.floor(body.y)))
	body.inLiquid = if inLiquid then World.fg(world, math.floor(body.x), math.floor(body.y)) else 0
	if (grounded or inLiquid) and state.fallPeak > 0 then
		local tiles = (state.fallPeak * state.fallPeak) / (2 * Config.GRAVITY)
		if tiles > Config.FALL_SAFE and not inLiquid then
			local damage = (tiles - Config.FALL_SAFE) * Config.FALL_DMG_PER_TILE
			PlayerService.damage(player, damage, "السقوط")
		end
		state.fallPeak = 0
	end
end

local function broadcastPeers()
	local payload = {}
	for player, state in states do
		table.insert(payload, {
			u = player.UserId,
			n = player.DisplayName,
			x = math.floor(state.body.x * 32) / 32,
			y = math.floor(state.body.y * 32) / 32,
			f = state.facing,
			hp = math.floor(state.hp / math.max(1, state.maxHp) * 100),
			d = state.dead,
			it = if state.slots[state.hotbar] then (state.slots[state.hotbar] :: Inventory.Stack).id else "",
			iu = Upgrades.isModified(state.slots[state.hotbar]),
			hd = if state.armor.head then (state.armor.head :: Inventory.Stack).id else "",
			ch = if state.armor.chest then (state.armor.chest :: Inventory.Stack).id else "",
		})
	end
	if #payload == 0 then return end
	Net.get("PeerState"):FireAllClients(payload)
end

-- ===== التحديث الدوري =====

local function tickPlayer(state: PlayerState, dt: number)
	local player = state.player
	if state.dead then
		return
	end

	local agg = Buffs.aggregate(state.buffs)
	local world = Services.World.getWorld()

	-- التعزيزات
	local expired = false
	for id, remaining in state.buffs do
		local left = remaining - dt
		if left <= 0 then
			state.buffs[id] = nil
			expired = true
		else
			state.buffs[id] = left
		end
	end

	-- الجوع
	state.food = math.max(0, state.food - Config.FOOD_DRAIN * dt)
	if state.food <= 0 then
		state.hp -= Config.STARVE_DPS * dt
	end

	-- تجدد الحياة (يشمل صفة «حيويّ» على الدرع)
	local armorBonus = Upgrades.armorBonus(state.armor)
	if os.clock() - state.lastDamage > Config.HP_REGEN_DELAY and state.food > 10 then
		local regen = Config.HP_REGEN * (state.food / Config.FOOD_MAX) + agg.regen + armorBonus.regen
		state.hp = math.min(state.maxHp, state.hp + regen * dt)
	elseif agg.regen > 0 then
		state.hp = math.min(state.maxHp, state.hp + agg.regen * dt)
	end

	-- المانا (السقف يشمل مكافأة الدرع المسحور)
	state.mana = math.min(PlayerService.effectiveMaxMana(state), state.mana + Config.MANA_REGEN * dt)

	-- ضرر مستمر من التعزيزات السلبية
	if agg.dps > 0 then
		state.hp -= agg.dps * dt
	end

	-- ضرر البيئة (حمم، صبّار)
	local contact = Physics.contactDamage(world, state.body)
	if contact > 0 then
		PlayerService.damage(player, contact * dt * 6, "environment")
	end

	-- الغرق
	local headTile = World.fg(world, math.floor(state.body.x), math.floor(state.body.y - state.body.h / 2 + 0.3))
	if Blocks.isLiquid(headTile) and headTile == Blocks.ID.WATER then
		state.underwater += dt
		if state.underwater > Config.DROWN_TIME then
			state.hp -= Config.DROWN_DPS * dt
		end
	else
		state.underwater = math.max(0, state.underwater - dt * 3)
	end

	if state.hp <= 0 then
		PlayerService.kill(player, "البيئة")
		return
	end

	if expired then
		PlayerService.syncStats(player)
	end
end

-- ===== الحفظ =====

local function serialize(state: PlayerState): any
	local armor: { [string]: any } = {}
	for slot, stack in state.armor do
		if stack then
			local entry: { any } = { stack.id }
			if stack.up then
				entry[2] = stack.up.lvl
				entry[3] = stack.up.aff or ""
			end
			armor[slot] = entry
		end
	end
	return {
		v = 1,
		inv = Inventory.serialize(state.slots),
		armor = armor,
		hp = math.floor(state.hp),
		maxHp = state.maxHp,
		maxMana = state.maxMana,
		food = math.floor(state.food),
		x = state.body.x,
		y = state.body.y,
		spawnX = state.spawnX,
		spawnY = state.spawnY,
		hotbar = state.hotbar,
		kills = state.kills,
		deaths = state.deaths,
		mined = state.blocksMined,
		playtime = os.time() - state.joinedAt,
	}
end

function PlayerService.save(player: Player)
	local state = states[player]
	if not state or not state.loaded then return end
	SaveService.savePlayer(player.UserId, serialize(state))
	state.dirty = false
end

-- ===== الانضمام والمغادرة =====

local STARTER_KIT: { { id: string, n: number } } = {
	{ id = "wood_pickaxe", n = 1 },
	{ id = "wood_axe", n = 1 },
	{ id = "wood_sword", n = 1 },
	{ id = "torch", n = 20 },
	{ id = "apple", n = 5 },
	{ id = "plank", n = 20 },
}

local function onPlayerAdded(player: Player)
	-- أمان: لو ظهرت شخصية روبلوكس (مثلاً لاعب دخل قبل تعطيل الظهور التلقائي)
	-- فأزلها — اللعبة ثنائية الأبعاد بالكامل ولا تستعمل الشخصيات.
	player.CharacterAdded:Connect(function(character)
		task.defer(function()
			if character and character.Parent then character:Destroy() end
		end)
	end)
	if player.Character then
		player.Character:Destroy()
	end

	local spawnX, spawnY = Services.World.getSpawn()
	local state: PlayerState = {
		player = player,
		body = Physics.newBody(spawnX, spawnY, Config.PLAYER_W, Config.PLAYER_H),
		slots = Inventory.new(),
		armor = {},
		hotbar = 1,
		hp = Config.BASE_HP,
		maxHp = Config.BASE_HP,
		mana = Config.BASE_MANA,
		maxMana = Config.BASE_MANA,
		food = Config.FOOD_MAX,
		buffs = {},
		dead = false,
		respawnAt = 0,
		spawnX = spawnX,
		spawnY = spawnY,
		lastDamage = 0,
		lastAttack = 0,
		lastUse = 0,
		facing = 1,
		anim = "idle",
		fallPeak = 0,
		aimX = spawnX,
		aimY = spawnY,
		underwater = 0,
		kills = 0,
		deaths = 0,
		blocksMined = 0,
		joinedAt = os.time(),
		loaded = false,
		dirty = false,
	} :: any
	states[player] = state

	-- حمّل البيانات المحفوظة
	local saved = SaveService.loadPlayer(player.UserId)
	if type(saved) == "table" then
		state.slots = Inventory.deserialize(saved.inv)
		if type(saved.armor) == "table" then
			for slot, entry in saved.armor do
				-- الصيغة القديمة نص، والحالية مصفوفة تحمل التطوير
				local id = if type(entry) == "string" then entry
					elseif type(entry) == "table" then entry[1] else nil
				if type(id) == "string" and Items.get(id) then
					local stack: Inventory.Stack = { id = id, n = 1 }
					if type(entry) == "table" and type(entry[2]) == "number" then
						stack.up = Upgrades.normalize({ lvl = entry[2], aff = entry[3] })
					end
					state.armor[slot] = stack
				end
			end
		end
		state.maxHp = math.clamp(tonumber(saved.maxHp) or Config.BASE_HP, Config.BASE_HP, 300)
		state.maxMana = math.clamp(tonumber(saved.maxMana) or Config.BASE_MANA, Config.BASE_MANA, 200)
		state.hp = math.clamp(tonumber(saved.hp) or state.maxHp, 1, state.maxHp)
		state.mana = state.maxMana
		state.food = math.clamp(tonumber(saved.food) or Config.FOOD_MAX, 0, Config.FOOD_MAX)
		state.hotbar = math.clamp(math.floor(tonumber(saved.hotbar) or 1), 1, Config.HOTBAR)
		state.kills = tonumber(saved.kills) or 0
		state.deaths = tonumber(saved.deaths) or 0
		state.blocksMined = tonumber(saved.mined) or 0
		if type(saved.spawnX) == "number" then
			state.spawnX = saved.spawnX
			state.spawnY = saved.spawnY
		end
		if type(saved.x) == "number" and type(saved.y) == "number" then
			state.body.x = math.clamp(saved.x, 2, Config.WORLD_W - 2)
			state.body.y = math.clamp(saved.y, 2, Config.WORLD_H - 2)
		end
	else
		for _, entry in STARTER_KIT do
			Inventory.add(state.slots, entry.id, entry.n)
		end
	end
	state.loaded = true

	-- تأكد من تحميل تعديلات منطقة الظهور قبل إرسال Hello
	Services.World.ensureRegionAt(math.floor(state.body.x), math.floor(state.body.y))

	Net.get("Hello"):FireClient(player, {
		seed = Services.World.getSeed(),
		x = state.body.x,
		y = state.body.y,
		spawnX = state.spawnX,
		spawnY = state.spawnY,
		worldW = Config.WORLD_W,
		worldH = Config.WORLD_H,
		userId = player.UserId,
	})
	PlayerService.syncInventory(player)
	PlayerService.syncStats(player)
	Services.Time.broadcast(player)
end

local function onPlayerRemoving(player: Player)
	PlayerService.save(player)
	states[player] = nil
end

function PlayerService.start()
	Net.get("PlayerState").OnServerEvent:Connect(handlePlayerState)
	Net.get("InvAction").OnServerEvent:Connect(handleInvAction)
	Net.get("UseItem").OnServerEvent:Connect(handleUseItem)
	Net.get("Respawn").OnServerEvent:Connect(function(player)
		PlayerService.respawn(player)
	end)

	Players.PlayerAdded:Connect(function(player)
		local ok, err = pcall(onPlayerAdded, player)
		if not ok then
			warn("[PlayerService] فشل تجهيز اللاعب: " .. tostring(err))
		end
	end)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- التحديث الدوري
	local accumulator = 0
	local statsTimer = 0
	local peerTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.1 then
			for _, state in states do
				tickPlayer(state, accumulator)
			end
			accumulator = 0
		end

		statsTimer += dt
		if statsTimer >= 0.5 then
			statsTimer = 0
			for player in states do
				PlayerService.syncStats(player)
			end
		end

		peerTimer += dt
		if peerTimer >= 1 / Config.STATE_HZ then
			peerTimer = 0
			broadcastPeers()
		end
	end)

	-- حفظ دوري
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE)
			for player, state in states do
				if state.dirty then
					pcall(PlayerService.save, player)
					task.wait(0.2)
				end
			end
		end
	end)

	game:BindToClose(function()
		for player in states do
			pcall(PlayerService.save, player)
		end
	end)
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">SaveService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	SaveService — غلاف DataStore مع إعادة محاولة، وذاكرة احتياطية عند غياب الوصول
	(مثلاً في Studio بلا API access) حتى لا تنهار اللعبة أثناء التطوير.
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local SaveService = {}

local playerStore: DataStore? = nil
local worldStore: DataStore? = nil
local available = true
local memory: { [string]: any } = {} -- احتياطي في الذاكرة

do
	local ok, err = pcall(function()
		playerStore = DataStoreService:GetDataStore(Config.DATASTORE_PLAYER)
		worldStore = DataStoreService:GetDataStore(Config.DATASTORE_WORLD)
	end)
	if not ok then
		available = false
		warn("[SaveService] DataStore غير متاح، سيتم الحفظ في الذاكرة فقط: " .. tostring(err))
	end
end

local function retry<T>(label: string, fn: () -> T): (boolean, T?)
	local delayTime = 0.5
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then return true, result end
		if attempt == 4 then
			warn(string.format("[SaveService] فشل %s بعد %d محاولات: %s", label, attempt, tostring(result)))
			return false, nil
		end
		task.wait(delayTime)
		delayTime *= 2
	end
	return false, nil
end

function SaveService.isAvailable(): boolean
	return available
end

-- ===== بيانات اللاعب =====
function SaveService.loadPlayer(userId: number): any?
	local key = "p_" .. userId
	if not available or not playerStore then return memory[key] end
	local ok, data = retry("تحميل بيانات اللاعب", function()
		return (playerStore :: DataStore):GetAsync(key)
	end)
	if ok then return data end
	return memory[key]
end

function SaveService.savePlayer(userId: number, data: any): boolean
	local key = "p_" .. userId
	memory[key] = data
	if not available or not playerStore then return false end
	local ok = retry("حفظ بيانات اللاعب", function()
		(playerStore :: DataStore):SetAsync(key, data)
		return true
	end)
	return ok
end

-- ===== بيانات العالم =====
function SaveService.loadMeta(): any?
	local key = "meta_" .. Config.WORLD_NAME
	if not available or not worldStore then return memory[key] end
	local ok, data = retry("تحميل بيانات العالم", function()
		return (worldStore :: DataStore):GetAsync(key)
	end)
	if ok then return data end
	return memory[key]
end

function SaveService.saveMeta(data: any): boolean
	local key = "meta_" .. Config.WORLD_NAME
	memory[key] = data
	if not available or not worldStore then return false end
	return (retry("حفظ بيانات العالم", function()
		(worldStore :: DataStore):SetAsync(key, data)
		return true
	end))
end

-- ===== مناطق التعديلات =====
-- المنطقة = REGION×REGION قطعة، تُخزَّن في مفتاح واحد لتقليل عدد طلبات DataStore.
function SaveService.regionKey(rx: number, ry: number): string
	return string.format("w_%s_%d_%d", Config.WORLD_NAME, rx, ry)
end

function SaveService.loadRegion(rx: number, ry: number): { [string]: { number } }?
	local key = SaveService.regionKey(rx, ry)
	if not available or not worldStore then return memory[key] end
	local ok, data = retry("تحميل منطقة", function()
		return (worldStore :: DataStore):GetAsync(key)
	end)
	if ok and type(data) == "table" then return data end
	return memory[key]
end

function SaveService.saveRegion(rx: number, ry: number, payload: { [string]: { number } }): boolean
	local key = SaveService.regionKey(rx, ry)
	memory[key] = payload
	if not available or not worldStore then return false end
	return (retry("حفظ منطقة", function()
		(worldStore :: DataStore):SetAsync(key, payload)
		return true
	end))
end

-- في Studio نعطّل الكتابة الفعلية إن أراد المطوّر ذلك
function SaveService.setEnabled(enabled: boolean)
	available = enabled and not RunService:IsStudio() or enabled
end

return SaveService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Services</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Services — سجل مركزي لكسر الاعتماد الدائري بين خدمات الخادم.
	يملؤه init.server.luau عند الإقلاع، وتقرأ منه بقية الوحدات.
]]

local Services = {}

Services.Save = nil :: any
Services.Time = nil :: any
Services.World = nil :: any
Services.Player = nil :: any
Services.Entity = nil :: any
Services.Combat = nil :: any
Services.Craft = nil :: any
Services.Station = nil :: any

return Services
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">StationService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	StationService — المحطات ذات الحالة في العالم.

	* **الفرن**: كيان بلاطة حقيقي له مُدخل ووقود وناتج وشريط تقدّم. يستمر في
	  الصهر وأنت بعيد عنه، وتُحفظ محتوياته مع تعديلات العالم، وتتناثر عند كسره.
	* **السندان**: تطوير الأدوات والدروع (+1 حتى +5) — مضمون النجاح.
	* **طاولة السحر**: منح صفة سحرية عشوائية قابلة لإعادة الرمي.

	كل شيء يُتحقق منه على الخادم: وجود البلاطة، قرب اللاعب، ملكية العناصر،
	وكفاية المواد والعملات.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Config = require(Shared.Config)
local Inventory = require(Shared.Inventory)
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local Smelting = require(Shared.Smelting)
local Upgrades = require(Shared.Upgrades)
local Util = require(Shared.Util)
local World = require(Shared.World)

local Services = require(script.Parent.Services)

local StationService = {}

local USE_RANGE = 9 -- أقصى مسافة للتفاعل مع محطة
local CHEST_SLOTS = 27 -- ثلاثة صفوف × تسع خانات
local TICK = 0.25
local PUSH_HZ = 5 -- تحديثات الواجهة للمشاهدين

export type Furnace = {
	x: number,
	y: number,
	input: Inventory.Stack?,
	fuel: Inventory.Stack?,
	output: Inventory.Stack?,
	burn: number, -- ثواني وقود متبقية
	burnMax: number,
	progress: number, -- ثواني صهر متراكمة
	progressMax: number,
}

export type Chest = {
	x: number,
	y: number,
	slots: Inventory.Slots,
}

local furnaces: { [string]: Furnace } = {}
local chests: { [string]: Chest } = {}
-- اللاعب -> المحطة المفتوحة حالياً
local viewing: { [Player]: { x: number, y: number, kind: string } } = {}

local function key(x: number, y: number): string
	return x .. "," .. y
end

-- ===== أدوات =====

local function netStack(stack: Inventory.Stack?): any
	if not stack then return nil end
	local out = { id = stack.id, n = stack.n }
	if stack.up then
		out.lvl = stack.up.lvl
		out.aff = stack.up.aff or ""
	end
	return out
end

local function stationAt(x: number, y: number): string?
	local world = Services.World.getWorld()
	local block = Blocks.get(World.fg(world, x, y))
	if block.container then return "chest" end
	return block.station
end

local function playerNear(player: Player, x: number, y: number): boolean
	local state = Services.Player.get(player)
	if not state or state.dead then return false end
	return Util.dist(state.body.x, state.body.y, x + 0.5, y + 0.5) <= USE_RANGE
end

local function getFurnace(x: number, y: number, create: boolean?): Furnace?
	local k = key(x, y)
	local furnace = furnaces[k]
	if furnace then return furnace end
	if not create then return nil end
	if stationAt(x, y) ~= "furnace" then return nil end
	furnace = {
		x = x, y = y,
		input = nil, fuel = nil, output = nil,
		burn = 0, burnMax = 0, progress = 0, progressMax = 0,
	}
	furnaces[k] = furnace
	return furnace
end

local function getChest(x: number, y: number, create: boolean?): Chest?
	local k = key(x, y)
	local chest = chests[k]
	if chest then return chest end
	if not create then return nil end
	if stationAt(x, y) ~= "chest" then return nil end
	chest = { x = x, y = y, slots = Inventory.new() }
	chests[k] = chest
	return chest
end

-- ===== إرسال الحالة =====

local function buildPayload(player: Player, x: number, y: number, kind: string): any
	local payload: any = {
		open = true,
		kind = kind,
		x = x, y = y,
	}

	if kind == "furnace" then
		local furnace = getFurnace(x, y, true)
		if furnace then
			payload.input = netStack(furnace.input)
			payload.fuel = netStack(furnace.fuel)
			payload.output = netStack(furnace.output)
			payload.burn = math.floor(furnace.burn * 10) / 10
			payload.burnMax = furnace.burnMax
			payload.progress = math.floor(furnace.progress * 100) / 100
			payload.progressMax = furnace.progressMax
		end
	elseif kind == "chest" then
		local chest = getChest(x, y, true)
		if chest then
			local slots = {}
			for i = 1, CHEST_SLOTS do
				slots[i] = netStack(chest.slots[i])
			end
			payload.slots = slots
			payload.count = CHEST_SLOTS
		end
	end

	return payload
end

local function pushState(player: Player)
	local view = viewing[player]
	if not view then return end
	Net.get("Station"):FireClient(player, buildPayload(player, view.x, view.y, view.kind))
end

function StationService.close(player: Player, silent: boolean?)
	viewing[player] = nil
	if not silent then
		Net.get("Station"):FireClient(player, { open = false })
	end
end

-- ===== محاكاة الفرن =====

local function outputAccepts(furnace: Furnace, itemId: string, count: number): boolean
	local output = furnace.output
	if not output then return true end
	if output.id ~= itemId then return false end
	return output.n + count <= Items.maxStack(itemId)
end

local function stepFurnace(furnace: Furnace, dt: number): boolean
	local changed = false

	-- الوقود المشتعل يستمر حتى ينفد
	if furnace.burn > 0 then
		furnace.burn = math.max(0, furnace.burn - dt)
		changed = true
	end

	local recipe = Smelting.recipeFor(if furnace.input then (furnace.input :: Inventory.Stack).id else nil)
	local canWork = recipe ~= nil and outputAccepts(furnace, (recipe :: Smelting.SmeltRecipe).out, (recipe :: Smelting.SmeltRecipe).n)

	if not canWork then
		if furnace.progress > 0 then
			furnace.progress = 0
			furnace.progressMax = 0
			changed = true
		end
		return changed
	end

	local smelt = recipe :: Smelting.SmeltRecipe
	furnace.progressMax = smelt.time

	-- أشعل وقوداً جديداً عند الحاجة
	if furnace.burn <= 0 then
		local fuel = furnace.fuel
		local value = Smelting.fuelValue(if fuel then (fuel :: Inventory.Stack).id else nil)
		if value > 0 and fuel then
			furnace.burn = value
			furnace.burnMax = value
			fuel.n -= 1
			if fuel.n <= 0 then furnace.fuel = nil end
			changed = true
		else
			-- لا وقود: يبرد التقدّم تدريجياً بدل أن يضيع فوراً
			if furnace.progress > 0 then
				furnace.progress = math.max(0, furnace.progress - dt * 0.5)
				changed = true
			end
			return changed
		end
	end

	furnace.progress += dt
	changed = true

	if furnace.progress >= smelt.time then
		furnace.progress -= smelt.time
		local input = furnace.input
		if input then
			input.n -= 1
			if input.n <= 0 then furnace.input = nil end
		end
		if furnace.output then
			(furnace.output :: Inventory.Stack).n += smelt.n
		else
			furnace.output = { id = smelt.out, n = smelt.n }
		end
	end

	return changed
end

-- ===== نقل العناصر =====

local function handleGive(player: Player, x: number, y: number, playerSlot: number, target: string)
	local state = Services.Player.get(player)
	if not state or not playerNear(player, x, y) then return end
	if stationAt(x, y) ~= "furnace" then return end
	if playerSlot < 1 or playerSlot > Config.INV_SLOTS then return end

	local stack = state.slots[playerSlot]
	if not stack then return end

	local furnace = getFurnace(x, y, true)
	if not furnace then return end

	if target == "input" then
		if not Smelting.recipeFor(stack.id) then
			Net.get("Notify"):FireClient(player, { text = "هذا العنصر لا يُصهر", color = { 230, 160, 90 } })
			return
		end
	elseif target == "fuel" then
		if not Smelting.isFuel(stack.id) then
			Net.get("Notify"):FireClient(player, { text = "هذا العنصر ليس وقوداً", color = { 230, 160, 90 } })
			return
		end
	else
		return -- الناتج للأخذ فقط
	end

	local slot = if target == "input" then furnace.input else furnace.fuel
	local max = Items.maxStack(stack.id)

	if slot and slot.id ~= stack.id then
		-- بادل المحتويين
		local removed = Inventory.removeFromSlot(state.slots, playerSlot, stack.n)
		local swapped: Inventory.Stack = { id = stack.id, n = removed }
		if target == "input" then
			state.slots[playerSlot] = slot
			furnace.input = swapped
		else
			state.slots[playerSlot] = slot
			furnace.fuel = swapped
		end
	else
		local space = if slot then max - slot.n else max
		local move = math.min(space, stack.n)
		if move <= 0 then return end
		Inventory.removeFromSlot(state.slots, playerSlot, move)
		if slot then
			slot.n += move
		elseif target == "input" then
			furnace.input = { id = stack.id, n = move }
		else
			furnace.fuel = { id = stack.id, n = move }
		end
	end

	Services.Player.syncInventory(player)
	pushState(player)
	StationService.markDirty(x, y)
end

local function handleTake(player: Player, x: number, y: number, source: string)
	local state = Services.Player.get(player)
	if not state or not playerNear(player, x, y) then return end

	local furnace = getFurnace(x, y, false)
	if not furnace then return end

	local slot: Inventory.Stack? = nil
	if source == "input" then slot = furnace.input
	elseif source == "fuel" then slot = furnace.fuel
	elseif source == "output" then slot = furnace.output
	else return end
	if not slot then return end

	local leftover = Inventory.add(state.slots, slot.id, slot.n)
	local taken = slot.n - leftover
	if taken <= 0 then
		Net.get("Notify"):FireClient(player, { text = "المخزون ممتلئ", color = { 230, 120, 100 } })
		return
	end

	slot.n = leftover
	if slot.n <= 0 then
		if source == "input" then furnace.input = nil
		elseif source == "fuel" then furnace.fuel = nil
		else furnace.output = nil end
	end

	Services.Player.syncInventory(player)
	pushState(player)
	StationService.markDirty(x, y)
end

-- تبادل خانة بين مخزون اللاعب والصندوق (نفس منطق تبديل المخزون)
local function handleChestSwap(player: Player, x: number, y: number, playerSlot: number, chestSlot: number)
	local state = Services.Player.get(player)
	if not state or not playerNear(player, x, y) then return end
	if stationAt(x, y) ~= "chest" then return end
	if playerSlot < 1 or playerSlot > Config.INV_SLOTS then return end
	if chestSlot < 1 or chestSlot > CHEST_SLOTS then return end

	local chest = getChest(x, y, true)
	if not chest then return end

	local playerStack = state.slots[playerSlot]
	local chestStack = chest.slots[chestSlot]

	-- دمج الأكوام المتطابقة غير المطوّرة بدل تبديلها
	if playerStack and chestStack and playerStack.id == chestStack.id
		and playerStack.up == nil and chestStack.up == nil then
		local max = Items.maxStack(playerStack.id)
		local move = math.min(max - chestStack.n, playerStack.n)
		if move > 0 then
			chestStack.n += move
			playerStack.n -= move
			if playerStack.n <= 0 then state.slots[playerSlot] = nil end
			Services.Player.syncInventory(player)
			pushState(player)
			StationService.markDirty(x, y)
			return
		end
	end

	state.slots[playerSlot] = chestStack
	chest.slots[chestSlot] = playerStack

	Services.Player.syncInventory(player)
	pushState(player)
	StationService.markDirty(x, y)
end

-- «أودِع الكل»: ينقل كل ما يماثل محتويات الصندوق من المخزون إليه
local function handleChestDeposit(player: Player, x: number, y: number)
	local state = Services.Player.get(player)
	if not state or not playerNear(player, x, y) then return end
	if stationAt(x, y) ~= "chest" then return end
	local chest = getChest(x, y, true)
	if not chest then return end

	local moved = 0
	for i = Config.HOTBAR + 1, Config.INV_SLOTS do
		local stack = state.slots[i]
		if stack and stack.up == nil then
			local emptied = false
			for j = 1, CHEST_SLOTS do
				local target = chest.slots[j]
				if target and target.id == stack.id and target.up == nil then
					local space = Items.maxStack(stack.id) - target.n
					local move = math.min(space, stack.n)
					if move > 0 then
						target.n += move
						stack.n -= move
						moved += move
						if stack.n <= 0 then
							state.slots[i] = nil
							emptied = true
							break
						end
					end
				end
			end
			if not emptied and state.slots[i] then
				for j = 1, CHEST_SLOTS do
					if not chest.slots[j] then
						chest.slots[j] = state.slots[i]
						moved += 1
						state.slots[i] = nil
						break
					end
				end
			end
		end
	end

	if moved > 0 then
		Services.Player.syncInventory(player)
		pushState(player)
		StationService.markDirty(x, y)
	end
end

-- ===== التطوير والسحر =====

local function payCost(state: any, cost: Upgrades.Cost): boolean
	if Inventory.count(state.slots, cost.material) < cost.amount then return false end
	if Inventory.count(state.slots, "coin") < cost.coins then return false end
	Inventory.remove(state.slots, cost.material, cost.amount)
	Inventory.remove(state.slots, "coin", cost.coins)
	return true
end

local function handleUpgrade(player: Player, x: number, y: number, slotIndex: number)
	local state = Services.Player.get(player)
	if not state or not playerNear(player, x, y) then return end
	if stationAt(x, y) ~= "anvil" then return end
	if slotIndex < 1 or slotIndex > Config.INV_SLOTS then return end

	local stack = state.slots[slotIndex]
	if not stack then return end
	if not Upgrades.canModify(stack.id) then
		Net.get("Notify"):FireClient(player, { text = "هذا العنصر غير قابل للتطوير", color = { 230, 160, 90 } })
		return
	end

	local level = Upgrades.levelOf(stack)
	local cost = Upgrades.upgradeCost(stack.id, level)
	if not cost then
		Net.get("Notify"):FireClient(player, { text = "بلغ العنصر أقصى تطوير (+" .. Upgrades.MAX_LEVEL .. ")", color = { 240, 200, 110 } })
		return
	end

	if not payCost(state, cost) then
		Net.get("Notify"):FireClient(player, {
			text = string.format("تحتاج %d × %s و %d عملة", cost.amount, Items.name(cost.material), cost.coins),
			color = { 230, 120, 100 },
		})
		return
	end

	stack.up = { lvl = level + 1, aff = if stack.up then stack.up.aff else nil }
	Services.Player.syncInventory(player)
	Services.Player.syncStats(player)
	Net.get("Notify"):FireClient(player, {
		text = Upgrades.displayName(stack) .. " — تمّ التطوير!",
		color = { 250, 210, 110 },
	})
	Net.get("Fx"):FireAllClients({ kind = "upgrade", x = state.body.x, y = state.body.y })
end

local function handleEnchant(player: Player, x: number, y: number, slotIndex: number)
	local state = Services.Player.get(player)
	if not state or not playerNear(player, x, y) then return end
	if stationAt(x, y) ~= "enchant" then return end
	if slotIndex < 1 or slotIndex > Config.INV_SLOTS then return end

	local stack = state.slots[slotIndex]
	if not stack then return end
	local category = Upgrades.categoryOf(stack.id)
	if not category then
		Net.get("Notify"):FireClient(player, { text = "هذا العنصر غير قابل للسحر", color = { 230, 160, 90 } })
		return
	end

	local cost = Upgrades.enchantCost(stack.id)
	if not cost then return end
	if not payCost(state, cost) then
		Net.get("Notify"):FireClient(player, {
			text = string.format("تحتاج %d × %s و %d عملة", cost.amount, Items.name(cost.material), cost.coins),
			color = { 230, 120, 100 },
		})
		return
	end

	local current = if stack.up then stack.up.aff else nil
	local affixId = Upgrades.rollAffix(category, math.random(), current)
	stack.up = { lvl = Upgrades.levelOf(stack), aff = affixId }

	Services.Player.syncInventory(player)
	Services.Player.syncStats(player)
	local affix = Upgrades.affix(affixId)
	Net.get("Notify"):FireClient(player, {
		text = Upgrades.displayName(stack) .. (if affix then " — " .. affix.desc else ""),
		color = { 190, 150, 250 },
	})
	Net.get("Fx"):FireAllClients({ kind = "enchant", x = state.body.x, y = state.body.y })
end

-- ===== كسر البلاطة =====

-- يُستدعى من WorldService قبل إزالة بلاطة: تتناثر محتويات الفرن
function StationService.onBlockRemoved(x: number, y: number)
	local k = key(x, y)
	local furnace = furnaces[k]
	local chest = chests[k]
	if not furnace and not chest then return end

	if furnace then
		furnaces[k] = nil
		for _, stack in { furnace.input, furnace.fuel, furnace.output } do
			if stack then
				Services.Entity.spawnItem(x + 0.5, y + 0.5, stack.id, stack.n)
			end
		end
	end

	if chest then
		chests[k] = nil
		for i = 1, CHEST_SLOTS do
			local stack = chest.slots[i]
			if stack then
				local upgrade = if stack.up then { lvl = stack.up.lvl, aff = stack.up.aff } else nil
				Services.Entity.spawnItem(x + 0.5, y + 0.5, stack.id, stack.n, nil, nil, nil, upgrade)
			end
		end
	end

	for player, view in viewing do
		if view.x == x and view.y == y then
			StationService.close(player)
		end
	end
	StationService.markDirty(x, y)
end

-- ===== الحفظ =====

local dirtyRegions: { [string]: boolean } = {}

function StationService.markDirty(x: number, y: number)
	local rx = (x // Config.CHUNK) // Config.REGION
	local ry = (y // Config.CHUNK) // Config.REGION
	dirtyRegions[rx .. "," .. ry] = true
end

function StationService.consumeDirtyRegions(): { [string]: boolean }
	local snapshot = dirtyRegions
	dirtyRegions = {}
	return snapshot
end

local function serializeStack(stack: Inventory.Stack?): any
	if not stack then return nil end
	local out: { any } = { stack.id, stack.n }
	if stack.up then
		out[3] = stack.up.lvl
		out[4] = stack.up.aff or ""
	end
	return out
end

local function deserializeStack(data: any): Inventory.Stack?
	if type(data) ~= "table" then return nil end
	local id, n = data[1], data[2]
	if type(id) ~= "string" or type(n) ~= "number" or n <= 0 then return nil end
	if not Items.get(id) then return nil end
	local stack: Inventory.Stack = { id = id, n = math.min(n, Items.maxStack(id)) }
	if type(data[3]) == "number" and Upgrades.canModify(id) then
		stack.up = Upgrades.normalize({ lvl = data[3], aff = data[4] })
	end
	return stack
end

function StationService.exportRegion(rx: number, ry: number): { [string]: any }?
	local out: { [string]: any } = {}
	local any = false
	local minX = rx * Config.REGION * Config.CHUNK
	local maxX = minX + Config.REGION * Config.CHUNK - 1
	local minY = ry * Config.REGION * Config.CHUNK
	local maxY = minY + Config.REGION * Config.CHUNK - 1

	for k, furnace in furnaces do
		if furnace.x >= minX and furnace.x <= maxX and furnace.y >= minY and furnace.y <= maxY then
			if furnace.input or furnace.fuel or furnace.output or furnace.burn > 0 then
				out[k] = {
					t = "f",
					i = serializeStack(furnace.input),
					f = serializeStack(furnace.fuel),
					o = serializeStack(furnace.output),
					b = math.floor(furnace.burn),
					bm = math.floor(furnace.burnMax),
					p = math.floor(furnace.progress * 10) / 10,
				}
				any = true
			end
		end
	end

	for k, chest in chests do
		if chest.x >= minX and chest.x <= maxX and chest.y >= minY and chest.y <= maxY then
			local packed = {}
			for i = 1, CHEST_SLOTS do
				local stack = chest.slots[i]
				if stack then
					table.insert(packed, { i, serializeStack(stack) })
				end
			end
			if #packed > 0 then
				out[k] = { t = "c", s = packed }
				any = true
			end
		end
	end

	return if any then out else nil
end

function StationService.importRegion(data: any)
	if type(data) ~= "table" then return end
	for k, entry in data do
		if type(k) == "string" and type(entry) == "table" then
			local parts = string.split(k, ",")
			local x, y = tonumber(parts[1]), tonumber(parts[2])
			if x and y then
				if entry.t == "c" then
					local slots = Inventory.new()
					if type(entry.s) == "table" then
						for _, pair in entry.s do
							local index = tonumber(pair[1])
							local stack = deserializeStack(pair[2])
							if index and stack and index >= 1 and index <= CHEST_SLOTS then
								slots[index] = stack
							end
						end
					end
					chests[k] = { x = x, y = y, slots = slots }
				else
					furnaces[k] = {
						x = x, y = y,
						input = deserializeStack(entry.i),
						fuel = deserializeStack(entry.f),
						output = deserializeStack(entry.o),
						burn = tonumber(entry.b) or 0,
						burnMax = tonumber(entry.bm) or 0,
						progress = tonumber(entry.p) or 0,
						progressMax = 0,
					}
				end
			end
		end
	end
end

-- ===== المعالجات =====

local function handleOpen(player: Player, x: number, y: number)
	if not playerNear(player, x, y) then
		Net.get("Notify"):FireClient(player, { text = "اقترب من المحطة", color = { 220, 180, 100 } })
		return
	end
	local kind = stationAt(x, y)
	if not kind then return end

	viewing[player] = { x = x, y = y, kind = kind }
	if kind == "furnace" then
		getFurnace(x, y, true)
	elseif kind == "chest" then
		getChest(x, y, true)
		Net.get("Fx"):FireAllClients({ kind = "chest_open", x = x + 0.5, y = y + 0.5 })
	end
	pushState(player)
end

function StationService.start()
	Net.get("Station").OnServerEvent:Connect(function(player, action, x, y, a, b)
		if action == "close" then
			StationService.close(player, true)
			return
		end
		if type(x) ~= "number" or type(y) ~= "number" then return end
		x, y = math.floor(x), math.floor(y)
		if not World.inBounds(x, y) then return end

		if action == "open" then
			handleOpen(player, x, y)
		elseif action == "give" then
			if type(a) == "number" and type(b) == "string" then
				handleGive(player, x, y, math.floor(a), b)
			end
		elseif action == "take" then
			if type(a) == "string" then
				handleTake(player, x, y, a)
			end
		elseif action == "upgrade" then
			if type(a) == "number" then
				handleUpgrade(player, x, y, math.floor(a))
			end
		elseif action == "enchant" then
			if type(a) == "number" then
				handleEnchant(player, x, y, math.floor(a))
			end
		elseif action == "chest_swap" then
			if type(a) == "number" and type(b) == "number" then
				handleChestSwap(player, x, y, math.floor(a), math.floor(b))
			end
		elseif action == "chest_deposit" then
			handleChestDeposit(player, x, y)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		viewing[player] = nil
	end)

	-- محاكاة الأفران
	local accumulator = 0
	local pushTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= TICK then
			local step = accumulator
			accumulator = 0
			for _, furnace in furnaces do
				local ok, err = pcall(stepFurnace, furnace, step)
				if not ok then
					warn("[StationService] خطأ في محاكاة الفرن: " .. tostring(err))
				end
			end
		end

		pushTimer += dt
		if pushTimer >= 1 / PUSH_HZ then
			pushTimer = 0
			for player, view in viewing do
				-- أغلق النافذة إن ابتعد اللاعب أو كُسرت المحطة
				if not playerNear(player, view.x, view.y) or stationAt(view.x, view.y) ~= view.kind then
					StationService.close(player)
				else
					pushState(player)
				end
			end
		end
	end)

	-- حفظ دوري لحالات الأفران يُحرّكه WorldService عبر consumeDirtyRegions
	task.spawn(function()
		while true do
			task.wait(20)
			for _, furnace in furnaces do
				if furnace.burn > 0 or furnace.progress > 0 then
					StationService.markDirty(furnace.x, furnace.y)
				end
			end
		end
	end)
end

function StationService.furnaceCount(): number
	local n = 0
	for _ in furnaces do n += 1 end
	return n
end

function StationService.chestCount(): number
	local n = 0
	for _ in chests do n += 1 end
	return n
end

StationService.CHEST_SLOTS = CHEST_SLOTS

return StationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">TimeService</string>
          <string name="Source"><![CDATA[--!strict
--[[ TimeService — دورة الليل والنهار ومزامنتها مع العملاء. ]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local TimeService = {}

local timeOfDay = Config.DAY_START -- 0..1
local dayCount = 1
local accumulator = 0
local bloodMoon = false

function TimeService.get(): number
	return timeOfDay
end

function TimeService.day(): number
	return dayCount
end

function TimeService.isNight(): boolean
	return timeOfDay >= Config.NIGHT_FROM or timeOfDay < Config.NIGHT_TO
end

function TimeService.isBloodMoon(): boolean
	return bloodMoon
end

-- شدة ضوء الشمس 0..1 مع فجر وغسق متدرجين
function TimeService.sunlight(): number
	local t = timeOfDay
	if t >= 0.27 and t <= 0.73 then return 1 end
	if t > 0.73 and t < Config.NIGHT_FROM then
		return 1 - (t - 0.73) / (Config.NIGHT_FROM - 0.73)
	end
	if t > Config.NIGHT_TO and t < 0.27 then
		return (t - Config.NIGHT_TO) / (0.27 - Config.NIGHT_TO)
	end
	return 0
end

function TimeService.set(t: number)
	timeOfDay = t % 1
	TimeService.broadcast()
end

function TimeService.broadcast(player: Player?)
	local payload = { t = timeOfDay, day = dayCount, blood = bloodMoon }
	local remote = Net.get("TimeSync")
	if player then
		remote:FireClient(player, payload)
	else
		remote:FireAllClients(payload)
	end
end

function TimeService.start()
	local wasNight = TimeService.isNight()

	RunService.Heartbeat:Connect(function(dt)
		timeOfDay += dt / Config.DAY_LENGTH
		if timeOfDay >= 1 then
			timeOfDay -= 1
			dayCount += 1
		end

		local night = TimeService.isNight()
		if night ~= wasNight then
			wasNight = night
			if night then
				-- قمر الدم: ليلة عنيفة باحتمال 10% بعد اليوم الثالث
				bloodMoon = dayCount >= 3 and math.random() < 0.10
				if bloodMoon then
					Net.get("Notify"):FireAllClients({
						text = "قمر الدم يرتفع… الوحوش أقوى الليلة!",
						color = { 220, 60, 60 },
						big = true,
					})
				end
			else
				bloodMoon = false
			end
			TimeService.broadcast()
		end

		accumulator += dt
		if accumulator >= 5 then
			accumulator = 0
			TimeService.broadcast()
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.wait(1)
		TimeService.broadcast(player)
	end)
end

function TimeService.serialize(): { t: number, day: number }
	return { t = timeOfDay, day = dayCount }
end

function TimeService.load(data: any)
	if type(data) == "table" then
		if type(data.t) == "number" then timeOfDay = data.t % 1 end
		if type(data.day) == "number" then dayCount = math.max(1, math.floor(data.day)) end
	end
end

return TimeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	WorldService — مرجع الحقيقة للعالم على الخادم.

	مسؤولياته:
	* امتلاك نسخة World الموثوقة وحفظ/تحميل تعديلات اللاعبين بالمناطق.
	* التحقق من كل طلب تعدين أو بناء (مدى، أداة، سرعة، أحقية العنصر).
	* بثّ تغيّرات البلاطات للاعبين القريبين فقط.
	* محاكاة السوائل وسقوط البلاطات غير المسنودة.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Chunk = require(Shared.Chunk)
local Config = require(Shared.Config)
local Inventory = require(Shared.Inventory)
local Items = require(Shared.Items)
local Mining = require(Shared.Mining)
local Net = require(Shared.Net)
local Upgrades = require(Shared.Upgrades)
local Util = require(Shared.Util)
local World = require(Shared.World)
local WorldGen = require(Shared.WorldGen)

local Services = require(script.Parent.Services)
local SaveService = require(script.Parent.SaveService)

local B = Blocks.ID
local SIZE = Config.CHUNK

local WorldService = {}

local world: World.World
local seed: number = 0
local spawnX, spawnY = 0, 0

-- حالة المناطق: nil | "loading" | "ready"
local regionState: { [string]: string } = {}
local dirtyRegions: { [string]: boolean } = {}

-- اشتراكات القطع لكل لاعب (لتقليل البث)
local subs: { [Player]: { [string]: boolean } } = {}

-- عدّاد مضاد للغش
type EditGuard = { tokens: number, last: number, lastBreak: number }
local guards: { [Player]: EditGuard } = {}

-- طابور محاكاة السوائل
local liquidQueue: { [string]: boolean } = {}
local liquidOrder: { { number } } = {}

function WorldService.getWorld(): World.World
	return world
end

function WorldService.getSeed(): number
	return seed
end

function WorldService.getSpawn(): (number, number)
	return spawnX, spawnY
end

-- ===== المناطق =====

local function regionOf(cx: number, cy: number): (number, number)
	return cx // Config.REGION, cy // Config.REGION
end

local function regionKey(rx: number, ry: number): string
	return rx .. "," .. ry
end

local function ensureRegion(rx: number, ry: number)
	local key = regionKey(rx, ry)
	local state = regionState[key]
	if state == "ready" then return end
	if state == "loading" then
		local guard = 0
		while regionState[key] == "loading" and guard < 600 do
			task.wait(0.05)
			guard += 1
		end
		return
	end

	regionState[key] = "loading"
	local data = SaveService.loadRegion(rx, ry)
	if type(data) == "table" then
		-- الصيغة الحالية: { tiles = {...}, stations = {...} }
		-- الصيغة الأقدم: خريطة مسطّحة من مفتاح القطعة إلى التعديلات
		local tiles = if type(data.tiles) == "table" then data.tiles else data
		for chunkKey, flat in tiles do
			if type(flat) == "table" then
				local cx, cy = Chunk.parseKey(chunkKey)
				World.applyEncodedDiff(world, cx, cy, flat)
			end
		end
		if type(data.stations) == "table" and Services.Station then
			Services.Station.importRegion(data.stations)
		end
	end
	regionState[key] = "ready"
end

local function markDirty(cx: number, cy: number)
	local rx, ry = regionOf(cx, cy)
	dirtyRegions[regionKey(rx, ry)] = true
end

function WorldService.saveDirtyRegions()
	-- ادمج المناطق التي غيّرتها المحطات (محتويات الأفران)
	if Services.Station then
		for key in Services.Station.consumeDirtyRegions() do
			dirtyRegions[key] = true
		end
	end

	local pending = {}
	for key in dirtyRegions do
		table.insert(pending, key)
	end
	table.clear(dirtyRegions)

	for _, key in pending do
		local parts = string.split(key, ",")
		local rx, ry = tonumber(parts[1]) or 0, tonumber(parts[2]) or 0
		local tiles: { [string]: { number } } = {}
		local any = false
		for cy = ry * Config.REGION, (ry + 1) * Config.REGION - 1 do
			for cx = rx * Config.REGION, (rx + 1) * Config.REGION - 1 do
				local flat = World.encodeDiff(world, cx, cy)
				if flat and #flat > 0 then
					tiles[Chunk.keyOf(cx, cy)] = flat
					any = true
				end
			end
		end

		local stations = if Services.Station then Services.Station.exportRegion(rx, ry) else nil
		if any or stations then
			SaveService.saveRegion(rx, ry, { tiles = tiles, stations = stations } :: any)
		end
		task.wait(0.12) -- احترام حدود معدّل DataStore
	end
end

-- ===== الاشتراكات والبثّ =====

local function chunkKeyOfTile(x: number, y: number): string
	return Chunk.keyOf(x // SIZE, y // SIZE)
end

local function broadcastBlock(x: number, y: number, fg: number, bg: number)
	local key = chunkKeyOfTile(x, y)
	local remote = Net.get("BlockUpdate")
	for player, set in subs do
		if set[key] then
			remote:FireClient(player, x, y, fg, bg)
		end
	end
end

-- ===== تعديل البلاطات (داخلي، بلا تحقق) =====

function WorldService.setTile(x: number, y: number, fg: number, bg: number)
	if not World.inBounds(x, y) then return end
	local oldFg = World.fg(world, x, y)
	local oldBg = World.bg(world, x, y)
	if oldFg == fg and oldBg == bg then return end

	World.set(world, x, y, fg, bg)
	markDirty(x // SIZE, y // SIZE)
	broadcastBlock(x, y, fg, bg)

	-- أيقظ السوائل والبلاطات المعلّقة حول التغيير
	WorldService.wakeLiquid(x, y)
	for _, offset in { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
		WorldService.wakeLiquid(x + offset[1], y + offset[2])
	end
	if fg == B.AIR then
		WorldService.checkSupport(x, y - 1)
		WorldService.checkSupport(x - 1, y)
		WorldService.checkSupport(x + 1, y)
	end
end

-- بلاطة تحتاج سنداً وفقدته -> تنكسر وتسقط كغرض
function WorldService.checkSupport(x: number, y: number)
	local id = World.fg(world, x, y)
	if not Blocks.needsSupport(id) then return end
	local below = World.fg(world, x, y + 1)
	local left = World.fg(world, x - 1, y)
	local right = World.fg(world, x + 1, y)
	local wall = World.bg(world, x, y)
	local supported = Blocks.isSolid(below) or Blocks.isSolid(left) or Blocks.isSolid(right) or wall ~= B.AIR
	if not supported then
		local drop = Items.fromBlock(id)
		WorldService.setTile(x, y, B.AIR, wall)
		if drop and Services.Entity then
			Services.Entity.spawnItem(x + 0.5, y + 0.5, drop, 1)
		end
	end
end

-- ===== محاكاة السوائل =====
--[[
	سائل بمستويات حقيقية (1..8) محفوظ في البتّات العليا من معرّف البلاطة.
	القواعد ثلاث فقط، وهي كافية لسلوك مقنع:
	  1. السائل يهبط إلى ما تحته حتى يمتلئ.
	  2. إن لم يستطع الهبوط، يتسوّى أفقياً مع جاره الأقل منه.
	  3. الماء + الحمم = سبج.
	الكتلة محفوظة تماماً: كل وحدة تُنقل تُطرح من مصدرها وتُضاف لهدفها،
	فلا يتكاثر الماء ولا يتبخّر (هناك اختبار يتحقق من ذلك).
]]

function WorldService.wakeLiquid(x: number, y: number)
	if not World.inBounds(x, y) then return end
	local key = x .. "," .. y
	if liquidQueue[key] then return end
	if not Blocks.isLiquid(World.fg(world, x, y)) then return end
	liquidQueue[key] = true
	table.insert(liquidOrder, { x, y })
end

-- كتابة سائل عبر المسار الرسمي حتى يُبثّ ويُحفظ
local function setLiquidTile(x: number, y: number, id: number, level: number)
	local bg = World.bg(world, x, y)
	if level <= 0 then
		WorldService.setTile(x, y, B.AIR, bg)
		return
	end
	local clamped = math.min(math.floor(level), World.LIQUID_FULL)
	WorldService.setTile(x, y, id + bit32.lshift(clamped, World.LIQUID_SHIFT), bg)
end

WorldService.setLiquidTile = setLiquidTile

local function obsidianAt(x: number, y: number)
	WorldService.setTile(x, y, B.OBSIDIAN, World.bg(world, x, y))
end

-- يحاول تحويل التقاء الماء بالحمم إلى سبج؛ يُعيد true إن حدث تفاعل
local function reactLiquids(x: number, y: number, id: number): boolean
	for _, offset in { { 0, 1 }, { 0, -1 }, { -1, 0 }, { 1, 0 } } do
		local nx, ny = x + offset[1], y + offset[2]
		local other = World.fg(world, nx, ny)
		if Blocks.isLiquid(other) and other ~= id then
			-- الحمم هي التي تتصلّب، والماء يتبخّر عند نقطة التماس
			if id == B.LAVA then
				obsidianAt(x, y)
			else
				obsidianAt(nx, ny)
				setLiquidTile(x, y, id, 0)
			end
			return true
		end
	end
	return false
end

local function stepLiquids()
	local budget = 300
	local processed = 0

	while processed < budget and #liquidOrder > 0 do
		local cell = table.remove(liquidOrder, 1)
		if not cell then break end
		local x, y = cell[1], cell[2]
		liquidQueue[x .. "," .. y] = nil
		processed += 1

		local id = World.fg(world, x, y)
		if not Blocks.isLiquid(id) then continue end

		local level = World.liquidLevel(world, x, y)
		if level <= 0 then
			setLiquidTile(x, y, id, 0)
			continue
		end

		if reactLiquids(x, y, id) then continue end

		-- 1) الهبوط
		local belowId = World.fg(world, x, y + 1)
		if belowId == id then
			local belowLevel = World.liquidLevel(world, x, y + 1)
			if belowLevel < World.LIQUID_FULL then
				local move = math.min(level, World.LIQUID_FULL - belowLevel)
				setLiquidTile(x, y + 1, id, belowLevel + move)
				setLiquidTile(x, y, id, level - move)
				continue
			end
		elseif Blocks.isReplaceable(belowId) and not Blocks.isLiquid(belowId) then
			setLiquidTile(x, y + 1, id, level)
			setLiquidTile(x, y, id, 0)
			continue
		end

		-- 2) التسوية الأفقية (وحدة أو أكثر نحو الجار الأقل)
		local dirs: { number } = if math.random() < 0.5 then { -1, 1 } else { 1, -1 }
		local remaining = level
		for _, dx in dirs do
			if remaining <= 1 then break end
			local sideId = World.fg(world, x + dx, y)
			local sideLevel = 0
			local canFlow = false

			if sideId == id then
				sideLevel = World.liquidLevel(world, x + dx, y)
				canFlow = sideLevel < remaining - 1
			elseif Blocks.isReplaceable(sideId) and not Blocks.isLiquid(sideId) then
				canFlow = true
			end

			if canFlow then
				local gap = remaining - sideLevel
				local move = math.max(1, gap // 3)
				move = math.min(move, remaining - 1, World.LIQUID_FULL - sideLevel)
				if move > 0 then
					setLiquidTile(x + dx, y, id, sideLevel + move)
					remaining -= move
				end
			end
		end

		if remaining ~= level then
			setLiquidTile(x, y, id, remaining)
		end
	end
end

-- ===== قطع الأشجار =====
-- كسر جذع يُسقط الشجرة كلها (كما في تيراريا) بدل تركها معلّقة في الهواء.
local function fellTree(x: number, y: number): number
	local logs = 0
	local cursor = y
	while cursor > Config.SKY_TOP and logs < 40 do
		if World.fg(world, x, cursor) ~= B.LOG then break end
		WorldService.setTile(x, cursor, B.AIR, World.bg(world, x, cursor))
		logs += 1
		cursor -= 1
	end
	-- نظّف الأوراق المحيطة بالتاج
	for dy = -5, 2 do
		for dx = -4, 4 do
			local lx, ly = x + dx, cursor + dy
			if World.fg(world, lx, ly) == B.LEAVES then
				WorldService.setTile(lx, ly, B.AIR, World.bg(world, lx, ly))
				if math.random() < 0.12 and Services.Entity then
					Services.Entity.spawnItem(lx + 0.5, ly + 0.5, "sapling", 1)
				end
			end
		end
	end
	return logs
end

-- ===== حساب زمن الكسر =====

function WorldService.breakTime(blockId: number, itemId: string?, miningMult: number?): number?
	return Mining.breakTime(blockId, itemId, miningMult)
end

-- ===== التحقق من الطلبات =====

local function getGuard(player: Player): EditGuard
	local guard = guards[player]
	if not guard then
		guard = { tokens = Config.MAX_EDITS_PER_SEC, last = os.clock(), lastBreak = 0 }
		guards[player] = guard
	end
	return guard
end

local function consumeToken(player: Player): boolean
	local guard = getGuard(player)
	local now = os.clock()
	guard.tokens = math.min(Config.MAX_EDITS_PER_SEC, guard.tokens + (now - guard.last) * Config.MAX_EDITS_PER_SEC)
	guard.last = now
	if guard.tokens < 1 then return false end
	guard.tokens -= 1
	return true
end

-- كسر بلاطة بناءً على طلب لاعب
local function handleBreak(player: Player, x: number, y: number, layer: string)
	local state = Services.Player.get(player)
	if not state or state.dead then return end
	if not World.inBounds(x, y) then return end
	if y >= Config.BEDROCK_Y then return end

	local held = Services.Player.heldItem(player)
	local heldId = if held then held.id else nil

	local px, py = state.body.x, state.body.y
	local reach = Config.REACH + Upgrades.reachBonus(held) + 1.2
	if Util.dist(px, py, x + 0.5, y + 0.5) > reach then return end
	if not consumeToken(player) then return end

	if layer == "wall" then
		local item = if heldId then Items.get(heldId) else nil
		if not item or item.tool ~= "hammer" then return end
		local wall = World.bg(world, x, y)
		if wall == B.AIR or wall == B.BEDROCK then return end
		local now = os.clock()
		local guard = getGuard(player)
		if now - guard.lastBreak < 0.18 then return end
		guard.lastBreak = now
		WorldService.setTile(x, y, World.fg(world, x, y), B.AIR)
		local drop = Items.fromBlock(wall)
		if drop then
			Services.Player.giveItem(player, drop, 1, x + 0.5, y + 0.5)
		end
		Net.get("Fx"):FireAllClients({ kind = "break", x = x, y = y, block = wall })
		return
	end

	local blockId = World.fg(world, x, y)
	if blockId == B.AIR or Blocks.isLiquid(blockId) then return end

	local buffs = Services.Player.buffAggregate(player)
	local required = Mining.breakTime(
		blockId,
		heldId,
		buffs.mining * Upgrades.miningMultiplier(held),
		Upgrades.powerBonus(held)
	)
	if not required then
		Net.get("Notify"):FireClient(player, { text = "تحتاج معولاً أقوى", color = { 230, 160, 80 } })
		return
	end

	-- تحقق زمني متسامح مع زمن الشبكة: لا يمكن كسر أسرع من 75% من الزمن المطلوب
	local now = os.clock()
	local guard = getGuard(player)
	if now - guard.lastBreak < required * 0.75 then return end
	guard.lastBreak = now

	local block = Blocks.get(blockId)
	local wall = World.bg(world, x, y)
	local extraLogs = 0

	-- محطة ذات حالة: انثر محتوياتها قبل إزالتها
	if block.station and Services.Station then
		Services.Station.onBlockRemoved(x, y)
	end

	if blockId == B.LOG then
		extraLogs = fellTree(x, y) - 1
	else
		WorldService.setTile(x, y, B.AIR, wall)
	end

	-- الإسقاط
	local dropBlock = block.drop or blockId
	local dropItem = Items.fromBlock(dropBlock)
	local chance = block.dropChance or 1
	if dropItem and math.random() <= chance then
		local count = 1
		if blockId == B.LOG then
			count = 1 + math.max(0, extraLogs)
			dropItem = "wood"
		elseif blockId == B.COAL_ORE then
			dropItem = "coal"
		elseif blockId == B.DIAMOND_ORE then
			dropItem = "diamond"
			count = math.random(1, 2)
		elseif blockId == B.GRASS_TUFT or blockId == B.FLOWER then
			dropItem = if math.random() < 0.35 then "herb" else dropItem
		end
		-- صفة «موفّق»: فرصة مضاعفة الإسقاط
		local fortune = Upgrades.fortune(held)
		if fortune > 0 and math.random() < fortune then
			count *= 2
		end
		Services.Player.giveItem(player, dropItem, count, x + 0.5, y + 0.5)
	end

	state.blocksMined += 1
	Net.get("Fx"):FireAllClients({ kind = "break", x = x, y = y, block = blockId })
end

-- وضع بلاطة
local function handlePlace(player: Player, x: number, y: number, layer: string, slotIndex: number)
	local state = Services.Player.get(player)
	if not state or state.dead then return end
	if not World.inBounds(x, y) then return end
	if y >= Config.BEDROCK_Y or y < Config.SKY_TOP then return end

	local px, py = state.body.x, state.body.y
	local reach = Config.REACH + Upgrades.reachBonus(Services.Player.heldItem(player)) + 1.2
	if Util.dist(px, py, x + 0.5, y + 0.5) > reach then return end
	if not consumeToken(player) then return end

	local stack = state.slots[slotIndex]
	if not stack then return end
	local item = Items.get(stack.id)
	if not item or not item.place then return end

	local now = os.clock()
	local guard = getGuard(player)
	if now - guard.lastBreak < 0.1 then return end
	guard.lastBreak = now

	local blockId = item.place
	local block = Blocks.get(blockId)

	if layer == "wall" then
		if not item.wall then return end
		if World.bg(world, x, y) ~= B.AIR then return end
		-- الجدران تحتاج جواراً
		local neighbour = World.bg(world, x - 1, y) ~= B.AIR or World.bg(world, x + 1, y) ~= B.AIR
			or World.bg(world, x, y - 1) ~= B.AIR or World.bg(world, x, y + 1) ~= B.AIR
			or Blocks.isSolid(World.fg(world, x, y))
		if not neighbour then return end
		Inventory.removeFromSlot(state.slots, slotIndex, 1)
		WorldService.setTile(x, y, World.fg(world, x, y), blockId)
		Services.Player.syncInventory(player)
		return
	end

	local existing = World.fg(world, x, y)
	if not Blocks.isReplaceable(existing) then return end

	-- لا تبنِ داخل جسد لاعب أو وحش
	if block.solid then
		for _, other in Players:GetPlayers() do
			local otherState = Services.Player.get(other)
			if otherState and not otherState.dead then
				local body = otherState.body
				if math.abs(body.x - (x + 0.5)) < (body.w / 2 + 0.5)
					and math.abs(body.y - (y + 0.5)) < (body.h / 2 + 0.5) then
					return
				end
			end
		end
		if Services.Entity.blockedBy(x, y) then return end
	end

	-- يجب أن تلتصق البلاطة بشيء (بلاطة مجاورة أو جدار خلفي)
	local attached = Blocks.isSolid(World.fg(world, x - 1, y)) or Blocks.isSolid(World.fg(world, x + 1, y))
		or Blocks.isSolid(World.fg(world, x, y - 1)) or Blocks.isSolid(World.fg(world, x, y + 1))
		or World.bg(world, x, y) ~= B.AIR
		or Blocks.isPlatform(World.fg(world, x - 1, y)) or Blocks.isPlatform(World.fg(world, x + 1, y))
	if not attached then return end

	if Blocks.needsSupport(blockId) then
		local ok = Blocks.isSolid(World.fg(world, x, y + 1)) or Blocks.isSolid(World.fg(world, x - 1, y))
			or Blocks.isSolid(World.fg(world, x + 1, y)) or World.bg(world, x, y) ~= B.AIR
		if not ok then return end
	end

	Inventory.removeFromSlot(state.slots, slotIndex, 1)
	WorldService.setTile(x, y, blockId, World.bg(world, x, y))
	Services.Player.syncInventory(player)
	Net.get("Fx"):FireAllClients({ kind = "place", x = x, y = y, block = blockId })
end

-- ===== الاشتراك في القطع =====

local function handleRequestChunks(player: Player, keys: { string })
	if type(keys) ~= "table" or #keys > 80 then return end
	local set = subs[player]
	if not set then
		set = {}
		subs[player] = set
	end

	local remote = Net.get("ChunkDiff")
	for _, key in keys do
		if type(key) == "string" and not set[key] then
			local cx, cy = Chunk.parseKey(key)
			if cx >= 0 and cy >= 0 and cx < Config.CHUNKS_X and cy < Config.CHUNKS_Y then
				set[key] = true
				local rx, ry = regionOf(cx, cy)
				ensureRegion(rx, ry)
				local flat = World.encodeDiff(world, cx, cy)
				remote:FireClient(player, cx, cy, flat or {})
			end
		end
	end
end

local function handleDropSubs(player: Player, keys: { string })
	local set = subs[player]
	if not set then return end
	for _, key in keys do
		set[key] = nil
	end
end

-- ===== الإقلاع =====

function WorldService.start()
	-- البذرة: ثابتة عبر كل الخوادم حتى يكون العالم واحداً للجميع
	local meta = SaveService.loadMeta()
	if type(meta) == "table" and type(meta.seed) == "number" then
		seed = meta.seed
		Services.Time.load(meta.time)
	else
		seed = math.random(1, 2 ^ 30)
		SaveService.saveMeta({ seed = seed, time = Services.Time.serialize(), created = os.time() })
	end

	world = World.new(seed, 900)
	spawnX, spawnY = WorldGen.spawnPoint(seed)

	-- حمّل منطقة الظهور مسبقاً
	task.spawn(function()
		local cx, cy = math.floor(spawnX) // SIZE, math.floor(spawnY) // SIZE
		ensureRegion(regionOf(cx, cy))
	end)

	Net.get("RequestChunks").OnServerEvent:Connect(function(player, keys, drop)
		if drop == true then
			handleDropSubs(player, keys)
		else
			handleRequestChunks(player, keys)
		end
	end)

	Net.get("Edit").OnServerEvent:Connect(function(player, action, x, y, layer, slotIndex)
		if type(x) ~= "number" or type(y) ~= "number" then return end
		x, y = math.floor(x), math.floor(y)
		if action == "break" then
			handleBreak(player, x, y, if layer == "wall" then "wall" else "fg")
		elseif action == "place" then
			if type(slotIndex) ~= "number" then return end
			slotIndex = math.floor(slotIndex)
			if slotIndex < 1 or slotIndex > Config.INV_SLOTS then return end
			handlePlace(player, x, y, if layer == "wall" then "wall" else "fg", slotIndex)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		subs[player] = nil
		guards[player] = nil
	end)

	-- محاكاة السوائل
	task.spawn(function()
		while true do
			task.wait(0.1)
			local ok, err = pcall(stepLiquids)
			if not ok then warn("[WorldService] خطأ في محاكاة السوائل: " .. tostring(err)) end
		end
	end)

	-- الحفظ التلقائي
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE)
			local ok, err = pcall(WorldService.saveDirtyRegions)
			if not ok then warn("[WorldService] فشل الحفظ التلقائي: " .. tostring(err)) end
			SaveService.saveMeta({ seed = seed, time = Services.Time.serialize(), created = os.time() })
		end
	end)

	game:BindToClose(function()
		pcall(WorldService.saveDirtyRegions)
		pcall(function()
			SaveService.saveMeta({ seed = seed, time = Services.Time.serialize(), created = os.time() })
		end)
	end)

	RunService.Heartbeat:Connect(function()
		-- لا شيء دائم هنا؛ محجوز لتوسعات مستقبلية (نمو النباتات، إلخ)
	end)

	-- نمو النباتات والشتلات
	task.spawn(function()
		while true do
			task.wait(6)
			for player, set in subs do
				local state = Services.Player.get(player)
				if state then
					for _ = 1, 3 do
						local gx = math.floor(state.body.x) + math.random(-30, 30)
						local gy = math.floor(state.body.y) + math.random(-16, 16)
						if World.inBounds(gx, gy) then
							local id = World.fg(world, gx, gy)
							if id == B.SAPLING and Blocks.isSolid(World.fg(world, gx, gy + 1)) then
								if math.random() < 0.25 then
									-- تنمو الشتلة إلى جذع صغير
									WorldService.setTile(gx, gy, B.LOG, World.bg(world, gx, gy))
									for i = 1, math.random(4, 7) do
										if World.fg(world, gx, gy - i) == B.AIR then
											WorldService.setTile(gx, gy - i, B.LOG, World.bg(world, gx, gy - i))
										end
									end
								end
							elseif id == B.AIR and World.fg(world, gx, gy + 1) == B.GRASS then
								if math.random() < 0.06 then
									WorldService.setTile(gx, gy, B.GRASS_TUFT, World.bg(world, gx, gy))
								end
							end
						end
					end
				end
			end
		end
	end)
end

WorldService.ensureRegionAt = function(x: number, y: number)
	ensureRegion(regionOf(x // SIZE, y // SIZE))
end

return WorldService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="35">

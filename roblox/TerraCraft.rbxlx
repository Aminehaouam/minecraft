      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Buffs</string>
          <string name="Source"><![CDATA[--!strict
--[[ Buffs — التعزيزات والتأثيرات المؤقتة. ]]

local Buffs = {}

export type BuffDef = {
	id: string,
	name: string,
	color: Color3,
	good: boolean,
	speed: number?, -- مضاعف سرعة المشي
	jump: number?,
	defense: number?,
	regen: number?, -- حياة/ثانية
	light: number?, -- توهج حول اللاعب
	dps: number?, -- ضرر مستمر
	mining: number?, -- مضاعف سرعة التعدين
	blockPotion: boolean?,
}

local defs: { [string]: BuffDef } = {
	swift = { id = "swift", name = "سرعة", color = Color3.fromRGB(120, 226, 140), good = true, speed = 1.28, jump = 1.08 },
	iron_skin = { id = "iron_skin", name = "جلد حديدي", color = Color3.fromRGB(180, 180, 200), good = true, defense = 8 },
	shine = { id = "shine", name = "توهج", color = Color3.fromRGB(250, 240, 160), good = true, light = 9 },
	regeneration = { id = "regeneration", name = "تجدد", color = Color3.fromRGB(240, 120, 160), good = true, regen = 2.5 },
	haste = { id = "haste", name = "خفة", color = Color3.fromRGB(240, 200, 120), good = true, mining = 1.35 },
	potion_sickness = { id = "potion_sickness", name = "إجهاد الجرعات", color = Color3.fromRGB(150, 120, 160), good = false, blockPotion = true },
	burn = { id = "burn", name = "احتراق", color = Color3.fromRGB(250, 120, 60), good = false, dps = 4 },
	slow = { id = "slow", name = "تباطؤ", color = Color3.fromRGB(120, 140, 170), good = false, speed = 0.6 },
	poison = { id = "poison", name = "تسمم", color = Color3.fromRGB(140, 200, 90), good = false, dps = 2.5 },
	well_fed = { id = "well_fed", name = "شبع", color = Color3.fromRGB(230, 180, 120), good = true, regen = 0.8, speed = 1.05 },
}

Buffs.defs = defs

function Buffs.get(id: string): BuffDef?
	return defs[id]
end

-- يجمع تأثيرات مجموعة تعزيزات نشطة
export type Aggregate = {
	speed: number,
	jump: number,
	defense: number,
	regen: number,
	light: number,
	dps: number,
	mining: number,
	blockPotion: boolean,
}

function Buffs.aggregate(active: { [string]: number }): Aggregate
	local agg: Aggregate = {
		speed = 1, jump = 1, defense = 0, regen = 0,
		light = 0, dps = 0, mining = 1, blockPotion = false,
	}
	for id, remaining in active do
		if remaining > 0 then
			local buff = defs[id]
			if buff then
				if buff.speed then agg.speed *= buff.speed end
				if buff.jump then agg.jump *= buff.jump end
				if buff.defense then agg.defense += buff.defense end
				if buff.regen then agg.regen += buff.regen end
				if buff.light then agg.light = math.max(agg.light, buff.light) end
				if buff.dps then agg.dps += buff.dps end
				if buff.mining then agg.mining *= buff.mining end
				if buff.blockPotion then agg.blockPotion = true end
			end
		end
	end
	return agg
end

return Buffs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Chunk</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Chunk — تخزين مضغوط لبيانات القطعة داخل buffer.
	كل بلاطة 4 بايت: u16 للطبقة الأمامية + u16 للجدار الخلفي.
	هذا يقلّل الذاكرة ~10 أضعاف مقارنة بجداول Lua ويجعل النسخ عبر الشبكة رخيصاً.
]]

local Config = require(script.Parent.Config)

local Chunk = {}

local SIZE = Config.CHUNK
local AREA = SIZE * SIZE
Chunk.SIZE = SIZE
Chunk.AREA = AREA
Chunk.BYTES = AREA * 4

export type Data = buffer

function Chunk.create(): Data
	return buffer.create(Chunk.BYTES)
end

-- فهرس محلي 0..AREA-1 من إحداثيات محلية
function Chunk.index(lx: number, ly: number): number
	return ly * SIZE + lx
end

function Chunk.localOf(x: number, y: number): (number, number)
	return x % SIZE, y % SIZE
end

function Chunk.keyOf(cx: number, cy: number): string
	return cx .. ":" .. cy
end

function Chunk.parseKey(key: string): (number, number)
	local a, b = string.match(key, "^(-?%d+):(-?%d+)$")
	return tonumber(a) or 0, tonumber(b) or 0
end

function Chunk.getFg(data: Data, index: number): number
	return buffer.readu16(data, index * 4)
end

function Chunk.getBg(data: Data, index: number): number
	return buffer.readu16(data, index * 4 + 2)
end

function Chunk.setFg(data: Data, index: number, id: number)
	buffer.writeu16(data, index * 4, id)
end

function Chunk.setBg(data: Data, index: number, id: number)
	buffer.writeu16(data, index * 4 + 2, id)
end

function Chunk.fill(data: Data, fg: number, bg: number)
	for i = 0, AREA - 1 do
		buffer.writeu16(data, i * 4, fg)
		buffer.writeu16(data, i * 4 + 2, bg)
	end
end

function Chunk.clone(data: Data): Data
	local out = buffer.create(Chunk.BYTES)
	buffer.copy(out, 0, data, 0, Chunk.BYTES)
	return out
end

return Chunk
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Config — كل الأرقام القابلة للضبط في اللعبة.
	غيّر من هنا فقط؛ لا تنثر الأرقام السحرية في بقية الملفات.
]]

local Config = {}

-- ===== العالم =====
Config.WORLD_NAME = "TerraCraft"
Config.WORLD_W = 2048 -- عرض العالم بالبلاطات
Config.WORLD_H = 512 -- عمق العالم بالبلاطات
Config.CHUNK = 32 -- حجم القطعة (chunk) بالبلاطات
Config.CHUNKS_X = Config.WORLD_W // Config.CHUNK
Config.CHUNKS_Y = Config.WORLD_H // Config.CHUNK
Config.REGION = 8 -- عدد القطع في كل منطقة حفظ (8x8)

-- طبقات العالم (إحداثي Y يزداد للأسفل)
Config.SKY_TOP = 8 -- أعلى حد للبناء
Config.SURFACE = 150 -- متوسط ارتفاع السطح
Config.SURFACE_AMP = 26 -- تضاريس السطح
Config.DIRT_DEPTH = 70 -- سماكة التراب تحت السطح
Config.CAVERN_Y = 300 -- بداية طبقة الكهوف العميقة
Config.HELL_Y = 460 -- بداية طبقة الجحيم
Config.BEDROCK_Y = Config.WORLD_H - 3

-- ===== العرض =====
Config.TILES_ON_SCREEN_Y = 24 -- ثابت الزوم: كم بلاطة تظهر رأسياً
Config.RENDER_PAD = 2 -- بلاطات إضافية خارج الشاشة
Config.LIGHT_PAD = 8 -- هامش حساب الإضاءة (يمنع ظهور حافة مضيئة عند طرف الشاشة)
Config.MAX_LIGHT = 15
Config.LIGHT_HZ = 15 -- أقصى معدل لإعادة حساب الإضاءة
Config.CAMERA_SMOOTH = 12 -- نعومة تتبع الكاميرا

-- ===== الفيزياء (بالبلاطة/الثانية) =====
Config.GRAVITY = 62
Config.MAX_FALL = 46
Config.WALK_SPEED = 9.2
Config.WALK_ACCEL = 62
Config.AIR_ACCEL = 28
Config.GROUND_FRICTION = 58
Config.AIR_FRICTION = 6
Config.JUMP_VELOCITY = 21.5
Config.JUMP_HOLD_TIME = 0.16 -- قفزة متغيرة الارتفاع
Config.COYOTE_TIME = 0.10
Config.JUMP_BUFFER = 0.12
Config.STEP_UP = 1 -- صعود تلقائي لبلاطة واحدة
Config.SWIM_SPEED = 5.5
Config.WATER_DRAG = 0.72
Config.FALL_SAFE = 12 -- بلاطات سقوط بلا ضرر
Config.FALL_DMG_PER_TILE = 6

-- ===== اللاعب =====
Config.PLAYER_W = 1.6
Config.PLAYER_H = 2.8
Config.REACH = 6.5 -- مدى التعدين/البناء بالبلاطات
Config.BASE_HP = 100
Config.BASE_MANA = 40
Config.MANA_REGEN = 3.5
Config.HP_REGEN = 1.1 -- نقطة/ثانية عند الشبع
Config.HP_REGEN_DELAY = 5 -- ثوانٍ بعد آخر ضرر
Config.FOOD_MAX = 100
Config.FOOD_DRAIN = 0.16 -- نقطة/ثانية (شريط ممتلئ ≈ 10 دقائق)
Config.STARVE_DPS = 1.5
Config.RESPAWN_TIME = 5
Config.IFRAMES = 0.55
Config.DROWN_TIME = 12
Config.DROWN_DPS = 8

-- ===== المخزون =====
Config.HOTBAR = 10
Config.INV_ROWS = 4 -- صفوف إضافية تحت الشريط
Config.INV_SLOTS = Config.HOTBAR * (1 + Config.INV_ROWS)
Config.ARMOR_SLOTS = 3 -- خوذة/درع/حذاء
Config.MAX_STACK = 999
Config.PICKUP_RANGE = 2.6
Config.PICKUP_DELAY = 0.55
Config.ITEM_DESPAWN = 300

-- ===== الوقت =====
Config.DAY_LENGTH = 900 -- ثانية لليوم الكامل (15 دقيقة)
Config.DAY_START = 0.25 -- 0 = منتصف الليل، 0.5 = الظهر
Config.NIGHT_FROM = 0.76
Config.NIGHT_TO = 0.22

-- ===== الكائنات =====
Config.MOB_CAP_PER_PLAYER = 9
Config.MOB_SPAWN_MIN = 14 -- أقل مسافة للظهور
Config.MOB_SPAWN_MAX = 34 -- أقصى مسافة
Config.MOB_DESPAWN = 60
Config.MOB_TICK = 1 / 20 -- معدل محاكاة الخادم
Config.SPAWN_INTERVAL = 1.35

-- ===== الشبكة =====
Config.STATE_HZ = 18 -- إرسال حالة اللاعب
Config.ENTITY_HZ = 14 -- إرسال حالة الكائنات
-- نصف قطر القطع المحمّلة حول اللاعب. القيم أكبر من اللازم تعني توليداً أكثر
-- بلا فائدة مرئية: النافذة المرئية ~50×24 بلاطة، وهذه التغطية 160×96.
Config.CHUNK_RADIUS_X = 2
Config.CHUNK_RADIUS_Y = 1
Config.MAX_EDITS_PER_SEC = 14 -- مضاد للغش

-- ===== الحفظ =====
Config.AUTOSAVE = 120
Config.DATASTORE_PLAYER = "TC_Player_v1"
Config.DATASTORE_WORLD = "TC_World_v1"

return Config
]]></string>

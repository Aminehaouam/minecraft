  <Item class="StarterPlayer" referent="36">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="37">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
--[[
	نقطة إقلاع العميل — تربط الشبكة بالمحرك والواجهة ثم تدير الحلقة الرئيسية.
]]

local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Buffs = require(Shared.Buffs)
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Net = require(Shared.Net)

local Atlas = require(script.Atlas)
local ClientWorld = require(script.ClientWorld)
local Controller = require(script.Controller)
local Fx = require(script.Fx)
local Lighting = require(script.Lighting)
local Minimap = require(script.Minimap)
local Renderer = require(script.Renderer)
local Sfx = require(script.Sfx)
local State = require(script.State)

local Hud = require(script.UI.Hud)
local Panels = require(script.UI.Panels)

-- ===== شاشة التحميل =====
-- نبني كل النقوش بكسلاً بكسلاً قبل أي شيء، ونُظهر تقدّم البناء بدل شاشة سوداء.

local loadingGui = Instance.new("ScreenGui")
loadingGui.Name = "TerraCraftLoading"
loadingGui.IgnoreGuiInset = true
loadingGui.ResetOnSpawn = false
loadingGui.DisplayOrder = 50
loadingGui.Parent = player:WaitForChild("PlayerGui")

local loadingBack = Instance.new("Frame")
loadingBack.BackgroundColor3 = Color3.fromRGB(14, 13, 20)
loadingBack.BorderSizePixel = 0
loadingBack.Size = UDim2.fromScale(1, 1)
loadingBack.Parent = loadingGui

local loadingTitle = Instance.new("TextLabel")
loadingTitle.BackgroundTransparency = 1
loadingTitle.AnchorPoint = Vector2.new(0.5, 0.5)
loadingTitle.Position = UDim2.fromScale(0.5, 0.44)
loadingTitle.Size = UDim2.fromOffset(600, 40)
loadingTitle.Font = Enum.Font.GothamBold
loadingTitle.TextSize = 26
loadingTitle.TextColor3 = Color3.fromRGB(236, 236, 244)
loadingTitle.Text = "جارٍ رسم عالم TerraCraft…"
loadingTitle.Parent = loadingBack

local loadingBarBack = Instance.new("Frame")
loadingBarBack.BackgroundColor3 = Color3.fromRGB(40, 38, 52)
loadingBarBack.BorderSizePixel = 0
loadingBarBack.AnchorPoint = Vector2.new(0.5, 0.5)
loadingBarBack.Position = UDim2.fromScale(0.5, 0.52)
loadingBarBack.Size = UDim2.fromOffset(420, 18)
loadingBarBack.Parent = loadingBack

local loadingBarFill = Instance.new("Frame")
loadingBarFill.BackgroundColor3 = Color3.fromRGB(120, 200, 140)
loadingBarFill.BorderSizePixel = 0
loadingBarFill.Size = UDim2.new(0, 0, 1, 0)
loadingBarFill.Parent = loadingBarBack

task.spawn(function()
	while not Atlas.isReady() do
		loadingBarFill.Size = UDim2.new(math.clamp(Atlas.progress(), 0, 1), 0, 1, 0)
		task.wait(0.05)
	end
end)

Atlas.build()
loadingTitle.Text = "جارٍ توليد العالم…"

-- ===== تهيئة الواجهة =====

Renderer.init()
ClientWorld.start()
ClientWorld.onDirty(function()
	Lighting.markDirty()
end)

local gui = Renderer.gui()
Hud.build(gui)
Panels.build(gui)
Minimap.build(gui)
Minimap.start()

pcall(function()
	StarterGui:SetCore("TopbarEnabled", false)
	-- خاصية حديثة نسبياً؛ نتجاهلها بهدوء على الإصدارات الأقدم
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
end)
UserInputService.MouseIconEnabled = true

-- ===== ربط الأحداث =====

Hud.onHotbar(function(index)
	Controller.selectHotbar(index)
end)

Hud.onInventoryButton(function()
	Panels.setOpen(not Panels.isOpen())
	Sfx.play("ui")
end)

Hud.onTouch(function(action, down)
	Controller.setTouch(action, down)
end)

Controller.on("toggleInventory", function()
	Panels.setOpen(not Panels.isOpen())
	Sfx.play("ui")
end)

Controller.on("closeAll", function()
	Panels.closeAll()
end)

Controller.on("wallMode", function(enabled: boolean)
	Hud.setWallMode(enabled)
	Sfx.play("ui")
end)

Controller.on("sfx", function(name: string, blockId: number?)
	if name == "mine" and blockId then
		Sfx.block("mine", blockId)
	elseif name == "break" and blockId then
		Sfx.block("break", blockId)
	else
		Sfx.play(name)
	end
end)

Controller.on("particles", function(tx: number, ty: number, blockId: number)
	Fx.blockBurst(tx, ty, blockId, 4)
end)

-- ===== قنوات الخادم =====

Net.get("Hello").OnClientEvent:Connect(function(payload)
	State.seed = payload.seed
	State.userId = payload.userId
	State.spawnX = payload.spawnX
	State.spawnY = payload.spawnY
	State.body.x = payload.x
	State.body.y = payload.y
	State.camX = payload.x
	State.camY = payload.y
	ClientWorld.init(payload.seed)
	-- ولّد محيط اللاعب فوراً حتى لا يسقط في فراغ غير محمّل
	ClientWorld.generateAround(payload.x, payload.y, 1)
	ClientWorld.updateSubscriptions(State.camX, State.camY)
	Lighting.markDirty()
	State.ready = true
	Hud.notify("أهلاً بك في TerraCraft — ابنِ، نقّب، وانجُ!", Color3.fromRGB(140, 220, 250), true)
end)

Net.get("Inventory").OnClientEvent:Connect(function(payload)
	local slots = {}
	for index, entry in (payload.slots or {}) :: { [number]: any } do
		slots[tonumber(index) or 0] = { id = entry[1], n = entry[2] }
	end
	State.slots = slots

	local armor = {}
	for slotName, entry in (payload.armor or {}) :: { [string]: any } do
		armor[slotName] = { id = entry[1], n = entry[2] }
	end
	State.armor = armor

	if payload.hotbar then State.hotbar = payload.hotbar end
	Panels.onInventoryChanged()
end)

Net.get("Stats").OnClientEvent:Connect(function(payload)
	local wasDead = State.dead
	State.hp = payload.hp
	State.maxHp = payload.maxHp
	State.mana = payload.mana
	State.maxMana = payload.maxMana
	State.food = payload.food
	State.defense = payload.defense
	State.dead = payload.dead
	State.respawnIn = payload.respawnIn or 0
	State.buffs = payload.buffs or {}
	State.kills = payload.kills or 0
	State.deaths = payload.deaths or 0

	if payload.dead and not wasDead then
		Sfx.play("hurt")
		Panels.closeAll()
	end
end)

Net.get("TimeSync").OnClientEvent:Connect(function(payload)
	State.time = payload.t
	State.day = payload.day
	State.bloodMoon = payload.blood == true
end)

Net.get("Entities").OnClientEvent:Connect(function(list)
	if type(list) ~= "table" then return end
	local seen: { [number]: boolean } = {}

	for _, packet in list do
		local id = packet.i
		seen[id] = true
		local existing = State.entities[id]
		if existing then
			existing.vx = (packet.x - existing.x) * Config.ENTITY_HZ
			existing.vy = (packet.y - existing.y) * Config.ENTITY_HZ
			existing.x = packet.x
			existing.y = packet.y
			existing.f = packet.f
			existing.a = packet.a
			existing.h = packet.h
			existing.n = packet.n
			existing.t = packet.t
			existing.k = packet.k
		else
			packet.rx = packet.x
			packet.ry = packet.y
			packet.vx = 0
			packet.vy = 0
			State.entities[id] = packet
		end
	end

	for id in State.entities do
		if not seen[id] then
			State.entities[id] = nil
		end
	end
end)

Net.get("PeerState").OnClientEvent:Connect(function(list)
	if type(list) ~= "table" then return end
	local seen: { [number]: boolean } = {}
	for _, packet in list do
		seen[packet.u] = true
		local existing = State.peers[packet.u]
		if existing then
			existing.vx = (packet.x - existing.x) * Config.STATE_HZ
			existing.x = packet.x
			existing.y = packet.y
			existing.f = packet.f
			existing.d = packet.d
			existing.n = packet.n
			existing.it = packet.it
			existing.hd = packet.hd
			existing.ch = packet.ch
		else
			packet.rx = packet.x
			packet.ry = packet.y
			packet.vx = 0
			State.peers[packet.u] = packet
		end
	end
	for userId in State.peers do
		if not seen[userId] then
			State.peers[userId] = nil
		end
	end
end)

Net.get("Fx").OnClientEvent:Connect(function(payload)
	Fx.handle(payload)
	if type(payload) == "table" then
		if payload.kind == "pickup" then
			Sfx.play("pickup")
		elseif payload.kind == "craft" then
			Sfx.play("craft")
		elseif payload.kind == "mob_death" then
			Sfx.play("break_block")
		end
	end
end)

Net.get("Hit").OnClientEvent:Connect(function(payload)
	Fx.handleHit(payload)
	if type(payload) == "table" and payload.kind == "player" and payload.player == State.userId then
		Sfx.play("hurt")
	end
end)

Net.get("Notify").OnClientEvent:Connect(function(payload)
	local color = if payload.color
		then Color3.fromRGB(payload.color[1], payload.color[2], payload.color[3])
		else nil
	Hud.notify(payload.text, color, payload.big)
end)

Net.get("Boss").OnClientEvent:Connect(function(payload)
	State.boss = payload
end)

Net.get("Respawn").OnClientEvent:Connect(function(x: number, y: number)
	State.body.x = x
	State.body.y = y
	State.body.vx = 0
	State.body.vy = 0
	State.camX = x
	State.camY = y
	ClientWorld.generateAround(x, y, 1)
	Lighting.markDirty()
end)

Net.get("Station").OnClientEvent:Connect(function(payload)
	Panels.openStation(payload)
	if type(payload) == "table" and payload.open then
		Sfx.play("ui")
	end
end)

Net.get("Shop").OnClientEvent:Connect(function(payload)
	Panels.openShop(payload)
	if payload.open then
		Sfx.play("ui")
	else
		Hud.notify("لا يوجد تاجر هنا — اقترب من نقطة الظهور", Color3.fromRGB(230, 190, 110))
	end
end)

-- ===== الحلقة الرئيسية =====

Controller.start()

local lightTimer = 0
local footstepTimer = 0

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 1 / 20) -- لا تسمح لقفزة إطار بكسر الفيزياء

	if not State.ready or not ClientWorld.isReady() then
		return
	end

	ClientWorld.updateSubscriptions(State.camX, State.camY)
	-- توليد مُقسَّط: قطعة واحدة كحد أقصى، وفقط إن كان الإطار السابق مريحاً.
	-- هكذا يبقى تحميل العالم غير مرئي بدل أن يُحدث تقطّعاً أثناء اللعب.
	if dt < 1 / 45 then
		ClientWorld.pump(1)
	end
	State.pending = ClientWorld.pendingChunks()
	Controller.update(dt)

	-- استيفاء مواضع الكيانات لحركة ناعمة بين حزم الشبكة
	local blend = math.min(1, dt * 16)
	for _, entity in State.entities do
		entity.rx = (entity.rx or entity.x) + (entity.x - (entity.rx or entity.x)) * blend
		entity.ry = (entity.ry or entity.y) + (entity.y - (entity.ry or entity.y)) * blend
	end
	for _, peer in State.peers do
		peer.rx = (peer.rx or peer.x) + (peer.x - (peer.rx or peer.x)) * blend
		peer.ry = (peer.ry or peer.y) + (peer.y - (peer.ry or peer.y)) * blend
	end

	-- مصادر الضوء الديناميكية: المشعل المحمول وتعزيز التوهج
	lightTimer -= dt
	if lightTimer <= 0 then
		lightTimer = 0.15
		local sources = {}
		local held = State.heldItem()
		local glow = 0
		if held then
			local item = Items.get(held.id)
			if item and item.place then
				glow = math.max(glow, Blocks.light(item.place))
			end
		end
		local buffMap = {}
		for _, buff in State.buffs do buffMap[buff.id] = buff.t end
		glow = math.max(glow, Buffs.aggregate(buffMap).light)
		if glow > 0 then
			table.insert(sources, { x = State.body.x, y = State.body.y, level = glow })
		end
		Lighting.setDynamicSources(sources)

		-- ضوء الشمس حسب وقت اليوم
		local t = State.time
		local sun = 0
		if t >= 0.27 and t <= 0.73 then
			sun = 1
		elseif t > 0.73 and t < Config.NIGHT_FROM then
			sun = 1 - (t - 0.73) / (Config.NIGHT_FROM - 0.73)
		elseif t > Config.NIGHT_TO and t < 0.27 then
			sun = (t - Config.NIGHT_TO) / (0.27 - Config.NIGHT_TO)
		end
		Lighting.setSunlight(math.max(0.08, sun))
	end

	-- صوت الخطوات
	if State.body.onGround and math.abs(State.body.vx) > 2 then
		footstepTimer -= dt
		if footstepTimer <= 0 then
			footstepTimer = 0.34
			Sfx.play("step", 0.25)
		end
	else
		footstepTimer = 0
	end

	Renderer.render(dt)
	Fx.update(dt)
	Minimap.update(dt)
	Hud.update(dt)
	Panels.update(dt)
end)

-- أخفِ شاشة التحميل بعد وصول أول بيانات عالم
task.spawn(function()
	local guard = 0
	while (not State.ready or ClientWorld.pendingChunks() > 6) and guard < 600 do
		task.wait(0.1)
		guard += 1
	end
	loadingGui:Destroy()
end)

print("[TerraCraft] العميل جاهز")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Atlas</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Atlas — يبني أطالس النقوش في الذاكرة ثم يرفعها إلى EditableImage.

	لماذا أطلس واحد لا صورة لكل بلاطة؟ لأن آلاف الـ ImageLabel التي تشترك في
	صورة واحدة أرخص بكثير على المحرّك: نغيّر ImageRectOffset فقط لاختيار البلاطة.
	هذه هي الطريقة التي تعمل بها محرّكات البلاطات الحقيقية.

	كل شيء يُولَّد وقت التشغيل — لا نرفع أي أصل إلى روبلوكس.
]]

local AssetService = game:GetService("AssetService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ArtBlocks = require(Shared.ArtBlocks)
local ArtItems = require(Shared.ArtItems)
local ArtSprites = require(Shared.ArtSprites)
local ArtUI = require(Shared.ArtUI)
local Blocks = require(Shared.Blocks)
local Items = require(Shared.Items)
local Mobs = require(Shared.Mobs)
local Pixels = require(Shared.Pixels)

local Atlas = {}

Atlas.TILE = 16 -- بكسلات النقش الواحد (دقة الفن، لا حجم العرض)

export type Rect = { x: number, y: number, w: number, h: number }

local images: { [string]: EditableImage } = {}
local contents: { [string]: any } = {}

local tileRects: { [number]: { [number]: Rect } } = {}
local itemRects: { [string]: Rect } = {}
local spriteRects: { [string]: Rect } = {}

local ready = false
local warnedNoContent = false
local progress = 0

function Atlas.isReady(): boolean
	return ready
end

function Atlas.progress(): number
	return progress
end

-- ===== رفع لوحة إلى EditableImage =====

local function upload(name: string, canvas: Pixels.Canvas): boolean
	local ok, image = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(canvas.w, canvas.h) })
	end)
	if not ok or not image then
		warn("[Atlas] تعذّر إنشاء EditableImage: " .. tostring(image))
		return false
	end

	local wrote = pcall(function()
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(canvas.w, canvas.h), canvas.data)
	end)
	if not wrote then
		warn("[Atlas] تعذّرت كتابة البكسلات في " .. name)
		return false
	end

	images[name] = image

	-- الطريقة الحديثة: ImageContent. نحتفظ بالكائن نفسه كبديل للإصدارات الأقدم.
	local madeContent = pcall(function()
		contents[name] = (Content :: any).fromObject(image)
	end)
	if not madeContent then
		contents[name] = nil
	end
	return true
end

-- يربط ImageLabel/ImageButton بأطلس معيّن
function Atlas.apply(label: ImageLabel | ImageButton, name: string)
	local content = contents[name]
	if content then
		local ok = pcall(function()
			(label :: any).ImageContent = content
		end)
		if ok then
			label.ResampleMode = Enum.ResamplerMode.Pixelated
			return
		end
	end
	-- لا بديل عملي: EditableImage واحد لا يمكن مشاركته بين آلاف العناصر
	-- إلا عبر Content. نُحذّر مرة واحدة بدل إغراق السجلّ.
	if not warnedNoContent then
		warnedNoContent = true
		warn("[Atlas] هذا الإصدار من روبلوكس لا يدعم ImageContent — النقوش لن تظهر. حدّث Studio.")
	end
	label.ResampleMode = Enum.ResamplerMode.Pixelated
end

-- صورة ديناميكية يملؤها المستدعي وقت التشغيل (الخريطة المصغّرة مثلاً)
function Atlas.createDynamic(name: string, width: number, height: number): EditableImage?
	local ok, image = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(width, height) })
	end)
	if not ok or not image then
		warn("[Atlas] تعذّر إنشاء صورة ديناميكية: " .. name)
		return nil
	end
	images[name] = image
	pcall(function()
		contents[name] = (Content :: any).fromObject(image)
	end)
	return image
end

-- ===== رصف الأطلس =====

type Shelf = { x: number, y: number, rowHeight: number }

local function packInto(canvas: Pixels.Canvas, shelf: Shelf, cell: Pixels.Canvas): Rect
	if shelf.x + cell.w > canvas.w then
		shelf.x = 0
		shelf.y += shelf.rowHeight + 1
		shelf.rowHeight = 0
	end
	local rect: Rect = { x = shelf.x, y = shelf.y, w = cell.w, h = cell.h }
	if shelf.y + cell.h <= canvas.h then
		Pixels.blitFast(canvas, cell, shelf.x, shelf.y)
	else
		warn("[Atlas] امتلأ الأطلس — بعض النقوش لن تظهر")
	end
	shelf.x += cell.w + 1
	if cell.h > shelf.rowHeight then shelf.rowHeight = cell.h end
	return rect
end

-- ===== بناء أطلس البلاطات =====

local function buildTiles(): Pixels.Canvas
	local size = Atlas.TILE
	local canvas = Pixels.new(1024, 1024)
	local shelf: Shelf = { x = 0, y = 0, rowHeight = 0 }
	local count = 0

	for blockId in Blocks.defs do
		if blockId ~= Blocks.ID.AIR then
			local base = ArtBlocks.paint(blockId, size)
			local masks: { [number]: Rect } = {}

			if ArtBlocks.usesEdges(blockId) then
				-- 16 نسخة: واحدة لكل تركيبة جيران مكشوفين
				for mask = 0, 15 do
					local variant = Pixels.clone(base)
					Pixels.applyEdges(variant, mask, size)
					masks[mask] = packInto(canvas, shelf, variant)
				end
			else
				local rect = packInto(canvas, shelf, base)
				for mask = 0, 15 do
					masks[mask] = rect
				end
			end

			tileRects[blockId] = masks
			count += 1
			if count % 8 == 0 then
				progress = count / 60 * 0.5
				task.wait()
			end
		end
	end

	return canvas
end

-- ===== بناء أطلس العناصر =====

local function buildItems(): Pixels.Canvas
	local size = Atlas.TILE
	local canvas = Pixels.new(256, 256)
	local shelf: Shelf = { x = 0, y = 0, rowHeight = 0 }
	local count = 0

	for _, itemId in Items.order do
		local cell = ArtItems.paint(itemId, size)
		itemRects[itemId] = packInto(canvas, shelf, cell)
		count += 1
		if count % 24 == 0 then task.wait() end
	end

	return canvas
end

-- ===== بناء أطلس الكائنات =====

local function addSprite(canvas: Pixels.Canvas, shelf: Shelf, key: string, cell: Pixels.Canvas)
	spriteRects[key] = packInto(canvas, shelf, cell)
	-- النسخة المعكوسة للاتجاه المعاكس (نخبزها بدل قلبها وقت التشغيل)
	local mirrored = Pixels.new(cell.w, cell.h)
	Pixels.blitMirrored(mirrored, cell, 0, 0)
	spriteRects[key .. ":L"] = packInto(canvas, shelf, mirrored)
end

local function buildSprites(): Pixels.Canvas
	local canvas = Pixels.new(512, 512)
	local shelf: Shelf = { x = 0, y = 0, rowHeight = 0 }

	for _, frame in ArtSprites.PLAYER_FRAMES do
		addSprite(canvas, shelf, "player:" .. frame, ArtSprites.paintPlayer(frame))
		addSprite(canvas, shelf, "helm:" .. frame, ArtSprites.paintHelmet(frame))
		addSprite(canvas, shelf, "chest:" .. frame, ArtSprites.paintChestplate(frame))
	end
	task.wait()

	for mobId in Mobs.defs do
		local frames = ArtSprites.mobFrames(mobId)
		for frame = 1, frames do
			addSprite(canvas, shelf, "mob:" .. mobId .. ":" .. frame, ArtSprites.paintMob(mobId, frame))
		end
		task.wait()
	end

	for projId in Mobs.projectiles do
		addSprite(canvas, shelf, "proj:" .. projId, ArtSprites.paintProjectile(projId))
	end

	return canvas
end

-- ===== قطع الواجهة =====
-- كل قطعة صورة مستقلة لا خلية في أطلس: التقطيع التسعي (ScaleType.Slice)
-- يقيس SliceCenter على الصورة كاملة، فالفصل يجنّبنا التباساً حقيقياً.
local function buildUI()
	for name, painter in ArtUI.pieces do
		upload("ui:" .. name, painter())
	end
end

-- ===== الواجهة العامة =====

function Atlas.build()
	if ready then return end

	local startTime = os.clock()

	local tiles = buildTiles()
	progress = 0.55
	upload("tiles", tiles)
	task.wait()

	local items = buildItems()
	progress = 0.75
	upload("items", items)
	task.wait()

	local sprites = buildSprites()
	progress = 0.92
	upload("sprites", sprites)
	task.wait()

	buildUI()

	progress = 1
	ready = true
	print(string.format("[Atlas] بُنيت النقوش في %.0f مللي ثانية", (os.clock() - startTime) * 1000))
end

local EMPTY: Rect = { x = 0, y = 0, w = 1, h = 1 }

function Atlas.tileRect(blockId: number, mask: number): Rect
	local masks = tileRects[blockId]
	if not masks then return EMPTY end
	return masks[mask] or masks[0] or EMPTY
end

function Atlas.itemRect(itemId: string): Rect
	return itemRects[itemId] or EMPTY
end

function Atlas.spriteRect(key: string, facing: number?): Rect
	local suffix = if facing == -1 then ":L" else ""
	return spriteRects[key .. suffix] or spriteRects[key] or EMPTY
end

-- يضبط ImageLabel على قطعة واجهة كاملة (بلا مستطيل جزئي)
function Atlas.applyUI(label: ImageLabel | ImageButton, name: string)
	Atlas.apply(label, "ui:" .. name)
	label.ImageRectOffset = Vector2.zero
	label.ImageRectSize = Vector2.zero
end

-- إطار تسعي: يبقى سُمك الحافة ثابتاً مهما تمدّد العنصر
function Atlas.applySlice(label: ImageLabel | ImageButton, name: string)
	Atlas.applyUI(label, name)
	label.ScaleType = Enum.ScaleType.Slice
	label.SliceCenter = Rect.new(ArtUI.SLICE, ArtUI.SLICE, ArtUI.PANEL - ArtUI.SLICE, ArtUI.PANEL - ArtUI.SLICE)
end

-- مساعدات لضبط ImageLabel على مستطيل من الأطلس
function Atlas.setRect(label: ImageLabel | ImageButton, rect: Rect)
	label.ImageRectOffset = Vector2.new(rect.x, rect.y)
	label.ImageRectSize = Vector2.new(rect.w, rect.h)
end

function Atlas.bind(label: ImageLabel | ImageButton, name: string, rect: Rect?)
	Atlas.apply(label, name)
	if rect then Atlas.setRect(label, rect) end
end

return Atlas
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">ClientWorld</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ClientWorld — نسخة العالم على العميل.
	تُولَّد محلياً من نفس البذرة، ثم تُطبَّق عليها تعديلات الخادم.
	تدير أيضاً الاشتراك في القطع حسب موقع الكاميرا.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Chunk = require(Shared.Chunk)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local World = require(Shared.World)

local ClientWorld = {}

local world: World.World? = nil
local subscribed: { [string]: boolean } = {}
local genQueue: { { number } } = {}
local genQueued: { [string]: boolean } = {}
local pendingRequest: { string } = {}
local lastChunkX, lastChunkY = -999, -999
local dirtyCallback: ((x: number, y: number) -> ())? = nil

function ClientWorld.get(): World.World
	assert(world, "لم تتم تهيئة عالم العميل بعد")
	return world :: World.World
end

function ClientWorld.isReady(): boolean
	return world ~= nil
end

function ClientWorld.onDirty(callback: (x: number, y: number) -> ())
	dirtyCallback = callback
end

function ClientWorld.init(seed: number)
	world = World.new(seed, 300)
	subscribed = {}
	table.clear(genQueue)
	table.clear(genQueued)
	lastChunkX, lastChunkY = -999, -999
end

-- ===== التوليد المُقسَّط =====
-- توليد قطعة يكلف ~1024 بلاطة بحسابات ضوضاء، لذا نولّد عدداً محدوداً كل إطار
-- بدل توليدها فجأة داخل حلقة الرسم (وإلا ظهرت تقطّعات عند الحركة السريعة).

local function queueChunk(cx: number, cy: number, priority: boolean?)
	if cx < 0 or cy < 0 or cx >= Config.CHUNKS_X or cy >= Config.CHUNKS_Y then return end
	local key = Chunk.keyOf(cx, cy)
	if genQueued[key] then return end
	if world and World.isLoaded(world :: World.World, cx, cy) then return end
	genQueued[key] = true
	if priority then
		table.insert(genQueue, 1, { cx, cy })
	else
		table.insert(genQueue, { cx, cy })
	end
end

ClientWorld.queueChunk = queueChunk

-- يولّد فوراً القطع المحيطة بنقطة (تُستعمل عند الدخول أو بعد الانتقال)
function ClientWorld.generateAround(x: number, y: number, radius: number)
	if not world then return end
	local cx, cy = math.floor(x) // Config.CHUNK, math.floor(y) // Config.CHUNK
	for dy = -radius, radius do
		for dx = -radius, radius do
			World.getChunk(world :: World.World, cx + dx, cy + dy)
		end
	end
end

function ClientWorld.pump(budget: number)
	if not world then return end
	local generated = 0
	while generated < budget and #genQueue > 0 do
		local entry = table.remove(genQueue, 1)
		if not entry then break end
		local cx, cy = entry[1], entry[2]
		genQueued[Chunk.keyOf(cx, cy)] = nil
		if not World.isLoaded(world :: World.World, cx, cy) then
			World.getChunk(world :: World.World, cx, cy)
			generated += 1
		end
	end
end

function ClientWorld.pendingChunks(): number
	return #genQueue
end

-- ===== الاشتراك في القطع =====

local function flushRequests()
	if #pendingRequest == 0 then return end
	local batch = pendingRequest
	pendingRequest = {}
	Net.get("RequestChunks"):FireServer(batch, false)
end

function ClientWorld.updateSubscriptions(camX: number, camY: number)
	if not world then return end
	local cx = math.floor(camX) // Config.CHUNK
	local cy = math.floor(camY) // Config.CHUNK
	if cx == lastChunkX and cy == lastChunkY then return end
	lastChunkX, lastChunkY = cx, cy

	local wanted: { [string]: boolean } = {}
	for dy = -Config.CHUNK_RADIUS_Y, Config.CHUNK_RADIUS_Y do
		for dx = -Config.CHUNK_RADIUS_X, Config.CHUNK_RADIUS_X do
			local tx, ty = cx + dx, cy + dy
			if tx >= 0 and ty >= 0 and tx < Config.CHUNKS_X and ty < Config.CHUNKS_Y then
				local key = Chunk.keyOf(tx, ty)
				wanted[key] = true
				queueChunk(tx, ty, math.abs(dx) <= 1 and math.abs(dy) <= 1)
				if not subscribed[key] then
					subscribed[key] = true
					table.insert(pendingRequest, key)
				end
			end
		end
	end

	-- ألغِ اشتراك القطع البعيدة وحرّر ذاكرتها
	local drop: { string } = {}
	for key in subscribed do
		if not wanted[key] then
			subscribed[key] = nil
			table.insert(drop, key)
			local dcx, dcy = Chunk.parseKey(key)
			World.unload(world :: World.World, dcx, dcy)
		end
	end
	if #drop > 0 then
		Net.get("RequestChunks"):FireServer(drop, true)
	end

	flushRequests()
end

-- ===== استقبال التحديثات =====

function ClientWorld.start()
	Net.get("ChunkDiff").OnClientEvent:Connect(function(cx: number, cy: number, flat: { number })
		if not world then return end
		if type(flat) ~= "table" or #flat == 0 then return end
		World.applyEncodedDiff(world :: World.World, cx, cy, flat)
		if dirtyCallback then
			dirtyCallback(cx * Config.CHUNK, cy * Config.CHUNK)
		end
	end)

	Net.get("BlockUpdate").OnClientEvent:Connect(function(x: number, y: number, fg: number, bg: number)
		if not world then return end
		local w = world :: World.World
		-- نكتب مباشرة في القطعة والتعديلات معاً
		World.set(w, x, y, fg, bg)
		if dirtyCallback then
			dirtyCallback(x, y)
		end
	end)
end

-- تعديل تفاؤلي محلي (قبل تأكيد الخادم) لاستجابة فورية
function ClientWorld.predictSet(x: number, y: number, fg: number, bg: number)
	if not world then return end
	World.set(world :: World.World, x, y, fg, bg)
	if dirtyCallback then dirtyCallback(x, y) end
end

return ClientWorld
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Controller</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Controller — الإدخال، تنبؤ الحركة محلياً، والتعدين/البناء.

	الحركة تُحاكى فوراً على العميل بنفس وحدة الفيزياء المشتركة، وتُرسل الحالة
	18 مرة/ثانية. الخادم يرفض المستحيل فقط، فتبقى الاستجابة فورية بلا غش سهل.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Buffs = require(Shared.Buffs)
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Mining = require(Shared.Mining)
local Net = require(Shared.Net)
local Physics = require(Shared.Physics)
local Upgrades = require(Shared.Upgrades)
local Util = require(Shared.Util)
local World = require(Shared.World)

local ClientWorld = require(script.Parent.ClientWorld)
local Renderer = require(script.Parent.Renderer)
local State = require(script.Parent.State)

local Controller = {}

local input = {
	left = false,
	right = false,
	jump = false,
	down = false,
	up = false,
	primary = false,
	secondary = false,
}

local jumpHeld = 0
local coyote = 0
local jumpBuffer = 0
local sendAccumulator = 0
local placeCooldown = 0
local attackCooldown = 0
local wallMode = false

local callbacks: { [string]: (...any) -> () } = {}

function Controller.on(event: string, fn: (...any) -> ())
	callbacks[event] = fn
end

local function fire(event: string, ...)
	local fn = callbacks[event]
	if fn then fn(...) end
end

function Controller.wallMode(): boolean
	return wallMode
end

-- ===== الإدخال =====

local KEY_MOVE = {
	[Enum.KeyCode.A] = "left", [Enum.KeyCode.Left] = "left",
	[Enum.KeyCode.D] = "right", [Enum.KeyCode.Right] = "right",
	[Enum.KeyCode.W] = "up", [Enum.KeyCode.Up] = "up",
	[Enum.KeyCode.S] = "down", [Enum.KeyCode.Down] = "down",
	[Enum.KeyCode.Space] = "jump",
}

local HOTKEYS = {
	[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8, [Enum.KeyCode.Nine] = 9,
	[Enum.KeyCode.Zero] = 10,
}

function Controller.selectHotbar(index: number)
	if index < 1 or index > Config.HOTBAR then return end
	State.hotbar = index
	Net.get("InvAction"):FireServer("hotbar", index)
	fire("hotbar", index)
end

local function onInput(io: InputObject, processed: boolean)
	if processed then return end

	if io.UserInputType == Enum.UserInputType.Keyboard then
		local move = KEY_MOVE[io.KeyCode]
		if move then
			input[move] = true
			if move == "jump" then jumpBuffer = Config.JUMP_BUFFER end
			return
		end

		local hotkey = HOTKEYS[io.KeyCode]
		if hotkey then
			Controller.selectHotbar(hotkey)
			return
		end

		if io.KeyCode == Enum.KeyCode.E then
			fire("toggleInventory")
		elseif io.KeyCode == Enum.KeyCode.Q then
			Net.get("InvAction"):FireServer("drop", State.hotbar, if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then "all" else 1)
		elseif io.KeyCode == Enum.KeyCode.F then
			wallMode = not wallMode
			fire("wallMode", wallMode)
		elseif io.KeyCode == Enum.KeyCode.R then
			Net.get("Shop"):FireServer("open")
		elseif io.KeyCode == Enum.KeyCode.Escape then
			fire("closeAll")
		end
		return
	end

	if io.UserInputType == Enum.UserInputType.MouseButton1 then
		input.primary = true
	elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
		input.secondary = true
	elseif io.UserInputType == Enum.UserInputType.MouseWheel then
		local delta = if io.Position.Z > 0 then -1 else 1
		Controller.selectHotbar(((State.hotbar - 1 + delta) % Config.HOTBAR) + 1)
	end
end

local function onInputEnded(io: InputObject)
	if io.UserInputType == Enum.UserInputType.Keyboard then
		local move = KEY_MOVE[io.KeyCode]
		if move then input[move] = false end
	elseif io.UserInputType == Enum.UserInputType.MouseButton1 then
		input.primary = false
		State.mining = nil
	elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
		input.secondary = false
	end
end

-- أزرار اللمس للأجهزة المحمولة
function Controller.setTouch(action: string, down: boolean)
	if action == "left" or action == "right" or action == "jump" or action == "down" then
		input[action] = down
		if action == "jump" and down then jumpBuffer = Config.JUMP_BUFFER end
	elseif action == "primary" then
		input.primary = down
		if not down then State.mining = nil end
	elseif action == "secondary" then
		input.secondary = down
	end
end

-- ===== الحركة =====

-- GetMouseLocation يتجاهل شريط Roblox العلوي بينما واجهتنا تتجاهل الإزاحة
-- (IgnoreGuiInset)، فنضيف الإزاحة يدوياً وإلا انحرف التصويب رأسياً.
local function mousePosition(): (number, number)
	local pos = UserInputService:GetMouseLocation()
	local inset = GuiService:GetGuiInset()
	return Renderer.screenToWorld(pos.X + inset.X, pos.Y + inset.Y)
end

Controller.aimWorld = mousePosition

local function updateMovement(dt: number)
	local body = State.body
	local world = ClientWorld.get()
	local agg = Buffs.aggregate((function()
		local map = {}
		for _, buff in State.buffs do map[buff.id] = buff.t end
		return map
	end)())

	local moveDir = 0
	if input.left then moveDir -= 1 end
	if input.right then moveDir += 1 end

	local armorSpeed = Upgrades.armorBonus(State.armor).speed
	local speed = Config.WALK_SPEED * agg.speed * armorSpeed
	local accel = if body.onGround then Config.WALK_ACCEL else Config.AIR_ACCEL
	local inWater = body.inLiquid ~= 0

	if inWater then
		speed = Config.SWIM_SPEED * agg.speed * armorSpeed
		accel *= 0.6
	end

	if moveDir ~= 0 then
		body.vx = Util.approach(body.vx, moveDir * speed, accel * dt)
		State.facing = moveDir
	else
		local friction = if body.onGround then Config.GROUND_FRICTION else Config.AIR_FRICTION
		body.vx = Util.approach(body.vx, 0, friction * dt)
	end

	-- التسلّق
	local climbing = Physics.canClimb(world, body)
	if climbing then
		if input.up then
			body.vy = -Config.WALK_SPEED * 0.62
		elseif input.down then
			body.vy = Config.WALK_SPEED * 0.62
		else
			body.vy *= 0.45
		end
	end

	-- القفز
	if body.onGround then
		coyote = Config.COYOTE_TIME
	else
		coyote = math.max(0, coyote - dt)
	end
	jumpBuffer = math.max(0, jumpBuffer - dt)

	if input.jump and (inWater or climbing) then
		body.vy = -Config.SWIM_SPEED * 1.15
		jumpHeld = 0
	elseif jumpBuffer > 0 and coyote > 0 then
		body.vy = -Config.JUMP_VELOCITY * agg.jump
		jumpHeld = Config.JUMP_HOLD_TIME
		jumpBuffer = 0
		coyote = 0
		fire("sfx", "jump")
	elseif input.jump and jumpHeld > 0 then
		-- قفزة متغيرة الارتفاع
		jumpHeld -= dt
		body.vy -= Config.GRAVITY * 0.55 * dt
	else
		jumpHeld = 0
	end

	if not input.jump then jumpHeld = 0 end

	-- النزول عبر المنصات
	if input.down and body.onGround then
		body.dropThrough = 0.24
	end

	local wasAir = not body.onGround
	local fallVelocity = body.vy

	Physics.step(world, body, dt, {})

	-- ضرر السقوط (تنبؤي؛ الخادم يطبّق ضرره الخاص أيضاً عند اللزوم)
	if wasAir and body.onGround and fallVelocity > 0 then
		local tiles = (fallVelocity * fallVelocity) / (2 * Config.GRAVITY)
		if tiles > Config.FALL_SAFE and body.inLiquid == 0 then
			fire("sfx", "hurt")
			Renderer.shake(math.min(18, (tiles - Config.FALL_SAFE) * 1.5), 0.25)
		elseif fallVelocity > 12 then
			fire("sfx", "land")
		end
	end

	-- الرسوم المتحركة
	if not body.onGround then
		State.anim = if body.vy < 0 then "jump" else "fall"
	elseif math.abs(body.vx) > 0.6 then
		State.anim = "walk"
	else
		State.anim = "idle"
	end
	State.animTime += dt * math.max(1, math.abs(body.vx) / 3)

	-- حدود العالم السفلى
	if body.y > Config.WORLD_H - 4 then
		body.y = Config.WORLD_H - 4
		body.vy = 0
	end
end

-- ===== التعدين والبناء =====

local function targetTile(): (number?, number?, boolean)
	local wx, wy = mousePosition()
	local tx, ty = math.floor(wx), math.floor(wy)
	if not World.inBounds(tx, ty) then return nil, nil, false end
	local body = State.body
	local reach = Config.REACH + Upgrades.reachBonus(State.heldItem())
	local inRange = Util.dist(body.x, body.y, tx + 0.5, ty + 0.5) <= reach
	return tx, ty, inRange
end

local function currentMiningMultiplier(): number
	local map = {}
	for _, buff in State.buffs do map[buff.id] = buff.t end
	return Buffs.aggregate(map).mining * Upgrades.miningMultiplier(State.heldItem())
end

local function tryPlace(tx: number, ty: number): boolean
	local held = State.heldItem()
	if not held then return false end
	local item = Items.get(held.id)
	if not item or not item.place then return false end

	local world = ClientWorld.get()

	if wallMode then
		if not item.wall then return false end
		if World.bg(world, tx, ty) ~= Blocks.ID.AIR then return false end
	else
		if not Blocks.isReplaceable(World.fg(world, tx, ty)) then return false end
		-- لا تبنِ داخل نفسك
		local body = State.body
		local block = Blocks.get(item.place)
		if block.solid then
			if math.abs(body.x - (tx + 0.5)) < (body.w / 2 + 0.5)
				and math.abs(body.y - (ty + 0.5)) < (body.h / 2 + 0.5) then
				return false
			end
		end
	end

	if placeCooldown > 0 then return true end
	placeCooldown = 0.14

	Net.get("Edit"):FireServer("place", tx, ty, if wallMode then "wall" else "fg", State.hotbar)
	-- تنبؤ محلي فوري
	if wallMode then
		ClientWorld.predictSet(tx, ty, World.fg(world, tx, ty), item.place)
	else
		ClientWorld.predictSet(tx, ty, item.place, World.bg(world, tx, ty))
	end
	fire("sfx", "place")
	State.lastSwing = os.clock()
	return true
end

local function tryMine(tx: number, ty: number, dt: number): boolean
	local world = ClientWorld.get()
	local held = State.heldItem()
	local heldId = if held then held.id else nil

	local targetId
	if wallMode then
		local item = if heldId then Items.get(heldId) else nil
		if not item or item.tool ~= "hammer" then return false end
		targetId = World.bg(world, tx, ty)
		if targetId == Blocks.ID.AIR then return false end
	else
		targetId = World.fg(world, tx, ty)
		if targetId == Blocks.ID.AIR or Blocks.isLiquid(targetId) then return false end
	end

	local required = Mining.breakTime(
		targetId,
		heldId,
		currentMiningMultiplier(),
		Upgrades.powerBonus(held)
	)
	if not required then
		State.mining = nil
		return false
	end
	if wallMode then required *= 0.6 end

	local mining = State.mining
	if not mining or mining.x ~= tx or mining.y ~= ty or mining.layer ~= (if wallMode then "wall" else "fg") then
		mining = { x = tx, y = ty, layer = if wallMode then "wall" else "fg", progress = 0, required = required }
		State.mining = mining
	end
	mining.required = required
	mining.progress += dt
	State.lastSwing = os.clock()

	if mining.progress % 0.28 < dt then
		fire("sfx", "mine", targetId)
		fire("particles", tx, ty, targetId)
	end

	if mining.progress >= required then
		Net.get("Edit"):FireServer("break", tx, ty, mining.layer)
		-- تنبؤ محلي
		if wallMode then
			ClientWorld.predictSet(tx, ty, World.fg(world, tx, ty), Blocks.ID.AIR)
		else
			ClientWorld.predictSet(tx, ty, Blocks.ID.AIR, World.bg(world, tx, ty))
		end
		fire("sfx", "break", targetId)
		fire("particles", tx, ty, targetId)
		State.mined += 1
		State.mining = nil
	end
	return true
end

local function attack(dt: number)
	if attackCooldown > 0 then return end
	local held = State.heldItem()
	local item = if held then Items.get(held.id) else nil
	attackCooldown = if item and item.useTime then item.useTime else 0.35

	local wx, wy = mousePosition()
	Net.get("UseItem"):FireServer("attack", wx, wy)
	State.lastSwing = os.clock()
	State.facing = if wx >= State.body.x then 1 else -1
	fire("sfx", "swing")
end

local function updateActions(dt: number)
	placeCooldown = math.max(0, placeCooldown - dt)
	attackCooldown = math.max(0, attackCooldown - dt)

	if State.dead or State.uiOpen or State.shopOpen then
		State.mining = nil
		Renderer.setSelection(nil, nil, false)
		Renderer.setMiningProgress(nil, nil, 0)
		return
	end

	local tx, ty, inRange = targetTile()
	Renderer.setSelection(tx, ty, inRange)

	if not tx or not ty or not inRange then
		State.mining = nil
		Renderer.setMiningProgress(nil, nil, 0)
		if input.primary or input.secondary then
			attack(dt)
		end
		return
	end

	if input.primary then
		local held = State.heldItem()
		local item = if held then Items.get(held.id) else nil
		local handled = false

		if item and item.place then
			handled = tryPlace(tx, ty)
		end
		if not handled then
			handled = tryMine(tx, ty, dt)
		end
		if not handled then
			attack(dt)
		end
	else
		State.mining = nil
	end

	if input.secondary then
		-- التفاعل مع محطة (فرن، طاولة عمل، سندان، طاولة سحر) له الأولوية
		local block = Blocks.get(World.fg(ClientWorld.get(), tx, ty))
		if block.station or block.container then
			input.secondary = false
			Net.get("Station"):FireServer("open", tx, ty)
			fire("sfx", "ui")
			return
		end

		local held = State.heldItem()
		local item = if held then Items.get(held.id) else nil
		if item and (item.cat == "consumable" or item.cat == "misc") then
			local wx, wy = mousePosition()
			Net.get("UseItem"):FireServer("use", wx, wy)
			attackCooldown = math.max(attackCooldown, item.useTime or 0.5)
			input.secondary = false
		else
			attack(dt)
		end
	end

	local mining = State.mining
	if mining then
		Renderer.setMiningProgress(mining.x, mining.y, mining.progress / math.max(0.01, mining.required))
	else
		Renderer.setMiningProgress(nil, nil, 0)
	end
end

-- ===== الشبكة =====

local function sendState(dt: number)
	sendAccumulator += dt
	if sendAccumulator < 1 / Config.STATE_HZ then return end
	sendAccumulator = 0
	local body = State.body
	Net.get("PlayerState"):FireServer(body.x, body.y, body.vx, body.vy, State.facing, State.anim)
end

-- ===== الحلقة =====

function Controller.update(dt: number)
	if not ClientWorld.isReady() then return end
	if not State.dead then
		updateMovement(dt)
	end
	updateActions(dt)
	sendState(dt)
end

function Controller.start()
	UserInputService.InputBegan:Connect(onInput)
	UserInputService.InputEnded:Connect(function(io) onInputEnded(io) end)

	UserInputService.WindowFocusReleased:Connect(function()
		for key in input do input[key] = false end
		State.mining = nil
	end)

	-- امنع قائمة Roblox الافتراضية من التقاط المفاتيح المستعملة
	ContextActionService:BindAction("TerraCraftBlockDefaults", function()
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Slash)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">EntitySprites</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EntitySprites — رسم اللاعبين والوحوش والأغراض والمقذوفات من أطلس البكسل.

	كل كائن صار ImageLabel واحداً (أو ثلاثة للشخصية: جسد + خوذة + درع) يشير
	إلى مستطيل داخل الأطلس. تغيير إطار الحركة = تغيير ImageRectOffset فقط،
	بلا إنشاء أو حذف أي كائن.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ArtSprites = require(Shared.ArtSprites)
local Items = require(Shared.Items)
local Mobs = require(Shared.Mobs)

local Atlas = require(script.Parent.Atlas)

local EntitySprites = {}

local function newImage(parent: Instance, zindex: number, atlas: string): ImageLabel
	local image = Instance.new("ImageLabel")
	image.BackgroundTransparency = 1
	image.BorderSizePixel = 0
	image.AnchorPoint = Vector2.new(0.5, 0.5)
	image.Size = UDim2.fromScale(1, 1)
	image.Position = UDim2.fromScale(0.5, 0.5)
	image.ZIndex = zindex
	image.Parent = parent
	Atlas.apply(image, atlas)
	return image
end

-- ===== الشخصية =====

export type Character = {
	root: Frame,
	body: ImageLabel,
	helm: ImageLabel,
	chest: ImageLabel,
	held: ImageLabel,
	nameTag: TextLabel,
	hpBack: Frame,
	hpFill: Frame,
}

function EntitySprites.newCharacter(parent: Instance, showName: boolean): Character
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = 6
	root.Parent = parent

	local body = newImage(root, 6, "sprites")
	local chest = newImage(root, 7, "sprites")
	local helm = newImage(root, 8, "sprites")

	local held = Instance.new("ImageLabel")
	held.BackgroundTransparency = 1
	held.BorderSizePixel = 0
	held.AnchorPoint = Vector2.new(0.5, 0.9)
	held.ZIndex = 9
	held.Visible = false
	held.Parent = root
	Atlas.apply(held, "items")

	local nameTag = Instance.new("TextLabel")
	nameTag.BackgroundTransparency = 1
	nameTag.AnchorPoint = Vector2.new(0.5, 1)
	nameTag.Font = Enum.Font.GothamMedium
	nameTag.TextSize = 13
	nameTag.TextColor3 = Color3.fromRGB(240, 240, 240)
	nameTag.TextStrokeTransparency = 0.3
	nameTag.ZIndex = 11
	nameTag.Visible = showName
	nameTag.Parent = root

	local hpBack = Instance.new("Frame")
	hpBack.BackgroundColor3 = Color3.fromRGB(16, 14, 20)
	hpBack.BorderSizePixel = 0
	hpBack.AnchorPoint = Vector2.new(0.5, 1)
	hpBack.ZIndex = 11
	hpBack.Visible = false
	hpBack.Parent = root

	local hpFill = Instance.new("Frame")
	hpFill.BackgroundColor3 = Color3.fromRGB(226, 64, 74)
	hpFill.BorderSizePixel = 0
	hpFill.ZIndex = 12
	hpFill.Parent = hpBack

	return { root = root, body = body, helm = helm, chest = chest, held = held,
		nameTag = nameTag, hpBack = hpBack, hpFill = hpFill }
end

-- اختيار إطار المشي من زمن الحركة
local WALK_CYCLE = { "walk1", "walk2", "walk3", "walk4" }

function EntitySprites.playerFrame(anim: string, animTime: number): string
	if anim == "jump" or anim == "fall" then return "jump" end
	if anim == "walk" then
		local index = math.floor(animTime * 7) % 4 + 1
		return WALK_CYCLE[index]
	end
	return "idle"
end

function EntitySprites.updateCharacter(
	character: Character,
	pxWidth: number,
	pxHeight: number,
	facing: number,
	anim: string,
	animTime: number,
	helmet: string?,
	chestPiece: string?,
	heldItem: string?,
	swing: number,
	heldModified: boolean?
)
	local root = character.root
	root.Size = UDim2.fromOffset(pxWidth, pxHeight)

	local frame = EntitySprites.playerFrame(anim, animTime)
	Atlas.setRect(character.body, Atlas.spriteRect("player:" .. frame, facing))

	character.helm.Visible = helmet ~= nil and helmet ~= ""
	if character.helm.Visible then
		Atlas.setRect(character.helm, Atlas.spriteRect("helm:" .. frame, facing))
		local item = Items.get(helmet :: string)
		character.helm.ImageColor3 = if item then item.color else Color3.fromRGB(190, 190, 200)
	end

	character.chest.Visible = chestPiece ~= nil and chestPiece ~= ""
	if character.chest.Visible then
		Atlas.setRect(character.chest, Atlas.spriteRect("chest:" .. frame, facing))
		local item = Items.get(chestPiece :: string)
		character.chest.ImageColor3 = if item then item.color else Color3.fromRGB(190, 190, 200)
	end

	-- العنصر المحمول: يتأرجح مع الضربة
	local hasHeld = heldItem ~= nil and heldItem ~= "" and Items.get(heldItem :: string) ~= nil
	character.held.Visible = hasHeld
	if hasHeld then
		Atlas.setRect(character.held, Atlas.itemRect(heldItem :: string))
		local iconSize = pxHeight * 0.42
		character.held.Size = UDim2.fromOffset(iconSize, iconSize)
		character.held.Position = UDim2.fromOffset(
			pxWidth / 2 + facing * pxWidth * 0.42,
			pxHeight * 0.56
		)
		character.held.Rotation = facing * (-20 + swing * 120)
		character.held.ImageColor3 = if heldModified
			then Color3.fromRGB(255, 245, 210)
			else Color3.fromRGB(255, 255, 255)
	end
end

function EntitySprites.setCharacterHealth(character: Character, pxWidth: number, pxHeight: number, percent: number)
	local show = percent < 99
	character.hpBack.Visible = show
	if not show then return end
	character.hpBack.Size = UDim2.fromOffset(pxWidth * 0.9, math.max(3, pxHeight * 0.05))
	character.hpBack.Position = UDim2.fromOffset(pxWidth / 2, -4)
	character.hpFill.Size = UDim2.new(math.clamp(percent / 100, 0, 1), -2, 1, -2)
	character.hpFill.Position = UDim2.fromOffset(1, 1)
end

-- ===== الوحوش =====

export type MobSprite = {
	root: Frame,
	image: ImageLabel,
	hpBack: Frame,
	hpFill: Frame,
}

function EntitySprites.newMob(parent: Instance): MobSprite
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = 5
	root.Parent = parent

	local image = newImage(root, 5, "sprites")

	local hpBack = Instance.new("Frame")
	hpBack.BackgroundColor3 = Color3.fromRGB(16, 14, 20)
	hpBack.BorderSizePixel = 0
	hpBack.AnchorPoint = Vector2.new(0.5, 1)
	hpBack.ZIndex = 9
	hpBack.Visible = false
	hpBack.Parent = root

	local hpFill = Instance.new("Frame")
	hpFill.BackgroundColor3 = Color3.fromRGB(226, 64, 74)
	hpFill.BorderSizePixel = 0
	hpFill.ZIndex = 10
	hpFill.Parent = hpBack

	return { root = root, image = image, hpBack = hpBack, hpFill = hpFill }
end

function EntitySprites.updateMob(
	sprite: MobSprite,
	mobId: string,
	pxW: number,
	pxH: number,
	facing: number,
	anim: string,
	age: number,
	hpPercent: number
)
	sprite.root.Size = UDim2.fromOffset(pxW, pxH)

	local frames = ArtSprites.mobFrames(mobId)
	local speed = if anim == "walk" or anim == "fly" then 7 else 3
	local frame = math.floor(age * speed) % frames + 1
	Atlas.setRect(sprite.image, Atlas.spriteRect("mob:" .. mobId .. ":" .. frame, facing))

	local def = Mobs.get(mobId)
	local isBoss = def ~= nil and def.boss == true
	local show = hpPercent < 99 and not isBoss
	sprite.hpBack.Visible = show
	if show then
		sprite.hpBack.Size = UDim2.fromOffset(pxW * 0.9, math.max(3, pxH * 0.07))
		sprite.hpBack.Position = UDim2.fromOffset(pxW / 2, -3)
		sprite.hpFill.Size = UDim2.new(math.clamp(hpPercent / 100, 0, 1), -2, 1, -2)
		sprite.hpFill.Position = UDim2.fromOffset(1, 1)
	end
end

-- ===== الأغراض الساقطة =====

export type ItemSprite = { root: Frame, image: ImageLabel, count: TextLabel }

function EntitySprites.newItem(parent: Instance): ItemSprite
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = 5
	root.Parent = parent

	local image = newImage(root, 5, "items")

	local count = Instance.new("TextLabel")
	count.BackgroundTransparency = 1
	count.AnchorPoint = Vector2.new(0.5, 0)
	count.Font = Enum.Font.Arcade
	count.TextSize = 12
	count.TextColor3 = Color3.fromRGB(255, 255, 255)
	count.TextStrokeTransparency = 0.1
	count.ZIndex = 7
	count.Parent = root

	return { root = root, image = image, count = count }
end

function EntitySprites.updateItem(sprite: ItemSprite, itemId: string, count: number, pxSize: number, age: number)
	local bob = math.sin(age * 3.4) * pxSize * 0.2
	sprite.root.Size = UDim2.fromOffset(pxSize, pxSize)
	Atlas.setRect(sprite.image, Atlas.itemRect(itemId))
	sprite.image.Position = UDim2.fromOffset(pxSize / 2, pxSize / 2 + bob)

	sprite.count.Visible = count > 1
	if sprite.count.Visible then
		sprite.count.Text = tostring(count)
		sprite.count.Size = UDim2.fromOffset(pxSize * 2, pxSize * 0.55)
		sprite.count.Position = UDim2.fromOffset(pxSize / 2, pxSize * 0.8 + bob)
	end
end

-- ===== المقذوفات =====

export type ProjSprite = { root: Frame, image: ImageLabel }

function EntitySprites.newProjectile(parent: Instance): ProjSprite
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = 6
	root.Parent = parent
	local image = newImage(root, 6, "sprites")
	return { root = root, image = image }
end

function EntitySprites.updateProjectile(sprite: ProjSprite, projId: string, pxSize: number, angle: number)
	sprite.root.Size = UDim2.fromOffset(pxSize, pxSize)
	Atlas.setRect(sprite.image, Atlas.spriteRect("proj:" .. projId, 1))
	sprite.image.Rotation = angle
end

return EntitySprites
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
--[[ Fx — الجسيمات وأرقام الضرر والمؤثرات اللحظية. ]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Items = require(Shared.Items)

local Renderer = require(script.Parent.Renderer)
local State = require(script.Parent.State)

local Fx = {}

type Particle = {
	frame: Frame,
	x: number,
	y: number,
	vx: number,
	vy: number,
	life: number,
	maxLife: number,
	gravity: number,
	size: number,
	fade: boolean,
}

type FloatText = {
	label: TextLabel,
	x: number,
	y: number,
	vy: number,
	life: number,
	maxLife: number,
}

local particles: { Particle } = {}
local texts: { FloatText } = {}
local particlePool: { Frame } = {}
local textPool: { TextLabel } = {}

local MAX_PARTICLES = 220
local MAX_TEXTS = 40

local function acquireParticle(): Frame
	local frame = table.remove(particlePool)
	if frame then
		frame.Visible = true
		return frame
	end
	frame = Instance.new("Frame")
	frame.BorderSizePixel = 0
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.ZIndex = 9
	frame.Parent = Renderer.fxLayer()
	return frame
end

local function releaseParticle(frame: Frame)
	frame.Visible = false
	table.insert(particlePool, frame)
end

local function acquireText(): TextLabel
	local label = table.remove(textPool)
	if label then
		label.Visible = true
		return label
	end
	label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Font = Enum.Font.Arcade -- أرقام بخط بكسلي يطابق أسلوب اللعبة
	label.TextStrokeTransparency = 0.15
	label.ZIndex = 12
	label.Size = UDim2.fromOffset(140, 26)
	label.Parent = Renderer.fxLayer()
	return label
end

local function releaseText(label: TextLabel)
	label.Visible = false
	table.insert(textPool, label)
end

-- ===== الإنشاء =====

function Fx.particle(x: number, y: number, vx: number, vy: number, color: Color3, size: number, life: number, gravity: number?)
	if #particles >= MAX_PARTICLES then return end
	local frame = acquireParticle()
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 0
	frame.Rotation = math.random(0, 90)
	table.insert(particles, {
		frame = frame, x = x, y = y, vx = vx, vy = vy,
		life = life, maxLife = life, gravity = gravity or 30,
		size = size, fade = true,
	})
end

function Fx.blockBurst(tx: number, ty: number, blockId: number, amount: number?)
	local block = Blocks.get(blockId)
	if blockId == 0 then return end
	local count = amount or 7
	for _ = 1, count do
		Fx.particle(
			tx + 0.2 + math.random() * 0.6,
			ty + 0.2 + math.random() * 0.6,
			(math.random() - 0.5) * 7,
			-math.random() * 6 - 1,
			block.color,
			0.18 + math.random() * 0.14,
			0.45 + math.random() * 0.35
		)
	end
end

function Fx.burst(x: number, y: number, color: Color3, count: number, power: number, life: number?, gravity: number?)
	for _ = 1, count do
		local angle = math.random() * math.pi * 2
		local speed = power * (0.35 + math.random() * 0.65)
		Fx.particle(
			x, y,
			math.cos(angle) * speed,
			math.sin(angle) * speed,
			color,
			0.16 + math.random() * 0.18,
			life or (0.4 + math.random() * 0.4),
			gravity
		)
	end
end

function Fx.text(x: number, y: number, message: string, color: Color3, size: number?)
	if #texts >= MAX_TEXTS then
		local oldest = table.remove(texts, 1)
		if oldest then releaseText(oldest.label) end
	end
	local label = acquireText()
	label.Text = message
	label.TextColor3 = color
	label.TextSize = size or 18
	label.TextTransparency = 0
	table.insert(texts, {
		label = label, x = x, y = y,
		vy = -2.6, life = 0.95, maxLife = 0.95,
	})
end

function Fx.damage(x: number, y: number, amount: number, crit: boolean, mine: boolean)
	local color = if crit then Color3.fromRGB(255, 210, 90)
		elseif mine then Color3.fromRGB(255, 120, 120)
		else Color3.fromRGB(255, 245, 230)
	Fx.text(x + (math.random() - 0.5) * 0.6, y, tostring(amount), color, if crit then 24 else 18)
end

function Fx.pickup(x: number, y: number, itemId: string, count: number)
	local item = Items.get(itemId)
	local name = if item then item.name else itemId
	local color = if item then item.color else Color3.fromRGB(240, 240, 240)
	Fx.text(x, y - 1, string.format("%s ×%d", name, count), color, 15)
end

-- ===== التحديث =====

function Fx.update(dt: number)
	local tile = Renderer.tileSize()

	for i = #particles, 1, -1 do
		local particle = particles[i]
		particle.life -= dt
		if particle.life <= 0 then
			releaseParticle(particle.frame)
			table.remove(particles, i)
		else
			particle.vy += particle.gravity * dt
			particle.x += particle.vx * dt
			particle.y += particle.vy * dt
			local pxSize = particle.size * tile
			particle.frame.Size = UDim2.fromOffset(pxSize, pxSize)
			particle.frame.Position = UDim2.fromOffset(particle.x * tile, particle.y * tile)
			particle.frame.BackgroundTransparency = 1 - (particle.life / particle.maxLife)
		end
	end

	for i = #texts, 1, -1 do
		local entry = texts[i]
		entry.life -= dt
		if entry.life <= 0 then
			releaseText(entry.label)
			table.remove(texts, i)
		else
			entry.y += entry.vy * dt
			entry.vy += 3.2 * dt
			local alpha = 1 - (entry.life / entry.maxLife)
			entry.label.Position = UDim2.fromOffset(entry.x * tile, entry.y * tile)
			entry.label.TextTransparency = math.max(0, alpha * alpha)
			entry.label.TextStrokeTransparency = 0.25 + alpha * 0.75
		end
	end
end

-- ===== معالجة رسائل المؤثرات من الخادم =====

function Fx.handle(payload: any)
	if type(payload) ~= "table" then return end
	local kind = payload.kind

	if kind == "break" then
		Fx.blockBurst(payload.x, payload.y, payload.block, 9)
	elseif kind == "place" then
		Fx.blockBurst(payload.x, payload.y, payload.block, 4)
	elseif kind == "mob_death" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(200, 60, 60), 16, 9)
	elseif kind == "burn_away" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(250, 170, 70), 14, 7)
	elseif kind == "death" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(220, 50, 50), 26, 12)
		Renderer.shake(20, 0.5)
	elseif kind == "proj_hit" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(240, 200, 140), 8, 6, 0.3)
	elseif kind == "teleport" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(160, 200, 250), 24, 10, 0.6, 0)
	elseif kind == "consume" then
		local item = Items.get(payload.item)
		Fx.burst(payload.x, payload.y, if item then item.color else Color3.fromRGB(240, 240, 240), 10, 5, 0.5, -6)
	elseif kind == "craft" then
		Fx.pickup(payload.x, payload.y - 1.5, payload.item, payload.count)
	elseif kind == "pickup" then
		Fx.pickup(payload.x, payload.y, payload.item, payload.count)
	elseif kind == "swing" then
		if payload.player ~= State.userId then return end
	elseif kind == "chest_open" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(200, 160, 90), 6, 4, 0.35)
	elseif kind == "upgrade" then
		Fx.burst(payload.x, payload.y - 1, Color3.fromRGB(250, 205, 110), 22, 8, 0.7, -4)
		Fx.text(payload.x, payload.y - 2, "تمّ التطوير!", Color3.fromRGB(250, 210, 110), 20)
	elseif kind == "enchant" then
		Fx.burst(payload.x, payload.y - 1, Color3.fromRGB(180, 150, 250), 26, 9, 0.8, -5)
		Fx.text(payload.x, payload.y - 2, "سِحر!", Color3.fromRGB(190, 150, 250), 20)
	elseif kind == "boss_charge" then
		Renderer.shake(12, 0.3)
		Fx.burst(payload.x, payload.y, Color3.fromRGB(220, 60, 70), 20, 12, 0.5, 0)
	elseif kind == "boss_phase" then
		Renderer.shake(26, 0.7)
		Fx.burst(payload.x, payload.y, Color3.fromRGB(255, 90, 90), 40, 16, 0.9, 0)
	end
end

function Fx.handleHit(payload: any)
	if type(payload) ~= "table" then return end
	if payload.kind == "mob" then
		Fx.damage(payload.x, payload.y, payload.amount, payload.crit == true, false)
		Fx.burst(payload.x, payload.y, Color3.fromRGB(220, 80, 80), 5, 5, 0.3)
	elseif payload.kind == "player" then
		local mine = payload.player == State.userId
		Fx.damage(payload.x, payload.y - 1.4, payload.amount, false, mine)
		if mine then
			Renderer.shake(9, 0.22)
		end
	elseif payload.kind == "heal" then
		Fx.text(payload.x, payload.y - 1.4, "+" .. tostring(payload.amount), Color3.fromRGB(120, 240, 140), 18)
	end
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Lighting</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Lighting — إضاءة بلاطية بانتشار BFS (مثل ماين كرافت) فوق نافذة حول الكاميرا.

	مصدران: ضوء الشمس النازل من السطح (متأثر بوقت اليوم) ومصادر الضوء
	(مشاعل، حمم، بلّور). يُعاد الحساب عند تغيّر النافذة أو تعديل بلاطة،
	وبحدّ أقصى LIGHT_HZ مرة في الثانية.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Config = require(Shared.Config)
local World = require(Shared.World)

local Lighting = {}

local MAX = Config.MAX_LIGHT

local levels: { number } = {} -- مصفوفة مسطّحة بحجم النافذة
local originX, originY = 0, 0
local width, height = 0, 0
local dirty = true
local sunlight = 1
local extraSources: { { x: number, y: number, level: number } } = {}

function Lighting.resize(w: number, h: number)
	width = w + Config.LIGHT_PAD * 2
	height = h + Config.LIGHT_PAD * 2
	levels = table.create(width * height, 0)
	dirty = true
end

function Lighting.markDirty()
	dirty = true
end

function Lighting.setSunlight(value: number)
	if math.abs(value - sunlight) > 0.02 then
		sunlight = value
		dirty = true
	end
end

-- مصادر ضوء ديناميكية (اللاعب حامل مشعل، تعزيز التوهج…)
function Lighting.setDynamicSources(sources: { { x: number, y: number, level: number } })
	extraSources = sources
	dirty = true
end

function Lighting.get(x: number, y: number): number
	local lx, ly = x - originX, y - originY
	if lx < 0 or ly < 0 or lx >= width or ly >= height then
		return MAX
	end
	return levels[ly * width + lx + 1] or 0
end

-- شدة الإضاءة كنسبة 0..1 مع منحنى ألطف للعين
function Lighting.factor(x: number, y: number): number
	local level = Lighting.get(x, y)
	local t = level / MAX
	return 0.055 + 0.945 * (t * t * (3 - 2 * t))
end

function Lighting.recompute(world: World.World, camX: number, camY: number, viewW: number, viewH: number)
	local newOriginX = math.floor(camX - viewW / 2) - Config.LIGHT_PAD
	local newOriginY = math.floor(camY - viewH / 2) - Config.LIGHT_PAD
	if newOriginX == originX and newOriginY == originY and not dirty then
		return
	end
	originX, originY = newOriginX, newOriginY
	dirty = false

	table.clear(levels)
	local size = width * height
	for i = 1, size do
		levels[i] = 0
	end

	-- طابور BFS مسطّح (فهرس, مستوى)
	local queue = table.create(size)
	local head, tail = 1, 0
	local sunLevel = math.floor(MAX * sunlight + 0.5)

	-- 1) بذور ضوء الشمس
	for lx = 0, width - 1 do
		local worldX = originX + lx
		if worldX >= 0 and worldX < Config.WORLD_W and sunLevel > 0 then
			local surface = World.surfaceY(world, worldX)
			for ly = 0, height - 1 do
				local worldY = originY + ly
				if worldY < surface then
					local index = ly * width + lx + 1
					if levels[index] < sunLevel then
						levels[index] = sunLevel
						tail += 1
						queue[tail] = index
					end
				else
					break
				end
			end
		end
	end

	-- 2) بذور مصادر الضوء داخل النافذة
	for ly = 0, height - 1 do
		local worldY = originY + ly
		local rowBase = ly * width
		for lx = 0, width - 1 do
			local worldX = originX + lx
			local fgId = World.fgRaw(world, worldX, worldY)
			local emit = if fgId then Blocks.light(fgId) else 0
			if emit == 0 then
				local bgId = World.bgRaw(world, worldX, worldY)
				emit = if bgId then Blocks.light(bgId) else 0
			end
			if emit > 0 then
				local index = rowBase + lx + 1
				if levels[index] < emit then
					levels[index] = emit
					tail += 1
					queue[tail] = index
				end
			end
		end
	end

	-- 3) المصادر الديناميكية
	for _, source in extraSources do
		local lx, ly = math.floor(source.x) - originX, math.floor(source.y) - originY
		if lx >= 0 and ly >= 0 and lx < width and ly < height then
			local index = ly * width + lx + 1
			if levels[index] < source.level then
				levels[index] = source.level
				tail += 1
				queue[tail] = index
			end
		end
	end

	-- 4) الانتشار
	while head <= tail do
		local index = queue[head]
		head += 1
		local level = levels[index]
		if level > 1 then
			local i0 = index - 1
			local lx = i0 % width
			local ly = i0 // width

			for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
				local nx, ny = lx + offset[1], ly + offset[2]
				if nx >= 0 and ny >= 0 and nx < width and ny < height then
					local nIndex = ny * width + nx + 1
					local worldX, worldY = originX + nx, originY + ny
					local neighbourFg = World.fgRaw(world, worldX, worldY)
					-- قطعة غير محمّلة بعد: عاملها كصخر معتم حتى لا يتسرّب الضوء
					local blockOpacity = if neighbourFg then Blocks.opacity(neighbourFg) else 15
					local opacity = math.max(1, blockOpacity)
					if blockOpacity < 15 then
						-- الجدار الخلفي يخفت الضوء قليلاً أيضاً
						local neighbourBg = World.bgRaw(world, worldX, worldY)
						if neighbourBg and neighbourBg ~= 0 then
							opacity = math.max(opacity, 2)
						end
					end
					local spread = level - opacity
					if spread > levels[nIndex] then
						levels[nIndex] = spread
						tail += 1
						queue[tail] = nIndex
					end
				end
			end
		end
	end
end

return Lighting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Minimap</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Minimap — خريطة مصغّرة مرسومة بكسلاً بكسلاً في EditableImage.

	كل بلاطة = بكسل واحد بلون كتلتها، والجدران الخلفية تظهر أغمق، وغير
	المحمّل يظهر أسود. هذه أرخص طريقة ممكنة: تحديث واحد للصورة كل ربع ثانية
	بدل آلاف الإطارات.
]]

local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Config = require(Shared.Config)
local World = require(Shared.World)

local Atlas = require(script.Parent.Atlas)
local ClientWorld = require(script.Parent.ClientWorld)
local State = require(script.Parent.State)

local Minimap = {}

local WIDTH = 176
local HEIGHT = 116
local SCALE = 2 -- بكسلات الشاشة لكل بكسل خريطة
local REFRESH = 0.25

local image: EditableImage? = nil
local pixels = buffer.create(WIDTH * HEIGHT * 4)
local frame: Frame? = nil
local display: ImageLabel? = nil
local coords: TextLabel? = nil
local timer = 0
local visible = true

local function writePixel(index: number, r: number, g: number, b: number)
	local offset = index * 4
	buffer.writeu8(pixels, offset, r)
	buffer.writeu8(pixels, offset + 1, g)
	buffer.writeu8(pixels, offset + 2, b)
	buffer.writeu8(pixels, offset + 3, 255)
end

function Minimap.build(parent: Instance)
	local Theme = require(script.Parent.UI.Theme)

	frame = Theme.panel(parent, "Minimap")
	local panel = frame :: Frame
	panel.Size = UDim2.fromOffset(WIDTH * SCALE + 12, HEIGHT * SCALE + 28)
	panel.AnchorPoint = Vector2.new(1, 1)
	panel.Position = UDim2.new(1, -16, 1, -16)
	panel.ZIndex = 28

	display = Instance.new("ImageLabel")
	local label = display :: ImageLabel
	label.BackgroundColor3 = Color3.fromRGB(8, 8, 12)
	label.BorderSizePixel = 0
	label.Position = UDim2.fromOffset(6, 6)
	label.Size = UDim2.fromOffset(WIDTH * SCALE, HEIGHT * SCALE)
	label.ZIndex = 29
	label.Parent = panel

	image = Atlas.createDynamic("minimap", WIDTH, HEIGHT)
	if image then
		Atlas.apply(label, "minimap")
	end

	coords = Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.fontNumber,
		Text = "",
		TextSize = 12,
		TextColor3 = Theme.colors.textDim,
		Position = UDim2.fromOffset(6, HEIGHT * SCALE + 8),
		Size = UDim2.fromOffset(WIDTH * SCALE, 16),
		ZIndex = 31,
	}, panel)
end

function Minimap.toggle()
	visible = not visible
	if frame then (frame :: Frame).Visible = visible end
end

function Minimap.isVisible(): boolean
	return visible
end

function Minimap.update(dt: number)
	if not visible or not image or not ClientWorld.isReady() then return end
	timer -= dt
	if timer > 0 then return end
	timer = REFRESH

	local world = ClientWorld.get()
	local originX = math.floor(State.body.x) - WIDTH // 2
	local originY = math.floor(State.body.y) - HEIGHT // 2

	for py = 0, HEIGHT - 1 do
		local ty = originY + py
		local rowBase = py * WIDTH
		for px = 0, WIDTH - 1 do
			local tx = originX + px
			local index = rowBase + px

			if not World.inBounds(tx, ty) then
				writePixel(index, 6, 6, 9)
			else
				local fgId = World.fgRaw(world, tx, ty)
				if fgId == nil then
					writePixel(index, 10, 10, 14) -- غير مستكشف
				elseif fgId ~= 0 then
					local block = Blocks.get(fgId)
					local shade = if block.liquid then 0.9 else 1
					writePixel(index,
						block.color.R * 255 * shade,
						block.color.G * 255 * shade,
						block.color.B * 255 * shade)
				else
					local bgId = World.bgRaw(world, tx, ty) or 0
					if bgId ~= 0 then
						local wall = Blocks.get(bgId)
						writePixel(index, wall.color.R * 90, wall.color.G * 90, wall.color.B * 90)
					elseif ty < Config.SURFACE - 10 then
						writePixel(index, 40, 58, 82) -- سماء
					else
						writePixel(index, 16, 16, 22) -- فراغ تحت الأرض
					end
				end
			end
		end
	end

	-- علامة اللاعب: صليب أبيض في المنتصف
	local cx, cy = WIDTH // 2, HEIGHT // 2
	for d = -2, 2 do
		writePixel(cy * WIDTH + math.clamp(cx + d, 0, WIDTH - 1), 255, 255, 255)
		writePixel(math.clamp(cy + d, 0, HEIGHT - 1) * WIDTH + cx, 255, 255, 255)
	end

	-- علامات اللاعبين الآخرين
	for userId, peer in State.peers do
		if userId ~= State.userId then
			local px = math.floor((peer.rx or peer.x) - originX)
			local py = math.floor((peer.ry or peer.y) - originY)
			if px >= 0 and py >= 0 and px < WIDTH and py < HEIGHT then
				writePixel(py * WIDTH + px, 120, 220, 255)
			end
		end
	end

	pcall(function()
		(image :: EditableImage):WritePixelsBuffer(Vector2.zero, Vector2.new(WIDTH, HEIGHT), pixels)
	end)

	if coords then
		(coords :: TextLabel).Text = string.format("X %d   Y %d",
			math.floor(State.body.x), math.floor(State.body.y - Config.SURFACE))
	end
end

function Minimap.start()
	UserInputService.InputBegan:Connect(function(io, processed)
		if processed then return end
		if io.KeyCode == Enum.KeyCode.M then
			Minimap.toggle()
		end
	end)
end

return Minimap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Renderer</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Renderer — محرّك الرسم البكسلي.

	كل بلاطة صارت ImageLabel تشير إلى مستطيل داخل أطلس النقوش، مع
	ResamplerMode.Pixelated فتبقى البكسلات حادّة مهما كان الزوم.

	ثلاث أفكار تحمل الأداء كله:
	1. شبكة ثابتة من الإطارات تُعاد تدويرها (torus mapping): التمرير يحرّك
	   الحاوية ويحدّث عموداً واحداً فقط بدل إعادة بناء كل شيء.
	2. ذاكرة لكل خانة: لا نكتب أي خاصية إن لم يتغيّر شيء فعلياً.
	3. قناع الحواف (auto-tiling): نختار من 16 نسخة مخبوزة مسبقاً حسب الجيران
	   المكشوفين، فنحصل على حواف مضاءة كتيراريا بلا أي كلفة وقت تشغيل.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Config = require(Shared.Config)
local Mobs = require(Shared.Mobs)
local Pixels = require(Shared.Pixels)
local Upgrades = require(Shared.Upgrades)
local Util = require(Shared.Util)
local World = require(Shared.World)
local WorldGen = require(Shared.WorldGen)

local Atlas = require(script.Parent.Atlas)
local ClientWorld = require(script.Parent.ClientWorld)
local EntitySprites = require(script.Parent.EntitySprites)
local Lighting = require(script.Parent.Lighting)
local State = require(script.Parent.State)

local Renderer = {}

local player = Players.LocalPlayer

local gui: ScreenGui
local skyFrame: Frame
local skyGradient: UIGradient
local starsFolder: Frame
local celestial: Frame
local cloudFolder: Frame
local hillsFar: Frame
local hillsNear: Frame
local worldRoot: Frame
local tileContainer: Frame
local entityContainer: Frame
local fxContainer: Frame

type Slot = {
	wall: ImageLabel,
	fg: ImageLabel,
	tx: number,
	ty: number,
	lastFg: number,
	lastBg: number,
	lastMask: number,
	lastLight: number,
	lastLevel: number,
}

local slots: { Slot } = {}
local cols, rows = 0, 0
local tilePx = 48
local viewW, viewH = 0, 0
local shakeTime, shakeMagnitude = 0, 0

local stars: { Frame } = {}
local clouds: { { Frame } } = {}
local hillBarsFar: { Frame } = {}
local hillBarsNear: { Frame } = {}

local charSprites: { [number]: EntitySprites.Character } = {}
local mobSprites: { [number]: EntitySprites.MobSprite } = {}
local itemSprites: { [number]: EntitySprites.ItemSprite } = {}
local projSprites: { [number]: EntitySprites.ProjSprite } = {}
local localCharacter: EntitySprites.Character
local crackOverlay: ImageLabel
local selectionBox: Frame
local crackStage = 0

local UNLOADED = -1
local UNLOADED_COLOR = Color3.fromRGB(10, 10, 14)

-- ===== إنشاء الواجهة =====

local function makeFrame(parent: Instance, name: string, zindex: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = zindex
	f.Parent = parent
	return f
end

local function buildSky(parent: Instance)
	skyFrame = Instance.new("Frame")
	skyFrame.Name = "Sky"
	skyFrame.Size = UDim2.fromScale(1, 1)
	skyFrame.BorderSizePixel = 0
	skyFrame.BackgroundColor3 = Color3.fromRGB(120, 180, 235)
	skyFrame.ZIndex = 1
	skyFrame.Parent = parent

	skyGradient = Instance.new("UIGradient")
	skyGradient.Rotation = 90
	skyGradient.Color = ColorSequence.new(Color3.fromRGB(96, 160, 230), Color3.fromRGB(186, 218, 240))
	skyGradient.Parent = skyFrame

	starsFolder = makeFrame(parent, "Stars", 2)
	for i = 1, 90 do
		local star = Instance.new("Frame")
		star.BorderSizePixel = 0
		star.BackgroundColor3 = Color3.fromRGB(255, 255, 245)
		star.AnchorPoint = Vector2.new(0.5, 0.5)
		star.Size = UDim2.fromOffset(if i % 5 == 0 then 3 else 2, if i % 5 == 0 then 3 else 2)
		star.Position = UDim2.fromScale(math.random(), math.random() * 0.65)
		star.ZIndex = 2
		star.Parent = starsFolder
		table.insert(stars, star)
	end

	-- الشمس/القمر: مربّع بكسلي بزوايا مقضومة بدل دائرة ناعمة
	celestial = Instance.new("Frame")
	celestial.Name = "Sun"
	celestial.BorderSizePixel = 0
	celestial.AnchorPoint = Vector2.new(0.5, 0.5)
	celestial.Size = UDim2.fromOffset(64, 64)
	celestial.BackgroundColor3 = Color3.fromRGB(255, 240, 190)
	celestial.ZIndex = 3
	celestial.Parent = parent
	for _, corner in { Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) } do
		local notch = Instance.new("Frame")
		notch.BorderSizePixel = 0
		notch.BackgroundTransparency = 1
		notch.Size = UDim2.fromScale(0.18, 0.18)
		notch.AnchorPoint = corner
		notch.Position = UDim2.fromScale(corner.X, corner.Y)
		notch.ZIndex = 4
		notch.Parent = celestial
	end

	hillsFar = makeFrame(parent, "HillsFar", 4)
	for _ = 1, 40 do
		local bar = Instance.new("Frame")
		bar.BorderSizePixel = 0
		bar.AnchorPoint = Vector2.new(0.5, 1)
		bar.BackgroundColor3 = Color3.fromRGB(56, 78, 96)
		bar.ZIndex = 4
		bar.Parent = hillsFar
		table.insert(hillBarsFar, bar)
	end

	hillsNear = makeFrame(parent, "HillsNear", 5)
	for _ = 1, 40 do
		local bar = Instance.new("Frame")
		bar.BorderSizePixel = 0
		bar.AnchorPoint = Vector2.new(0.5, 1)
		bar.BackgroundColor3 = Color3.fromRGB(40, 60, 70)
		bar.ZIndex = 5
		bar.Parent = hillsNear
		table.insert(hillBarsNear, bar)
	end

	-- سحب بكسلية: ثلاث كتل متداخلة لكل سحابة (بلا زوايا دائرية)
	cloudFolder = makeFrame(parent, "Clouds", 6)
	for _ = 1, 14 do
		local parts: { Frame } = {}
		for k = 1, 3 do
			local part = Instance.new("Frame")
			part.BorderSizePixel = 0
			part.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			part.BackgroundTransparency = 0.12
			part.AnchorPoint = Vector2.new(0.5, 0.5)
			part.ZIndex = 6
			part.Parent = cloudFolder
			table.insert(parts, part)
		end
		table.insert(clouds, parts)
	end
end

local function buildTileGrid()
	for _, slot in slots do
		slot.wall:Destroy()
		slot.fg:Destroy()
	end
	table.clear(slots)

	-- حجم البلاطة مضاعف صحيح لدقة الفن (16) فتبقى البكسلات مربّعة تماماً
	local raw = viewH / Config.TILES_ON_SCREEN_Y
	local scale = math.max(2, math.floor(raw / Atlas.TILE + 0.5))
	tilePx = scale * Atlas.TILE
	State.tilePx = tilePx

	cols = math.ceil(viewW / tilePx) + Config.RENDER_PAD * 2
	rows = math.ceil(viewH / tilePx) + Config.RENDER_PAD * 2

	for _ = 1, cols * rows do
		local wall = Instance.new("ImageLabel")
		wall.BorderSizePixel = 0
		wall.BackgroundColor3 = Color3.new(0, 0, 0)
		wall.BackgroundTransparency = 1
		wall.ImageTransparency = 1
		wall.Size = UDim2.fromOffset(tilePx, tilePx)
		wall.ZIndex = 2
		wall.Parent = tileContainer
		Atlas.apply(wall, "tiles")

		local fg = Instance.new("ImageLabel")
		fg.BorderSizePixel = 0
		fg.BackgroundTransparency = 1
		fg.Size = UDim2.fromOffset(tilePx, tilePx)
		fg.Visible = false
		fg.ZIndex = 3
		fg.Parent = tileContainer
		Atlas.apply(fg, "tiles")

		table.insert(slots, {
			wall = wall, fg = fg,
			tx = -99999, ty = -99999,
			lastFg = -2, lastBg = -2, lastMask = -1, lastLight = -1, lastLevel = -1,
		})
	end

	Lighting.resize(cols, rows)
end

function Renderer.init()
	local playerGui = player:WaitForChild("PlayerGui")

	gui = Instance.new("ScreenGui")
	gui.Name = "TerraCraft"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10
	gui.Parent = playerGui
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None
	end)

	buildSky(gui)

	worldRoot = Instance.new("Frame")
	worldRoot.Name = "World"
	worldRoot.BackgroundTransparency = 1
	worldRoot.Size = UDim2.fromScale(1, 1)
	worldRoot.ClipsDescendants = true
	worldRoot.ZIndex = 7
	worldRoot.Parent = gui

	tileContainer = Instance.new("Frame")
	tileContainer.Name = "Tiles"
	tileContainer.BackgroundTransparency = 1
	tileContainer.Size = UDim2.fromOffset(0, 0)
	tileContainer.ZIndex = 2
	tileContainer.Parent = worldRoot

	entityContainer = Instance.new("Frame")
	entityContainer.Name = "Entities"
	entityContainer.BackgroundTransparency = 1
	entityContainer.Size = UDim2.fromOffset(0, 0)
	entityContainer.ZIndex = 5
	entityContainer.Parent = worldRoot

	fxContainer = Instance.new("Frame")
	fxContainer.Name = "Fx"
	fxContainer.BackgroundTransparency = 1
	fxContainer.Size = UDim2.fromOffset(0, 0)
	fxContainer.ZIndex = 9
	fxContainer.Parent = worldRoot

	selectionBox = Instance.new("Frame")
	selectionBox.BackgroundTransparency = 1
	selectionBox.BorderSizePixel = 0
	selectionBox.ZIndex = 8
	selectionBox.Visible = false
	selectionBox.Parent = tileContainer
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 2
	stroke.Transparency = 0.25
	stroke.Parent = selectionBox

	crackOverlay = Instance.new("ImageLabel")
	crackOverlay.BackgroundTransparency = 1
	crackOverlay.BorderSizePixel = 0
	crackOverlay.ZIndex = 8
	crackOverlay.Visible = false
	crackOverlay.Parent = tileContainer
	Atlas.applyUI(crackOverlay, "crack1")

	localCharacter = EntitySprites.newCharacter(entityContainer, false)

	local camera = workspace.CurrentCamera
	while not camera do
		task.wait()
		camera = workspace.CurrentCamera
	end
	viewW, viewH = camera.ViewportSize.X, camera.ViewportSize.Y
	buildTileGrid()

	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		viewW, viewH = camera.ViewportSize.X, camera.ViewportSize.Y
		buildTileGrid()
	end)

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.new(0, 5000, 0)
end

function Renderer.gui(): ScreenGui return gui end
function Renderer.fxLayer(): Frame return fxContainer end
function Renderer.tileSize(): number return tilePx end

function Renderer.shake(magnitude: number, duration: number)
	shakeMagnitude = math.max(shakeMagnitude, magnitude)
	shakeTime = math.max(shakeTime, duration)
end

function Renderer.worldToScreen(x: number, y: number): (number, number)
	return (x - State.camX) * tilePx + viewW / 2, (y - State.camY) * tilePx + viewH / 2
end

function Renderer.screenToWorld(px: number, py: number): (number, number)
	return (px - viewW / 2) / tilePx + State.camX, (py - viewH / 2) / tilePx + State.camY
end

-- ===== السماء =====

local DAY_TOP = Color3.fromRGB(78, 148, 226)
local DAY_BOTTOM = Color3.fromRGB(186, 218, 240)
local NIGHT_TOP = Color3.fromRGB(8, 10, 28)
local NIGHT_BOTTOM = Color3.fromRGB(30, 34, 68)
local DUSK_TOP = Color3.fromRGB(48, 46, 96)
local DUSK_BOTTOM = Color3.fromRGB(232, 140, 88)
local BLOOD_TOP = Color3.fromRGB(52, 6, 10)
local BLOOD_BOTTOM = Color3.fromRGB(150, 32, 34)

local function sunAmount(t: number): number
	if t >= 0.27 and t <= 0.73 then return 1 end
	if t > 0.73 and t < Config.NIGHT_FROM then
		return 1 - (t - 0.73) / (Config.NIGHT_FROM - 0.73)
	end
	if t > Config.NIGHT_TO and t < 0.27 then
		return (t - Config.NIGHT_TO) / (0.27 - Config.NIGHT_TO)
	end
	return 0
end
Renderer.sunAmount = sunAmount

local function updateSky()
	local t = State.time
	local sun = sunAmount(t)
	local duskness = 1 - math.abs(sun * 2 - 1)
	if sun >= 0.999 then duskness = 0 end

	local topColor = NIGHT_TOP:Lerp(DAY_TOP, sun):Lerp(DUSK_TOP, duskness * 0.7)
	local bottomColor = NIGHT_BOTTOM:Lerp(DAY_BOTTOM, sun):Lerp(DUSK_BOTTOM, duskness * 0.8)

	if State.bloodMoon then
		topColor = topColor:Lerp(BLOOD_TOP, 0.75)
		bottomColor = bottomColor:Lerp(BLOOD_BOTTOM, 0.65)
	end

	local depth = State.camY - Config.SURFACE
	if depth > 0 then
		local blend = math.clamp(depth / 90, 0, 1)
		local caveTop = Color3.fromRGB(26, 22, 28)
		local caveBottom = Color3.fromRGB(14, 12, 16)
		if State.camY >= Config.HELL_Y - 40 then
			caveTop = Color3.fromRGB(48, 16, 12)
			caveBottom = Color3.fromRGB(22, 8, 8)
		end
		topColor = topColor:Lerp(caveTop, blend)
		bottomColor = bottomColor:Lerp(caveBottom, blend)
	end

	skyGradient.Color = ColorSequence.new(topColor, bottomColor)

	local starAlpha = math.clamp(1 - sun * 1.6, 0, 1) * math.clamp(1 - math.max(0, depth) / 40, 0, 1)
	starsFolder.Visible = starAlpha > 0.02
	if starsFolder.Visible then
		for i, star in stars do
			local twinkle = 0.35 + 0.65 * math.abs(math.sin(os.clock() * 1.3 + i))
			star.BackgroundTransparency = 1 - starAlpha * twinkle
		end
	end

	local aboveGround = depth < 30
	celestial.Visible = aboveGround
	if aboveGround then
		local angle = (t - 0.25) * math.pi * 2
		celestial.Position = UDim2.fromScale(
			0.5 + math.cos(angle - math.pi / 2) * 0.42,
			0.62 - math.sin(angle) * 0.5)
		if sun > 0.35 then
			celestial.BackgroundColor3 = Color3.fromRGB(255, 242, 196)
			celestial.Size = UDim2.fromOffset(72, 72)
		else
			celestial.BackgroundColor3 = if State.bloodMoon
				then Color3.fromRGB(228, 70, 64)
				else Color3.fromRGB(226, 230, 240)
			celestial.Size = UDim2.fromOffset(56, 56)
		end
		celestial.BackgroundTransparency = math.clamp(math.max(0, depth) / 30, 0, 1)
	end

	cloudFolder.Visible = aboveGround
	if aboveGround then
		local drift = os.clock() * 5
		local fade = 0.12 + math.clamp(math.max(0, depth) / 30, 0, 0.88)
		local tint = Color3.fromRGB(255, 255, 255):Lerp(bottomColor, 1 - sun * 0.75)
		for i, parts in clouds do
			local seedX = i * 151.3
			local baseX = ((seedX + drift - State.camX * tilePx * 0.1) % (viewW + 520)) - 260
			local baseY = 54 + (i % 5) * 52 - State.camY * tilePx * 0.05 + Config.SURFACE * tilePx * 0.05
			local unit = 18 + (i % 3) * 8
			-- ثلاث كتل مستطيلة تكوّن سحابة بكسلية
			local layout = {
				{ dx = 0, dy = 0, w = unit * 3, h = unit },
				{ dx = -unit * 0.6, dy = -unit * 0.6, w = unit * 1.6, h = unit * 0.9 },
				{ dx = unit * 0.8, dy = -unit * 0.45, w = unit * 1.3, h = unit * 0.8 },
			}
			for k, part in parts do
				local spec = layout[k]
				part.Size = UDim2.fromOffset(spec.w, spec.h)
				part.Position = UDim2.fromOffset(baseX + spec.dx, baseY + spec.dy)
				part.BackgroundTransparency = fade
				part.BackgroundColor3 = tint
			end
		end
	end

	local showHills = depth < 24
	hillsFar.Visible = showHills
	hillsNear.Visible = showHills
	if showHills then
		local seed = State.seed
		local fade = math.clamp(math.max(0, depth) / 24, 0, 1)
		for i, bar in hillBarsFar do
			local worldX = State.camX * 0.35 + (i - 20) * 7
			local h = WorldGen.surfaceHeight(seed, math.floor(worldX) % Config.WORLD_W)
			local screenY = viewH / 2 + (h - State.camY) * tilePx * 0.35 + 60
			bar.Size = UDim2.fromOffset(viewW / 18 + 4, math.max(10, viewH - screenY + 240))
			bar.Position = UDim2.fromOffset((i - 1) * (viewW / 18), screenY + 240)
			bar.BackgroundColor3 = Color3.fromRGB(56, 78, 96):Lerp(bottomColor, 0.55)
			bar.BackgroundTransparency = fade
		end
		for i, bar in hillBarsNear do
			local worldX = State.camX * 0.6 + (i - 20) * 5
			local h = WorldGen.surfaceHeight(seed, math.floor(worldX) % Config.WORLD_W)
			local screenY = viewH / 2 + (h - State.camY) * tilePx * 0.6 + 30
			bar.Size = UDim2.fromOffset(viewW / 24 + 4, math.max(10, viewH - screenY + 240))
			bar.Position = UDim2.fromOffset((i - 1) * (viewW / 24), screenY + 240)
			bar.BackgroundColor3 = Color3.fromRGB(38, 58, 68):Lerp(bottomColor, 0.35)
			bar.BackgroundTransparency = fade
		end
	end
end

-- ===== البلاطات =====

-- قناع الجيران المكشوفين: يحدّد أي نسخة من النقش نستعمل
local function edgeMask(world: World.World, tx: number, ty: number, blockId: number): number
	local mask = 0
	local function exposed(nx: number, ny: number): boolean
		local neighbour = World.fgRaw(world, nx, ny)
		if neighbour == nil then return false end
		if neighbour == blockId then return false end
		return not Blocks.isSolid(neighbour)
	end
	if exposed(tx, ty - 1) then mask += Pixels.EDGE_UP end
	if exposed(tx + 1, ty) then mask += Pixels.EDGE_RIGHT end
	if exposed(tx, ty + 1) then mask += Pixels.EDGE_DOWN end
	if exposed(tx - 1, ty) then mask += Pixels.EDGE_LEFT end
	return mask
end

local function applyTile(slot: Slot, tx: number, ty: number, fgId: number, bgId: number, mask: number, light: number, level: number)
	local wall = slot.wall
	local fg = slot.fg

	if fgId == UNLOADED then
		wall.ImageTransparency = 1
		wall.BackgroundTransparency = 0
		wall.BackgroundColor3 = UNLOADED_COLOR
		fg.Visible = false
		return
	end

	-- تنويع خفيف في السطوع لكسر تكرار الشبكة
	local jitter = 0.94 + Util.rand2(tx, ty, 917) * 0.12

	-- ===== الجدار الخلفي أو الظلمة =====
	if bgId ~= 0 then
		wall.BackgroundTransparency = 1
		wall.ImageTransparency = 0
		Atlas.setRect(wall, Atlas.tileRect(bgId, 0))
		local shade = light * 0.46 * jitter
		wall.ImageColor3 = Color3.new(shade, shade, shade)
	else
		wall.ImageTransparency = 1
		if light >= 0.985 then
			wall.BackgroundTransparency = 1
		else
			wall.BackgroundColor3 = Color3.new(0, 0, 0)
			wall.BackgroundTransparency = light
		end
	end

	-- ===== الطبقة الأمامية =====
	if fgId == 0 then
		fg.Visible = false
		return
	end

	local block = Blocks.get(fgId)
	fg.Visible = true
	Atlas.setRect(fg, Atlas.tileRect(fgId, mask))

	local emissive = block.light / Config.MAX_LIGHT
	local tint = math.min(1, light + emissive * 0.85) * jitter
	fg.ImageColor3 = Color3.new(tint, tint, tint)

	-- أشكال خاصة: سائل بارتفاع جزئي حسب مستواه، منصة رقيقة، نباتات
	if block.liquid then
		-- نقصّ النقش من أسفله بقدر المستوى فيبدو سطح السائل في مكانه الصحيح
		local rows = math.clamp(math.floor(level / 8 * Atlas.TILE + 0.5), 2, Atlas.TILE)
		local scale = tilePx // Atlas.TILE
		local rect = Atlas.tileRect(fgId, 0)
		fg.ImageRectOffset = Vector2.new(rect.x, rect.y + (Atlas.TILE - rows))
		fg.ImageRectSize = Vector2.new(Atlas.TILE, rows)
		fg.Size = UDim2.fromOffset(tilePx, rows * scale)
		fg.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx + (Atlas.TILE - rows) * scale)
		fg.ImageTransparency = if fgId == Blocks.ID.LAVA then 0 else 0.12
	elseif block.platform then
		fg.Size = UDim2.fromOffset(tilePx, tilePx // 4)
		fg.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx)
		fg.ImageRectSize = Vector2.new(Atlas.TILE, Atlas.TILE // 4)
		fg.ImageTransparency = 0
	else
		fg.Size = UDim2.fromOffset(tilePx, tilePx)
		fg.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx)
		fg.ImageTransparency = 0
	end
end

local function renderTiles()
	local world = ClientWorld.get()
	local halfW = viewW / tilePx / 2
	local halfH = viewH / tilePx / 2
	local left = math.floor(State.camX - halfW) - Config.RENDER_PAD
	local top = math.floor(State.camY - halfH) - Config.RENDER_PAD

	for row = 0, rows - 1 do
		local ty = top + row
		local slotRow = ((ty % rows) + rows) % rows
		for col = 0, cols - 1 do
			local tx = left + col
			local slotCol = ((tx % cols) + cols) % cols
			local slot = slots[slotRow * cols + slotCol + 1]
			if slot then
				local fgId, bgId
				if World.inBounds(tx, ty) then
					fgId = World.fgRaw(world, tx, ty) or UNLOADED
					bgId = World.bgRaw(world, tx, ty) or 0
				else
					fgId, bgId = Blocks.ID.BEDROCK, Blocks.ID.BEDROCK
				end

				local mask = 0
				if fgId > 0 and fgId ~= UNLOADED and Blocks.isSolid(fgId) then
					mask = edgeMask(world, tx, ty, fgId)
				end

				local level = 0
				if fgId ~= UNLOADED and Blocks.isLiquid(fgId) then
					level = World.liquidLevelRaw(world, tx, ty)
				end

				local light = if fgId == UNLOADED then 0 else Lighting.factor(tx, ty)
				local quantized = math.floor(light * 40)

				local moved = slot.tx ~= tx or slot.ty ~= ty
				if moved or slot.lastFg ~= fgId or slot.lastBg ~= bgId
					or slot.lastMask ~= mask or slot.lastLight ~= quantized
					or slot.lastLevel ~= level then
					slot.tx, slot.ty = tx, ty
					slot.lastFg, slot.lastBg = fgId, bgId
					slot.lastMask, slot.lastLight, slot.lastLevel = mask, quantized, level
					if moved then
						slot.wall.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx)
					end
					applyTile(slot, tx, ty, fgId, bgId, mask, light, level)
				end
			end
		end
	end
end

-- ===== الكيانات =====

local function releaseSprites(seen: { [number]: boolean })
	for id, sprite in charSprites do
		if not seen[id] then sprite.root:Destroy(); charSprites[id] = nil end
	end
	for id, sprite in mobSprites do
		if not seen[id] then sprite.root:Destroy(); mobSprites[id] = nil end
	end
	for id, sprite in itemSprites do
		if not seen[id] then sprite.root:Destroy(); itemSprites[id] = nil end
	end
	for id, sprite in projSprites do
		if not seen[id] then sprite.root:Destroy(); projSprites[id] = nil end
	end
end

local function renderEntities()
	local seen: { [number]: boolean } = {}
	local now = os.clock()

	for id, entity in State.entities do
		seen[id] = true
		local x = entity.rx or entity.x
		local y = entity.ry or entity.y

		if entity.k == 1 then
			local sprite = mobSprites[id]
			if not sprite then
				sprite = EntitySprites.newMob(entityContainer)
				mobSprites[id] = sprite
			end
			local def = Mobs.get(entity.t)
			local w = if def then def.w else 1
			local h = if def then def.h else 1
			sprite.root.Position = UDim2.fromOffset(x * tilePx, y * tilePx)
			EntitySprites.updateMob(sprite, entity.t, w * tilePx, h * tilePx,
				entity.f or 1, entity.a or "idle", now + id * 0.37, entity.h or 100)

		elseif entity.k == 2 then
			local sprite = itemSprites[id]
			if not sprite then
				sprite = EntitySprites.newItem(entityContainer)
				itemSprites[id] = sprite
			end
			sprite.root.Position = UDim2.fromOffset(x * tilePx, y * tilePx)
			EntitySprites.updateItem(sprite, entity.t, entity.n or 1, tilePx * 0.85, now + id)

		elseif entity.k == 3 then
			local sprite = projSprites[id]
			if not sprite then
				sprite = EntitySprites.newProjectile(entityContainer)
				projSprites[id] = sprite
			end
			local def = Mobs.projectiles[entity.t]
			local scale = if def then math.max(def.w, def.h) else 0.6
			local angle = math.deg(math.atan2(entity.vy or 0, entity.vx or 1))
			sprite.root.Position = UDim2.fromOffset(x * tilePx, y * tilePx)
			EntitySprites.updateProjectile(sprite, entity.t, math.max(12, scale * tilePx * 1.6), angle)
		end
	end

	for userId, peer in State.peers do
		if userId ~= State.userId then
			seen[-userId] = true
			local sprite = charSprites[-userId]
			if not sprite then
				sprite = EntitySprites.newCharacter(entityContainer, true)
				charSprites[-userId] = sprite
			end
			local px = peer.rx or peer.x
			local py = peer.ry or peer.y
			local pxW = Config.PLAYER_W * tilePx
			local pxH = Config.PLAYER_H * tilePx
			sprite.root.Position = UDim2.fromOffset(px * tilePx, py * tilePx)
			sprite.root.Visible = not peer.d
			sprite.nameTag.Text = peer.n or "لاعب"
			sprite.nameTag.Position = UDim2.fromOffset(pxW / 2, -14)
			sprite.nameTag.Size = UDim2.fromOffset(180, 18)
			EntitySprites.updateCharacter(sprite, pxW, pxH, peer.f or 1,
				if math.abs(peer.vx or 0) > 0.5 then "walk" else "idle",
				now, peer.hd, peer.ch, peer.it, 0, peer.iu)
			EntitySprites.setCharacterHealth(sprite, pxW, pxH, peer.hp or 100)
		end
	end

	releaseSprites(seen)
end

local function renderLocalPlayer()
	local body = State.body
	localCharacter.root.Visible = not State.dead
	localCharacter.root.Position = UDim2.fromOffset(body.x * tilePx, body.y * tilePx)

	local swing = 0
	local since = os.clock() - (State.lastSwing or 0)
	if since < 0.22 then
		swing = math.sin(since / 0.22 * math.pi)
	end

	local held = State.heldItem()
	EntitySprites.updateCharacter(
		localCharacter,
		Config.PLAYER_W * tilePx,
		Config.PLAYER_H * tilePx,
		State.facing,
		State.anim,
		State.animTime,
		if State.armor.head then (State.armor.head :: any).id else nil,
		if State.armor.chest then (State.armor.chest :: any).id else nil,
		if held then held.id else nil,
		swing,
		Upgrades.isModified(held)
	)
end

-- ===== المؤشرات =====

function Renderer.setSelection(tx: number?, ty: number?, valid: boolean)
	if not tx or not ty then
		selectionBox.Visible = false
		return
	end
	selectionBox.Visible = true
	selectionBox.Size = UDim2.fromOffset(tilePx, tilePx)
	selectionBox.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx)
	local stroke = selectionBox:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if valid then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(235, 90, 80)
	end
end

-- تقدّم التعدين يُعرض كتشقّق متنامٍ فوق البلاطة (بدل شريط)
function Renderer.setMiningProgress(tx: number?, ty: number?, progress: number)
	if not tx or not ty or progress <= 0.02 then
		crackOverlay.Visible = false
		return
	end
	local stage = math.clamp(math.ceil(progress * 4), 1, 4)
	crackOverlay.Visible = true
	crackOverlay.Size = UDim2.fromOffset(tilePx, tilePx)
	crackOverlay.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx)
	if crackStage ~= stage then
		crackStage = stage
		Atlas.applyUI(crackOverlay, "crack" .. stage)
	end
end

-- ===== الكاميرا والحلقة =====

local function updateCamera(dt: number)
	local body = State.body
	local halfW = viewW / tilePx / 2
	local halfH = viewH / tilePx / 2
	local targetX = math.clamp(body.x, halfW, Config.WORLD_W - halfW)
	local targetY = math.clamp(body.y - 1, halfH, Config.WORLD_H - halfH)

	State.camX = Util.damp(State.camX, targetX, Config.CAMERA_SMOOTH, dt)
	State.camY = Util.damp(State.camY, targetY, Config.CAMERA_SMOOTH, dt)
end

local lightAccumulator = 1

function Renderer.render(dt: number)
	if not ClientWorld.isReady() or not Atlas.isReady() then return end

	updateCamera(dt)
	updateSky()

	local shakeX, shakeY = 0, 0
	if shakeTime > 0 then
		shakeTime -= dt
		local strength = shakeMagnitude * math.min(1, shakeTime * 4)
		shakeX = (math.random() - 0.5) * strength
		shakeY = (math.random() - 0.5) * strength
		if shakeTime <= 0 then shakeMagnitude = 0 end
	end

	-- تثبيت الإزاحة على بكسلات صحيحة يمنع اهتزاز النقوش
	local offsetX = math.floor(-State.camX * tilePx + viewW / 2 + shakeX)
	local offsetY = math.floor(-State.camY * tilePx + viewH / 2 + shakeY)
	local offset = UDim2.fromOffset(offsetX, offsetY)
	tileContainer.Position = offset
	entityContainer.Position = offset
	fxContainer.Position = offset

	lightAccumulator += dt
	local lightStep = 1 / Config.LIGHT_HZ
	if lightAccumulator >= lightStep then
		lightAccumulator = 0
		Lighting.recompute(ClientWorld.get(), State.camX, State.camY, cols, rows)
	end

	renderTiles()
	renderEntities()
	renderLocalPlayer()
end

return Renderer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Sfx — أصوات اللعبة.
	نستعمل أصوات العميل المدمجة (rbxasset) فلا تحتاج رفع أي أصول.
	إن أردت أصواتاً أفضل: ضع معرّفات rbxassetid في الجدول أدناه.
]]

local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)

local Sfx = {}

local LIBRARY: { [string]: { id: string, volume: number, pitch: number } } = {
	jump = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.35, pitch = 1.1 },
	land = { id = "rbxasset://sounds/action_footsteps_plastic.mp3", volume = 0.4, pitch = 0.8 },
	step = { id = "rbxasset://sounds/action_footsteps_plastic.mp3", volume = 0.18, pitch = 1.05 },
	swing = { id = "rbxasset://sounds/snap.mp3", volume = 0.28, pitch = 1.35 },
	mine_soft = { id = "rbxasset://sounds/action_footsteps_plastic.mp3", volume = 0.22, pitch = 0.7 },
	mine_hard = { id = "rbxasset://sounds/clickfast.wav", volume = 0.3, pitch = 0.65 },
	mine_wood = { id = "rbxasset://sounds/snap.mp3", volume = 0.25, pitch = 0.75 },
	break_block = { id = "rbxasset://sounds/bass.wav", volume = 0.3, pitch = 1.6 },
	place = { id = "rbxasset://sounds/switch3.wav", volume = 0.3, pitch = 1.2 },
	hurt = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.45, pitch = 1 },
	pickup = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.28, pitch = 1.5 },
	craft = { id = "rbxasset://sounds/switch3.wav", volume = 0.4, pitch = 0.9 },
	splash = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.4, pitch = 1 },
	ui = { id = "rbxasset://sounds/clickfast.wav", volume = 0.25, pitch = 1.3 },
}

local pool: { Sound } = {}
local muted = false

local function acquire(): Sound
	local sound = table.remove(pool)
	if sound then return sound end
	sound = Instance.new("Sound")
	sound.Parent = SoundService
	return sound
end

function Sfx.setMuted(value: boolean)
	muted = value
end

function Sfx.play(name: string, pitchJitter: number?)
	if muted then return end
	local entry = LIBRARY[name]
	if not entry then return end

	local ok = pcall(function()
		local sound = acquire()
		sound.SoundId = entry.id
		sound.Volume = entry.volume
		sound.PlaybackSpeed = entry.pitch + (math.random() - 0.5) * (pitchJitter or 0.12)
		sound.TimePosition = 0
		sound:Play()
		task.delay(3, function()
			sound:Stop()
			if #pool < 24 then
				table.insert(pool, sound)
			else
				sound:Destroy()
			end
		end)
	end)
	if not ok then
		-- صوت غير متاح: تجاهل بصمت بدل إيقاف اللعبة
	end
end

-- صوت مناسب لنوع البلاطة
function Sfx.block(action: string, blockId: number)
	local block = Blocks.get(blockId)
	local material = block.sound or "hard"
	if action == "break" then
		Sfx.play("break_block")
	else
		if material == "wood" then
			Sfx.play("mine_wood")
		elseif material == "soft" then
			Sfx.play("mine_soft")
		else
			Sfx.play("mine_hard")
		end
	end
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
--[[ State — الحالة المشتركة بين وحدات العميل (مصدر واحد للحقيقة محلياً). ]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Physics = require(Shared.Physics)

local State = {}

State.ready = false
State.seed = 0
State.userId = 0

-- اللاعب المحلي
State.body = Physics.newBody(0, 0, Config.PLAYER_W, Config.PLAYER_H)
State.facing = 1
State.anim = "idle"
State.animTime = 0
State.lastSwing = 0
State.spawnX = 0
State.spawnY = 0

-- الكاميرا (بالبلاطات)
State.camX = 0
State.camY = 0
State.tilePx = 40

-- الإحصاءات
State.hp = 100
State.maxHp = 100
State.mana = 40
State.maxMana = 40
State.food = 100
State.defense = 0
State.dead = false
State.respawnIn = 0
State.buffs = {} :: { { id: string, t: number } }
State.kills = 0
State.deaths = 0
State.mined = 0

-- المخزون
State.slots = {} :: { [number]: { id: string, n: number }? }
State.armor = {} :: { [string]: { id: string, n: number }? }
State.hotbar = 1

-- العالم
State.pending = 0 -- قطع بانتظار التوليد المحلي
State.time = 0.25
State.day = 1
State.bloodMoon = false

-- الكيانات القادمة من الخادم
State.entities = {} :: { [number]: any }
State.peers = {} :: { [number]: any }

-- الزعيم
State.boss = nil :: any

-- التعدين الجاري
State.mining = nil :: { x: number, y: number, layer: string, progress: number, required: number }?

-- واجهات مفتوحة
State.uiOpen = false
State.shopOpen = false

function State.heldItem(): { id: string, n: number }?
	return State.slots[State.hotbar]
end

return State
]]></string>
          </Properties>

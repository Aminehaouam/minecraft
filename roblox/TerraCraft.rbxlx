      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Net — تعريف قنوات الشبكة في مكان واحد.
	الخادم ينشئها، والعميل ينتظرها. الحزم عالية التردد تستعمل UnreliableRemoteEvent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

-- اسم القناة -> هل هي غير موثوقة (للحزم المتكررة التي لا يضرّ ضياعها)
local CHANNELS: { [string]: boolean } = {
	Hello = false, -- بداية الجلسة: البذرة، نقطة الظهور، البيانات المحفوظة
	RequestChunks = false, -- العميل يطلب تعديلات قطع
	ChunkDiff = false, -- الخادم يرسل تعديلات قطعة
	Edit = false, -- طلب تعدين/بناء
	BlockUpdate = false, -- بثّ تغيّر بلاطة
	PlayerState = true, -- موضع اللاعب (عميل -> خادم)
	PeerState = true, -- مواضع بقية اللاعبين (خادم -> عميل)
	Entities = true, -- حالة الوحوش والمقذوفات والأغراض
	Inventory = false, -- مزامنة المخزون
	InvAction = false, -- نقل/رمي/تجهيز
	Craft = false,
	UseItem = false, -- هجوم/استخدام عنصر
	Stats = false, -- حياة/مانا/جوع/تعزيزات
	Hit = false, -- أرقام الضرر والمؤثرات
	TimeSync = false,
	Notify = false,
	Station = false, -- الفرن والسندان وطاولة السحر ونافذة التصنيع
	Shop = false,
	Respawn = false,
	Boss = false,
	Fx = false, -- مؤثرات لمرة واحدة
}

local folder: Folder? = nil

function Net.init(): Folder
	assert(RunService:IsServer(), "Net.init يُستدعى على الخادم فقط")
	local existing = ReplicatedStorage:FindFirstChild("Net")
	if existing then
		folder = existing :: Folder
		return existing :: Folder
	end
	local created = Instance.new("Folder")
	created.Name = "Net"
	for name, unreliable in CHANNELS do
		local remote = if unreliable then Instance.new("UnreliableRemoteEvent") else Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = created
	end
	created.Parent = ReplicatedStorage
	folder = created
	return created
end

local cache: { [string]: any } = {}

function Net.get(name: string): any
	local cached = cache[name]
	if cached then return cached end
	local root = folder
	if not root then
		root = ReplicatedStorage:WaitForChild("Net", 30) :: Folder
		folder = root
	end
	assert(root, "تعذّر العثور على مجلد الشبكة")
	local remote = root:WaitForChild(name, 20)
	assert(remote, "قناة شبكة غير معروفة: " .. name)
	cache[name] = remote
	return remote
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Noise</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Noise — ضوضاء قيمية حتمية (value noise) مبنية على تجزئة صحيحة.
	لا نستعمل math.noise لأن نتائجه غير مضمونة الثبات بين الإصدارات،
	ونحتاج تطابقاً تاماً بين توليد الخادم وتوليد العميل.
]]

local Util = require(script.Parent.Util)

local Noise = {}

local function fade(t: number): number
	return t * t * (3 - 2 * t) -- smoothstep
end

-- ضوضاء أحادية البعد في [0,1)
function Noise.value1(x: number, seed: number): number
	local x0 = math.floor(x)
	local t = fade(x - x0)
	local a = Util.rand1(x0, seed)
	local b = Util.rand1(x0 + 1, seed)
	return a + (b - a) * t
end

-- ضوضاء ثنائية البعد في [0,1)
function Noise.value2(x: number, y: number, seed: number): number
	local x0, y0 = math.floor(x), math.floor(y)
	local tx, ty = fade(x - x0), fade(y - y0)
	local a = Util.rand2(x0, y0, seed)
	local b = Util.rand2(x0 + 1, y0, seed)
	local c = Util.rand2(x0, y0 + 1, seed)
	local d = Util.rand2(x0 + 1, y0 + 1, seed)
	local top = a + (b - a) * tx
	local bottom = c + (d - c) * tx
	return top + (bottom - top) * ty
end

-- تراكب عدة طبقات (fBm) — النتيجة في [0,1)
function Noise.fbm1(x: number, seed: number, octaves: number, freq: number, persistence: number): number
	local total, amp, max = 0, 1, 0
	for i = 0, octaves - 1 do
		total += Noise.value1(x * freq, seed + i * 7919) * amp
		max += amp
		amp *= persistence
		freq *= 2
	end
	return total / max
end

function Noise.fbm2(x: number, y: number, seed: number, octaves: number, freq: number, persistence: number): number
	local total, amp, max = 0, 1, 0
	for i = 0, octaves - 1 do
		total += Noise.value2(x * freq, y * freq, seed + i * 7919) * amp
		max += amp
		amp *= persistence
		freq *= 2
	end
	return total / max
end

-- ضوضاء "حِيَد" مناسبة لأنفاق الكهوف: قمم حادة حول 0
function Noise.ridged2(x: number, y: number, seed: number, octaves: number, freq: number): number
	local total, amp, max = 0, 1, 0
	for i = 0, octaves - 1 do
		local n = math.abs(Noise.value2(x * freq, y * freq, seed + i * 104729) * 2 - 1)
		total += (1 - n) * amp
		max += amp
		amp *= 0.5
		freq *= 2
	end
	return total / max
end

-- ضوضاء خلوية مبسّطة (worley) لعروق المعادن والبقع
function Noise.cell2(x: number, y: number, seed: number, scale: number): number
	local cx, cy = math.floor(x / scale), math.floor(y / scale)
	local best = math.huge
	for oy = -1, 1 do
		for ox = -1, 1 do
			local gx, gy = cx + ox, cy + oy
			local jx, jy = Util.rand2pair(gx, gy, seed)
			local px = (gx + jx) * scale
			local py = (gy + jy) * scale
			local d = Util.dist2(x, y, px, py)
			if d < best then best = d end
		end
	end
	return math.sqrt(best) / scale
end

return Noise
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Physics</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Physics — فيزياء AABB على شبكة بلاطات.
	تُستخدم *نفس* الدالة على العميل (تنبؤ) وعلى الخادم (تحقق ومحاكاة الوحوش)،
	فتتطابق النتائج ويقل الارتداد (rubber-banding).

	نظام الإحداثيات: الوحدة = بلاطة واحدة، المحور Y يزداد للأسفل،
	و (body.x, body.y) هو *مركز* الصندوق.
]]

local Blocks = require(script.Parent.Blocks)
local Config = require(script.Parent.Config)
local World = require(script.Parent.World)

local Physics = {}

local EPS = 1e-3

export type Body = {
	x: number,
	y: number,
	w: number,
	h: number,
	vx: number,
	vy: number,
	onGround: boolean,
	inLiquid: number, -- 0 = لا شيء، وإلا معرّف السائل
	headUnder: boolean,
	dropThrough: number, -- مؤقت تجاهل المنصات
	stepUp: boolean,
}

export type Options = {
	gravity: number?,
	maxFall: number?,
	ignorePlatforms: boolean?,
	noGravity: boolean?,
}

function Physics.newBody(x: number, y: number, w: number, h: number): Body
	return {
		x = x, y = y, w = w, h = h,
		vx = 0, vy = 0,
		onGround = false,
		inLiquid = 0,
		headUnder = false,
		dropThrough = 0,
		stepUp = true,
	}
end

local function tileBlocks(world: World.World, tx: number, ty: number): boolean
	return Blocks.isSolid(World.fg(world, tx, ty))
end

-- هل تعترض هذه البلاطة الحركة الرأسية للأسفل فقط؟ (منصات)
local function tilePlatform(world: World.World, tx: number, ty: number): boolean
	return Blocks.isPlatform(World.fg(world, tx, ty))
end

function Physics.boxOverlapsSolid(world: World.World, x: number, y: number, w: number, h: number): boolean
	local left, right = x - w / 2, x + w / 2
	local top, bottom = y - h / 2, y + h / 2
	for ty = math.floor(top), math.ceil(bottom) - 1 do
		for tx = math.floor(left), math.ceil(right) - 1 do
			if tileBlocks(world, tx, ty) then return true end
		end
	end
	return false
end

-- إيجاد أقرب موضع آمن للأسفل من نقطة معينة
function Physics.findGround(world: World.World, x: number, y: number, w: number, h: number, maxScan: number?): number
	local scan = maxScan or 200
	local ty = math.floor(y)
	for i = 0, scan do
		local py = ty + i
		if not Physics.boxOverlapsSolid(world, x, py - h / 2 - 0.02, w, h) then
			if tileBlocks(world, math.floor(x), py) then
				return py - h / 2 - 0.02
			end
		end
	end
	return y
end

-- ===== الخطوة الرئيسية =====
-- ملاحظة مهمة: نقسّم الخطوة إن تجاوز الإزاحة نصف بلاطة، وإلا لأمكن لجسم سريع
-- (سقوط حر أو مقذوف) أن يعبر أرضية بسمك بلاطة واحدة بين إطارين.
local function stepOnce(world: World.World, body: Body, dt: number, opts: Options?)
	local options: Options = opts or {}
	local gravity = options.gravity or Config.GRAVITY
	local maxFall = options.maxFall or Config.MAX_FALL

	-- حالة السوائل (تُقاس عند المركز والرأس)
	local centerLiquid = World.fg(world, math.floor(body.x), math.floor(body.y))
	local headLiquidId = World.fg(world, math.floor(body.x), math.floor(body.y - body.h / 2 + 0.3))
	body.inLiquid = if Blocks.isLiquid(centerLiquid) then centerLiquid else 0
	body.headUnder = Blocks.isLiquid(headLiquidId)

	-- الجاذبية
	if not options.noGravity then
		local g = gravity
		if body.inLiquid ~= 0 then g *= 0.32 end
		body.vy += g * dt
	end

	local fallCap = if body.inLiquid ~= 0 then maxFall * 0.28 else maxFall
	if body.vy > fallCap then body.vy = fallCap end

	-- مقاومة السائل
	if body.inLiquid ~= 0 then
		local drag = math.pow(Config.WATER_DRAG, dt * 60)
		body.vx *= drag
		body.vy *= drag
	end

	if body.dropThrough > 0 then
		body.dropThrough -= dt
	end

	local prevBottom = body.y + body.h / 2

	-- ===== الحركة الأفقية =====
	local dx = body.vx * dt
	if dx ~= 0 then
		body.x += dx
		local left, right = body.x - body.w / 2, body.x + body.w / 2
		local top, bottom = body.y - body.h / 2, body.y + body.h / 2
		local hit = false
		local hitTileX = 0

		local ty0, ty1 = math.floor(top), math.ceil(bottom) - 1
		if dx > 0 then
			local tx = math.ceil(right) - 1
			for ty = ty0, ty1 do
				if tileBlocks(world, tx, ty) then hit = true; hitTileX = tx; break end
			end
			if hit then body.x = hitTileX - body.w / 2 - EPS end
		else
			local tx = math.floor(left)
			for ty = ty0, ty1 do
				if tileBlocks(world, tx, ty) then hit = true; hitTileX = tx; break end
			end
			if hit then body.x = hitTileX + 1 + body.w / 2 + EPS end
		end

		-- صعود تلقائي لبلاطة واحدة (يمنع التعثر بكل حافة كما في تيراريا)
		if hit and body.stepUp and (body.onGround or body.inLiquid ~= 0) then
			local tryX = body.x + (if dx > 0 then body.w / 2 + 0.05 else -body.w / 2 - 0.05)
			local tryY = body.y - Config.STEP_UP
			if not Physics.boxOverlapsSolid(world, tryX, tryY, body.w, body.h)
				and not Physics.boxOverlapsSolid(world, body.x, tryY, body.w, body.h) then
				body.y = tryY
				body.x += (if dx > 0 then 0.06 else -0.06)
				hit = false
			end
		end

		if hit then body.vx = 0 end
	end

	-- ===== الحركة الرأسية =====
	body.onGround = false
	local dy = body.vy * dt
	if dy ~= 0 then
		body.y += dy
		local left, right = body.x - body.w / 2, body.x + body.w / 2
		local tx0, tx1 = math.floor(left), math.ceil(right) - 1

		if dy > 0 then -- هبوط
			local ty = math.ceil(body.y + body.h / 2) - 1
			local landed = false
			for tx = tx0, tx1 do
				if tileBlocks(world, tx, ty) then
					landed = true
					break
				end
				if not options.ignorePlatforms and body.dropThrough <= 0 and tilePlatform(world, tx, ty) then
					-- المنصة تُصدّ فقط إن كنا فوقها قبل الحركة
					if prevBottom <= ty + 0.05 then
						landed = true
						break
					end
				end
			end
			if landed then
				body.y = ty - body.h / 2 - EPS
				body.vy = 0
				body.onGround = true
			end
		else -- صعود
			local ty = math.floor(body.y - body.h / 2)
			for tx = tx0, tx1 do
				if tileBlocks(world, tx, ty) then
					body.y = ty + 1 + body.h / 2 + EPS
					body.vy = 0
					break
				end
			end
		end
	end

	-- فحص إضافي: هل نلامس الأرض بلا حركة رأسية؟
	if not body.onGround and math.abs(body.vy) < 1e-4 then
		local checkY = body.y + 0.02
		if Physics.boxOverlapsSolid(world, body.x, checkY, body.w, body.h) then
			body.onGround = true
		end
	end

	-- حدود العالم
	if body.x < body.w / 2 then body.x = body.w / 2; body.vx = 0 end
	if body.x > Config.WORLD_W - body.w / 2 then body.x = Config.WORLD_W - body.w / 2; body.vx = 0 end
	if body.y < body.h / 2 then body.y = body.h / 2; body.vy = 0 end
end

local MAX_SUBSTEP_TILES = 0.5

function Physics.step(world: World.World, body: Body, dt: number, opts: Options?)
	if dt <= 0 then return end
	local travel = math.max(math.abs(body.vx), math.abs(body.vy)) * dt
	local steps = math.clamp(math.ceil(travel / MAX_SUBSTEP_TILES), 1, 12)
	if steps == 1 then
		stepOnce(world, body, dt, opts)
		return
	end

	local slice = dt / steps
	local grounded = false
	for _ = 1, steps do
		stepOnce(world, body, slice, opts)
		if body.onGround then grounded = true end
	end
	body.onGround = grounded
end

-- تسلّق (سلالم/لبلاب)
function Physics.canClimb(world: World.World, body: Body): boolean
	local tx = math.floor(body.x)
	for ty = math.floor(body.y - body.h / 2), math.ceil(body.y + body.h / 2) - 1 do
		if Blocks.isClimb(World.fg(world, tx, ty)) then return true end
	end
	return false
end

-- ضرر اللمس (حمم، صبّار…) — يُعيد أعلى قيمة ضرر ملامسة
function Physics.contactDamage(world: World.World, body: Body): number
	local worst = 0
	local left, right = body.x - body.w / 2, body.x + body.w / 2
	local top, bottom = body.y - body.h / 2, body.y + body.h / 2
	for ty = math.floor(top), math.ceil(bottom) - 1 do
		for tx = math.floor(left), math.ceil(right) - 1 do
			local block = Blocks.get(World.fg(world, tx, ty))
			if block.burn and block.burn > worst then worst = block.burn end
		end
	end
	return worst
end

-- خط رؤية بسيط بخوارزمية Bresenham على البلاطات
function Physics.lineOfSight(world: World.World, ax: number, ay: number, bx: number, by: number): boolean
	local x0, y0 = math.floor(ax), math.floor(ay)
	local x1, y1 = math.floor(bx), math.floor(by)
	local dx = math.abs(x1 - x0)
	local dy = -math.abs(y1 - y0)
	local sx = if x0 < x1 then 1 else -1
	local sy = if y0 < y1 then 1 else -1
	local err = dx + dy
	local guard = 0

	while guard < 400 do
		guard += 1
		if x0 == x1 and y0 == y1 then return true end
		if tileBlocks(world, x0, y0) then return false end
		local e2 = 2 * err
		if e2 >= dy then err += dy; x0 += sx end
		if e2 <= dx then err += dx; y0 += sy end
	end
	return false
end

return Physics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Pixels</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Pixels — لوحة رسم نقطية فوق buffer بصيغة RGBA8.

	هذه أساس كل فنّ اللعبة: نرسم كل نقش وكل كائن بكسلاً بكسلاً في الذاكرة،
	ثم نرفعه مرة واحدة إلى EditableImage. لا نحتاج رفع أي صورة إلى روبلوكس،
	والنتيجة بكسل آرت حقيقي حادّ الحواف (ResamplerMode.Pixelated).

	الوحدة نقية تماماً (بلا أي واجهة روبلوكس) لتبقى قابلة للاختبار خارج المحرّك.
]]

local Util = require(script.Parent.Util)

local Pixels = {}

export type Canvas = {
	w: number,
	h: number,
	data: buffer,
}

function Pixels.new(w: number, h: number): Canvas
	return { w = w, h = h, data = buffer.create(w * h * 4) }
end

local function index(canvas: Canvas, x: number, y: number): number
	return (y * canvas.w + x) * 4
end

-- كتابة بكسل (بلا مزج) — الإحداثيات خارج الحدود تُتجاهل بصمت
function Pixels.set(canvas: Canvas, x: number, y: number, r: number, g: number, b: number, a: number?)
	if x < 0 or y < 0 or x >= canvas.w or y >= canvas.h then return end
	local i = index(canvas, x, y)
	buffer.writeu8(canvas.data, i, math.clamp(math.floor(r), 0, 255))
	buffer.writeu8(canvas.data, i + 1, math.clamp(math.floor(g), 0, 255))
	buffer.writeu8(canvas.data, i + 2, math.clamp(math.floor(b), 0, 255))
	buffer.writeu8(canvas.data, i + 3, math.clamp(math.floor(a or 255), 0, 255))
end

function Pixels.get(canvas: Canvas, x: number, y: number): (number, number, number, number)
	if x < 0 or y < 0 or x >= canvas.w or y >= canvas.h then return 0, 0, 0, 0 end
	local i = index(canvas, x, y)
	return buffer.readu8(canvas.data, i),
		buffer.readu8(canvas.data, i + 1),
		buffer.readu8(canvas.data, i + 2),
		buffer.readu8(canvas.data, i + 3)
end

-- مزج ألفا: يرسم لوناً شبه شفاف فوق الموجود
function Pixels.blend(canvas: Canvas, x: number, y: number, r: number, g: number, b: number, a: number)
	if a >= 255 then
		Pixels.set(canvas, x, y, r, g, b, 255)
		return
	end
	if a <= 0 then return end
	local dr, dg, db, da = Pixels.get(canvas, x, y)
	local alpha = a / 255
	local outA = alpha + (da / 255) * (1 - alpha)
	if outA <= 0 then return end
	Pixels.set(canvas, x, y,
		(r * alpha + dr * (da / 255) * (1 - alpha)) / outA,
		(g * alpha + dg * (da / 255) * (1 - alpha)) / outA,
		(b * alpha + db * (da / 255) * (1 - alpha)) / outA,
		outA * 255)
end

function Pixels.fill(canvas: Canvas, x: number, y: number, w: number, h: number, r: number, g: number, b: number, a: number?)
	for py = y, y + h - 1 do
		for px = x, x + w - 1 do
			Pixels.set(canvas, px, py, r, g, b, a)
		end
	end
end

function Pixels.clear(canvas: Canvas)
	buffer.fill(canvas.data, 0, 0, canvas.w * canvas.h * 4)
end

-- تحويل Color3 (0..1) إلى ثلاثية 0..255
function Pixels.rgb(color: Color3): (number, number, number)
	return color.R * 255, color.G * 255, color.B * 255
end

-- تفتيح/تعتيم نسبي لبكسل واحد
function Pixels.shadePixel(canvas: Canvas, x: number, y: number, amount: number)
	local r, g, b, a = Pixels.get(canvas, x, y)
	if a == 0 then return end
	Pixels.set(canvas, x, y, r * amount, g * amount, b * amount, a)
end

function Pixels.shadeRect(canvas: Canvas, x: number, y: number, w: number, h: number, amount: number)
	for py = y, y + h - 1 do
		for px = x, x + w - 1 do
			Pixels.shadePixel(canvas, px, py, amount)
		end
	end
end

-- نسخ لوحة داخل أخرى مع احترام الشفافية
function Pixels.blit(dst: Canvas, src: Canvas, dx: number, dy: number)
	for y = 0, src.h - 1 do
		for x = 0, src.w - 1 do
			local r, g, b, a = Pixels.get(src, x, y)
			if a > 0 then
				Pixels.set(dst, dx + x, dy + y, r, g, b, a)
			end
		end
	end
end

-- نسخ مقلوب أفقياً (لاتجاه الكائنات: نخبز الاتجاهين بدل قلبها وقت التشغيل)
function Pixels.blitMirrored(dst: Canvas, src: Canvas, dx: number, dy: number)
	for y = 0, src.h - 1 do
		for x = 0, src.w - 1 do
			local r, g, b, a = Pixels.get(src, x, y)
			if a > 0 then
				Pixels.set(dst, dx + (src.w - 1 - x), dy + y, r, g, b, a)
			end
		end
	end
end

-- نسخ سريع بلا مزج (صفّاً صفّاً عبر buffer.copy) — يُستعمل لرصف الأطلس،
-- حيث لا تتداخل الخلايا فلا حاجة لحساب الشفافية لكل بكسل.
function Pixels.blitFast(dst: Canvas, src: Canvas, dx: number, dy: number)
	local rowBytes = src.w * 4
	for y = 0, src.h - 1 do
		local targetY = dy + y
		if targetY >= 0 and targetY < dst.h and dx >= 0 and dx + src.w <= dst.w then
			buffer.copy(dst.data, (targetY * dst.w + dx) * 4, src.data, y * rowBytes, rowBytes)
		end
	end
end

function Pixels.clone(src: Canvas): Canvas
	local out = Pixels.new(src.w, src.h)
	buffer.copy(out.data, 0, src.data, 0, src.w * src.h * 4)
	return out
end

-- ===== أشكال =====

function Pixels.rect(canvas: Canvas, x: number, y: number, w: number, h: number, r: number, g: number, b: number, a: number?)
	Pixels.fill(canvas, x, y, w, h, r, g, b, a)
end

function Pixels.rectOutline(canvas: Canvas, x: number, y: number, w: number, h: number, r: number, g: number, b: number, a: number?)
	for px = x, x + w - 1 do
		Pixels.set(canvas, px, y, r, g, b, a)
		Pixels.set(canvas, px, y + h - 1, r, g, b, a)
	end
	for py = y, y + h - 1 do
		Pixels.set(canvas, x, py, r, g, b, a)
		Pixels.set(canvas, x + w - 1, py, r, g, b, a)
	end
end

-- حدّ خارجي ممزوج (لا يمسح ما تحته) — مهم لشطف إطارات الواجهة
function Pixels.blendRectOutline(canvas: Canvas, x: number, y: number, w: number, h: number, r: number, g: number, b: number, a: number)
	for px = x, x + w - 1 do
		Pixels.blend(canvas, px, y, r, g, b, a)
		Pixels.blend(canvas, px, y + h - 1, r, g, b, a)
	end
	for py = y + 1, y + h - 2 do
		Pixels.blend(canvas, x, py, r, g, b, a)
		Pixels.blend(canvas, x + w - 1, py, r, g, b, a)
	end
end

function Pixels.line(canvas: Canvas, x0: number, y0: number, x1: number, y1: number, r: number, g: number, b: number, a: number?)
	local dx = math.abs(x1 - x0)
	local dy = -math.abs(y1 - y0)
	local sx = if x0 < x1 then 1 else -1
	local sy = if y0 < y1 then 1 else -1
	local err = dx + dy
	local guard = 0
	while guard < 512 do
		guard += 1
		Pixels.set(canvas, x0, y0, r, g, b, a)
		if x0 == x1 and y0 == y1 then break end
		local e2 = 2 * err
		if e2 >= dy then err += dy; x0 += sx end
		if e2 <= dx then err += dx; y0 += sy end
	end
end

function Pixels.disc(canvas: Canvas, cx: number, cy: number, radius: number, r: number, g: number, b: number, a: number?)
	local rr = radius * radius
	for y = math.floor(cy - radius), math.ceil(cy + radius) do
		for x = math.floor(cx - radius), math.ceil(cx + radius) do
			local dx, dy = x - cx, y - cy
			if dx * dx + dy * dy <= rr then
				Pixels.set(canvas, x, y, r, g, b, a)
			end
		end
	end
end

-- بيضاوي مملوء (مفيد لأجسام الكائنات)
function Pixels.ellipse(canvas: Canvas, cx: number, cy: number, rx: number, ry: number, r: number, g: number, b: number, a: number?)
	for y = math.floor(cy - ry), math.ceil(cy + ry) do
		for x = math.floor(cx - rx), math.ceil(cx + rx) do
			local dx = (x - cx) / math.max(0.001, rx)
			local dy = (y - cy) / math.max(0.001, ry)
			if dx * dx + dy * dy <= 1 then
				Pixels.set(canvas, x, y, r, g, b, a)
			end
		end
	end
end

-- ===== ضوضاء حتمية للنقوش =====

-- قيمة ضوضاء ثابتة لكل (x, y) — نفس النقش في كل جلسة وعلى كل جهاز
function Pixels.noise(x: number, y: number, seed: number): number
	return Util.rand2(x, y, seed)
end

-- يرشّ بكسلات أفتح/أغمق فوق منطقة لإعطاء ملمس حبيبي
function Pixels.speckle(canvas: Canvas, x: number, y: number, w: number, h: number, seed: number, strength: number, density: number)
	for py = y, y + h - 1 do
		for px = x, x + w - 1 do
			local n = Pixels.noise(px, py, seed)
			if n < density then
				local amount = 1 - strength * (1 - n / density)
				Pixels.shadePixel(canvas, px, py, amount)
			elseif n > 1 - density then
				local amount = 1 + strength * ((n - (1 - density)) / density)
				Pixels.shadePixel(canvas, px, py, amount)
			end
		end
	end
end

-- ===== إضاءة الحواف (auto-tiling) =====
-- قناع البتّات: 1=أعلى مكشوف، 2=يمين، 4=أسفل، 8=يسار
Pixels.EDGE_UP = 1
Pixels.EDGE_RIGHT = 2
Pixels.EDGE_DOWN = 4
Pixels.EDGE_LEFT = 8

--[[
	يطبّق إضاءة الحواف على نسخة من البلاطة:
	الحافة العلوية المكشوفة تُضاء (ضوء من فوق)، السفلية تُعتم، والجانبية تُظلَّل
	قليلاً — وهذا بالضبط ما يعطي الإحساس المجسّم في تيراريا وماين كرافت.
]]
function Pixels.applyEdges(canvas: Canvas, mask: number, size: number)
	local light = 1.30
	local dark = 0.62
	local side = 0.82

	if bit32.band(mask, Pixels.EDGE_UP) ~= 0 then
		Pixels.shadeRect(canvas, 0, 0, size, 1, light + 0.12)
		Pixels.shadeRect(canvas, 0, 1, size, 1, light)
		Pixels.shadeRect(canvas, 0, 2, size, 1, 1 + (light - 1) * 0.45)
	end
	if bit32.band(mask, Pixels.EDGE_DOWN) ~= 0 then
		Pixels.shadeRect(canvas, 0, size - 1, size, 1, dark - 0.1)
		Pixels.shadeRect(canvas, 0, size - 2, size, 1, dark)
		Pixels.shadeRect(canvas, 0, size - 3, size, 1, 1 - (1 - dark) * 0.45)
	end
	if bit32.band(mask, Pixels.EDGE_LEFT) ~= 0 then
		Pixels.shadeRect(canvas, 0, 0, 1, size, side - 0.08)
		Pixels.shadeRect(canvas, 1, 0, 1, size, side + 0.08)
	end
	if bit32.band(mask, Pixels.EDGE_RIGHT) ~= 0 then
		Pixels.shadeRect(canvas, size - 1, 0, 1, size, side - 0.12)
		Pixels.shadeRect(canvas, size - 2, 0, 1, size, side + 0.06)
	end
end

return Pixels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Recipes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Recipes — وصفات التصنيع.
	station = nil يعني التصنيع باليد من أي مكان.
	وصفات الفرن تستهلك الفحم كوقود ضمن المكوّنات (تبسيط مقصود بدل محاكاة فرن بحالة).
]]

local Recipes = {}

export type Stack = { id: string, n: number }
export type Recipe = {
	key: string,
	out: Stack,
	ins: { Stack },
	station: string?,
}

local list: { Recipe } = {}

local function R(out: string, n: number, ins: { Stack }, station: string?)
	table.insert(list, {
		key = out .. "#" .. tostring(#list + 1),
		out = { id = out, n = n },
		ins = ins,
		station = station,
	})
end

-- ===== باليد =====
R("plank", 4, { { id = "wood", n = 1 } })
R("workbench", 1, { { id = "plank", n = 8 } })
R("torch", 4, { { id = "wood", n = 1 }, { id = "coal", n = 1 } })
R("platform", 4, { { id = "plank", n = 1 } })

-- ===== طاولة العمل =====
R("furnace", 1, { { id = "stone", n = 20 }, { id = "wood", n = 4 } }, "workbench")
R("chest", 1, { { id = "plank", n = 8 }, { id = "iron_bar", n = 1 } }, "workbench")
R("ladder", 6, { { id = "plank", n = 2 } }, "workbench")
R("lantern", 1, { { id = "iron_bar", n = 1 }, { id = "torch", n = 1 } }, "workbench")
R("anvil", 1, { { id = "iron_bar", n = 5 } }, "workbench")
R("alchemy_table", 1, { { id = "plank", n = 10 }, { id = "crystal", n = 3 }, { id = "glow_dust", n = 2 } }, "workbench")
R("enchant_table", 1, { { id = "obsidian", n = 8 }, { id = "crystal", n = 6 }, { id = "plank", n = 10 }, { id = "glow_dust", n = 4 } }, "anvil")

R("wood_pickaxe", 1, { { id = "wood", n = 3 }, { id = "plank", n = 5 } }, "workbench")
R("wood_axe", 1, { { id = "wood", n = 3 }, { id = "plank", n = 4 } }, "workbench")
R("wood_sword", 1, { { id = "wood", n = 2 }, { id = "plank", n = 5 } }, "workbench")
R("wood_bow", 1, { { id = "wood", n = 8 }, { id = "string", n = 3 } }, "workbench")
R("stone_pickaxe", 1, { { id = "stone", n = 12 }, { id = "wood", n = 3 } }, "workbench")
R("stone_axe", 1, { { id = "stone", n = 10 }, { id = "wood", n = 3 } }, "workbench")
R("stone_sword", 1, { { id = "stone", n = 10 }, { id = "wood", n = 2 } }, "workbench")
R("hammer", 1, { { id = "stone", n = 14 }, { id = "wood", n = 4 } }, "workbench")
R("arrow", 10, { { id = "wood", n = 1 }, { id = "stone", n = 1 }, { id = "string", n = 1 } }, "workbench")

R("leather_helm", 1, { { id = "leather", n = 5 } }, "workbench")
R("leather_chest", 1, { { id = "leather", n = 8 } }, "workbench")
R("leather_boots", 1, { { id = "leather", n = 5 } }, "workbench")

-- ملاحظة: الصهر انتقل إلى نافذة الفرن نفسها (انظر Smelting.luau).
-- الفرن الآن محطة ذات حالة: وقود يحترق وشريط تقدّم، لا وصفة فورية.

-- ===== السندان =====
R("copper_pickaxe", 1, { { id = "copper_bar", n = 8 }, { id = "wood", n = 3 } }, "anvil")
R("copper_sword", 1, { { id = "copper_bar", n = 7 }, { id = "wood", n = 2 } }, "anvil")
R("iron_pickaxe", 1, { { id = "iron_bar", n = 10 }, { id = "wood", n = 3 } }, "anvil")
R("iron_axe", 1, { { id = "iron_bar", n = 9 }, { id = "wood", n = 3 } }, "anvil")
R("iron_sword", 1, { { id = "iron_bar", n = 9 }, { id = "wood", n = 2 } }, "anvil")
R("iron_bow", 1, { { id = "iron_bar", n = 8 }, { id = "string", n = 4 } }, "anvil")
R("silver_sword", 1, { { id = "silver_bar", n = 10 }, { id = "wood", n = 2 } }, "anvil")
R("gold_pickaxe", 1, { { id = "gold_bar", n = 12 }, { id = "wood", n = 3 } }, "anvil")
R("gold_sword", 1, { { id = "gold_bar", n = 11 }, { id = "wood", n = 2 } }, "anvil")
R("diamond_pickaxe", 1, { { id = "diamond", n = 8 }, { id = "gold_bar", n = 4 } }, "anvil")
R("diamond_axe", 1, { { id = "diamond", n = 7 }, { id = "gold_bar", n = 3 } }, "anvil")
R("diamond_sword", 1, { { id = "diamond", n = 9 }, { id = "gold_bar", n = 3 } }, "anvil")
R("mythril_pickaxe", 1, { { id = "mythril_bar", n = 14 }, { id = "diamond", n = 4 } }, "anvil")
R("mythril_blade", 1, { { id = "mythril_bar", n = 16 }, { id = "soul_fragment", n = 3 } }, "anvil")
R("night_edge", 1, { { id = "mythril_blade", n = 1 }, { id = "hellstone_bar", n = 12 }, { id = "shadow_scale", n = 8 }, { id = "soul_fragment", n = 10 } }, "anvil")
R("hell_bow", 1, { { id = "hellstone_bar", n = 10 }, { id = "string", n = 5 } }, "anvil")
R("fire_arrow", 20, { { id = "arrow", n = 20 }, { id = "hellstone_ore", n = 1 } }, "anvil")
R("hellstone_brick", 4, { { id = "hellstone_ore", n = 2 }, { id = "ash", n = 2 } }, "anvil")

R("copper_helm", 1, { { id = "copper_bar", n = 10 } }, "anvil")
R("copper_chest", 1, { { id = "copper_bar", n = 14 } }, "anvil")
R("copper_boots", 1, { { id = "copper_bar", n = 10 } }, "anvil")
R("iron_helm", 1, { { id = "iron_bar", n = 12 } }, "anvil")
R("iron_chest", 1, { { id = "iron_bar", n = 18 } }, "anvil")
R("iron_boots", 1, { { id = "iron_bar", n = 12 } }, "anvil")
R("diamond_helm", 1, { { id = "diamond", n = 10 }, { id = "iron_bar", n = 6 } }, "anvil")
R("diamond_chest", 1, { { id = "diamond", n = 15 }, { id = "iron_bar", n = 8 } }, "anvil")
R("diamond_boots", 1, { { id = "diamond", n = 10 }, { id = "iron_bar", n = 6 } }, "anvil")
R("mythril_helm", 1, { { id = "mythril_bar", n = 14 } }, "anvil")
R("mythril_chest", 1, { { id = "mythril_bar", n = 20 } }, "anvil")
R("mythril_boots", 1, { { id = "mythril_bar", n = 14 } }, "anvil")

R("eye_totem", 1, { { id = "bone", n = 12 }, { id = "gel", n = 20 }, { id = "coal", n = 6 } }, "anvil")

-- مواد التطوير والسحر: تُصنع أو تسقط من الوحوش العميقة
R("upgrade_core", 1, { { id = "iron_bar", n = 3 }, { id = "silver_bar", n = 2 }, { id = "crystal", n = 2 } }, "anvil")

-- ===== طاولة الخيمياء =====
R("health_potion", 2, { { id = "herb", n = 2 }, { id = "mushroom", n = 1 }, { id = "glass", n = 1 } }, "alchemy")
R("mana_potion", 2, { { id = "crystal", n = 1 }, { id = "herb", n = 1 }, { id = "glass", n = 1 } }, "alchemy")
R("swift_potion", 1, { { id = "herb", n = 3 }, { id = "gel", n = 4 }, { id = "glass", n = 1 } }, "alchemy")
R("iron_skin_potion", 1, { { id = "iron_bar", n = 2 }, { id = "herb", n = 2 }, { id = "glass", n = 1 } }, "alchemy")
R("shine_potion", 1, { { id = "glow_dust", n = 3 }, { id = "glass", n = 1 } }, "alchemy")
R("spark_staff", 1, { { id = "crystal", n = 12 }, { id = "silver_bar", n = 6 }, { id = "wood", n = 8 } }, "alchemy")
R("flame_staff", 1, { { id = "spark_staff", n = 1 }, { id = "hellstone_bar", n = 8 }, { id = "soul_fragment", n = 4 } }, "alchemy")
R("magic_mirror", 1, { { id = "glass", n = 6 }, { id = "silver_bar", n = 6 }, { id = "crystal", n = 4 } }, "alchemy")
R("recall_stone", 3, { { id = "stone", n = 10 }, { id = "glow_dust", n = 1 } }, "alchemy")
R("mana_crystal", 1, { { id = "crystal", n = 8 }, { id = "glow_dust", n = 4 } }, "alchemy")
R("magic_essence", 2, { { id = "crystal", n = 3 }, { id = "glow_dust", n = 3 }, { id = "gold_bar", n = 1 } }, "alchemy")

Recipes.list = list

local byKey: { [string]: Recipe } = {}
for _, r in list do
	byKey[r.key] = r
end
Recipes.byKey = byKey

-- الوصفات المتاحة لمجموعة محطات مفتوحة
function Recipes.available(stations: { [string]: boolean }): { Recipe }
	local out = {}
	for _, r in list do
		if r.station == nil or stations[r.station] then
			table.insert(out, r)
		end
	end
	return out
end

return Recipes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Smelting</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Smelting — وصفات الفرن ووقوده.

	الفرن ليس وصفة تصنيع عادية: له حالة مستمرة (وقود يحترق، وشريط تقدّم)
	تعيش في العالم حتى وأنت بعيد عنه. لذلك وصفاته منفصلة عن Recipes.luau.
]]

local Items = require(script.Parent.Items)

local Smelting = {}

export type SmeltRecipe = { out: string, n: number, time: number }

-- المُدخل -> الناتج. الزمن بالثواني وقوداً محترقاً.
local recipes: { [string]: SmeltRecipe } = {
	copper_ore = { out = "copper_bar", n = 1, time = 5 },
	iron_ore = { out = "iron_bar", n = 1, time = 6 },
	silver_ore = { out = "silver_bar", n = 1, time = 7 },
	gold_ore = { out = "gold_bar", n = 1, time = 8 },
	mythril_ore = { out = "mythril_bar", n = 1, time = 12 },
	hellstone_ore = { out = "hellstone_bar", n = 1, time = 11 },

	sand = { out = "glass", n = 1, time = 3 },
	stone = { out = "stone_brick", n = 1, time = 3 },
	sandstone = { out = "sand_brick", n = 1, time = 3 },
	ice = { out = "ice_brick", n = 1, time = 3 },
	clay = { out = "brick", n = 1, time = 4 },

	leather = { out = "cooked_meat", n = 1, time = 7 },
	herb = { out = "bread", n = 1, time = 6 },
	mushroom = { out = "cooked_meat", n = 1, time = 7 },
}

-- الوقود: العنصر -> ثواني احتراق
local fuels: { [string]: number } = {
	coal = 60,
	wood = 10,
	plank = 8,
	log = 12,
	sapling = 2,
	cactus = 5,
	hellstone_ore = 90, -- يحترق طويلاً لكنه ثمين
	torch = 3,
}

Smelting.recipes = recipes
Smelting.fuels = fuels

function Smelting.recipeFor(itemId: string?): SmeltRecipe?
	if not itemId then return nil end
	return recipes[itemId]
end

function Smelting.fuelValue(itemId: string?): number
	if not itemId then return 0 end
	return fuels[itemId] or 0
end

function Smelting.isFuel(itemId: string?): boolean
	return Smelting.fuelValue(itemId) > 0
end

-- قائمة مرتّبة للعرض في الواجهة
function Smelting.list(): { { input: string, out: string, n: number, time: number } }
	local out = {}
	for input, recipe in recipes do
		if Items.get(input) and Items.get(recipe.out) then
			table.insert(out, { input = input, out = recipe.out, n = recipe.n, time = recipe.time })
		end
	end
	table.sort(out, function(a, b)
		if a.time ~= b.time then return a.time < b.time end
		return a.input < b.input
	end)
	return out
end

return Smelting
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Upgrades</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Upgrades — نظام تطوير الأدوات والدروع وسِحرها.

	لكل غرض قابل للتطوير حقل `up` صغير داخل كومته:
		{ lvl = 0..5, aff = "sharp" }

	* **التطوير (+N)** على السندان: زيادة خطية مضمونة النجاح — لا كسر ولا عشوائية.
	* **السحر (صفة)** على طاولة السحر: صفة واحدة عشوائية، يمكن إعادة رميها
	  كما في تيراريا. العشوائية هنا مقبولة لأنها قابلة للإعادة دائماً.

	كل الأغراض القابلة للتطوير حدّ تكديسها 1، فلا مشكلة اندماج أكوام مختلفة.
]]

local Items = require(script.Parent.Items)

local Upgrades = {}

export type Upgrade = { lvl: number, aff: string? }
export type Stack = { id: string, n: number, up: Upgrade? }

Upgrades.MAX_LEVEL = 5

-- ===== الصفات (السحر) =====

export type Affix = {
	id: string,
	name: string,
	color: Color3,
	desc: string,
	weight: number,
	damage: number?, -- مضاعف
	useTime: number?, -- مضاعف (أقل = أسرع)
	knockback: number?, -- مضاعف
	crit: number?, -- إضافة مطلقة
	lifesteal: number?, -- نسبة الضرر التي تُشفى
	mining: number?, -- مضاعف سرعة التعدين
	fortune: number?, -- احتمال إسقاط مضاعف
	reach: number?, -- بلاطات إضافية
	defense: number?, -- إضافة مطلقة
	speed: number?, -- مضاعف سرعة الحركة
	thorns: number?, -- نسبة الضرر المرتد
	regen: number?, -- حياة/ثانية
	mana: number?, -- مانا قصوى إضافية
}

local function C(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local WEAPON_AFFIXES: { Affix } = {
	{ id = "sharp", name = "حادّ", color = C(240, 120, 110), desc = "+15% ضرر", weight = 26, damage = 1.15 },
	{ id = "swift", name = "سريع", color = C(140, 220, 240), desc = "-14% زمن الاستخدام", weight = 24, useTime = 0.86 },
	{ id = "deadly", name = "فتّاك", color = C(250, 200, 90), desc = "+12% فرصة ضربة حرجة", weight = 18, crit = 0.12 },
	{ id = "brutal", name = "عنيف", color = C(230, 150, 90), desc = "+60% ارتداد و+6% ضرر", weight = 18, knockback = 1.6, damage = 1.06 },
	{ id = "vampiric", name = "مصّاص", color = C(200, 110, 200), desc = "يشفيك 8% من الضرر", weight = 14, lifesteal = 0.08 },
}

local TOOL_AFFIXES: { Affix } = {
	{ id = "efficient", name = "كفؤ", color = C(150, 230, 160), desc = "+28% سرعة تعدين", weight = 28, mining = 1.28 },
	{ id = "fortune", name = "موفّق", color = C(250, 210, 110), desc = "25% فرصة إسقاط مضاعف", weight = 20, fortune = 0.25 },
	{ id = "far", name = "بعيد المدى", color = C(160, 200, 250), desc = "+1.5 بلاطة مدى", weight = 20, reach = 1.5 },
	{ id = "keen", name = "ماضٍ", color = C(240, 140, 120), desc = "+18% ضرر", weight = 18, damage = 1.18 },
	{ id = "tireless", name = "لا يكلّ", color = C(200, 220, 240), desc = "+14% سرعة تعدين و-8% زمن استخدام", weight = 14, mining = 1.14, useTime = 0.92 },
}

local ARMOR_AFFIXES: { Affix } = {
	{ id = "tough", name = "صلب", color = C(190, 195, 210), desc = "+3 دفاع", weight = 28, defense = 3 },
	{ id = "agile", name = "رشيق", color = C(140, 230, 170), desc = "+8% سرعة حركة", weight = 22, speed = 1.08 },
	{ id = "thorny", name = "شائك", color = C(230, 140, 140), desc = "يرتدّ 25% من الضرر", weight = 18, thorns = 0.25 },
	{ id = "vital", name = "حيويّ", color = C(240, 130, 170), desc = "+1 حياة/ثانية", weight = 18, regen = 1 },
	{ id = "arcane", name = "غامض", color = C(150, 160, 250), desc = "+20 مانا قصوى", weight = 14, mana = 20 },
}

local byId: { [string]: Affix } = {}
for _, pool in { WEAPON_AFFIXES, TOOL_AFFIXES, ARMOR_AFFIXES } do
	for _, affix in pool do
		byId[affix.id] = affix
	end
end

Upgrades.pools = { weapon = WEAPON_AFFIXES, tool = TOOL_AFFIXES, armor = ARMOR_AFFIXES }

function Upgrades.affix(id: string?): Affix?
	if not id then return nil end
	return byId[id]
end

-- ===== الأهلية =====

-- فئة التطوير التي ينتمي إليها العنصر (أو nil إن كان غير قابل للتطوير)
function Upgrades.categoryOf(itemId: string?): string?
	if not itemId then return nil end
	local item = Items.get(itemId)
	if not item then return nil end
	if item.cat == "weapon" then return "weapon" end
	if item.cat == "tool" then return "tool" end
	if item.cat == "armor" then return "armor" end
	return nil
end

function Upgrades.canModify(itemId: string?): boolean
	return Upgrades.categoryOf(itemId) ~= nil
end

function Upgrades.levelOf(stack: Stack?): number
	if stack and stack.up then return math.clamp(stack.up.lvl or 0, 0, Upgrades.MAX_LEVEL) end
	return 0
end

function Upgrades.affixOf(stack: Stack?): Affix?
	if stack and stack.up then return Upgrades.affix(stack.up.aff) end
	return nil
end

-- ===== حساب الإحصاءات =====

-- كل مستوى تطوير يضيف 12% للأرقام النسبية
local function levelScale(level: number): number
	return 1 + 0.12 * level
end
Upgrades.levelScale = levelScale

function Upgrades.damage(stack: Stack?): number
	if not stack then return 0 end
	local item = Items.get(stack.id)
	if not item or not item.damage then return 0 end
	local value = item.damage * levelScale(Upgrades.levelOf(stack))
	local affix = Upgrades.affixOf(stack)
	if affix and affix.damage then value *= affix.damage end
	return math.floor(value + 0.5)
end

function Upgrades.useTime(stack: Stack?): number
	if not stack then return 0.35 end
	local item = Items.get(stack.id)
	local base = (item and item.useTime) or 0.35
	local affix = Upgrades.affixOf(stack)
	if affix and affix.useTime then base *= affix.useTime end
	-- التطوير يسرّع قليلاً أيضاً
	base *= 1 - 0.03 * Upgrades.levelOf(stack)
	return math.max(0.08, base)
end

function Upgrades.knockback(stack: Stack?): number
	if not stack then return 3 end
	local item = Items.get(stack.id)
	local base = (item and item.knockback) or 3
	local affix = Upgrades.affixOf(stack)
	if affix and affix.knockback then base *= affix.knockback end
	return base
end

function Upgrades.crit(stack: Stack?): number
	if not stack then return 0.03 end
	local item = Items.get(stack.id)
	local base = (item and item.crit) or 0.03
	local affix = Upgrades.affixOf(stack)
	if affix and affix.crit then base += affix.crit end
	return math.clamp(base, 0, 0.95)
end

function Upgrades.lifesteal(stack: Stack?): number
	local affix = Upgrades.affixOf(stack)
	return if affix and affix.lifesteal then affix.lifesteal else 0
end

-- قوة معول/فأس إضافية من التطوير
function Upgrades.powerBonus(stack: Stack?): number
	return 4 * Upgrades.levelOf(stack)
end

function Upgrades.miningMultiplier(stack: Stack?): number
	local value = 1 + 0.05 * Upgrades.levelOf(stack)
	local affix = Upgrades.affixOf(stack)
	if affix and affix.mining then value *= affix.mining end
	return value
end

function Upgrades.fortune(stack: Stack?): number
	local affix = Upgrades.affixOf(stack)
	return if affix and affix.fortune then affix.fortune else 0
end

function Upgrades.reachBonus(stack: Stack?): number
	local affix = Upgrades.affixOf(stack)
	return if affix and affix.reach then affix.reach else 0
end

function Upgrades.defense(stack: Stack?): number
	if not stack then return 0 end
	local item = Items.get(stack.id)
	if not item or not item.defense then return 0 end
	local value = item.defense * levelScale(Upgrades.levelOf(stack))
	local affix = Upgrades.affixOf(stack)
	if affix and affix.defense then value += affix.defense end
	return math.floor(value + 0.5)
end

-- مجموع تأثيرات الدرع الملبوس
export type ArmorBonus = { defense: number, speed: number, thorns: number, regen: number, mana: number }

function Upgrades.armorBonus(armor: { [string]: Stack? }): ArmorBonus
	local bonus: ArmorBonus = { defense = 0, speed = 1, thorns = 0, regen = 0, mana = 0 }
	for _, stack in armor do
		if stack then
			bonus.defense += Upgrades.defense(stack)
			local affix = Upgrades.affixOf(stack)
			if affix then
				if affix.speed then bonus.speed *= affix.speed end
				if affix.thorns then bonus.thorns += affix.thorns end
				if affix.regen then bonus.regen += affix.regen end
				if affix.mana then bonus.mana += affix.mana end
			end
		end
	end
	return bonus
end

-- ===== التكاليف =====

export type Cost = { material: string, amount: number, coins: number }

function Upgrades.upgradeCost(itemId: string, level: number): Cost?
	local item = Items.get(itemId)
	if not item then return nil end
	if level >= Upgrades.MAX_LEVEL then return nil end
	local target = level + 1
	return {
		material = "upgrade_core",
		amount = target,
		coins = 40 * target * (1 + item.rarity),
	}
end

function Upgrades.enchantCost(itemId: string): Cost?
	local item = Items.get(itemId)
	if not item then return nil end
	return {
		material = "magic_essence",
		amount = 2 + item.rarity,
		coins = 60 * (1 + item.rarity),
	}
end

-- اختيار صفة عشوائية موزونة (تُمرَّر قيمة عشوائية 0..1 لتبقى الدالة نقية)
function Upgrades.rollAffix(category: string, roll: number, exclude: string?): string?
	local pool = Upgrades.pools[category]
	if not pool then return nil end

	local total = 0
	for _, affix in pool do
		if affix.id ~= exclude then total += affix.weight end
	end
	if total <= 0 then
		return pool[1].id
	end

	local pick = roll * total
	for _, affix in pool do
		if affix.id ~= exclude then
			pick -= affix.weight
			if pick <= 0 then return affix.id end
		end
	end
	return pool[#pool].id
end

-- ===== العرض =====

function Upgrades.displayName(stack: Stack?): string
	if not stack then return "" end
	local item = Items.get(stack.id)
	local name = if item then item.name else stack.id
	local affix = Upgrades.affixOf(stack)
	if affix then
		name = affix.name .. " " .. name
	end
	local level = Upgrades.levelOf(stack)
	if level > 0 then
		name ..= " +" .. level
	end
	return name
end

function Upgrades.displayColor(stack: Stack?): Color3
	local affix = Upgrades.affixOf(stack)
	if affix then return affix.color end
	local item = if stack then Items.get(stack.id) else nil
	if item then
		return Items.RARITY_COLORS[item.rarity] or Color3.fromRGB(236, 236, 236)
	end
	return Color3.fromRGB(236, 236, 236)
end

-- هل هذه الكومة مطوّرة أو مسحورة؟ (لإظهار توهج في الواجهة)
function Upgrades.isModified(stack: Stack?): boolean
	return Upgrades.levelOf(stack) > 0 or Upgrades.affixOf(stack) ~= nil
end

-- تنظيف حقل التطوير قبل الحفظ/الإرسال (يُعيد nil إن كان بلا معنى)
function Upgrades.normalize(up: any): Upgrade?
	if type(up) ~= "table" then return nil end
	local level = tonumber(up.lvl) or 0
	level = math.clamp(math.floor(level), 0, Upgrades.MAX_LEVEL)
	local affixId = if type(up.aff) == "string" and byId[up.aff] then up.aff else nil
	if level == 0 and affixId == nil then return nil end
	return { lvl = level, aff = affixId }
end

return Upgrades
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!strict
--[[ Util — دوال رياضية وأدوات صغيرة مشتركة. ]]

local Util = {}

function Util.clamp(v: number, lo: number, hi: number): number
	if v < lo then return lo elseif v > hi then return hi end
	return v
end

function Util.sign(v: number): number
	return (v > 0 and 1) or (v < 0 and -1) or 0
end

function Util.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- تنعيم مستقل عن معدل الإطارات
function Util.damp(a: number, b: number, lambda: number, dt: number): number
	return Util.lerp(a, b, 1 - math.exp(-lambda * dt))
end

function Util.approach(v: number, target: number, delta: number): number
	if v < target then return math.min(v + delta, target) end
	return math.max(v - delta, target)
end

function Util.round(v: number): number
	return math.floor(v + 0.5)
end

-- تجزئة حتمية ثابتة عبر الخادم والعميل (32-bit)
function Util.hash2(x: number, y: number, seed: number): number
	local h = bit32.bxor(x * 374761393, y * 668265263, seed * 2147483647)
	h = bit32.band(h, 0xFFFFFFFF)
	h = bit32.bxor(h, bit32.rshift(h, 13))
	h = bit32.band(h * 1274126177, 0xFFFFFFFF)
	return bit32.bxor(h, bit32.rshift(h, 16))
end

-- عشوائي حتمي [0,1)
function Util.rand2(x: number, y: number, seed: number): number
	return Util.hash2(x, y, seed) % 1000000 / 1000000
end

function Util.rand1(x: number, seed: number): number
	return Util.rand2(x, 0, seed)
end

-- قيمتان عشوائيتان من تجزئة واحدة (نصفا الكلمة) — يوفّر نصف الحسابات
-- في الضوضاء الخلوية التي تحتاج إحداثيين لكل خلية.
function Util.rand2pair(x: number, y: number, seed: number): (number, number)
	local h = Util.hash2(x, y, seed)
	return (h % 65536) / 65536, ((h // 65536) % 65536) / 65536
end

-- اختيار موزون: list = {{weight = n, ...}, ...}
function Util.weightedPick<T>(list: { T & { weight: number } }, rng: number): T?
	local total = 0
	for _, v in list do total += v.weight end
	if total <= 0 then return nil end
	local r = rng * total
	for _, v in list do
		r -= v.weight
		if r <= 0 then return v end
	end
	return list[#list]
end

function Util.dist(ax: number, ay: number, bx: number, by: number): number
	local dx, dy = bx - ax, by - ay
	return math.sqrt(dx * dx + dy * dy)
end

function Util.dist2(ax: number, ay: number, bx: number, by: number): number
	local dx, dy = bx - ax, by - ay
	return dx * dx + dy * dy
end

-- تحويل ثوانٍ إلى "س:د"
function Util.clock(t: number): string
	local hours = math.floor(t * 24)
	local minutes = math.floor((t * 24 % 1) * 60)
	local suffix = hours < 12 and "ص" or "م"
	local h12 = hours % 12
	if h12 == 0 then h12 = 12 end
	return string.format("%d:%02d %s", h12, minutes, suffix)
end

function Util.shuffle<T>(list: { T }, random: Random): { T }
	for i = #list, 2, -1 do
		local j = random:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function Util.deepCopy<T>(tbl: T): T
	if type(tbl) ~= "table" then return tbl end
	local out = {}
	for k, v in tbl :: any do
		out[k] = if type(v) == "table" then Util.deepCopy(v) else v
	end
	return out :: any
end

return Util
]]></string>
        </Properties>

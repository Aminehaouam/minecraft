  <Item class="SoundService" referent="30">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="31">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="32">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="33">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
--[[
	نقطة إقلاع العميل — تربط الشبكة بالمحرك والواجهة ثم تدير الحلقة الرئيسية.
]]

local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Buffs = require(Shared.Buffs)
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Net = require(Shared.Net)

local ClientWorld = require(script.ClientWorld)
local Controller = require(script.Controller)
local Fx = require(script.Fx)
local Lighting = require(script.Lighting)
local Renderer = require(script.Renderer)
local Sfx = require(script.Sfx)
local State = require(script.State)

local Hud = require(script.UI.Hud)
local Panels = require(script.UI.Panels)

-- ===== تهيئة الواجهة =====

Renderer.init()
ClientWorld.start()
ClientWorld.onDirty(function()
	Lighting.markDirty()
end)

local gui = Renderer.gui()
Hud.build(gui)
Panels.build(gui)

pcall(function()
	StarterGui:SetCore("TopbarEnabled", false)
	-- خاصية حديثة نسبياً؛ نتجاهلها بهدوء على الإصدارات الأقدم
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
end)
UserInputService.MouseIconEnabled = true

-- ===== ربط الأحداث =====

Hud.onHotbar(function(index)
	Controller.selectHotbar(index)
end)

Hud.onInventoryButton(function()
	Panels.setOpen(not Panels.isOpen())
	Sfx.play("ui")
end)

Hud.onTouch(function(action, down)
	Controller.setTouch(action, down)
end)

Controller.on("toggleInventory", function()
	Panels.setOpen(not Panels.isOpen())
	Sfx.play("ui")
end)

Controller.on("closeAll", function()
	Panels.closeAll()
end)

Controller.on("wallMode", function(enabled: boolean)
	Hud.setWallMode(enabled)
	Sfx.play("ui")
end)

Controller.on("sfx", function(name: string, blockId: number?)
	if name == "mine" and blockId then
		Sfx.block("mine", blockId)
	elseif name == "break" and blockId then
		Sfx.block("break", blockId)
	else
		Sfx.play(name)
	end
end)

Controller.on("particles", function(tx: number, ty: number, blockId: number)
	Fx.blockBurst(tx, ty, blockId, 4)
end)

-- ===== قنوات الخادم =====

Net.get("Hello").OnClientEvent:Connect(function(payload)
	State.seed = payload.seed
	State.userId = payload.userId
	State.spawnX = payload.spawnX
	State.spawnY = payload.spawnY
	State.body.x = payload.x
	State.body.y = payload.y
	State.camX = payload.x
	State.camY = payload.y
	ClientWorld.init(payload.seed)
	-- ولّد محيط اللاعب فوراً حتى لا يسقط في فراغ غير محمّل
	ClientWorld.generateAround(payload.x, payload.y, 1)
	ClientWorld.updateSubscriptions(State.camX, State.camY)
	Lighting.markDirty()
	State.ready = true
	Hud.notify("أهلاً بك في TerraCraft — ابنِ، نقّب، وانجُ!", Color3.fromRGB(140, 220, 250), true)
end)

Net.get("Inventory").OnClientEvent:Connect(function(payload)
	local slots = {}
	for index, entry in (payload.slots or {}) :: { [number]: any } do
		slots[tonumber(index) or 0] = { id = entry[1], n = entry[2] }
	end
	State.slots = slots

	local armor = {}
	for slotName, entry in (payload.armor or {}) :: { [string]: any } do
		armor[slotName] = { id = entry[1], n = entry[2] }
	end
	State.armor = armor

	if payload.hotbar then State.hotbar = payload.hotbar end
	Panels.onInventoryChanged()
end)

Net.get("Stats").OnClientEvent:Connect(function(payload)
	local wasDead = State.dead
	State.hp = payload.hp
	State.maxHp = payload.maxHp
	State.mana = payload.mana
	State.maxMana = payload.maxMana
	State.food = payload.food
	State.defense = payload.defense
	State.dead = payload.dead
	State.respawnIn = payload.respawnIn or 0
	State.buffs = payload.buffs or {}
	State.kills = payload.kills or 0
	State.deaths = payload.deaths or 0

	if payload.dead and not wasDead then
		Sfx.play("hurt")
		Panels.closeAll()
	end
end)

Net.get("TimeSync").OnClientEvent:Connect(function(payload)
	State.time = payload.t
	State.day = payload.day
	State.bloodMoon = payload.blood == true
end)

Net.get("Entities").OnClientEvent:Connect(function(list)
	if type(list) ~= "table" then return end
	local seen: { [number]: boolean } = {}

	for _, packet in list do
		local id = packet.i
		seen[id] = true
		local existing = State.entities[id]
		if existing then
			existing.vx = (packet.x - existing.x) * Config.ENTITY_HZ
			existing.vy = (packet.y - existing.y) * Config.ENTITY_HZ
			existing.x = packet.x
			existing.y = packet.y
			existing.f = packet.f
			existing.a = packet.a
			existing.h = packet.h
			existing.n = packet.n
			existing.t = packet.t
			existing.k = packet.k
		else
			packet.rx = packet.x
			packet.ry = packet.y
			packet.vx = 0
			packet.vy = 0
			State.entities[id] = packet
		end
	end

	for id in State.entities do
		if not seen[id] then
			State.entities[id] = nil
		end
	end
end)

Net.get("PeerState").OnClientEvent:Connect(function(list)
	if type(list) ~= "table" then return end
	local seen: { [number]: boolean } = {}
	for _, packet in list do
		seen[packet.u] = true
		local existing = State.peers[packet.u]
		if existing then
			existing.vx = (packet.x - existing.x) * Config.STATE_HZ
			existing.x = packet.x
			existing.y = packet.y
			existing.f = packet.f
			existing.d = packet.d
			existing.n = packet.n
			existing.it = packet.it
			existing.hd = packet.hd
			existing.ch = packet.ch
		else
			packet.rx = packet.x
			packet.ry = packet.y
			packet.vx = 0
			State.peers[packet.u] = packet
		end
	end
	for userId in State.peers do
		if not seen[userId] then
			State.peers[userId] = nil
		end
	end
end)

Net.get("Fx").OnClientEvent:Connect(function(payload)
	Fx.handle(payload)
	if type(payload) == "table" then
		if payload.kind == "pickup" then
			Sfx.play("pickup")
		elseif payload.kind == "craft" then
			Sfx.play("craft")
		elseif payload.kind == "mob_death" then
			Sfx.play("break_block")
		end
	end
end)

Net.get("Hit").OnClientEvent:Connect(function(payload)
	Fx.handleHit(payload)
	if type(payload) == "table" and payload.kind == "player" and payload.player == State.userId then
		Sfx.play("hurt")
	end
end)

Net.get("Notify").OnClientEvent:Connect(function(payload)
	local color = if payload.color
		then Color3.fromRGB(payload.color[1], payload.color[2], payload.color[3])
		else nil
	Hud.notify(payload.text, color, payload.big)
end)

Net.get("Boss").OnClientEvent:Connect(function(payload)
	State.boss = payload
end)

Net.get("Respawn").OnClientEvent:Connect(function(x: number, y: number)
	State.body.x = x
	State.body.y = y
	State.body.vx = 0
	State.body.vy = 0
	State.camX = x
	State.camY = y
	ClientWorld.generateAround(x, y, 1)
	Lighting.markDirty()
end)

Net.get("Station").OnClientEvent:Connect(function(payload)
	Panels.openStation(payload)
	if type(payload) == "table" and payload.open then
		Sfx.play("ui")
	end
end)

Net.get("Shop").OnClientEvent:Connect(function(payload)
	Panels.openShop(payload)
	if payload.open then
		Sfx.play("ui")
	else
		Hud.notify("لا يوجد تاجر هنا — اقترب من نقطة الظهور", Color3.fromRGB(230, 190, 110))
	end
end)

-- ===== الحلقة الرئيسية =====

Controller.start()

local lightTimer = 0
local footstepTimer = 0

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 1 / 20) -- لا تسمح لقفزة إطار بكسر الفيزياء

	if not State.ready or not ClientWorld.isReady() then
		return
	end

	ClientWorld.updateSubscriptions(State.camX, State.camY)
	-- توليد مُقسَّط: قطعة واحدة كحد أقصى، وفقط إن كان الإطار السابق مريحاً.
	-- هكذا يبقى تحميل العالم غير مرئي بدل أن يُحدث تقطّعاً أثناء اللعب.
	if dt < 1 / 45 then
		ClientWorld.pump(1)
	end
	State.pending = ClientWorld.pendingChunks()
	Controller.update(dt)

	-- استيفاء مواضع الكيانات لحركة ناعمة بين حزم الشبكة
	local blend = math.min(1, dt * 16)
	for _, entity in State.entities do
		entity.rx = (entity.rx or entity.x) + (entity.x - (entity.rx or entity.x)) * blend
		entity.ry = (entity.ry or entity.y) + (entity.y - (entity.ry or entity.y)) * blend
	end
	for _, peer in State.peers do
		peer.rx = (peer.rx or peer.x) + (peer.x - (peer.rx or peer.x)) * blend
		peer.ry = (peer.ry or peer.y) + (peer.y - (peer.ry or peer.y)) * blend
	end

	-- مصادر الضوء الديناميكية: المشعل المحمول وتعزيز التوهج
	lightTimer -= dt
	if lightTimer <= 0 then
		lightTimer = 0.15
		local sources = {}
		local held = State.heldItem()
		local glow = 0
		if held then
			local item = Items.get(held.id)
			if item and item.place then
				glow = math.max(glow, Blocks.light(item.place))
			end
		end
		local buffMap = {}
		for _, buff in State.buffs do buffMap[buff.id] = buff.t end
		glow = math.max(glow, Buffs.aggregate(buffMap).light)
		if glow > 0 then
			table.insert(sources, { x = State.body.x, y = State.body.y, level = glow })
		end
		Lighting.setDynamicSources(sources)

		-- ضوء الشمس حسب وقت اليوم
		local t = State.time
		local sun = 0
		if t >= 0.27 and t <= 0.73 then
			sun = 1
		elseif t > 0.73 and t < Config.NIGHT_FROM then
			sun = 1 - (t - 0.73) / (Config.NIGHT_FROM - 0.73)
		elseif t > Config.NIGHT_TO and t < 0.27 then
			sun = (t - Config.NIGHT_TO) / (0.27 - Config.NIGHT_TO)
		end
		Lighting.setSunlight(math.max(0.08, sun))
	end

	-- صوت الخطوات
	if State.body.onGround and math.abs(State.body.vx) > 2 then
		footstepTimer -= dt
		if footstepTimer <= 0 then
			footstepTimer = 0.34
			Sfx.play("step", 0.25)
		end
	else
		footstepTimer = 0
	end

	Renderer.render(dt)
	Fx.update(dt)
	Hud.update(dt)
	Panels.update(dt)
end)

print("[TerraCraft] العميل جاهز")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ClientWorld</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ClientWorld — نسخة العالم على العميل.
	تُولَّد محلياً من نفس البذرة، ثم تُطبَّق عليها تعديلات الخادم.
	تدير أيضاً الاشتراك في القطع حسب موقع الكاميرا.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Chunk = require(Shared.Chunk)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local World = require(Shared.World)

local ClientWorld = {}

local world: World.World? = nil
local subscribed: { [string]: boolean } = {}
local genQueue: { { number } } = {}
local genQueued: { [string]: boolean } = {}
local pendingRequest: { string } = {}
local lastChunkX, lastChunkY = -999, -999
local dirtyCallback: ((x: number, y: number) -> ())? = nil

function ClientWorld.get(): World.World
	assert(world, "لم تتم تهيئة عالم العميل بعد")
	return world :: World.World
end

function ClientWorld.isReady(): boolean
	return world ~= nil
end

function ClientWorld.onDirty(callback: (x: number, y: number) -> ())
	dirtyCallback = callback
end

function ClientWorld.init(seed: number)
	world = World.new(seed, 300)
	subscribed = {}
	table.clear(genQueue)
	table.clear(genQueued)
	lastChunkX, lastChunkY = -999, -999
end

-- ===== التوليد المُقسَّط =====
-- توليد قطعة يكلف ~1024 بلاطة بحسابات ضوضاء، لذا نولّد عدداً محدوداً كل إطار
-- بدل توليدها فجأة داخل حلقة الرسم (وإلا ظهرت تقطّعات عند الحركة السريعة).

local function queueChunk(cx: number, cy: number, priority: boolean?)
	if cx < 0 or cy < 0 or cx >= Config.CHUNKS_X or cy >= Config.CHUNKS_Y then return end
	local key = Chunk.keyOf(cx, cy)
	if genQueued[key] then return end
	if world and World.isLoaded(world :: World.World, cx, cy) then return end
	genQueued[key] = true
	if priority then
		table.insert(genQueue, 1, { cx, cy })
	else
		table.insert(genQueue, { cx, cy })
	end
end

ClientWorld.queueChunk = queueChunk

-- يولّد فوراً القطع المحيطة بنقطة (تُستعمل عند الدخول أو بعد الانتقال)
function ClientWorld.generateAround(x: number, y: number, radius: number)
	if not world then return end
	local cx, cy = math.floor(x) // Config.CHUNK, math.floor(y) // Config.CHUNK
	for dy = -radius, radius do
		for dx = -radius, radius do
			World.getChunk(world :: World.World, cx + dx, cy + dy)
		end
	end
end

function ClientWorld.pump(budget: number)
	if not world then return end
	local generated = 0
	while generated < budget and #genQueue > 0 do
		local entry = table.remove(genQueue, 1)
		if not entry then break end
		local cx, cy = entry[1], entry[2]
		genQueued[Chunk.keyOf(cx, cy)] = nil
		if not World.isLoaded(world :: World.World, cx, cy) then
			World.getChunk(world :: World.World, cx, cy)
			generated += 1
		end
	end
end

function ClientWorld.pendingChunks(): number
	return #genQueue
end

-- ===== الاشتراك في القطع =====

local function flushRequests()
	if #pendingRequest == 0 then return end
	local batch = pendingRequest
	pendingRequest = {}
	Net.get("RequestChunks"):FireServer(batch, false)
end

function ClientWorld.updateSubscriptions(camX: number, camY: number)
	if not world then return end
	local cx = math.floor(camX) // Config.CHUNK
	local cy = math.floor(camY) // Config.CHUNK
	if cx == lastChunkX and cy == lastChunkY then return end
	lastChunkX, lastChunkY = cx, cy

	local wanted: { [string]: boolean } = {}
	for dy = -Config.CHUNK_RADIUS_Y, Config.CHUNK_RADIUS_Y do
		for dx = -Config.CHUNK_RADIUS_X, Config.CHUNK_RADIUS_X do
			local tx, ty = cx + dx, cy + dy
			if tx >= 0 and ty >= 0 and tx < Config.CHUNKS_X and ty < Config.CHUNKS_Y then
				local key = Chunk.keyOf(tx, ty)
				wanted[key] = true
				queueChunk(tx, ty, math.abs(dx) <= 1 and math.abs(dy) <= 1)
				if not subscribed[key] then
					subscribed[key] = true
					table.insert(pendingRequest, key)
				end
			end
		end
	end

	-- ألغِ اشتراك القطع البعيدة وحرّر ذاكرتها
	local drop: { string } = {}
	for key in subscribed do
		if not wanted[key] then
			subscribed[key] = nil
			table.insert(drop, key)
			local dcx, dcy = Chunk.parseKey(key)
			World.unload(world :: World.World, dcx, dcy)
		end
	end
	if #drop > 0 then
		Net.get("RequestChunks"):FireServer(drop, true)
	end

	flushRequests()
end

-- ===== استقبال التحديثات =====

function ClientWorld.start()
	Net.get("ChunkDiff").OnClientEvent:Connect(function(cx: number, cy: number, flat: { number })
		if not world then return end
		if type(flat) ~= "table" or #flat == 0 then return end
		World.applyEncodedDiff(world :: World.World, cx, cy, flat)
		if dirtyCallback then
			dirtyCallback(cx * Config.CHUNK, cy * Config.CHUNK)
		end
	end)

	Net.get("BlockUpdate").OnClientEvent:Connect(function(x: number, y: number, fg: number, bg: number)
		if not world then return end
		local w = world :: World.World
		-- نكتب مباشرة في القطعة والتعديلات معاً
		World.set(w, x, y, fg, bg)
		if dirtyCallback then
			dirtyCallback(x, y)
		end
	end)
end

-- تعديل تفاؤلي محلي (قبل تأكيد الخادم) لاستجابة فورية
function ClientWorld.predictSet(x: number, y: number, fg: number, bg: number)
	if not world then return end
	World.set(world :: World.World, x, y, fg, bg)
	if dirtyCallback then dirtyCallback(x, y) end
end

return ClientWorld
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Controller</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Controller — الإدخال، تنبؤ الحركة محلياً، والتعدين/البناء.

	الحركة تُحاكى فوراً على العميل بنفس وحدة الفيزياء المشتركة، وتُرسل الحالة
	18 مرة/ثانية. الخادم يرفض المستحيل فقط، فتبقى الاستجابة فورية بلا غش سهل.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Buffs = require(Shared.Buffs)
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Mining = require(Shared.Mining)
local Net = require(Shared.Net)
local Physics = require(Shared.Physics)
local Upgrades = require(Shared.Upgrades)
local Util = require(Shared.Util)
local World = require(Shared.World)

local ClientWorld = require(script.Parent.ClientWorld)
local Renderer = require(script.Parent.Renderer)
local State = require(script.Parent.State)

local Controller = {}

local input = {
	left = false,
	right = false,
	jump = false,
	down = false,
	up = false,
	primary = false,
	secondary = false,
}

local jumpHeld = 0
local coyote = 0
local jumpBuffer = 0
local sendAccumulator = 0
local placeCooldown = 0
local attackCooldown = 0
local wallMode = false

local callbacks: { [string]: (...any) -> () } = {}

function Controller.on(event: string, fn: (...any) -> ())
	callbacks[event] = fn
end

local function fire(event: string, ...)
	local fn = callbacks[event]
	if fn then fn(...) end
end

function Controller.wallMode(): boolean
	return wallMode
end

-- ===== الإدخال =====

local KEY_MOVE = {
	[Enum.KeyCode.A] = "left", [Enum.KeyCode.Left] = "left",
	[Enum.KeyCode.D] = "right", [Enum.KeyCode.Right] = "right",
	[Enum.KeyCode.W] = "up", [Enum.KeyCode.Up] = "up",
	[Enum.KeyCode.S] = "down", [Enum.KeyCode.Down] = "down",
	[Enum.KeyCode.Space] = "jump",
}

local HOTKEYS = {
	[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8, [Enum.KeyCode.Nine] = 9,
	[Enum.KeyCode.Zero] = 10,
}

function Controller.selectHotbar(index: number)
	if index < 1 or index > Config.HOTBAR then return end
	State.hotbar = index
	Net.get("InvAction"):FireServer("hotbar", index)
	fire("hotbar", index)
end

local function onInput(io: InputObject, processed: boolean)
	if processed then return end

	if io.UserInputType == Enum.UserInputType.Keyboard then
		local move = KEY_MOVE[io.KeyCode]
		if move then
			input[move] = true
			if move == "jump" then jumpBuffer = Config.JUMP_BUFFER end
			return
		end

		local hotkey = HOTKEYS[io.KeyCode]
		if hotkey then
			Controller.selectHotbar(hotkey)
			return
		end

		if io.KeyCode == Enum.KeyCode.E then
			fire("toggleInventory")
		elseif io.KeyCode == Enum.KeyCode.Q then
			Net.get("InvAction"):FireServer("drop", State.hotbar, if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then "all" else 1)
		elseif io.KeyCode == Enum.KeyCode.F then
			wallMode = not wallMode
			fire("wallMode", wallMode)
		elseif io.KeyCode == Enum.KeyCode.R then
			Net.get("Shop"):FireServer("open")
		elseif io.KeyCode == Enum.KeyCode.Escape then
			fire("closeAll")
		end
		return
	end

	if io.UserInputType == Enum.UserInputType.MouseButton1 then
		input.primary = true
	elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
		input.secondary = true
	elseif io.UserInputType == Enum.UserInputType.MouseWheel then
		local delta = if io.Position.Z > 0 then -1 else 1
		Controller.selectHotbar(((State.hotbar - 1 + delta) % Config.HOTBAR) + 1)
	end
end

local function onInputEnded(io: InputObject)
	if io.UserInputType == Enum.UserInputType.Keyboard then
		local move = KEY_MOVE[io.KeyCode]
		if move then input[move] = false end
	elseif io.UserInputType == Enum.UserInputType.MouseButton1 then
		input.primary = false
		State.mining = nil
	elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
		input.secondary = false
	end
end

-- أزرار اللمس للأجهزة المحمولة
function Controller.setTouch(action: string, down: boolean)
	if action == "left" or action == "right" or action == "jump" or action == "down" then
		input[action] = down
		if action == "jump" and down then jumpBuffer = Config.JUMP_BUFFER end
	elseif action == "primary" then
		input.primary = down
		if not down then State.mining = nil end
	elseif action == "secondary" then
		input.secondary = down
	end
end

-- ===== الحركة =====

-- GetMouseLocation يتجاهل شريط Roblox العلوي بينما واجهتنا تتجاهل الإزاحة
-- (IgnoreGuiInset)، فنضيف الإزاحة يدوياً وإلا انحرف التصويب رأسياً.
local function mousePosition(): (number, number)
	local pos = UserInputService:GetMouseLocation()
	local inset = GuiService:GetGuiInset()
	return Renderer.screenToWorld(pos.X + inset.X, pos.Y + inset.Y)
end

Controller.aimWorld = mousePosition

local function updateMovement(dt: number)
	local body = State.body
	local world = ClientWorld.get()
	local agg = Buffs.aggregate((function()
		local map = {}
		for _, buff in State.buffs do map[buff.id] = buff.t end
		return map
	end)())

	local moveDir = 0
	if input.left then moveDir -= 1 end
	if input.right then moveDir += 1 end

	local armorSpeed = Upgrades.armorBonus(State.armor).speed
	local speed = Config.WALK_SPEED * agg.speed * armorSpeed
	local accel = if body.onGround then Config.WALK_ACCEL else Config.AIR_ACCEL
	local inWater = body.inLiquid ~= 0

	if inWater then
		speed = Config.SWIM_SPEED * agg.speed * armorSpeed
		accel *= 0.6
	end

	if moveDir ~= 0 then
		body.vx = Util.approach(body.vx, moveDir * speed, accel * dt)
		State.facing = moveDir
	else
		local friction = if body.onGround then Config.GROUND_FRICTION else Config.AIR_FRICTION
		body.vx = Util.approach(body.vx, 0, friction * dt)
	end

	-- التسلّق
	local climbing = Physics.canClimb(world, body)
	if climbing then
		if input.up then
			body.vy = -Config.WALK_SPEED * 0.62
		elseif input.down then
			body.vy = Config.WALK_SPEED * 0.62
		else
			body.vy *= 0.45
		end
	end

	-- القفز
	if body.onGround then
		coyote = Config.COYOTE_TIME
	else
		coyote = math.max(0, coyote - dt)
	end
	jumpBuffer = math.max(0, jumpBuffer - dt)

	if input.jump and (inWater or climbing) then
		body.vy = -Config.SWIM_SPEED * 1.15
		jumpHeld = 0
	elseif jumpBuffer > 0 and coyote > 0 then
		body.vy = -Config.JUMP_VELOCITY * agg.jump
		jumpHeld = Config.JUMP_HOLD_TIME
		jumpBuffer = 0
		coyote = 0
		fire("sfx", "jump")
	elseif input.jump and jumpHeld > 0 then
		-- قفزة متغيرة الارتفاع
		jumpHeld -= dt
		body.vy -= Config.GRAVITY * 0.55 * dt
	else
		jumpHeld = 0
	end

	if not input.jump then jumpHeld = 0 end

	-- النزول عبر المنصات
	if input.down and body.onGround then
		body.dropThrough = 0.24
	end

	local wasAir = not body.onGround
	local fallVelocity = body.vy

	Physics.step(world, body, dt, {})

	-- ضرر السقوط (تنبؤي؛ الخادم يطبّق ضرره الخاص أيضاً عند اللزوم)
	if wasAir and body.onGround and fallVelocity > 0 then
		local tiles = (fallVelocity * fallVelocity) / (2 * Config.GRAVITY)
		if tiles > Config.FALL_SAFE and body.inLiquid == 0 then
			fire("sfx", "hurt")
			Renderer.shake(math.min(18, (tiles - Config.FALL_SAFE) * 1.5), 0.25)
		elseif fallVelocity > 12 then
			fire("sfx", "land")
		end
	end

	-- الرسوم المتحركة
	if not body.onGround then
		State.anim = if body.vy < 0 then "jump" else "fall"
	elseif math.abs(body.vx) > 0.6 then
		State.anim = "walk"
	else
		State.anim = "idle"
	end
	State.animTime += dt * math.max(1, math.abs(body.vx) / 3)

	-- حدود العالم السفلى
	if body.y > Config.WORLD_H - 4 then
		body.y = Config.WORLD_H - 4
		body.vy = 0
	end
end

-- ===== التعدين والبناء =====

local function targetTile(): (number?, number?, boolean)
	local wx, wy = mousePosition()
	local tx, ty = math.floor(wx), math.floor(wy)
	if not World.inBounds(tx, ty) then return nil, nil, false end
	local body = State.body
	local reach = Config.REACH + Upgrades.reachBonus(State.heldItem())
	local inRange = Util.dist(body.x, body.y, tx + 0.5, ty + 0.5) <= reach
	return tx, ty, inRange
end

local function currentMiningMultiplier(): number
	local map = {}
	for _, buff in State.buffs do map[buff.id] = buff.t end
	return Buffs.aggregate(map).mining * Upgrades.miningMultiplier(State.heldItem())
end

local function tryPlace(tx: number, ty: number): boolean
	local held = State.heldItem()
	if not held then return false end
	local item = Items.get(held.id)
	if not item or not item.place then return false end

	local world = ClientWorld.get()

	if wallMode then
		if not item.wall then return false end
		if World.bg(world, tx, ty) ~= Blocks.ID.AIR then return false end
	else
		if not Blocks.isReplaceable(World.fg(world, tx, ty)) then return false end
		-- لا تبنِ داخل نفسك
		local body = State.body
		local block = Blocks.get(item.place)
		if block.solid then
			if math.abs(body.x - (tx + 0.5)) < (body.w / 2 + 0.5)
				and math.abs(body.y - (ty + 0.5)) < (body.h / 2 + 0.5) then
				return false
			end
		end
	end

	if placeCooldown > 0 then return true end
	placeCooldown = 0.14

	Net.get("Edit"):FireServer("place", tx, ty, if wallMode then "wall" else "fg", State.hotbar)
	-- تنبؤ محلي فوري
	if wallMode then
		ClientWorld.predictSet(tx, ty, World.fg(world, tx, ty), item.place)
	else
		ClientWorld.predictSet(tx, ty, item.place, World.bg(world, tx, ty))
	end
	fire("sfx", "place")
	State.lastSwing = os.clock()
	return true
end

local function tryMine(tx: number, ty: number, dt: number): boolean
	local world = ClientWorld.get()
	local held = State.heldItem()
	local heldId = if held then held.id else nil

	local targetId
	if wallMode then
		local item = if heldId then Items.get(heldId) else nil
		if not item or item.tool ~= "hammer" then return false end
		targetId = World.bg(world, tx, ty)
		if targetId == Blocks.ID.AIR then return false end
	else
		targetId = World.fg(world, tx, ty)
		if targetId == Blocks.ID.AIR or Blocks.isLiquid(targetId) then return false end
	end

	local required = Mining.breakTime(
		targetId,
		heldId,
		currentMiningMultiplier(),
		Upgrades.powerBonus(held)
	)
	if not required then
		State.mining = nil
		return false
	end
	if wallMode then required *= 0.6 end

	local mining = State.mining
	if not mining or mining.x ~= tx or mining.y ~= ty or mining.layer ~= (if wallMode then "wall" else "fg") then
		mining = { x = tx, y = ty, layer = if wallMode then "wall" else "fg", progress = 0, required = required }
		State.mining = mining
	end
	mining.required = required
	mining.progress += dt
	State.lastSwing = os.clock()

	if mining.progress % 0.28 < dt then
		fire("sfx", "mine", targetId)
		fire("particles", tx, ty, targetId)
	end

	if mining.progress >= required then
		Net.get("Edit"):FireServer("break", tx, ty, mining.layer)
		-- تنبؤ محلي
		if wallMode then
			ClientWorld.predictSet(tx, ty, World.fg(world, tx, ty), Blocks.ID.AIR)
		else
			ClientWorld.predictSet(tx, ty, Blocks.ID.AIR, World.bg(world, tx, ty))
		end
		fire("sfx", "break", targetId)
		fire("particles", tx, ty, targetId)
		State.mined += 1
		State.mining = nil
	end
	return true
end

local function attack(dt: number)
	if attackCooldown > 0 then return end
	local held = State.heldItem()
	local item = if held then Items.get(held.id) else nil
	attackCooldown = if item and item.useTime then item.useTime else 0.35

	local wx, wy = mousePosition()
	Net.get("UseItem"):FireServer("attack", wx, wy)
	State.lastSwing = os.clock()
	State.facing = if wx >= State.body.x then 1 else -1
	fire("sfx", "swing")
end

local function updateActions(dt: number)
	placeCooldown = math.max(0, placeCooldown - dt)
	attackCooldown = math.max(0, attackCooldown - dt)

	if State.dead or State.uiOpen or State.shopOpen then
		State.mining = nil
		Renderer.setSelection(nil, nil, false)
		Renderer.setMiningProgress(nil, nil, 0)
		return
	end

	local tx, ty, inRange = targetTile()
	Renderer.setSelection(tx, ty, inRange)

	if not tx or not ty or not inRange then
		State.mining = nil
		Renderer.setMiningProgress(nil, nil, 0)
		if input.primary or input.secondary then
			attack(dt)
		end
		return
	end

	if input.primary then
		local held = State.heldItem()
		local item = if held then Items.get(held.id) else nil
		local handled = false

		if item and item.place then
			handled = tryPlace(tx, ty)
		end
		if not handled then
			handled = tryMine(tx, ty, dt)
		end
		if not handled then
			attack(dt)
		end
	else
		State.mining = nil
	end

	if input.secondary then
		-- التفاعل مع محطة (فرن، طاولة عمل، سندان، طاولة سحر) له الأولوية
		local block = Blocks.get(World.fg(ClientWorld.get(), tx, ty))
		if block.station then
			input.secondary = false
			Net.get("Station"):FireServer("open", tx, ty)
			fire("sfx", "ui")
			return
		end

		local held = State.heldItem()
		local item = if held then Items.get(held.id) else nil
		if item and (item.cat == "consumable" or item.cat == "misc") then
			local wx, wy = mousePosition()
			Net.get("UseItem"):FireServer("use", wx, wy)
			attackCooldown = math.max(attackCooldown, item.useTime or 0.5)
			input.secondary = false
		else
			attack(dt)
		end
	end

	local mining = State.mining
	if mining then
		Renderer.setMiningProgress(mining.x, mining.y, mining.progress / math.max(0.01, mining.required))
	else
		Renderer.setMiningProgress(nil, nil, 0)
	end
end

-- ===== الشبكة =====

local function sendState(dt: number)
	sendAccumulator += dt
	if sendAccumulator < 1 / Config.STATE_HZ then return end
	sendAccumulator = 0
	local body = State.body
	Net.get("PlayerState"):FireServer(body.x, body.y, body.vx, body.vy, State.facing, State.anim)
end

-- ===== الحلقة =====

function Controller.update(dt: number)
	if not ClientWorld.isReady() then return end
	if not State.dead then
		updateMovement(dt)
	end
	updateActions(dt)
	sendState(dt)
end

function Controller.start()
	UserInputService.InputBegan:Connect(onInput)
	UserInputService.InputEnded:Connect(function(io) onInputEnded(io) end)

	UserInputService.WindowFocusReleased:Connect(function()
		for key in input do input[key] = false end
		State.mining = nil
	end)

	-- امنع قائمة Roblox الافتراضية من التقاط المفاتيح المستعملة
	ContextActionService:BindAction("TerraCraftBlockDefaults", function()
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Slash)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
--[[ Fx — الجسيمات وأرقام الضرر والمؤثرات اللحظية. ]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Items = require(Shared.Items)

local Renderer = require(script.Parent.Renderer)
local State = require(script.Parent.State)

local Fx = {}

type Particle = {
	frame: Frame,
	x: number,
	y: number,
	vx: number,
	vy: number,
	life: number,
	maxLife: number,
	gravity: number,
	size: number,
	fade: boolean,
}

type FloatText = {
	label: TextLabel,
	x: number,
	y: number,
	vy: number,
	life: number,
	maxLife: number,
}

local particles: { Particle } = {}
local texts: { FloatText } = {}
local particlePool: { Frame } = {}
local textPool: { TextLabel } = {}

local MAX_PARTICLES = 220
local MAX_TEXTS = 40

local function acquireParticle(): Frame
	local frame = table.remove(particlePool)
	if frame then
		frame.Visible = true
		return frame
	end
	frame = Instance.new("Frame")
	frame.BorderSizePixel = 0
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.ZIndex = 9
	frame.Parent = Renderer.fxLayer()
	return frame
end

local function releaseParticle(frame: Frame)
	frame.Visible = false
	table.insert(particlePool, frame)
end

local function acquireText(): TextLabel
	local label = table.remove(textPool)
	if label then
		label.Visible = true
		return label
	end
	label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.25
	label.ZIndex = 12
	label.Size = UDim2.fromOffset(140, 26)
	label.Parent = Renderer.fxLayer()
	return label
end

local function releaseText(label: TextLabel)
	label.Visible = false
	table.insert(textPool, label)
end

-- ===== الإنشاء =====

function Fx.particle(x: number, y: number, vx: number, vy: number, color: Color3, size: number, life: number, gravity: number?)
	if #particles >= MAX_PARTICLES then return end
	local frame = acquireParticle()
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 0
	frame.Rotation = math.random(0, 90)
	table.insert(particles, {
		frame = frame, x = x, y = y, vx = vx, vy = vy,
		life = life, maxLife = life, gravity = gravity or 30,
		size = size, fade = true,
	})
end

function Fx.blockBurst(tx: number, ty: number, blockId: number, amount: number?)
	local block = Blocks.get(blockId)
	if blockId == 0 then return end
	local count = amount or 7
	for _ = 1, count do
		Fx.particle(
			tx + 0.2 + math.random() * 0.6,
			ty + 0.2 + math.random() * 0.6,
			(math.random() - 0.5) * 7,
			-math.random() * 6 - 1,
			block.color,
			0.18 + math.random() * 0.14,
			0.45 + math.random() * 0.35
		)
	end
end

function Fx.burst(x: number, y: number, color: Color3, count: number, power: number, life: number?, gravity: number?)
	for _ = 1, count do
		local angle = math.random() * math.pi * 2
		local speed = power * (0.35 + math.random() * 0.65)
		Fx.particle(
			x, y,
			math.cos(angle) * speed,
			math.sin(angle) * speed,
			color,
			0.16 + math.random() * 0.18,
			life or (0.4 + math.random() * 0.4),
			gravity
		)
	end
end

function Fx.text(x: number, y: number, message: string, color: Color3, size: number?)
	if #texts >= MAX_TEXTS then
		local oldest = table.remove(texts, 1)
		if oldest then releaseText(oldest.label) end
	end
	local label = acquireText()
	label.Text = message
	label.TextColor3 = color
	label.TextSize = size or 18
	label.TextTransparency = 0
	table.insert(texts, {
		label = label, x = x, y = y,
		vy = -2.6, life = 0.95, maxLife = 0.95,
	})
end

function Fx.damage(x: number, y: number, amount: number, crit: boolean, mine: boolean)
	local color = if crit then Color3.fromRGB(255, 210, 90)
		elseif mine then Color3.fromRGB(255, 120, 120)
		else Color3.fromRGB(255, 245, 230)
	Fx.text(x + (math.random() - 0.5) * 0.6, y, tostring(amount), color, if crit then 24 else 18)
end

function Fx.pickup(x: number, y: number, itemId: string, count: number)
	local item = Items.get(itemId)
	local name = if item then item.name else itemId
	local color = if item then item.color else Color3.fromRGB(240, 240, 240)
	Fx.text(x, y - 1, string.format("%s ×%d", name, count), color, 15)
end

-- ===== التحديث =====

function Fx.update(dt: number)
	local tile = Renderer.tileSize()

	for i = #particles, 1, -1 do
		local particle = particles[i]
		particle.life -= dt
		if particle.life <= 0 then
			releaseParticle(particle.frame)
			table.remove(particles, i)
		else
			particle.vy += particle.gravity * dt
			particle.x += particle.vx * dt
			particle.y += particle.vy * dt
			local pxSize = particle.size * tile
			particle.frame.Size = UDim2.fromOffset(pxSize, pxSize)
			particle.frame.Position = UDim2.fromOffset(particle.x * tile, particle.y * tile)
			particle.frame.BackgroundTransparency = 1 - (particle.life / particle.maxLife)
		end
	end

	for i = #texts, 1, -1 do
		local entry = texts[i]
		entry.life -= dt
		if entry.life <= 0 then
			releaseText(entry.label)
			table.remove(texts, i)
		else
			entry.y += entry.vy * dt
			entry.vy += 3.2 * dt
			local alpha = 1 - (entry.life / entry.maxLife)
			entry.label.Position = UDim2.fromOffset(entry.x * tile, entry.y * tile)
			entry.label.TextTransparency = math.max(0, alpha * alpha)
			entry.label.TextStrokeTransparency = 0.25 + alpha * 0.75
		end
	end
end

-- ===== معالجة رسائل المؤثرات من الخادم =====

function Fx.handle(payload: any)
	if type(payload) ~= "table" then return end
	local kind = payload.kind

	if kind == "break" then
		Fx.blockBurst(payload.x, payload.y, payload.block, 9)
	elseif kind == "place" then
		Fx.blockBurst(payload.x, payload.y, payload.block, 4)
	elseif kind == "mob_death" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(200, 60, 60), 16, 9)
	elseif kind == "burn_away" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(250, 170, 70), 14, 7)
	elseif kind == "death" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(220, 50, 50), 26, 12)
		Renderer.shake(20, 0.5)
	elseif kind == "proj_hit" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(240, 200, 140), 8, 6, 0.3)
	elseif kind == "teleport" then
		Fx.burst(payload.x, payload.y, Color3.fromRGB(160, 200, 250), 24, 10, 0.6, 0)
	elseif kind == "consume" then
		local item = Items.get(payload.item)
		Fx.burst(payload.x, payload.y, if item then item.color else Color3.fromRGB(240, 240, 240), 10, 5, 0.5, -6)
	elseif kind == "craft" then
		Fx.pickup(payload.x, payload.y - 1.5, payload.item, payload.count)
	elseif kind == "pickup" then
		Fx.pickup(payload.x, payload.y, payload.item, payload.count)
	elseif kind == "swing" then
		if payload.player ~= State.userId then return end
	elseif kind == "upgrade" then
		Fx.burst(payload.x, payload.y - 1, Color3.fromRGB(250, 205, 110), 22, 8, 0.7, -4)
		Fx.text(payload.x, payload.y - 2, "تمّ التطوير!", Color3.fromRGB(250, 210, 110), 20)
	elseif kind == "enchant" then
		Fx.burst(payload.x, payload.y - 1, Color3.fromRGB(180, 150, 250), 26, 9, 0.8, -5)
		Fx.text(payload.x, payload.y - 2, "سِحر!", Color3.fromRGB(190, 150, 250), 20)
	elseif kind == "boss_charge" then
		Renderer.shake(12, 0.3)
		Fx.burst(payload.x, payload.y, Color3.fromRGB(220, 60, 70), 20, 12, 0.5, 0)
	elseif kind == "boss_phase" then
		Renderer.shake(26, 0.7)
		Fx.burst(payload.x, payload.y, Color3.fromRGB(255, 90, 90), 40, 16, 0.9, 0)
	end
end

function Fx.handleHit(payload: any)
	if type(payload) ~= "table" then return end
	if payload.kind == "mob" then
		Fx.damage(payload.x, payload.y, payload.amount, payload.crit == true, false)
		Fx.burst(payload.x, payload.y, Color3.fromRGB(220, 80, 80), 5, 5, 0.3)
	elseif payload.kind == "player" then
		local mine = payload.player == State.userId
		Fx.damage(payload.x, payload.y - 1.4, payload.amount, false, mine)
		if mine then
			Renderer.shake(9, 0.22)
		end
	elseif payload.kind == "heal" then
		Fx.text(payload.x, payload.y - 1.4, "+" .. tostring(payload.amount), Color3.fromRGB(120, 240, 140), 18)
	end
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Lighting</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Lighting — إضاءة بلاطية بانتشار BFS (مثل ماين كرافت) فوق نافذة حول الكاميرا.

	مصدران: ضوء الشمس النازل من السطح (متأثر بوقت اليوم) ومصادر الضوء
	(مشاعل، حمم، بلّور). يُعاد الحساب عند تغيّر النافذة أو تعديل بلاطة،
	وبحدّ أقصى LIGHT_HZ مرة في الثانية.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Config = require(Shared.Config)
local World = require(Shared.World)

local Lighting = {}

local MAX = Config.MAX_LIGHT

local levels: { number } = {} -- مصفوفة مسطّحة بحجم النافذة
local originX, originY = 0, 0
local width, height = 0, 0
local dirty = true
local sunlight = 1
local extraSources: { { x: number, y: number, level: number } } = {}

function Lighting.resize(w: number, h: number)
	width = w + Config.LIGHT_PAD * 2
	height = h + Config.LIGHT_PAD * 2
	levels = table.create(width * height, 0)
	dirty = true
end

function Lighting.markDirty()
	dirty = true
end

function Lighting.setSunlight(value: number)
	if math.abs(value - sunlight) > 0.02 then
		sunlight = value
		dirty = true
	end
end

-- مصادر ضوء ديناميكية (اللاعب حامل مشعل، تعزيز التوهج…)
function Lighting.setDynamicSources(sources: { { x: number, y: number, level: number } })
	extraSources = sources
	dirty = true
end

function Lighting.get(x: number, y: number): number
	local lx, ly = x - originX, y - originY
	if lx < 0 or ly < 0 or lx >= width or ly >= height then
		return MAX
	end
	return levels[ly * width + lx + 1] or 0
end

-- شدة الإضاءة كنسبة 0..1 مع منحنى ألطف للعين
function Lighting.factor(x: number, y: number): number
	local level = Lighting.get(x, y)
	local t = level / MAX
	return 0.055 + 0.945 * (t * t * (3 - 2 * t))
end

function Lighting.recompute(world: World.World, camX: number, camY: number, viewW: number, viewH: number)
	local newOriginX = math.floor(camX - viewW / 2) - Config.LIGHT_PAD
	local newOriginY = math.floor(camY - viewH / 2) - Config.LIGHT_PAD
	if newOriginX == originX and newOriginY == originY and not dirty then
		return
	end
	originX, originY = newOriginX, newOriginY
	dirty = false

	table.clear(levels)
	local size = width * height
	for i = 1, size do
		levels[i] = 0
	end

	-- طابور BFS مسطّح (فهرس, مستوى)
	local queue = table.create(size)
	local head, tail = 1, 0
	local sunLevel = math.floor(MAX * sunlight + 0.5)

	-- 1) بذور ضوء الشمس
	for lx = 0, width - 1 do
		local worldX = originX + lx
		if worldX >= 0 and worldX < Config.WORLD_W and sunLevel > 0 then
			local surface = World.surfaceY(world, worldX)
			for ly = 0, height - 1 do
				local worldY = originY + ly
				if worldY < surface then
					local index = ly * width + lx + 1
					if levels[index] < sunLevel then
						levels[index] = sunLevel
						tail += 1
						queue[tail] = index
					end
				else
					break
				end
			end
		end
	end

	-- 2) بذور مصادر الضوء داخل النافذة
	for ly = 0, height - 1 do
		local worldY = originY + ly
		local rowBase = ly * width
		for lx = 0, width - 1 do
			local worldX = originX + lx
			local fgId = World.fgRaw(world, worldX, worldY)
			local emit = if fgId then Blocks.light(fgId) else 0
			if emit == 0 then
				local bgId = World.bgRaw(world, worldX, worldY)
				emit = if bgId then Blocks.light(bgId) else 0
			end
			if emit > 0 then
				local index = rowBase + lx + 1
				if levels[index] < emit then
					levels[index] = emit
					tail += 1
					queue[tail] = index
				end
			end
		end
	end

	-- 3) المصادر الديناميكية
	for _, source in extraSources do
		local lx, ly = math.floor(source.x) - originX, math.floor(source.y) - originY
		if lx >= 0 and ly >= 0 and lx < width and ly < height then
			local index = ly * width + lx + 1
			if levels[index] < source.level then
				levels[index] = source.level
				tail += 1
				queue[tail] = index
			end
		end
	end

	-- 4) الانتشار
	while head <= tail do
		local index = queue[head]
		head += 1
		local level = levels[index]
		if level > 1 then
			local i0 = index - 1
			local lx = i0 % width
			local ly = i0 // width

			for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
				local nx, ny = lx + offset[1], ly + offset[2]
				if nx >= 0 and ny >= 0 and nx < width and ny < height then
					local nIndex = ny * width + nx + 1
					local worldX, worldY = originX + nx, originY + ny
					local neighbourFg = World.fgRaw(world, worldX, worldY)
					-- قطعة غير محمّلة بعد: عاملها كصخر معتم حتى لا يتسرّب الضوء
					local blockOpacity = if neighbourFg then Blocks.opacity(neighbourFg) else 15
					local opacity = math.max(1, blockOpacity)
					if blockOpacity < 15 then
						-- الجدار الخلفي يخفت الضوء قليلاً أيضاً
						local neighbourBg = World.bgRaw(world, worldX, worldY)
						if neighbourBg and neighbourBg ~= 0 then
							opacity = math.max(opacity, 2)
						end
					end
					local spread = level - opacity
					if spread > levels[nIndex] then
						levels[nIndex] = spread
						tail += 1
						queue[tail] = nIndex
					end
				end
			end
		end
	end
end

return Lighting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Renderer</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Renderer — محرك الرسم ثنائي الأبعاد.

	الفكرة الأساسية للأداء: شبكة ثابتة من الإطارات تُعاد تدويرها (torus mapping).
	الإطار في الموضع (tx % cols, ty % rows) يرسم دائماً البلاطة (tx, ty)،
	وتُحرَّك الحاوية كلها مع الكاميرا. النتيجة: تمرير سلس بلا إنشاء/حذف إطارات،
	وتحديث خصائص فقط عند تغيّر المحتوى أو الإضاءة.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Config = require(Shared.Config)
local Mobs = require(Shared.Mobs)
local Util = require(Shared.Util)
local World = require(Shared.World)
local WorldGen = require(Shared.WorldGen)

local ClientWorld = require(script.Parent.ClientWorld)
local Lighting = require(script.Parent.Lighting)
local Sprites = require(script.Parent.Sprites)
local State = require(script.Parent.State)

local Renderer = {}

local player = Players.LocalPlayer

local gui: ScreenGui
local skyFrame: Frame
local skyGradient: UIGradient
local starsFolder: Frame
local celestial: Frame
local cloudFolder: Frame
local hillsFar: Frame
local hillsNear: Frame
local worldRoot: Frame
local tileContainer: Frame
local entityContainer: Frame
local fxContainer: Frame

type Slot = {
	wall: Frame,
	fg: Frame,
	tx: number,
	ty: number,
	lastFg: number,
	lastBg: number,
	lastLight: number,
}

local slots: { Slot } = {}
local cols, rows = 0, 0
local tilePx = 40
local viewW, viewH = 0, 0
local shakeTime, shakeMagnitude = 0, 0

local stars: { Frame } = {}
local clouds: { Frame } = {}
local hillBarsFar: { Frame } = {}
local hillBarsNear: { Frame } = {}

-- تجمّعات الكيانات
local charSprites: { [number]: Sprites.Character } = {}
local mobSprites: { [number]: Sprites.MobSprite } = {}
local itemSprites: { [number]: Sprites.ItemSprite } = {}
local projSprites: { [number]: Sprites.ProjSprite } = {}
local localCharacter: Sprites.Character
local miningOverlay: Frame
local selectionBox: Frame

-- ===== إنشاء الواجهة =====

local function makeFrame(parent: Instance, name: string, zindex: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = zindex
	f.Parent = parent
	return f
end

local function buildSky(parent: Instance)
	skyFrame = Instance.new("Frame")
	skyFrame.Name = "Sky"
	skyFrame.Size = UDim2.fromScale(1, 1)
	skyFrame.BorderSizePixel = 0
	skyFrame.BackgroundColor3 = Color3.fromRGB(120, 180, 235)
	skyFrame.ZIndex = 1
	skyFrame.Parent = parent

	skyGradient = Instance.new("UIGradient")
	skyGradient.Rotation = 90
	skyGradient.Color = ColorSequence.new(Color3.fromRGB(96, 160, 230), Color3.fromRGB(186, 218, 240))
	skyGradient.Parent = skyFrame

	starsFolder = makeFrame(parent, "Stars", 2)
	for i = 1, 90 do
		local star = Instance.new("Frame")
		star.BorderSizePixel = 0
		star.BackgroundColor3 = Color3.fromRGB(255, 255, 245)
		star.AnchorPoint = Vector2.new(0.5, 0.5)
		star.Size = UDim2.fromOffset(2, 2)
		star.Position = UDim2.fromScale(math.random(), math.random() * 0.65)
		star.ZIndex = 2
		star.Parent = starsFolder
		table.insert(stars, star)
	end

	celestial = Instance.new("Frame")
	celestial.Name = "Sun"
	celestial.BorderSizePixel = 0
	celestial.AnchorPoint = Vector2.new(0.5, 0.5)
	celestial.Size = UDim2.fromOffset(74, 74)
	celestial.BackgroundColor3 = Color3.fromRGB(255, 240, 190)
	celestial.ZIndex = 3
	celestial.Parent = parent
	local sunCorner = Instance.new("UICorner")
	sunCorner.CornerRadius = UDim.new(0.5, 0)
	sunCorner.Parent = celestial

	hillsFar = makeFrame(parent, "HillsFar", 4)
	for i = 1, 40 do
		local bar = Instance.new("Frame")
		bar.BorderSizePixel = 0
		bar.AnchorPoint = Vector2.new(0.5, 1)
		bar.BackgroundColor3 = Color3.fromRGB(56, 78, 96)
		bar.ZIndex = 4
		bar.Parent = hillsFar
		table.insert(hillBarsFar, bar)
	end

	hillsNear = makeFrame(parent, "HillsNear", 5)
	for i = 1, 40 do
		local bar = Instance.new("Frame")
		bar.BorderSizePixel = 0
		bar.AnchorPoint = Vector2.new(0.5, 1)
		bar.BackgroundColor3 = Color3.fromRGB(40, 60, 70)
		bar.ZIndex = 5
		bar.Parent = hillsNear
		table.insert(hillBarsNear, bar)
	end

	cloudFolder = makeFrame(parent, "Clouds", 6)
	for i = 1, 16 do
		local cloud = Instance.new("Frame")
		cloud.BorderSizePixel = 0
		cloud.AnchorPoint = Vector2.new(0.5, 0.5)
		cloud.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		cloud.BackgroundTransparency = 0.15
		cloud.ZIndex = 6
		cloud.Parent = cloudFolder
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = cloud
		table.insert(clouds, cloud)
	end
end

local function buildTileGrid()
	for _, slot in slots do
		slot.wall:Destroy()
		slot.fg:Destroy()
	end
	table.clear(slots)

	tilePx = math.max(16, math.floor(viewH / Config.TILES_ON_SCREEN_Y))
	State.tilePx = tilePx
	cols = math.ceil(viewW / tilePx) + Config.RENDER_PAD * 2
	rows = Config.TILES_ON_SCREEN_Y + Config.RENDER_PAD * 2

	for i = 1, cols * rows do
		local wall = Instance.new("Frame")
		wall.BorderSizePixel = 0
		wall.Size = UDim2.fromOffset(tilePx + 1, tilePx + 1)
		wall.BackgroundColor3 = Color3.new(0, 0, 0)
		wall.BackgroundTransparency = 1
		wall.ZIndex = 2
		wall.Parent = tileContainer

		local fg = Instance.new("Frame")
		fg.BorderSizePixel = 0
		fg.Size = UDim2.fromOffset(tilePx + 1, tilePx + 1)
		fg.BackgroundColor3 = Color3.new(0, 0, 0)
		fg.BackgroundTransparency = 1
		fg.ZIndex = 3
		fg.Parent = tileContainer

		-- تدرّج خفيف يعطي إحساس الإضاءة العلوية (بلا أي صور)
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = 90
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.18, Color3.fromRGB(238, 238, 238)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(188, 188, 188)),
		})
		gradient.Parent = fg

		table.insert(slots, {
			wall = wall, fg = fg,
			tx = -99999, ty = -99999,
			lastFg = -1, lastBg = -1, lastLight = -1,
		})
	end

	Lighting.resize(cols, rows)
end

function Renderer.init()
	local playerGui = player:WaitForChild("PlayerGui")

	gui = Instance.new("ScreenGui")
	gui.Name = "TerraCraft"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10
	-- خاصية حديثة نسبياً: نتجاهلها بهدوء على الإصدارات الأقدم من المحرّك
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None
	end)
	gui.Parent = playerGui

	buildSky(gui)

	worldRoot = Instance.new("Frame")
	worldRoot.Name = "World"
	worldRoot.BackgroundTransparency = 1
	worldRoot.Size = UDim2.fromScale(1, 1)
	worldRoot.ClipsDescendants = true
	worldRoot.ZIndex = 7
	worldRoot.Parent = gui

	tileContainer = Instance.new("Frame")
	tileContainer.Name = "Tiles"
	tileContainer.BackgroundTransparency = 1
	tileContainer.Size = UDim2.fromOffset(0, 0)
	tileContainer.ZIndex = 2
	tileContainer.Parent = worldRoot

	entityContainer = Instance.new("Frame")
	entityContainer.Name = "Entities"
	entityContainer.BackgroundTransparency = 1
	entityContainer.Size = UDim2.fromOffset(0, 0)
	entityContainer.ZIndex = 5
	entityContainer.Parent = worldRoot

	fxContainer = Instance.new("Frame")
	fxContainer.Name = "Fx"
	fxContainer.BackgroundTransparency = 1
	fxContainer.Size = UDim2.fromOffset(0, 0)
	fxContainer.ZIndex = 9
	fxContainer.Parent = worldRoot

	-- مؤشر البلاطة المستهدفة
	selectionBox = Instance.new("Frame")
	selectionBox.BackgroundTransparency = 1
	selectionBox.BorderSizePixel = 0
	selectionBox.AnchorPoint = Vector2.new(0, 0)
	selectionBox.ZIndex = 8
	selectionBox.Visible = false
	selectionBox.Parent = tileContainer
	local selStroke = Instance.new("UIStroke")
	selStroke.Color = Color3.fromRGB(255, 255, 255)
	selStroke.Thickness = 2
	selStroke.Transparency = 0.25
	selStroke.Parent = selectionBox

	-- تراكب تقدّم التعدين
	miningOverlay = Instance.new("Frame")
	miningOverlay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	miningOverlay.BackgroundTransparency = 0.55
	miningOverlay.BorderSizePixel = 0
	miningOverlay.AnchorPoint = Vector2.new(0, 1)
	miningOverlay.ZIndex = 8
	miningOverlay.Visible = false
	miningOverlay.Parent = tileContainer

	localCharacter = Sprites.newCharacter(entityContainer, false)

	local camera = workspace.CurrentCamera
	while not camera do
		task.wait()
		camera = workspace.CurrentCamera
	end
	viewW, viewH = camera.ViewportSize.X, camera.ViewportSize.Y
	buildTileGrid()

	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		viewW, viewH = camera.ViewportSize.X, camera.ViewportSize.Y
		buildTileGrid()
	end)

	-- كاميرا Roblox معطّلة تماماً: اللعبة كلها واجهة
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.new(0, 5000, 0)
end

function Renderer.gui(): ScreenGui
	return gui
end

function Renderer.fxLayer(): Frame
	return fxContainer
end

function Renderer.tileSize(): number
	return tilePx
end

function Renderer.shake(magnitude: number, duration: number)
	shakeMagnitude = math.max(shakeMagnitude, magnitude)
	shakeTime = math.max(shakeTime, duration)
end

-- ===== تحويل الإحداثيات =====

function Renderer.worldToScreen(x: number, y: number): (number, number)
	return (x - State.camX) * tilePx + viewW / 2, (y - State.camY) * tilePx + viewH / 2
end

function Renderer.screenToWorld(px: number, py: number): (number, number)
	return (px - viewW / 2) / tilePx + State.camX, (py - viewH / 2) / tilePx + State.camY
end

-- ===== السماء =====

local DAY_TOP = Color3.fromRGB(78, 148, 226)
local DAY_BOTTOM = Color3.fromRGB(186, 218, 240)
local NIGHT_TOP = Color3.fromRGB(8, 10, 28)
local NIGHT_BOTTOM = Color3.fromRGB(30, 34, 68)
local DUSK_TOP = Color3.fromRGB(48, 46, 96)
local DUSK_BOTTOM = Color3.fromRGB(232, 140, 88)
local BLOOD_TOP = Color3.fromRGB(52, 6, 10)
local BLOOD_BOTTOM = Color3.fromRGB(150, 32, 34)

local function updateSky()
	local t = State.time
	local topColor, bottomColor

	local sun = 0
	if t >= 0.27 and t <= 0.73 then
		sun = 1
	elseif t > 0.73 and t < Config.NIGHT_FROM then
		sun = 1 - (t - 0.73) / (Config.NIGHT_FROM - 0.73)
	elseif t > Config.NIGHT_TO and t < 0.27 then
		sun = (t - Config.NIGHT_TO) / (0.27 - Config.NIGHT_TO)
	end

	local duskness = 1 - math.abs(sun * 2 - 1)
	if sun >= 0.999 then duskness = 0 end

	topColor = NIGHT_TOP:Lerp(DAY_TOP, sun)
	bottomColor = NIGHT_BOTTOM:Lerp(DAY_BOTTOM, sun)
	topColor = topColor:Lerp(DUSK_TOP, duskness * 0.7)
	bottomColor = bottomColor:Lerp(DUSK_BOTTOM, duskness * 0.8)

	if State.bloodMoon then
		topColor = topColor:Lerp(BLOOD_TOP, 0.75)
		bottomColor = bottomColor:Lerp(BLOOD_BOTTOM, 0.65)
	end

	-- تحت الأرض: خلفية كهفية تعتم مع العمق
	local depth = State.camY - Config.SURFACE
	if depth > 0 then
		local blend = math.clamp(depth / 90, 0, 1)
		local caveTop = Color3.fromRGB(26, 22, 28)
		local caveBottom = Color3.fromRGB(14, 12, 16)
		if State.camY >= Config.HELL_Y - 40 then
			caveTop = Color3.fromRGB(48, 16, 12)
			caveBottom = Color3.fromRGB(22, 8, 8)
		end
		topColor = topColor:Lerp(caveTop, blend)
		bottomColor = bottomColor:Lerp(caveBottom, blend)
	end

	skyGradient.Color = ColorSequence.new(topColor, bottomColor)

	-- النجوم
	local starAlpha = math.clamp(1 - sun * 1.6, 0, 1) * math.clamp(1 - math.max(0, depth) / 40, 0, 1)
	starsFolder.Visible = starAlpha > 0.02
	if starsFolder.Visible then
		for i, star in stars do
			local twinkle = 0.3 + 0.7 * math.abs(math.sin(os.clock() * 1.4 + i))
			star.BackgroundTransparency = 1 - starAlpha * twinkle
		end
	end

	-- الشمس/القمر على قوس
	local aboveGround = depth < 30
	celestial.Visible = aboveGround
	if aboveGround then
		local angle = (t - 0.25) * math.pi * 2
		local cx = 0.5 + math.cos(angle - math.pi / 2) * 0.42
		local cy = 0.62 - math.sin(angle) * 0.5
		celestial.Position = UDim2.fromScale(cx, cy)
		if sun > 0.35 then
			celestial.BackgroundColor3 = Color3.fromRGB(255, 242, 196)
			celestial.Size = UDim2.fromOffset(78, 78)
		else
			celestial.BackgroundColor3 = if State.bloodMoon
				then Color3.fromRGB(228, 70, 64)
				else Color3.fromRGB(226, 230, 240)
			celestial.Size = UDim2.fromOffset(58, 58)
		end
		celestial.BackgroundTransparency = math.clamp(math.max(0, depth) / 30, 0, 1)
	end

	-- السحب (منظور متحرك)
	cloudFolder.Visible = aboveGround
	if aboveGround then
		local drift = os.clock() * 6
		for i, cloud in clouds do
			local seedX = i * 137.5
			local baseX = ((seedX + drift - State.camX * tilePx * 0.12) % (viewW + 600)) - 300
			local sizeX = 90 + (i % 5) * 55
			local sizeY = 26 + (i % 3) * 12
			cloud.Size = UDim2.fromOffset(sizeX, sizeY)
			cloud.Position = UDim2.fromOffset(baseX, 60 + (i % 6) * 46 - State.camY * tilePx * 0.06 + Config.SURFACE * tilePx * 0.06)
			cloud.BackgroundTransparency = 0.15 + math.clamp(math.max(0, depth) / 30, 0, 0.85)
			cloud.BackgroundColor3 = Color3.fromRGB(255, 255, 255):Lerp(bottomColor, 1 - sun * 0.8)
		end
	end

	-- التلال البعيدة
	local showHills = depth < 24
	hillsFar.Visible = showHills
	hillsNear.Visible = showHills
	if showHills then
		local seed = State.seed
		for i, bar in hillBarsFar do
			local worldX = State.camX * 0.35 + (i - 20) * 7
			local h = WorldGen.surfaceHeight(seed, math.floor(worldX) % Config.WORLD_W)
			local screenY = viewH / 2 + (h - State.camY) * tilePx * 0.35 + 60
			bar.Size = UDim2.fromOffset(viewW / 18 + 4, math.max(10, viewH - screenY + 200))
			bar.Position = UDim2.fromOffset((i - 1) * (viewW / 18) - (State.camX * tilePx * 0.12) % (viewW / 18) * 2, screenY + 200)
			bar.BackgroundColor3 = Color3.fromRGB(56, 78, 96):Lerp(bottomColor, 0.55)
			bar.BackgroundTransparency = math.clamp(math.max(0, depth) / 24, 0, 1)
		end
		for i, bar in hillBarsNear do
			local worldX = State.camX * 0.6 + (i - 20) * 5
			local h = WorldGen.surfaceHeight(seed, math.floor(worldX) % Config.WORLD_W)
			local screenY = viewH / 2 + (h - State.camY) * tilePx * 0.6 + 30
			bar.Size = UDim2.fromOffset(viewW / 24 + 4, math.max(10, viewH - screenY + 200))
			bar.Position = UDim2.fromOffset((i - 1) * (viewW / 24) - (State.camX * tilePx * 0.28) % (viewW / 24) * 2, screenY + 200)
			bar.BackgroundColor3 = Color3.fromRGB(38, 58, 68):Lerp(bottomColor, 0.35)
			bar.BackgroundTransparency = math.clamp(math.max(0, depth) / 24, 0, 1)
		end
	end
end

-- ===== البلاطات =====

local UNLOADED = -1
local UNLOADED_COLOR = Color3.fromRGB(12, 12, 16)

local function applyTile(slot: Slot, tx: number, ty: number, fgId: number, bgId: number, light: number)
	local fgFrame = slot.fg
	local wallFrame = slot.wall

	-- قطعة لم تُولَّد بعد: ارسمها كظلام صلب بدل ثقب في العالم
	if fgId == UNLOADED then
		wallFrame.BackgroundTransparency = 0
		wallFrame.BackgroundColor3 = UNLOADED_COLOR
		fgFrame.Visible = false
		return
	end

	-- الجدار الخلفي / الظلمة
	if bgId ~= 0 then
		local wallBlock = Blocks.get(bgId)
		local variation = (Util.rand2(tx, ty, 77) - 0.5) * (wallBlock.shade / 255) * 0.7
		local base = wallBlock.color
		local factor = light * 0.5
		wallFrame.BackgroundTransparency = 0
		wallFrame.BackgroundColor3 = Color3.new(
			math.clamp((base.R + variation) * factor, 0, 1),
			math.clamp((base.G + variation) * factor, 0, 1),
			math.clamp((base.B + variation) * factor, 0, 1)
		)
	else
		-- هواء بلا جدار: ارسم الظلمة فقط
		if light >= 0.985 then
			wallFrame.BackgroundTransparency = 1
		else
			wallFrame.BackgroundColor3 = Color3.new(0, 0, 0)
			wallFrame.BackgroundTransparency = light
		end
	end

	-- الطبقة الأمامية
	if fgId == 0 then
		fgFrame.Visible = false
		return
	end

	local block = Blocks.get(fgId)
	fgFrame.Visible = true

	local variation = (Util.rand2(tx, ty, 33) - 0.5) * (block.shade / 255) * 2
	local emissive = block.light / Config.MAX_LIGHT
	local factor = math.min(1, light + emissive * 0.8)
	local base = block.color
	fgFrame.BackgroundColor3 = Color3.new(
		math.clamp((base.R + variation) * factor, 0, 1),
		math.clamp((base.G + variation) * factor, 0, 1),
		math.clamp((base.B + variation) * factor, 0, 1)
	)

	-- أشكال خاصة
	if block.liquid then
		fgFrame.Size = UDim2.fromOffset(tilePx + 1, tilePx * 0.92)
		fgFrame.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx + tilePx * 0.08)
		fgFrame.BackgroundTransparency = 0.28
	elseif block.platform then
		fgFrame.Size = UDim2.fromOffset(tilePx + 1, math.max(3, tilePx * 0.22))
		fgFrame.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx)
		fgFrame.BackgroundTransparency = 0
	elseif fgId == Blocks.ID.TORCH or fgId == Blocks.ID.LANTERN then
		fgFrame.Size = UDim2.fromOffset(math.max(4, tilePx * 0.24), tilePx * 0.62)
		fgFrame.Position = UDim2.fromOffset(tx * tilePx + tilePx * 0.38, ty * tilePx + tilePx * 0.2)
		fgFrame.BackgroundTransparency = 0
	elseif block.fragile or fgId == Blocks.ID.VINE then
		fgFrame.Size = UDim2.fromOffset(tilePx * 0.7, tilePx * 0.7)
		fgFrame.Position = UDim2.fromOffset(tx * tilePx + tilePx * 0.15, ty * tilePx + tilePx * 0.3)
		fgFrame.BackgroundTransparency = 0.05
	elseif block.station or block.container then
		fgFrame.Size = UDim2.fromOffset(tilePx + 1, tilePx * 0.85)
		fgFrame.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx + tilePx * 0.15)
		fgFrame.BackgroundTransparency = 0
	else
		fgFrame.Size = UDim2.fromOffset(tilePx + 1, tilePx + 1)
		fgFrame.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx)
		fgFrame.BackgroundTransparency = 0
	end
end

local tileAccumulator = 1 -- يفرض حساب إضاءة في أول إطار

local function renderTiles(force: boolean)
	local world = ClientWorld.get()
	local halfW = viewW / tilePx / 2
	local halfH = viewH / tilePx / 2
	local left = math.floor(State.camX - halfW) - Config.RENDER_PAD
	local top = math.floor(State.camY - halfH) - Config.RENDER_PAD

	for row = 0, rows - 1 do
		local ty = top + row
		local slotRow = ((ty % rows) + rows) % rows
		for col = 0, cols - 1 do
			local tx = left + col
			local slotCol = ((tx % cols) + cols) % cols
			local slot = slots[slotRow * cols + slotCol + 1]
			if slot then
				local fgId, bgId
				if World.inBounds(tx, ty) then
					fgId = World.fgRaw(world, tx, ty) or UNLOADED
					bgId = World.bgRaw(world, tx, ty) or Blocks.ID.AIR
				else
					fgId, bgId = Blocks.ID.BEDROCK, Blocks.ID.BEDROCK
				end
				local light = if fgId == UNLOADED then 0 else Lighting.factor(tx, ty)
				local quantized = math.floor(light * 48)

				local moved = slot.tx ~= tx or slot.ty ~= ty
				if moved or force or slot.lastFg ~= fgId or slot.lastBg ~= bgId or slot.lastLight ~= quantized then
					slot.tx, slot.ty = tx, ty
					slot.lastFg, slot.lastBg, slot.lastLight = fgId, bgId, quantized
					if moved then
						slot.wall.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx)
					end
					applyTile(slot, tx, ty, fgId, bgId, light)
				end
			end
		end
	end
end

-- ===== الكيانات =====

local function releaseSprites(seen: { [number]: boolean })
	for id, sprite in charSprites do
		if not seen[id] then
			sprite.root:Destroy()
			charSprites[id] = nil
		end
	end
	for id, sprite in mobSprites do
		if not seen[id] then
			sprite.root:Destroy()
			mobSprites[id] = nil
		end
	end
	for id, sprite in itemSprites do
		if not seen[id] then
			sprite.root:Destroy()
			itemSprites[id] = nil
		end
	end
	for id, sprite in projSprites do
		if not seen[id] then
			sprite.root:Destroy()
			projSprites[id] = nil
		end
	end
end

local function renderEntities()
	local seen: { [number]: boolean } = {}
	local now = os.clock()

	for id, entity in State.entities do
		seen[id] = true
		local x = entity.rx or entity.x
		local y = entity.ry or entity.y

		if entity.k == 1 then -- وحش
			local sprite = mobSprites[id]
			if not sprite then
				sprite = Sprites.newMob(entityContainer)
				mobSprites[id] = sprite
			end
			local def = Mobs.get(entity.t)
			local w = if def then def.w else 1
			local h = if def then def.h else 1
			sprite.root.Position = UDim2.fromOffset(x * tilePx, y * tilePx)
			Sprites.updateMob(sprite, entity.t, w * tilePx, h * tilePx, entity.f or 1, entity.a or "idle", now, entity.h or 100)

		elseif entity.k == 2 then -- غرض
			local sprite = itemSprites[id]
			if not sprite then
				sprite = Sprites.newItem(entityContainer)
				itemSprites[id] = sprite
			end
			sprite.root.Position = UDim2.fromOffset(x * tilePx, y * tilePx)
			Sprites.updateItem(sprite, entity.t, entity.n or 1, tilePx * 0.8, now + id)

		elseif entity.k == 3 then -- مقذوف
			local sprite = projSprites[id]
			if not sprite then
				sprite = Sprites.newProjectile(entityContainer)
				projSprites[id] = sprite
			end
			local def = Mobs.projectiles[entity.t]
			local w = if def then def.w else 0.5
			local h = if def then def.h else 0.5
			local angle = math.deg(math.atan2(entity.vy or 0, entity.vx or 1))
			sprite.root.Position = UDim2.fromOffset(x * tilePx, y * tilePx)
			Sprites.updateProjectile(sprite, entity.t, w * tilePx, math.max(3, h * tilePx), angle, now)
		end
	end

	-- اللاعبون الآخرون
	for userId, peer in State.peers do
		if userId ~= State.userId then
			seen[-userId] = true
			local sprite = charSprites[-userId]
			if not sprite then
				sprite = Sprites.newCharacter(entityContainer, true)
				charSprites[-userId] = sprite
			end
			local px = peer.rx or peer.x
			local py = peer.ry or peer.y
			sprite.root.Position = UDim2.fromOffset(px * tilePx, py * tilePx)
			sprite.root.Visible = not peer.d
			sprite.nameTag.Text = peer.n or "لاعب"
			sprite.nameTag.Position = UDim2.fromOffset(Config.PLAYER_W * tilePx / 2, -6)
			sprite.nameTag.Size = UDim2.fromOffset(180, 18)
			Sprites.updateCharacter(
				sprite, Config.PLAYER_W * tilePx, Config.PLAYER_H * tilePx,
				peer.f or 1, if math.abs((peer.vx or 0)) > 0.5 then "walk" else "idle",
				now, peer.hd, peer.ch, peer.it, 0
			)
		end
	end

	releaseSprites(seen)
end

-- ===== اللاعب المحلي =====

local function renderLocalPlayer()
	local body = State.body
	localCharacter.root.Visible = not State.dead
	localCharacter.root.Position = UDim2.fromOffset(body.x * tilePx, body.y * tilePx)

	local swing = 0
	local lastSwing = State.lastSwing or 0
	local since = os.clock() - lastSwing
	if since < 0.22 then
		swing = math.sin(since / 0.22 * math.pi)
	end

	local held = State.heldItem()
	Sprites.updateCharacter(
		localCharacter,
		Config.PLAYER_W * tilePx,
		Config.PLAYER_H * tilePx,
		State.facing,
		State.anim,
		State.animTime,
		if State.armor.head then (State.armor.head :: any).id else nil,
		if State.armor.chest then (State.armor.chest :: any).id else nil,
		if held then held.id else nil,
		swing
	)
end

-- ===== مؤشر الاستهداف =====

function Renderer.setSelection(tx: number?, ty: number?, valid: boolean)
	if not tx or not ty then
		selectionBox.Visible = false
		return
	end
	selectionBox.Visible = true
	selectionBox.Size = UDim2.fromOffset(tilePx, tilePx)
	selectionBox.Position = UDim2.fromOffset(tx * tilePx, ty * tilePx)
	local stroke = selectionBox:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if valid then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(235, 90, 80)
	end
end

function Renderer.setMiningProgress(tx: number?, ty: number?, progress: number)
	if not tx or not ty or progress <= 0 then
		miningOverlay.Visible = false
		return
	end
	miningOverlay.Visible = true
	miningOverlay.Size = UDim2.fromOffset(tilePx, tilePx * math.clamp(progress, 0, 1))
	miningOverlay.Position = UDim2.fromOffset(tx * tilePx, (ty + 1) * tilePx)
end

-- ===== الكاميرا والحلقة =====

local function updateCamera(dt: number)
	local body = State.body
	local targetX = body.x
	local targetY = body.y - 1

	-- ابقَ داخل حدود العالم
	local halfW = viewW / tilePx / 2
	local halfH = viewH / tilePx / 2
	targetX = math.clamp(targetX, halfW, Config.WORLD_W - halfW)
	targetY = math.clamp(targetY, halfH, Config.WORLD_H - halfH)

	State.camX = Util.damp(State.camX, targetX, Config.CAMERA_SMOOTH, dt)
	State.camY = Util.damp(State.camY, targetY, Config.CAMERA_SMOOTH, dt)
end

function Renderer.render(dt: number)
	if not ClientWorld.isReady() then return end

	updateCamera(dt)
	updateSky()

	-- اهتزاز الشاشة
	local shakeX, shakeY = 0, 0
	if shakeTime > 0 then
		shakeTime -= dt
		local strength = shakeMagnitude * math.min(1, shakeTime * 4)
		shakeX = (math.random() - 0.5) * strength
		shakeY = (math.random() - 0.5) * strength
		if shakeTime <= 0 then shakeMagnitude = 0 end
	end

	local offsetX = math.floor(-State.camX * tilePx + viewW / 2 + shakeX)
	local offsetY = math.floor(-State.camY * tilePx + viewH / 2 + shakeY)
	local offset = UDim2.fromOffset(offsetX, offsetY)
	tileContainer.Position = offset
	entityContainer.Position = offset
	fxContainer.Position = offset

	-- الإضاءة (بمعدل محدود)
	tileAccumulator += dt
	local lightStep = 1 / Config.LIGHT_HZ
	if tileAccumulator >= lightStep then
		tileAccumulator -= lightStep
		local world = ClientWorld.get()
		Lighting.recompute(world, State.camX, State.camY, cols, rows)
	end

	renderTiles(false)
	renderEntities()
	renderLocalPlayer()
end

return Renderer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Sfx — أصوات اللعبة.
	نستعمل أصوات العميل المدمجة (rbxasset) فلا تحتاج رفع أي أصول.
	إن أردت أصواتاً أفضل: ضع معرّفات rbxassetid في الجدول أدناه.
]]

local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)

local Sfx = {}

local LIBRARY: { [string]: { id: string, volume: number, pitch: number } } = {
	jump = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.35, pitch = 1.1 },
	land = { id = "rbxasset://sounds/action_footsteps_plastic.mp3", volume = 0.4, pitch = 0.8 },
	step = { id = "rbxasset://sounds/action_footsteps_plastic.mp3", volume = 0.18, pitch = 1.05 },
	swing = { id = "rbxasset://sounds/snap.mp3", volume = 0.28, pitch = 1.35 },
	mine_soft = { id = "rbxasset://sounds/action_footsteps_plastic.mp3", volume = 0.22, pitch = 0.7 },
	mine_hard = { id = "rbxasset://sounds/clickfast.wav", volume = 0.3, pitch = 0.65 },
	mine_wood = { id = "rbxasset://sounds/snap.mp3", volume = 0.25, pitch = 0.75 },
	break_block = { id = "rbxasset://sounds/bass.wav", volume = 0.3, pitch = 1.6 },
	place = { id = "rbxasset://sounds/switch3.wav", volume = 0.3, pitch = 1.2 },
	hurt = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.45, pitch = 1 },
	pickup = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.28, pitch = 1.5 },
	craft = { id = "rbxasset://sounds/switch3.wav", volume = 0.4, pitch = 0.9 },
	splash = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.4, pitch = 1 },
	ui = { id = "rbxasset://sounds/clickfast.wav", volume = 0.25, pitch = 1.3 },
}

local pool: { Sound } = {}
local muted = false

local function acquire(): Sound
	local sound = table.remove(pool)
	if sound then return sound end
	sound = Instance.new("Sound")
	sound.Parent = SoundService
	return sound
end

function Sfx.setMuted(value: boolean)
	muted = value
end

function Sfx.play(name: string, pitchJitter: number?)
	if muted then return end
	local entry = LIBRARY[name]
	if not entry then return end

	local ok = pcall(function()
		local sound = acquire()
		sound.SoundId = entry.id
		sound.Volume = entry.volume
		sound.PlaybackSpeed = entry.pitch + (math.random() - 0.5) * (pitchJitter or 0.12)
		sound.TimePosition = 0
		sound:Play()
		task.delay(3, function()
			sound:Stop()
			if #pool < 24 then
				table.insert(pool, sound)
			else
				sound:Destroy()
			end
		end)
	end)
	if not ok then
		-- صوت غير متاح: تجاهل بصمت بدل إيقاف اللعبة
	end
end

-- صوت مناسب لنوع البلاطة
function Sfx.block(action: string, blockId: number)
	local block = Blocks.get(blockId)
	local material = block.sound or "hard"
	if action == "break" then
		Sfx.play("break_block")
	else
		if material == "wood" then
			Sfx.play("mine_wood")
		elseif material == "soft" then
			Sfx.play("mine_soft")
		else
			Sfx.play("mine_hard")
		end
	end
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Sprites</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Sprites — بناء الأشكال ثنائية الأبعاد من إطارات Frame بسيطة.
	لا نستخدم أي صور خارجية: كل شيء أشكال ملوّنة تُركّب برمجياً،
	فتعمل اللعبة فوراً بلا رفع أصول، وتبقى الهوية البصرية موحّدة.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items = require(Shared.Items)
local Mobs = require(Shared.Mobs)

local Sprites = {}

local function frame(parent: Instance, color: Color3, zindex: number?): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.ZIndex = zindex or 2
	f.Parent = parent
	return f
end

local function round(instance: GuiObject, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(radius, 0)
	corner.Parent = instance
end

-- ===== شخصية (اللاعب والأقران) =====

export type Character = {
	root: Frame,
	head: Frame,
	torso: Frame,
	legL: Frame,
	legR: Frame,
	arm: Frame,
	held: Frame,
	helm: Frame,
	nameTag: TextLabel,
	hpBar: Frame,
	hpFill: Frame,
}

function Sprites.newCharacter(parent: Instance, showName: boolean): Character
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = 6
	root.Parent = parent

	local legL = frame(root, Color3.fromRGB(58, 72, 120), 5)
	local legR = frame(root, Color3.fromRGB(48, 60, 104), 5)
	local torso = frame(root, Color3.fromRGB(96, 132, 196), 6)
	round(torso, 0.22)
	local arm = frame(root, Color3.fromRGB(226, 184, 150), 8)
	round(arm, 0.35)
	local head = frame(root, Color3.fromRGB(236, 194, 158), 7)
	round(head, 0.28)
	local helm = frame(root, Color3.fromRGB(120, 120, 130), 8)
	round(helm, 0.3)
	helm.Visible = false

	local held = frame(root, Color3.fromRGB(200, 200, 200), 9)
	round(held, 0.15)
	held.Visible = false

	local nameTag = Instance.new("TextLabel")
	nameTag.BackgroundTransparency = 1
	nameTag.AnchorPoint = Vector2.new(0.5, 1)
	nameTag.Font = Enum.Font.GothamMedium
	nameTag.TextSize = 13
	nameTag.TextColor3 = Color3.fromRGB(240, 240, 240)
	nameTag.TextStrokeTransparency = 0.35
	nameTag.ZIndex = 10
	nameTag.Visible = showName
	nameTag.Parent = root

	local hpBar = frame(root, Color3.fromRGB(20, 20, 24), 10)
	hpBar.Visible = false
	local hpFill = frame(hpBar, Color3.fromRGB(220, 70, 70), 11)
	hpFill.AnchorPoint = Vector2.new(0, 0.5)

	return {
		root = root, head = head, torso = torso, legL = legL, legR = legR,
		arm = arm, held = held, helm = helm, nameTag = nameTag,
		hpBar = hpBar, hpFill = hpFill,
	}
end

-- ألوان الدرع تُغيّر مظهر الشخصية
local function armorColor(itemId: string?, fallback: Color3): Color3
	if not itemId or itemId == "" then return fallback end
	local item = Items.get(itemId)
	return if item then item.color else fallback
end

function Sprites.updateCharacter(
	character: Character,
	pxWidth: number,
	pxHeight: number,
	facing: number,
	anim: string,
	animTime: number,
	helmet: string?,
	chest: string?,
	held: string?,
	swing: number
)
	local root = character.root
	root.Size = UDim2.fromOffset(pxWidth, pxHeight)

	local unit = pxHeight / 2.8 -- بكسل لكل بلاطة

	-- الرأس
	local headSize = unit * 0.95
	character.head.Size = UDim2.fromOffset(headSize, headSize * 0.92)
	character.head.Position = UDim2.fromOffset(pxWidth / 2 + facing * unit * 0.06, unit * 0.52)

	character.helm.Visible = helmet ~= nil and helmet ~= ""
	if character.helm.Visible then
		character.helm.BackgroundColor3 = armorColor(helmet, Color3.fromRGB(120, 120, 130))
		character.helm.Size = UDim2.fromOffset(headSize * 1.12, headSize * 0.58)
		character.helm.Position = UDim2.fromOffset(pxWidth / 2 + facing * unit * 0.06, unit * 0.34)
	end

	-- الجذع
	local torsoW, torsoH = unit * 0.95, unit * 0.95
	character.torso.Size = UDim2.fromOffset(torsoW, torsoH)
	character.torso.Position = UDim2.fromOffset(pxWidth / 2, unit * 1.48)
	character.torso.BackgroundColor3 = armorColor(chest, Color3.fromRGB(96, 132, 196))

	-- الأرجل مع حركة المشي
	local swingAngle = 0
	if anim == "walk" then
		swingAngle = math.sin(animTime * 11) * 26
	elseif anim == "jump" or anim == "fall" then
		swingAngle = 14
	end
	local legW, legH = unit * 0.34, unit * 0.85
	character.legL.Size = UDim2.fromOffset(legW, legH)
	character.legR.Size = UDim2.fromOffset(legW, legH)
	character.legL.Position = UDim2.fromOffset(pxWidth / 2 - legW * 0.7, unit * 2.36)
	character.legR.Position = UDim2.fromOffset(pxWidth / 2 + legW * 0.7, unit * 2.36)
	character.legL.Rotation = swingAngle
	character.legR.Rotation = -swingAngle

	-- الذراع تتبع اتجاه الضربة
	local armW, armH = unit * 0.3, unit * 0.9
	character.arm.Size = UDim2.fromOffset(armW, armH)
	character.arm.Position = UDim2.fromOffset(pxWidth / 2 + facing * unit * 0.42, unit * 1.5)
	character.arm.Rotation = facing * (18 + swing * 90) - (if anim == "walk" then swingAngle * 0.5 else 0)

	-- العنصر المحمول
	local heldItem = if held and held ~= "" then Items.get(held) else nil
	character.held.Visible = heldItem ~= nil
	if heldItem then
		local isTool = heldItem.cat == "tool" or heldItem.cat == "weapon"
		local w = if isTool then unit * 0.22 else unit * 0.55
		local h = if isTool then unit * 1.15 else unit * 0.55
		character.held.Size = UDim2.fromOffset(w, h)
		character.held.BackgroundColor3 = heldItem.color
		character.held.Position = UDim2.fromOffset(
			pxWidth / 2 + facing * unit * 0.72,
			unit * (if isTool then 1.15 else 1.5)
		)
		character.held.Rotation = facing * (30 + swing * 110)
	end
end

-- ===== الوحوش =====

export type MobSprite = {
	root: Frame,
	parts: { Frame },
	body: Frame,
	eyeL: Frame,
	eyeR: Frame,
	detail: Frame,
	hpBar: Frame,
	hpFill: Frame,
	kind: string,
}

function Sprites.newMob(parent: Instance): MobSprite
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = 5
	root.Parent = parent

	local parts: { Frame } = {}
	for i = 1, 4 do
		local part = frame(root, Color3.fromRGB(60, 60, 60), 4)
		round(part, 0.3)
		table.insert(parts, part)
	end

	local body = frame(root, Color3.fromRGB(120, 120, 120), 5)
	round(body, 0.3)
	local detail = frame(root, Color3.fromRGB(90, 90, 90), 6)
	round(detail, 0.4)
	local eyeL = frame(root, Color3.fromRGB(20, 20, 24), 7)
	round(eyeL, 0.5)
	local eyeR = frame(root, Color3.fromRGB(20, 20, 24), 7)
	round(eyeR, 0.5)

	local hpBar = frame(root, Color3.fromRGB(16, 16, 20), 9)
	hpBar.Visible = false
	local hpFill = frame(hpBar, Color3.fromRGB(220, 70, 70), 10)
	hpFill.AnchorPoint = Vector2.new(0, 0.5)

	return {
		root = root, parts = parts, body = body, detail = detail,
		eyeL = eyeL, eyeR = eyeR, hpBar = hpBar, hpFill = hpFill, kind = "",
	}
end

function Sprites.updateMob(sprite: MobSprite, typeId: string, pxW: number, pxH: number, facing: number, anim: string, age: number, hpPct: number)
	local def = Mobs.get(typeId)
	if not def then return end
	local root = sprite.root
	root.Size = UDim2.fromOffset(pxW, pxH)
	sprite.kind = typeId

	sprite.body.BackgroundColor3 = def.color
	sprite.detail.BackgroundColor3 = def.accent

	local ai = def.ai
	local bob = math.sin(age * 6) * pxH * 0.03

	if ai == "jumper" then
		-- هلامة: انسحاب وتمدد
		local squash = if anim == "jump" then 1.18 else 1 + math.sin(age * 8) * 0.05
		sprite.body.Size = UDim2.fromOffset(pxW / squash, pxH * squash)
		sprite.body.Position = UDim2.fromOffset(pxW / 2, pxH - (pxH * squash) / 2)
		sprite.detail.Size = UDim2.fromOffset(pxW * 0.35, pxH * 0.3)
		sprite.detail.Position = UDim2.fromOffset(pxW / 2, pxH * 0.55)
		sprite.detail.BackgroundTransparency = 0.4
		for _, part in sprite.parts do part.Visible = false end
		sprite.eyeL.Size = UDim2.fromOffset(pxW * 0.13, pxH * 0.16)
		sprite.eyeR.Size = UDim2.fromOffset(pxW * 0.13, pxH * 0.16)
		sprite.eyeL.Position = UDim2.fromOffset(pxW * 0.36, pxH * 0.52)
		sprite.eyeR.Position = UDim2.fromOffset(pxW * 0.64, pxH * 0.52)
		sprite.eyeL.Visible, sprite.eyeR.Visible = true, true

	elseif ai == "flyer" then
		local flap = math.sin(age * 18) * pxH * 0.22
		sprite.body.Size = UDim2.fromOffset(pxW * 0.62, pxH * 0.72)
		sprite.body.Position = UDim2.fromOffset(pxW / 2, pxH / 2 + bob)
		sprite.detail.Size = UDim2.fromOffset(pxW * 0.3, pxH * 0.3)
		sprite.detail.Position = UDim2.fromOffset(pxW / 2, pxH * 0.45 + bob)
		sprite.detail.BackgroundTransparency = 0
		-- جناحان
		for i = 1, 2 do
			local wing = sprite.parts[i]
			wing.Visible = true
			wing.BackgroundColor3 = def.accent
			wing.Size = UDim2.fromOffset(pxW * 0.42, pxH * 0.24)
			wing.Position = UDim2.fromOffset(pxW / 2 + (if i == 1 then -1 else 1) * pxW * 0.42, pxH / 2 + bob)
			wing.Rotation = (if i == 1 then -1 else 1) * flap
		end
		sprite.parts[3].Visible = false
		sprite.parts[4].Visible = false
		sprite.eyeL.Visible, sprite.eyeR.Visible = false, false

	elseif ai == "climber" then
		-- عنكبوت: جسم بيضاوي وأربع أرجل
		sprite.body.Size = UDim2.fromOffset(pxW * 0.62, pxH * 0.66)
		sprite.body.Position = UDim2.fromOffset(pxW / 2, pxH * 0.45)
		sprite.detail.Size = UDim2.fromOffset(pxW * 0.26, pxH * 0.28)
		sprite.detail.Position = UDim2.fromOffset(pxW / 2 + facing * pxW * 0.24, pxH * 0.42)
		sprite.detail.BackgroundTransparency = 0
		for i, leg in sprite.parts do
			leg.Visible = true
			leg.BackgroundColor3 = def.color
			leg.Size = UDim2.fromOffset(pxW * 0.09, pxH * 0.5)
			local side = if i <= 2 then -1 else 1
			local offset = (if i % 2 == 0 then 0.22 else 0.42)
			leg.Position = UDim2.fromOffset(pxW / 2 + side * pxW * offset, pxH * 0.62)
			leg.Rotation = side * (24 + math.sin(age * 14 + i) * 12)
		end
		sprite.eyeL.Size = UDim2.fromOffset(pxW * 0.08, pxH * 0.12)
		sprite.eyeR.Size = UDim2.fromOffset(pxW * 0.08, pxH * 0.12)
		sprite.eyeL.Position = UDim2.fromOffset(pxW / 2 + facing * pxW * 0.28, pxH * 0.36)
		sprite.eyeR.Position = UDim2.fromOffset(pxW / 2 + facing * pxW * 0.34, pxH * 0.46)
		sprite.eyeL.BackgroundColor3 = def.accent
		sprite.eyeR.BackgroundColor3 = def.accent
		sprite.eyeL.Visible, sprite.eyeR.Visible = true, true

	elseif ai == "boss" then
		-- عين ضخمة
		local pulse = 1 + math.sin(age * 3) * 0.04
		sprite.body.Size = UDim2.fromOffset(pxW * pulse, pxH * pulse)
		sprite.body.Position = UDim2.fromOffset(pxW / 2, pxH / 2)
		sprite.detail.Size = UDim2.fromOffset(pxW * 0.46, pxH * 0.46)
		sprite.detail.Position = UDim2.fromOffset(pxW / 2 + facing * pxW * 0.1, pxH / 2)
		sprite.detail.BackgroundTransparency = 0
		sprite.eyeL.Size = UDim2.fromOffset(pxW * 0.2, pxH * 0.2)
		sprite.eyeL.Position = UDim2.fromOffset(pxW / 2 + facing * pxW * 0.14, pxH / 2)
		sprite.eyeL.BackgroundColor3 = Color3.fromRGB(18, 14, 20)
		sprite.eyeL.Visible = true
		sprite.eyeR.Visible = false
		for i, part in sprite.parts do
			part.Visible = true
			part.BackgroundColor3 = def.accent
			local angle = age * 1.5 + i * (math.pi / 2)
			part.Size = UDim2.fromOffset(pxW * 0.16, pxH * 0.34)
			part.Position = UDim2.fromOffset(
				pxW / 2 + math.cos(angle) * pxW * 0.52,
				pxH / 2 + math.sin(angle) * pxH * 0.52
			)
			part.Rotation = math.deg(angle)
		end

	else
		-- شكل بشري (زومبي، هيكل، غول)
		local walkSwing = if anim == "walk" then math.sin(age * 10) * 22 else 0
		sprite.body.Size = UDim2.fromOffset(pxW * 0.6, pxH * 0.42)
		sprite.body.Position = UDim2.fromOffset(pxW / 2, pxH * 0.46)
		sprite.detail.Size = UDim2.fromOffset(pxW * 0.5, pxH * 0.28)
		sprite.detail.Position = UDim2.fromOffset(pxW / 2 + facing * pxW * 0.04, pxH * 0.16)
		sprite.detail.BackgroundColor3 = def.color
		sprite.detail.BackgroundTransparency = 0

		sprite.parts[1].Visible = true
		sprite.parts[2].Visible = true
		for i = 1, 2 do
			local leg = sprite.parts[i]
			leg.BackgroundColor3 = def.accent
			leg.Size = UDim2.fromOffset(pxW * 0.2, pxH * 0.34)
			leg.Position = UDim2.fromOffset(pxW / 2 + (if i == 1 then -1 else 1) * pxW * 0.16, pxH * 0.82)
			leg.Rotation = (if i == 1 then 1 else -1) * walkSwing
		end
		sprite.parts[3].Visible = true
		sprite.parts[3].BackgroundColor3 = def.accent
		sprite.parts[3].Size = UDim2.fromOffset(pxW * 0.16, pxH * 0.36)
		sprite.parts[3].Position = UDim2.fromOffset(pxW / 2 + facing * pxW * 0.32, pxH * 0.45)
		sprite.parts[3].Rotation = facing * 70
		sprite.parts[4].Visible = false

		sprite.eyeL.Size = UDim2.fromOffset(pxW * 0.09, pxH * 0.09)
		sprite.eyeR.Size = UDim2.fromOffset(pxW * 0.09, pxH * 0.09)
		sprite.eyeL.Position = UDim2.fromOffset(pxW / 2 + facing * pxW * 0.1 - pxW * 0.1, pxH * 0.15)
		sprite.eyeR.Position = UDim2.fromOffset(pxW / 2 + facing * pxW * 0.1 + pxW * 0.1, pxH * 0.15)
		sprite.eyeL.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
		sprite.eyeR.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
		sprite.eyeL.Visible, sprite.eyeR.Visible = true, true
	end

	-- شريط الحياة يظهر عند التضرر فقط
	local showHp = hpPct < 99 and not def.boss
	sprite.hpBar.Visible = showHp
	if showHp then
		sprite.hpBar.Size = UDim2.fromOffset(pxW * 0.9, math.max(3, pxH * 0.06))
		sprite.hpBar.Position = UDim2.fromOffset(pxW / 2, -pxH * 0.12)
		sprite.hpFill.Size = UDim2.new(math.clamp(hpPct / 100, 0, 1), -2, 1, -2)
		sprite.hpFill.Position = UDim2.new(0, 1, 0.5, 0)
	end
end

-- ===== غرض ساقط =====

export type ItemSprite = { root: Frame, box: Frame, count: TextLabel }

function Sprites.newItem(parent: Instance): ItemSprite
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = 5
	root.Parent = parent

	local box = frame(root, Color3.fromRGB(200, 200, 200), 5)
	round(box, 0.2)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(20, 20, 24)
	stroke.Thickness = 1.5
	stroke.Transparency = 0.35
	stroke.Parent = box

	local count = Instance.new("TextLabel")
	count.BackgroundTransparency = 1
	count.AnchorPoint = Vector2.new(0.5, 0)
	count.Font = Enum.Font.GothamBold
	count.TextSize = 12
	count.TextColor3 = Color3.fromRGB(255, 255, 255)
	count.TextStrokeTransparency = 0.2
	count.ZIndex = 7
	count.Parent = root

	return { root = root, box = box, count = count }
end

function Sprites.updateItem(sprite: ItemSprite, itemId: string, count: number, pxSize: number, age: number)
	local item = Items.get(itemId)
	local color = if item then item.color else Color3.fromRGB(200, 200, 200)
	local bob = math.sin(age * 3.5) * pxSize * 0.18

	sprite.root.Size = UDim2.fromOffset(pxSize, pxSize)
	sprite.box.BackgroundColor3 = color
	sprite.box.Size = UDim2.fromOffset(pxSize * 0.8, pxSize * 0.8)
	sprite.box.Position = UDim2.fromOffset(pxSize / 2, pxSize / 2 + bob)
	sprite.box.Rotation = math.sin(age * 2) * 8

	sprite.count.Visible = count > 1
	sprite.count.Text = tostring(count)
	sprite.count.Size = UDim2.fromOffset(pxSize * 2, pxSize * 0.6)
	sprite.count.Position = UDim2.fromOffset(pxSize / 2, pxSize * 0.85 + bob)
end

-- ===== مقذوف =====

export type ProjSprite = { root: Frame, body: Frame, trail: Frame }

function Sprites.newProjectile(parent: Instance): ProjSprite
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = 6
	root.Parent = parent

	local body = frame(root, Color3.fromRGB(220, 220, 220), 7)
	round(body, 0.35)
	local trail = frame(root, Color3.fromRGB(255, 200, 120), 6)
	round(trail, 0.5)
	trail.BackgroundTransparency = 0.55

	return { root = root, body = body, trail = trail }
end

function Sprites.updateProjectile(sprite: ProjSprite, typeId: string, pxW: number, pxH: number, angle: number, age: number)
	local def = Mobs.projectiles[typeId]
	local color = if def then def.color else Color3.fromRGB(220, 220, 220)
	sprite.root.Size = UDim2.fromOffset(math.max(pxW, pxH) * 2, math.max(pxW, pxH) * 2)
	sprite.body.BackgroundColor3 = color
	sprite.body.Size = UDim2.fromOffset(pxW, pxH)
	sprite.body.Position = UDim2.fromScale(0.5, 0.5)
	sprite.body.Rotation = angle

	local hasTrail = def ~= nil and def.trail ~= nil
	sprite.trail.Visible = hasTrail
	if hasTrail then
		local pulse = 1 + math.sin(age * 22) * 0.2
		sprite.trail.BackgroundColor3 = color
		sprite.trail.Size = UDim2.fromOffset(pxW * 1.6 * pulse, pxH * 1.9 * pulse)
		sprite.trail.Position = UDim2.fromScale(0.5, 0.5)
		sprite.trail.Rotation = angle
	end
end

return Sprites
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
--[[ State — الحالة المشتركة بين وحدات العميل (مصدر واحد للحقيقة محلياً). ]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Physics = require(Shared.Physics)

local State = {}

State.ready = false
State.seed = 0
State.userId = 0

-- اللاعب المحلي
State.body = Physics.newBody(0, 0, Config.PLAYER_W, Config.PLAYER_H)
State.facing = 1
State.anim = "idle"
State.animTime = 0
State.lastSwing = 0
State.spawnX = 0
State.spawnY = 0

-- الكاميرا (بالبلاطات)
State.camX = 0
State.camY = 0
State.tilePx = 40

-- الإحصاءات
State.hp = 100
State.maxHp = 100
State.mana = 40
State.maxMana = 40
State.food = 100
State.defense = 0
State.dead = false
State.respawnIn = 0
State.buffs = {} :: { { id: string, t: number } }
State.kills = 0
State.deaths = 0
State.mined = 0

-- المخزون
State.slots = {} :: { [number]: { id: string, n: number }? }
State.armor = {} :: { [string]: { id: string, n: number }? }
State.hotbar = 1

-- العالم
State.pending = 0 -- قطع بانتظار التوليد المحلي
State.time = 0.25
State.day = 1
State.bloodMoon = false

-- الكيانات القادمة من الخادم
State.entities = {} :: { [number]: any }
State.peers = {} :: { [number]: any }

-- الزعيم
State.boss = nil :: any

-- التعدين الجاري
State.mining = nil :: { x: number, y: number, layer: string, progress: number, required: number }?

-- واجهات مفتوحة
State.uiOpen = false
State.shopOpen = false

function State.heldItem(): { id: string, n: number }?
	return State.slots[State.hotbar]
end

return State
]]></string>

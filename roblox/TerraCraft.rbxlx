      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Buffs</string>
          <string name="Source"><![CDATA[--!strict
--[[ Buffs — التعزيزات والتأثيرات المؤقتة. ]]

local Buffs = {}

export type BuffDef = {
	id: string,
	name: string,
	color: Color3,
	good: boolean,
	speed: number?, -- مضاعف سرعة المشي
	jump: number?,
	defense: number?,
	regen: number?, -- حياة/ثانية
	light: number?, -- توهج حول اللاعب
	dps: number?, -- ضرر مستمر
	mining: number?, -- مضاعف سرعة التعدين
	blockPotion: boolean?,
}

local defs: { [string]: BuffDef } = {
	swift = { id = "swift", name = "سرعة", color = Color3.fromRGB(120, 226, 140), good = true, speed = 1.28, jump = 1.08 },
	iron_skin = { id = "iron_skin", name = "جلد حديدي", color = Color3.fromRGB(180, 180, 200), good = true, defense = 8 },
	shine = { id = "shine", name = "توهج", color = Color3.fromRGB(250, 240, 160), good = true, light = 9 },
	regeneration = { id = "regeneration", name = "تجدد", color = Color3.fromRGB(240, 120, 160), good = true, regen = 2.5 },
	haste = { id = "haste", name = "خفة", color = Color3.fromRGB(240, 200, 120), good = true, mining = 1.35 },
	potion_sickness = { id = "potion_sickness", name = "إجهاد الجرعات", color = Color3.fromRGB(150, 120, 160), good = false, blockPotion = true },
	burn = { id = "burn", name = "احتراق", color = Color3.fromRGB(250, 120, 60), good = false, dps = 4 },
	slow = { id = "slow", name = "تباطؤ", color = Color3.fromRGB(120, 140, 170), good = false, speed = 0.6 },
	poison = { id = "poison", name = "تسمم", color = Color3.fromRGB(140, 200, 90), good = false, dps = 2.5 },
	well_fed = { id = "well_fed", name = "شبع", color = Color3.fromRGB(230, 180, 120), good = true, regen = 0.8, speed = 1.05 },
}

Buffs.defs = defs

function Buffs.get(id: string): BuffDef?
	return defs[id]
end

-- يجمع تأثيرات مجموعة تعزيزات نشطة
export type Aggregate = {
	speed: number,
	jump: number,
	defense: number,
	regen: number,
	light: number,
	dps: number,
	mining: number,
	blockPotion: boolean,
}

function Buffs.aggregate(active: { [string]: number }): Aggregate
	local agg: Aggregate = {
		speed = 1, jump = 1, defense = 0, regen = 0,
		light = 0, dps = 0, mining = 1, blockPotion = false,
	}
	for id, remaining in active do
		if remaining > 0 then
			local buff = defs[id]
			if buff then
				if buff.speed then agg.speed *= buff.speed end
				if buff.jump then agg.jump *= buff.jump end
				if buff.defense then agg.defense += buff.defense end
				if buff.regen then agg.regen += buff.regen end
				if buff.light then agg.light = math.max(agg.light, buff.light) end
				if buff.dps then agg.dps += buff.dps end
				if buff.mining then agg.mining *= buff.mining end
				if buff.blockPotion then agg.blockPotion = true end
			end
		end
	end
	return agg
end

return Buffs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Chunk</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Chunk — تخزين مضغوط لبيانات القطعة داخل buffer.
	كل بلاطة 4 بايت: u16 للطبقة الأمامية + u16 للجدار الخلفي.
	هذا يقلّل الذاكرة ~10 أضعاف مقارنة بجداول Lua ويجعل النسخ عبر الشبكة رخيصاً.
]]

local Config = require(script.Parent.Config)

local Chunk = {}

local SIZE = Config.CHUNK
local AREA = SIZE * SIZE
Chunk.SIZE = SIZE
Chunk.AREA = AREA
Chunk.BYTES = AREA * 4

export type Data = buffer

function Chunk.create(): Data
	return buffer.create(Chunk.BYTES)
end

-- فهرس محلي 0..AREA-1 من إحداثيات محلية
function Chunk.index(lx: number, ly: number): number
	return ly * SIZE + lx
end

function Chunk.localOf(x: number, y: number): (number, number)
	return x % SIZE, y % SIZE
end

function Chunk.keyOf(cx: number, cy: number): string
	return cx .. ":" .. cy
end

function Chunk.parseKey(key: string): (number, number)
	local a, b = string.match(key, "^(-?%d+):(-?%d+)$")
	return tonumber(a) or 0, tonumber(b) or 0
end

function Chunk.getFg(data: Data, index: number): number
	return buffer.readu16(data, index * 4)
end

function Chunk.getBg(data: Data, index: number): number
	return buffer.readu16(data, index * 4 + 2)
end

function Chunk.setFg(data: Data, index: number, id: number)
	buffer.writeu16(data, index * 4, id)
end

function Chunk.setBg(data: Data, index: number, id: number)
	buffer.writeu16(data, index * 4 + 2, id)
end

function Chunk.fill(data: Data, fg: number, bg: number)
	for i = 0, AREA - 1 do
		buffer.writeu16(data, i * 4, fg)
		buffer.writeu16(data, i * 4 + 2, bg)
	end
end

function Chunk.clone(data: Data): Data
	local out = buffer.create(Chunk.BYTES)
	buffer.copy(out, 0, data, 0, Chunk.BYTES)
	return out
end

return Chunk
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Config — كل الأرقام القابلة للضبط في اللعبة.
	غيّر من هنا فقط؛ لا تنثر الأرقام السحرية في بقية الملفات.
]]

local Config = {}

-- ===== العالم =====
Config.WORLD_NAME = "TerraCraft"
Config.WORLD_W = 2048 -- عرض العالم بالبلاطات
Config.WORLD_H = 512 -- عمق العالم بالبلاطات
Config.CHUNK = 32 -- حجم القطعة (chunk) بالبلاطات
Config.CHUNKS_X = Config.WORLD_W // Config.CHUNK
Config.CHUNKS_Y = Config.WORLD_H // Config.CHUNK
Config.REGION = 8 -- عدد القطع في كل منطقة حفظ (8x8)

-- طبقات العالم (إحداثي Y يزداد للأسفل)
Config.SKY_TOP = 8 -- أعلى حد للبناء
Config.SURFACE = 150 -- متوسط ارتفاع السطح
Config.SURFACE_AMP = 26 -- تضاريس السطح
Config.DIRT_DEPTH = 70 -- سماكة التراب تحت السطح
Config.CAVERN_Y = 300 -- بداية طبقة الكهوف العميقة
Config.HELL_Y = 460 -- بداية طبقة الجحيم
Config.BEDROCK_Y = Config.WORLD_H - 3

-- ===== العرض =====
Config.TILES_ON_SCREEN_Y = 24 -- ثابت الزوم: كم بلاطة تظهر رأسياً
Config.RENDER_PAD = 2 -- بلاطات إضافية خارج الشاشة
Config.LIGHT_PAD = 8 -- هامش حساب الإضاءة (يمنع ظهور حافة مضيئة عند طرف الشاشة)
Config.MAX_LIGHT = 15
Config.LIGHT_HZ = 15 -- أقصى معدل لإعادة حساب الإضاءة
Config.CAMERA_SMOOTH = 12 -- نعومة تتبع الكاميرا

-- ===== الفيزياء (بالبلاطة/الثانية) =====
Config.GRAVITY = 62
Config.MAX_FALL = 46
Config.WALK_SPEED = 9.2
Config.WALK_ACCEL = 62
Config.AIR_ACCEL = 28
Config.GROUND_FRICTION = 58
Config.AIR_FRICTION = 6
Config.JUMP_VELOCITY = 21.5
Config.JUMP_HOLD_TIME = 0.16 -- قفزة متغيرة الارتفاع
Config.COYOTE_TIME = 0.10
Config.JUMP_BUFFER = 0.12
Config.STEP_UP = 1 -- صعود تلقائي لبلاطة واحدة
Config.SWIM_SPEED = 5.5
Config.WATER_DRAG = 0.72
Config.FALL_SAFE = 12 -- بلاطات سقوط بلا ضرر
Config.FALL_DMG_PER_TILE = 6

-- ===== اللاعب =====
Config.PLAYER_W = 1.6
Config.PLAYER_H = 2.8
Config.REACH = 6.5 -- مدى التعدين/البناء بالبلاطات
Config.BASE_HP = 100
Config.BASE_MANA = 40
Config.MANA_REGEN = 3.5
Config.HP_REGEN = 1.1 -- نقطة/ثانية عند الشبع
Config.HP_REGEN_DELAY = 5 -- ثوانٍ بعد آخر ضرر
Config.FOOD_MAX = 100
Config.FOOD_DRAIN = 0.16 -- نقطة/ثانية (شريط ممتلئ ≈ 10 دقائق)
Config.STARVE_DPS = 1.5
Config.RESPAWN_TIME = 5
Config.IFRAMES = 0.55
Config.DROWN_TIME = 12
Config.DROWN_DPS = 8

-- ===== المخزون =====
Config.HOTBAR = 10
Config.INV_ROWS = 4 -- صفوف إضافية تحت الشريط
Config.INV_SLOTS = Config.HOTBAR * (1 + Config.INV_ROWS)
Config.ARMOR_SLOTS = 3 -- خوذة/درع/حذاء
Config.MAX_STACK = 999
Config.PICKUP_RANGE = 2.6
Config.PICKUP_DELAY = 0.55
Config.ITEM_DESPAWN = 300

-- ===== الوقت =====
Config.DAY_LENGTH = 900 -- ثانية لليوم الكامل (15 دقيقة)
Config.DAY_START = 0.25 -- 0 = منتصف الليل، 0.5 = الظهر
Config.NIGHT_FROM = 0.76
Config.NIGHT_TO = 0.22

-- ===== الكائنات =====
Config.MOB_CAP_PER_PLAYER = 9
Config.MOB_SPAWN_MIN = 14 -- أقل مسافة للظهور
Config.MOB_SPAWN_MAX = 34 -- أقصى مسافة
Config.MOB_DESPAWN = 60
Config.MOB_TICK = 1 / 20 -- معدل محاكاة الخادم
Config.SPAWN_INTERVAL = 1.35

-- ===== الشبكة =====
Config.STATE_HZ = 18 -- إرسال حالة اللاعب
Config.ENTITY_HZ = 14 -- إرسال حالة الكائنات
-- نصف قطر القطع المحمّلة حول اللاعب. القيم أكبر من اللازم تعني توليداً أكثر
-- بلا فائدة مرئية: النافذة المرئية ~50×24 بلاطة، وهذه التغطية 160×96.
Config.CHUNK_RADIUS_X = 2
Config.CHUNK_RADIUS_Y = 1
Config.MAX_EDITS_PER_SEC = 14 -- مضاد للغش

-- ===== الحفظ =====
Config.AUTOSAVE = 120
Config.DATASTORE_PLAYER = "TC_Player_v1"
Config.DATASTORE_WORLD = "TC_World_v1"

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Inventory</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Inventory — منطق المخزون كدوال نقية (يُستعمل على الخادم كمصدر للحقيقة،
	وعلى العميل كنسخة معروضة).
]]

local Config = require(script.Parent.Config)
local Items = require(script.Parent.Items)
local Recipes = require(script.Parent.Recipes)
local Upgrades = require(script.Parent.Upgrades)

local Inventory = {}

-- `up` يحمل مستوى التطوير والصفة السحرية. الأغراض القابلة للتطوير حدّ تكديسها 1،
-- لذا لا يلتقي كومان مختلفان في الدمج أبداً — لكننا نحرس ذلك صراحة على أي حال.
export type Stack = { id: string, n: number, up: Upgrades.Upgrade? }
export type Slots = { [number]: Stack? }

function Inventory.new(): Slots
	return {}
end

function Inventory.copyStack(stack: Stack?): Stack?
	if not stack then return nil end
	local copy: Stack = { id = stack.id, n = stack.n }
	if stack.up then
		copy.up = { lvl = stack.up.lvl, aff = stack.up.aff }
	end
	return copy
end

-- إضافة عناصر؛ تُعيد الكمية المتبقية التي لم تتسع
function Inventory.add(slots: Slots, id: string, n: number, limit: number?): number
	local item = Items.get(id)
	if not item or n <= 0 then return n end
	local max = item.max
	local slotCount = limit or Config.INV_SLOTS

	-- أولاً: أكمل الأكوام الموجودة (لا ندمج في كومة مطوّرة أو مسحورة)
	for i = 1, slotCount do
		local stack = slots[i]
		if stack and stack.id == id and stack.n < max and stack.up == nil then
			local space = max - stack.n
			local take = math.min(space, n)
			stack.n += take
			n -= take
			if n <= 0 then return 0 end
		end
	end

	-- ثانياً: خانات فارغة
	for i = 1, slotCount do
		if not slots[i] then
			local take = math.min(max, n)
			slots[i] = { id = id, n = take }
			n -= take
			if n <= 0 then return 0 end
		end
	end

	return n
end

-- إضافة كومة كما هي (مع تطويرها) — تُستعمل لإعادة غرض مطوّر إلى اللاعب
function Inventory.addStack(slots: Slots, stack: Stack, limit: number?): boolean
	if not stack.up then
		return Inventory.add(slots, stack.id, stack.n, limit) == 0
	end
	local slotCount = limit or Config.INV_SLOTS
	for i = 1, slotCount do
		if not slots[i] then
			slots[i] = Inventory.copyStack(stack)
			return true
		end
	end
	return false
end

function Inventory.count(slots: Slots, id: string): number
	local total = 0
	for i = 1, Config.INV_SLOTS do
		local stack = slots[i]
		if stack and stack.id == id then total += stack.n end
	end
	return total
end

-- إزالة كمية؛ تُعيد false إن لم تكن متوفرة (ولا تُزيل شيئاً)
function Inventory.remove(slots: Slots, id: string, n: number): boolean
	if Inventory.count(slots, id) < n then return false end
	local left = n
	for i = 1, Config.INV_SLOTS do
		local stack = slots[i]
		if stack and stack.id == id then
			local take = math.min(stack.n, left)
			stack.n -= take
			left -= take
			if stack.n <= 0 then slots[i] = nil end
			if left <= 0 then return true end
		end
	end
	return left <= 0
end

function Inventory.removeFromSlot(slots: Slots, index: number, n: number): number
	local stack = slots[index]
	if not stack then return 0 end
	local take = math.min(stack.n, n)
	stack.n -= take
	if stack.n <= 0 then slots[index] = nil end
	return take
end

function Inventory.hasRoom(slots: Slots, id: string, n: number): boolean
	local item = Items.get(id)
	if not item then return false end
	local space = 0
	for i = 1, Config.INV_SLOTS do
		local stack = slots[i]
		if not stack then
			space += item.max
		elseif stack.id == id then
			space += item.max - stack.n
		end
		if space >= n then return true end
	end
	return space >= n
end

-- ===== التصنيع =====
function Inventory.canCraft(slots: Slots, recipe: Recipes.Recipe): boolean
	for _, ingredient in recipe.ins do
		if Inventory.count(slots, ingredient.id) < ingredient.n then return false end
	end
	return Inventory.hasRoom(slots, recipe.out.id, recipe.out.n)
end

function Inventory.craft(slots: Slots, recipe: Recipes.Recipe): boolean
	if not Inventory.canCraft(slots, recipe) then return false end
	for _, ingredient in recipe.ins do
		Inventory.remove(slots, ingredient.id, ingredient.n)
	end
	local leftover = Inventory.add(slots, recipe.out.id, recipe.out.n)
	return leftover == 0
end

-- ===== تحريك الخانات =====
function Inventory.swap(slots: Slots, a: number, b: number)
	if a == b then return end
	local sa, sb = slots[a], slots[b]

	-- دمج الأكوام المتطابقة (الأغراض المطوّرة لا تندمج أبداً)
	if sa and sb and sa.id == sb.id and sa.up == nil and sb.up == nil then
		local max = Items.maxStack(sa.id)
		local move = math.min(max - sb.n, sa.n)
		if move > 0 then
			sb.n += move
			sa.n -= move
			if sa.n <= 0 then slots[a] = nil end
			return
		end
	end

	slots[a], slots[b] = sb, sa
end

-- ===== التسلسل للحفظ =====
function Inventory.serialize(slots: Slots): { any }
	local out: { any } = {}
	for i = 1, Config.INV_SLOTS do
		local stack = slots[i]
		if stack then
			local entry: { any } = { i, stack.id, stack.n }
			if stack.up then
				entry[4] = stack.up.lvl
				entry[5] = stack.up.aff or ""
			end
			table.insert(out, entry)
		end
	end
	return out
end

function Inventory.deserialize(data: { any }?): Slots
	local slots: Slots = {}
	if type(data) ~= "table" then return slots end
	for _, entry in data :: { any } do
		if type(entry) == "table" and #entry >= 3 then
			local index, id, n = entry[1], entry[2], entry[3]
			if type(index) == "number" and type(id) == "string" and type(n) == "number" then
				if index >= 1 and index <= Config.INV_SLOTS and Items.get(id) and n > 0 then
					local stack: Stack = { id = id, n = math.min(n, Items.maxStack(id)) }
					if type(entry[4]) == "number" and Upgrades.canModify(id) then
						stack.up = Upgrades.normalize({ lvl = entry[4], aff = entry[5] })
					end
					slots[index] = stack
				end
			end
		end
	end
	return slots
end

-- شكل مُبسّط للإرسال عبر الشبكة
function Inventory.toNetwork(slots: Slots): { [number]: any }
	local out: { [number]: any } = {}
	for i = 1, Config.INV_SLOTS do
		local stack = slots[i]
		if stack then
			local entry: { any } = { stack.id, stack.n }
			if stack.up then
				entry[3] = stack.up.lvl
				entry[4] = stack.up.aff or ""
			end
			out[i] = entry
		end
	end
	return out
end

return Inventory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Items — سجل العناصر (كل ما يمكن حمله في المخزون).
	معرّف العنصر نص قصير ثابت (يُحفظ في DataStore) — لا تُغيّر المعرّفات بعد النشر.
]]

local Blocks = require(script.Parent.Blocks)
local B = Blocks.ID

local Items = {}

export type Item = {
	id: string,
	name: string,
	cat: string, -- block | tool | weapon | armor | material | consumable | ammo | misc
	max: number, -- أقصى تكديس
	color: Color3,
	rarity: number, -- 0 أبيض .. 5 أسطوري
	value: number, -- سعر البيع بالعملة

	place: number?, -- معرّف البلاطة عند الوضع
	wall: boolean?, -- يمكن وضعه كخلفية

	tool: string?, -- pickaxe | axe | hammer
	pick: number?, -- قوة المعول
	axe: number?, -- قوة الفأس
	speed: number?, -- مضاعف سرعة الاستخدام (1 = عادي)
	damage: number?,
	knockback: number?,
	useTime: number?, -- ثواني بين الاستخدامات
	crit: number?,
	ranged: string?, -- نوع الذخيرة المطلوبة
	shootSpeed: number?,
	mana: number?, -- كلفة المانا
	magic: string?, -- نوع التعويذة

	defense: number?,
	slot: string?, -- head | chest | feet
	setBonus: string?,

	heal: number?,
	restoreMana: number?,
	food: number?,
	buff: string?,
	buffTime: number?,

	ammo: string?,
	summon: string?, -- استدعاء زعيم
	nightOnly: boolean?,
	desc: string?,
}

local defs: { [string]: Item } = {}
local order: { string } = {}
local byBlock: { [number]: string } = {}

local function C(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function def(item: Item)
	defs[item.id] = item
	table.insert(order, item.id)
	if item.place then byBlock[item.place] = item.id end
end

-- عنصر بلاطة: يرث اللون والاسم من سجل البلاطات
local function blockItem(id: string, blockId: number, value: number, wall: boolean?)
	local b = Blocks.get(blockId)
	def({
		id = id,
		name = b.name,
		cat = "block",
		max = 999,
		color = b.color,
		rarity = 0,
		value = value,
		place = blockId,
		wall = wall,
	})
end

-- ===== بلاطات =====
blockItem("dirt", B.DIRT, 1, true)
blockItem("grass", B.GRASS, 1, true)
blockItem("stone", B.STONE, 1, true)
blockItem("clay", B.CLAY, 1, true)
blockItem("sand", B.SAND, 1, true)
blockItem("sandstone", B.SANDSTONE, 2, true)
blockItem("snow", B.SNOW, 1, true)
blockItem("ice", B.ICE, 1, true)
blockItem("mud", B.MUD, 1, true)
blockItem("jungle_grass", B.JUNGLE_GRASS, 1, true)
blockItem("gravel", B.GRAVEL, 1, true)
blockItem("ash", B.ASH, 1, true)
blockItem("log", B.LOG, 2, true)
blockItem("leaves", B.LEAVES, 1, true)
blockItem("plank", B.PLANK, 3, true)
blockItem("stone_brick", B.STONE_BRICK, 3, true)
blockItem("glass", B.GLASS, 4, true)
blockItem("sand_brick", B.SAND_BRICK, 3, true)
blockItem("brick", B.BRICK, 4, true)
blockItem("ice_brick", B.ICE_BRICK, 3, true)
blockItem("hellstone_brick", B.HELLSTONE_BRICK, 12, true)
blockItem("obsidian", B.OBSIDIAN, 14, true)
blockItem("coal_ore", B.COAL_ORE, 4)
blockItem("copper_ore", B.COPPER_ORE, 5)
blockItem("iron_ore", B.IRON_ORE, 8)
blockItem("silver_ore", B.SILVER_ORE, 12)
blockItem("gold_ore", B.GOLD_ORE, 18)
blockItem("diamond_ore", B.DIAMOND_ORE, 30)
blockItem("mythril_ore", B.MYTHRIL_ORE, 40)
blockItem("hellstone_ore", B.HELLSTONE_ORE, 35)
blockItem("crystal", B.CRYSTAL, 22)
blockItem("torch", B.TORCH, 1)
blockItem("lantern", B.LANTERN, 6)
blockItem("workbench", B.WORKBENCH, 8)
blockItem("furnace", B.FURNACE, 10)
blockItem("anvil", B.ANVIL, 18)
blockItem("alchemy_table", B.ALCHEMY, 24)
blockItem("enchant_table", B.ENCHANT_TABLE, 60)
blockItem("chest", B.CHEST, 12)
blockItem("platform", B.PLATFORM, 1)
blockItem("ladder", B.LADDER, 2)
blockItem("cactus", B.CACTUS, 2)
blockItem("cobweb", B.COBWEB, 1)
blockItem("sapling", B.SAPLING, 1)
blockItem("mushroom_block", B.MUSHROOM, 3)
blockItem("glow_mushroom_block", B.GLOW_MUSHROOM, 9)

-- ===== مواد =====
local function material(id: string, name: string, color: Color3, value: number, rarity: number?)
	def({ id = id, name = name, cat = "material", max = 999, color = color, rarity = rarity or 0, value = value })
end

material("wood", "خشب", C(150, 108, 64), 2)
material("coal", "فحم", C(48, 46, 50), 5)
material("copper_bar", "سبيكة نحاس", C(196, 122, 74), 14)
material("iron_bar", "سبيكة حديد", C(196, 174, 156), 22)
material("silver_bar", "سبيكة فضة", C(214, 220, 228), 34)
material("gold_bar", "سبيكة ذهب", C(238, 202, 84), 50, 1)
material("diamond", "ألماسة", C(126, 226, 234), 90, 2)
material("mythril_bar", "سبيكة ميثريل", C(102, 210, 176), 120, 3)
material("hellstone_bar", "سبيكة جهنمية", C(224, 110, 58), 110, 3)
material("string", "خيط", C(228, 228, 220), 3)
material("leather", "جلد", C(142, 98, 64), 8)
material("bone", "عظم", C(232, 228, 210), 6)
material("gel", "هلام", C(120, 170, 236), 4)
material("herb", "عشبة", C(126, 196, 96), 6)
material("glow_dust", "غبار متوهج", C(150, 242, 210), 12, 1)
material("shadow_scale", "قشرة ظلامية", C(126, 96, 170), 60, 3)
material("soul_fragment", "شظية روح", C(196, 150, 250), 80, 4)
material("coin", "عملة", C(246, 210, 96), 1)
material("upgrade_core", "نواة تطوير", C(232, 176, 80), 70, 2)
material("magic_essence", "جوهر سحري", C(168, 140, 250), 85, 3)

-- ===== الأدوات =====
local function tool(id: string, name: string, kind: string, power: number, damage: number, useTime: number, color: Color3, rarity: number, value: number)
	local item: Item = {
		id = id, name = name, cat = "tool", max = 1, color = color, rarity = rarity, value = value,
		tool = kind, damage = damage, useTime = useTime, knockback = 2.5, crit = 0.04,
	}
	if kind == "pickaxe" then item.pick = power elseif kind == "axe" then item.axe = power else item.pick = power end
	def(item)
end

tool("wood_pickaxe", "معول خشبي", "pickaxe", 12, 4, 0.42, C(150, 108, 64), 0, 10)
tool("stone_pickaxe", "معول حجري", "pickaxe", 22, 6, 0.36, C(122, 122, 130), 0, 20)
tool("copper_pickaxe", "معول نحاسي", "pickaxe", 30, 7, 0.33, C(196, 122, 74), 1, 40)
tool("iron_pickaxe", "معول حديدي", "pickaxe", 42, 9, 0.30, C(196, 174, 156), 1, 80)
tool("gold_pickaxe", "معول ذهبي", "pickaxe", 52, 10, 0.26, C(238, 202, 84), 2, 160)
tool("diamond_pickaxe", "معول ألماسي", "pickaxe", 68, 13, 0.22, C(126, 226, 234), 3, 320)
tool("mythril_pickaxe", "معول ميثريل", "pickaxe", 90, 17, 0.18, C(102, 210, 176), 4, 600)

tool("wood_axe", "فأس خشبي", "axe", 14, 5, 0.5, C(150, 108, 64), 0, 10)
tool("stone_axe", "فأس حجري", "axe", 26, 7, 0.44, C(122, 122, 130), 0, 20)
tool("iron_axe", "فأس حديدي", "axe", 46, 10, 0.36, C(196, 174, 156), 1, 80)
tool("diamond_axe", "فأس ألماسي", "axe", 72, 14, 0.28, C(126, 226, 234), 3, 300)

def({
	id = "hammer", name = "مطرقة", cat = "tool", max = 1, color = C(150, 140, 130), rarity = 1, value = 45,
	tool = "hammer", pick = 0, damage = 8, useTime = 0.45, knockback = 4,
	desc = "تهدم الجدران الخلفية",
})

-- ===== الأسلحة =====
local function sword(id: string, name: string, damage: number, useTime: number, color: Color3, rarity: number, value: number, kb: number?)
	def({
		id = id, name = name, cat = "weapon", max = 1, color = color, rarity = rarity, value = value,
		damage = damage, useTime = useTime, knockback = kb or 4, crit = 0.06, tool = "sword",
	})
end

sword("wood_sword", "سيف خشبي", 7, 0.36, C(150, 108, 64), 0, 12)
sword("stone_sword", "سيف حجري", 11, 0.34, C(122, 122, 130), 0, 24)
sword("copper_sword", "سيف نحاسي", 14, 0.32, C(196, 122, 74), 1, 48)
sword("iron_sword", "سيف حديدي", 19, 0.30, C(196, 174, 156), 1, 95)
sword("silver_sword", "سيف فضي", 24, 0.28, C(214, 220, 228), 2, 150)
sword("gold_sword", "سيف ذهبي", 29, 0.26, C(238, 202, 84), 2, 220)
sword("diamond_sword", "سيف ألماسي", 38, 0.24, C(126, 226, 234), 3, 420)
sword("mythril_blade", "نصل الميثريل", 52, 0.20, C(102, 210, 176), 4, 800, 6)
sword("night_edge", "حدّ الليل", 74, 0.18, C(150, 96, 200), 5, 1600, 7)

def({
	id = "wood_bow", name = "قوس خشبي", cat = "weapon", max = 1, color = C(150, 108, 64), rarity = 0, value = 20,
	damage = 8, useTime = 0.42, knockback = 2, ranged = "arrow", shootSpeed = 34, crit = 0.06,
})
def({
	id = "iron_bow", name = "قوس حديدي", cat = "weapon", max = 1, color = C(196, 174, 156), rarity = 1, value = 90,
	damage = 14, useTime = 0.34, knockback = 2.5, ranged = "arrow", shootSpeed = 42, crit = 0.08,
})
def({
	id = "hell_bow", name = "قوس الجحيم", cat = "weapon", max = 1, color = C(224, 110, 58), rarity = 3, value = 420,
	damage = 26, useTime = 0.26, knockback = 3, ranged = "arrow", shootSpeed = 52, crit = 0.1,
})
def({
	id = "arrow", name = "سهم", cat = "ammo", max = 999, color = C(190, 170, 140), rarity = 0, value = 1,
	ammo = "arrow", damage = 4,
})
def({
	id = "fire_arrow", name = "سهم ناري", cat = "ammo", max = 999, color = C(240, 140, 60), rarity = 1, value = 3,
	ammo = "arrow", damage = 9, buff = "burn",
})

def({
	id = "spark_staff", name = "عصا الشرر", cat = "weapon", max = 1, color = C(120, 190, 250), rarity = 2, value = 200,
	damage = 18, useTime = 0.3, knockback = 2, mana = 6, magic = "spark", shootSpeed = 30, crit = 0.08,
})
def({
	id = "flame_staff", name = "عصا اللهب", cat = "weapon", max = 1, color = C(250, 130, 70), rarity = 3, value = 520,
	damage = 30, useTime = 0.36, knockback = 3, mana = 10, magic = "flame", shootSpeed = 26, crit = 0.1,
})

-- ===== الدروع =====
local function armor(id: string, name: string, slot: string, defense: number, color: Color3, rarity: number, value: number, setBonus: string?)
	def({
		id = id, name = name, cat = "armor", max = 1, color = color, rarity = rarity, value = value,
		defense = defense, slot = slot, setBonus = setBonus,
	})
end

armor("leather_helm", "خوذة جلدية", "head", 2, C(142, 98, 64), 0, 20, "leather")
armor("leather_chest", "درع جلدي", "chest", 3, C(142, 98, 64), 0, 30, "leather")
armor("leather_boots", "حذاء جلدي", "feet", 2, C(142, 98, 64), 0, 20, "leather")
armor("copper_helm", "خوذة نحاسية", "head", 3, C(196, 122, 74), 1, 45, "copper")
armor("copper_chest", "درع نحاسي", "chest", 4, C(196, 122, 74), 1, 65, "copper")
armor("copper_boots", "حذاء نحاسي", "feet", 3, C(196, 122, 74), 1, 45, "copper")
armor("iron_helm", "خوذة حديدية", "head", 5, C(196, 174, 156), 1, 90, "iron")
armor("iron_chest", "درع حديدي", "chest", 7, C(196, 174, 156), 1, 130, "iron")
armor("iron_boots", "حذاء حديدي", "feet", 5, C(196, 174, 156), 1, 90, "iron")
armor("diamond_helm", "خوذة ألماسية", "head", 9, C(126, 226, 234), 3, 300, "diamond")
armor("diamond_chest", "درع ألماسي", "chest", 12, C(126, 226, 234), 3, 420, "diamond")
armor("diamond_boots", "حذاء ألماسي", "feet", 9, C(126, 226, 234), 3, 300, "diamond")
armor("mythril_helm", "خوذة ميثريل", "head", 13, C(102, 210, 176), 4, 700, "mythril")
armor("mythril_chest", "درع ميثريل", "chest", 17, C(102, 210, 176), 4, 900, "mythril")
armor("mythril_boots", "حذاء ميثريل", "feet", 13, C(102, 210, 176), 4, 700, "mythril")

-- ===== الاستهلاكيات =====
def({ id = "apple", name = "تفاحة", cat = "consumable", max = 99, color = C(214, 72, 72), rarity = 0, value = 4, food = 22, heal = 4, useTime = 0.6 })
def({ id = "mushroom", name = "فطر", cat = "consumable", max = 99, color = C(214, 178, 152), rarity = 0, value = 3, food = 14, useTime = 0.6 })
def({ id = "cooked_meat", name = "لحم مشوي", cat = "consumable", max = 99, color = C(178, 108, 74), rarity = 0, value = 10, food = 45, heal = 10, useTime = 0.8 })
def({ id = "bread", name = "خبز", cat = "consumable", max = 99, color = C(216, 178, 112), rarity = 0, value = 8, food = 36, useTime = 0.7 })
def({ id = "health_potion", name = "جرعة حياة", cat = "consumable", max = 30, color = C(232, 72, 96), rarity = 1, value = 24, heal = 60, useTime = 0.5, buff = "potion_sickness", buffTime = 20 })
def({ id = "mana_potion", name = "جرعة مانا", cat = "consumable", max = 30, color = C(96, 128, 240), rarity = 1, value = 20, restoreMana = 40, useTime = 0.5 })
